---
import Layout from '../layouts/Layout.astro';
import FAQ from '../components/FAQ.astro';
import { PageHero, Button, Icon } from '../components/ui';
import { localizePath } from '../i18n/routes';

const benefits = [
  {
    "icon": "bolt",
    "title": "Full access",
    "description": "All features of the platform from the first day"
  },
  {
    "icon": "target",
    "title": "No credit card required",
    "description": "Try all features for 14 days without payment details"
  },
  {
    "icon": "users",
    "title": "Full team access",
    "description": "Invite your entire board to try Dafira"
  },
  {
    "icon": "lock",
    "title": "Enterprise security",
    "description": "Encryption and security from day one"
  }
];

const faqData = {
  "title": "Frequently asked questions",
  "subtitle": "About the free trial.",
  "inLanguage": "en",
  "faqs": [
    {
      "question": "What's included in the free trial?",
      "answer": "You get full access to all Dafira features for 14 days, including document management, meeting tools, and collaboration features."
    },
    {
      "question": "Do I need a credit card to start?",
      "answer": "No, you can start your free trial without entering any payment information. We'll notify you before the trial ends."
    },
    {
      "question": "What happens after the trial?",
      "answer": "After 14 days, you can choose to upgrade to one of our paid plans. We'll help you select the best option for your needs."
    }
  ]
};

const trialHref = `${localizePath('en', '/request-demo')}?from=trial`;
---

<Layout title="Try Dafira Free - 14-Day Board Portal Trial" description="Try Dafira free for 14 days, with guidance from our team. No credit card required.">
  <main>
    <PageHero eyebrow="Free trial · 14 days" title="Start your free trial of Dafira" lead="Try Dafira for 14 days with your own board. No credit card required.">
      <dl class="mt-10 grid sm:grid-cols-2 gap-x-8 border-t border-line">
        {benefits.map((b) => (
          <div class="py-5 border-b border-line flex gap-3">
            <Icon name={b.icon} class="w-5 h-5 text-navy mt-0.5" />
            <div>
              <dt class="font-medium text-navy">{b.title}</dt>
              <dd class="mt-1 text-sm text-gray-600 leading-relaxed">{b.description}</dd>
            </div>
          </div>
        ))}
      </dl>

      <div slot="aside" class="border border-line rounded-md bg-white p-6 lg:p-10">
        <Icon name="users" class="w-6 h-6 text-navy" />
        <h2 class="mt-5 text-2xl font-semibold text-navy">Get started with expert guidance</h2>
        <p class="mt-3 text-gray-600 leading-relaxed">Our expert will help you set up your free trial so your board can use Dafira from day one.</p>
        <Button href={trialHref} size="lg" class="mt-8 w-full">Start now</Button>
        <p class="mt-3 text-sm text-gray-500">No commitment required</p>
      </div>
    </PageHero>


    <FAQ texts={faqData} />
  </main>
</Layout>
