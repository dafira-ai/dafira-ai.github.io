---
import Layout from '../layouts/Layout.astro';
import BoardAccountability from '../components/campaigns/BoardAccountability.astro';

const t = {
  hero: {
    eyebrow: 'Board accountability',
    title: 'From minutes to actions: AI that supports board accountability',
    lead: 'Do more than take notes. Turn every decision into traceable tasks with owners, deadlines, signatures and resolution status, in a secure, GDPR-compliant workflow.',
    primary: { text: 'Start free trial', href: '/try' },
    secondary: { text: 'Book a demo', href: '/request-demo' },
    note: 'No credit card required · EU-hosted · GDPR compliant',
  },
  card: {
    title: 'Decision → action → done',
    meta: 'Resolution register',
    rows: [
      { label: 'R-2026-11', text: 'Budget approval', tone: 'ok' as const, status: 'Completed' },
      { label: 'R-2026-12', text: 'Security audit', tone: 'pending' as const, status: 'In progress' },
      { label: 'R-2026-13', text: 'Board expansion', tone: 'info' as const, status: 'Proposed' },
    ],
    footer: 'Each resolution has an owner and a due date',
    footerMeta: 'eIDAS signatures',
    caption: 'Sample register',
  },
  promise: {
    eyebrow: 'The promise',
    title: 'From scattered decisions to systematic accountability',
    lead: 'Every board decision becomes a tracked action with clear ownership, deadlines and proof of completion.',
    items: [
      { icon: 'target', title: 'Decisions → actions', text: 'Decision points and resolutions are detected in your minutes and converted into tasks with owners, due dates and dependencies.', benefit: 'Decisions do not slip through the cracks' },
      { icon: 'bell', title: 'Accountability without friction', text: 'Automated reminders, follow-ups, an activity journal and traceability until closure.', benefit: 'Owners stay on track without micro-management' },
      { icon: 'signature', title: 'Integrated signatures', text: 'Validate minutes and resolutions with eIDAS-compliant electronic signature and evidential archiving.', benefit: 'Legal compliance built in' },
      { icon: 'list', title: 'Resolution tracking', text: 'Clear status (Proposed, Approved, In progress, Blocked, Closed), attached evidence and timestamps for audit.', benefit: 'Audit-ready documentation' },
    ],
  },
  roles: {
    eyebrow: 'For board leaders',
    title: 'Built for CEOs and board secretaries',
    lead: 'Different roles, shared need: decisions that get executed.',
    items: [
      { icon: 'user', role: 'CEO', benefits: [
        'Real-time visibility on who is doing what, and by when',
        'Fewer follow-up messages, more decisions executed, clearer accountability',
        'Clear reporting to the board, without parallel spreadsheets',
      ] },
      { icon: 'pen', role: 'Board secretary', benefits: [
        'No more post-meeting chaos: minutes generated, decisions extracted, tasks created automatically',
        'Signature workflow (minutes, resolutions) and secure distribution to directors',
        'A complete evidence file for audit and compliance',
      ] },
    ],
  },
  workflow: {
    eyebrow: 'Workflow',
    title: 'How it works: from meeting to accountability',
    steps: [
      { title: 'Capture and generate', text: 'Import audio, notes or documents; the AI generates a structured draft of the minutes (agenda, decisions, actions, resolutions).' },
      { title: 'Transform', text: 'Decisions and resolutions are detected and turned into tasks (owner, due date, tags, attachments).' },
      { title: 'Validate and sign', text: 'Electronic signature workflow for minutes and resolutions. Document locking, versioning and timestamps.' },
      { title: 'Track and follow up', text: 'Reminders, notifications, custom deadlines, owner follow-ups, comments and proof of execution.' },
      { title: 'Report', text: 'Dashboards and exports: resolution status, completion, delays and risks, plus an action follow-up item prepared for the next agenda.' },
    ],
  },
  modules: {
    eyebrow: 'Key modules',
    title: 'Everything you need for complete accountability',
    lead: 'Modules designed to work together.',
    items: [
      { icon: 'tasks', title: 'Action tracker', text: 'Kanban and list views, filters (owner, committee, priority, deadline), mentions and assignment.', features: ['Kanban boards', 'Filters', 'Team mentions', 'Priority management'] },
      { icon: 'book', title: 'Resolution register', text: 'Register of resolutions with status, legal basis, associated documents and votes.', features: ['Legal compliance', 'Document linking', 'Voting records', 'Status tracking'] },
      { icon: 'signature', title: 'E-signature and approvals', text: 'Qualified signature, seals, completion certificate and a configurable approval workflow.', features: ['eIDAS compliance', 'Approval workflows', 'Digital certificates', 'Audit trails'] },
      { icon: 'shield', title: 'Audit and compliance', text: 'Activity log, audit trails, EU hosting and GDPR compliance.', features: ['Complete audit trails', 'EU data hosting', 'GDPR compliance', 'Activity logging'] },
    ],
    links: [
      { text: 'Learn about security and e-signatures', href: '/security' },
      { text: 'Explore all features', href: '/features' },
    ],
  },
  europe: {
    eyebrow: 'Europe first',
    title: 'From decision to execution, with European safeguards',
    lead: 'Less friction between the meeting and the follow-up, in a platform built for European governance requirements.',
    callout: 'EU hosting, GDPR by design and eIDAS-compliant signatures: your board data stays in Europe.',
    primary: { text: 'Try it on your next meeting', href: '/try' },
    secondary: { text: 'Need an audit-ready resolution register?', href: '/request-demo' },
  },
  faq: {
    title: 'Frequently asked questions',
    subtitle: 'About AI-assisted board accountability',
    inLanguage: 'en',
    faqs: [
      { question: 'Can AI minutes track decisions and actions?', answer: 'Yes. The AI identifies decisions and resolutions in your minutes and converts them into actionable tasks with owners and due dates. Each item is tracked until completion with reminders, status updates and an auditable trail.' },
      { question: 'How do we follow up on board resolutions?', answer: 'Use the Resolution Register to track status (Proposed, Approved, In progress, Blocked, Closed), attach proof, assign owners and set deadlines. Automated reminders and dashboards make follow-up part of the standard board workflow.' },
      { question: 'Are electronic signatures legally binding?', answer: 'Yes. Dafira uses UniverSign, which provides eIDAS-compliant qualified electronic signatures. These have the same legal status as handwritten signatures in the EU and provide complete audit trails for compliance.' },
      { question: 'How does action tracking prevent things from falling through the cracks?', answer: 'Every decision becomes a tracked action with owner, deadline and status. Reminders, escalation workflows and dashboard visibility make sure nothing is forgotten or delayed without notice.' },
    ],
  },
  cta: {
    texts: {
      title: 'Turn every board decision into a tracked action',
      subtitle: 'See how a decision becomes a tracked, executed action. No credit card required.',
      cta1: 'Book a demo',
      cta2: 'Start free trial',
    },
    links: { cta1: '/request-demo', cta2: '/try' },
  },
};
---

<Layout
  title="From Minutes to Actions – AI Board Accountability | Dafira"
  description="Turn board minutes into trackable actions with owners, deadlines, e-signatures and resolution tracking. An EU-hosted, GDPR-compliant accountability workflow for boards."
>
  <main>
    <BoardAccountability t={t} />
  </main>
</Layout>
