---
import Layout from '../layouts/Layout.astro';
import RequestDemoView from '../components/forms/RequestDemoView.astro';
import type { RequestDemoTexts } from '../components/forms/RequestDemoView.astro';

const t: RequestDemoTexts = {
  eyebrow: 'Demo · 30 minutes',
  title: 'Talk to an expert',
  lead: 'Schedule a personalised demo with a board governance specialist and see how Dafira supports your board, from the agenda to signed minutes.',
  trial: {
    title: 'Almost there: one more step',
    before: 'Your free trial details have been submitted. Please book a meeting with our expert below.',
    strong: 'Your free trial will start after this meeting',
    after: ', where we will help you get set up and answer your questions.',
  },
  expert: {
    alt: '',
    name: 'Talk to a governance specialist',
    role: 'Board Governance Specialist',
    note: 'Your dedicated expert for this consultation',
  },
  form: {
    firstName: 'First name',
    lastName: 'Last name',
    email: 'Work email',
    emailPlaceholder: 'name@company.com',
    emailError: 'Please use your professional email address (not gmail.com, hotmail.com, etc.)',
    company: 'Company name',
    companyUrl: 'Company website',
    companyUrlPlaceholder: 'https://www.yourcompany.com',
    urlError: 'Please enter a valid company website URL',
    submit: 'Continue to schedule',
    confirmed: 'Details confirmed. Select your preferred time below.',
  },
  facts: [
    { label: 'Duration', value: '30 minutes' },
    { label: 'Commitment', value: 'None' },
    { label: 'Booking', value: 'Online' },
  ],
  outcomes: {
    eyebrow: 'During the demo',
    title: 'What you will get from this demo',
    items: [
      { icon: 'play', title: 'Live product walkthrough', text: 'Minute generation, agenda building and decision tracking, shown in a live board workspace.' },
      { icon: 'clipboard', title: 'Personalised assessment', text: 'A review of your current board processes and the areas where Dafira can help.' },
      { icon: 'list', title: 'Implementation roadmap', text: 'A plan for rolling out Dafira to your board, including timeline and good practices.' },
      { icon: 'document', title: 'Pricing proposal', text: 'A quote based on your board size, needs and specific requirements.' },
    ],
  },
  why: {
    eyebrow: 'Why Dafira',
    title: 'Why boards choose Dafira',
    lead: 'A board portal built for governance work, with security and support included.',
    items: [
      { icon: 'sparkle', title: 'AI built into the workflow', text: 'The AI assistant and AI minute builder are part of the platform, next to agendas, board packs and votes.' },
      { icon: 'lock', title: 'Enterprise security', text: 'Encryption, multi-factor authentication and data protection for every board and committee.' },
      { icon: 'support', title: 'Guided implementation', text: 'Guided onboarding with our team to get your board up and running.' },
      { icon: 'target', title: 'Purpose-built', text: 'Designed specifically for board governance, not adapted from other tools.' },
      { icon: 'globe', title: 'International compliance', text: 'Support for international governance standards and regulations.' },
    ],
  },
};
---

<Layout title="Request a Demo - Dafira Board Management Software" description="Schedule a personalised demo with a board governance specialist to see how Dafira supports your board meetings, board packs, votes and minutes.">
  <RequestDemoView t={t} />
</Layout>
