---
import Layout from '../layouts/Layout.astro';
import { supportFaqs } from '../data/faq-data';
import FAQ from '../components/FAQ.astro';
import CTA from '../components/CTA.astro';
import { PageHero, Section, SectionHeader, FeatureColumns } from '../components/ui';
import { localizePath } from '../i18n/routes';

import PricingTiers from '../components/pricing/PricingTiers.astro';
const supportServices = [
  {
    icon: "👥",
    title: "Dedicated Onboarding",
    description: "Personalized onboarding program tailored to your board's needs",
    features: [
      "Initial setup assistance",
      "Data migration support",
      "Custom workflow configuration",
      "Integration setup"
    ]
  },
  {
    icon: "🎓",
    title: "Training Programs",
    description: "Comprehensive training for all board members and administrators",
    features: [
      "Live training sessions",
      "On-demand video tutorials",
      "Best practices workshops",
      "Refresher courses"
    ]
  },
  {
    icon: "🛟",
    title: "Ongoing Support",
    description: "Multi-channel support to ensure your success",
    features: [
      "24/7 technical support",
      "Dedicated success manager",
      "Regular check-ins",
      "Priority issue resolution"
    ]
  }
];

const featureCategories = [
  {
    title: "Meeting Features",
    features: [
      "Agenda Builder",
      "Document Management",
      "Task Management",
      "Board Pack Tools",
      "Voting",
      "AI-Powered Minute Tools"
    ]
  },
  {
    title: "Post-Meeting Tools",
    features: [
      "Document Repository",
      "E-Signature",
      "Sub-Committee Support"
    ]
  },
  {
    title: "Collaboration & Governance",
    features: [
      "Real-time Collaboration",
      "Compliance Tools",
      "AI & Analytics",
      "Security Features"
    ]
  }
];


const faqData = {
  title: "Support & Training FAQ",
  subtitle: "Common questions about our support and training services",
  inLanguage: "en",
  faqs: supportFaqs
};



const ctaProps = {
  texts: {
    title: "Find the right plan for your board",
    subtitle: "Tell us about your board and committees. We will recommend a plan and prepare a quote.",
    cta1: "Request a demo",
    cta2: "Contact sales"
  },
  links: {
    cta1: localizePath("en", "/request-demo"),
    cta2: localizePath("en", "/contact")
  }
};

const supportColumns = supportServices.map((s) => ({ icon: s.icon, title: s.title, text: s.description, items: s.features }));
---

<Layout title="Pricing - Dafira Board Management Software" description="Simple and transparent pricing starting from €149/month. Choose the plan that fits your board.">
  <main>
    <PageHero
      eyebrow="Pricing"
      title="Simple, transparent pricing"
      lead="Three plans with the same secure foundation. All plans include our core features; you choose how far you go in collaboration, compliance and support."
    />

    <Section space="md">
      <PricingTiers />
    </Section>

    <Section tone="surface" border="top">
      <SectionHeader eyebrow="Onboarding and support" title="Support and training at every step" lead="Every plan comes with onboarding, training and support from our team." />
      <FeatureColumns items={supportColumns} />
    </Section>

    <FAQ texts={faqData} />

    <CTA {...ctaProps} />
  </main>
</Layout>
