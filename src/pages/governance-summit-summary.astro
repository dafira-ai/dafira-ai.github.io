---
import Layout from "../layouts/Layout.astro";
import { PageHero, Section, SectionHeader, Button, Icon, FeatureColumns, Field } from "../components/ui";
import governanceSummitImage from "../assets/governance_summit.png";

const pageTitle = "Governance Summit 2025: Programme and AI Summaries | Dafira";
const pageDescription = "Access the full programme and AI-generated session summaries from the Governance Summit 2025 in Antwerp, prepared with Dafira's AI minute builder.";

const benefits = [
  "Full programme with all sessions and speakers",
  "AI-generated summaries of the sessions",
  "Key takeaways on the governance topics discussed",
  "Immediate access after submitting the form",
];

const facts = [
  { term: "Date", value: "6 June 2025" },
  { term: "Venue", value: "Vestar, Antwerp" },
  { term: "Audience", value: "Board members, CEOs, secretaries-general, top managers, auditors, shareholders, sustainability experts" },
  { term: "Theme", value: "Creating good vibes in the boardroom" },
  { term: "Organiser", value: "De Bestuurder and network partners" },
];
---

<Layout
  title={pageTitle}
  description={pageDescription}
>
  <main>
    <PageHero
      eyebrow="Governance Summit 2025 · Antwerp"
      title="Missed the Governance Summit?"
      lead="Access the complete programme and AI-generated summaries of the sessions of the first Governance Summit, prepared with Dafira."
    >
      <ul class="mt-8 space-y-3">
        {benefits.map((b) => (
          <li class="flex gap-3 text-gray-700"><Icon name="check" class="w-5 h-5 mt-0.5 shrink-0 text-primary" /><span>{b}</span></li>
        ))}
      </ul>

      <div slot="aside" class="bg-white border border-line rounded-md p-6 lg:p-8">
        <h2 class="text-xl font-semibold text-navy">Get the programme and summaries</h2>
        <p class="mt-1 text-sm text-gray-500">Fill in the form to open the programme with the session summaries.</p>

        <form id="summaryForm" class="mt-6 space-y-5" method="POST">
          <div class="grid sm:grid-cols-2 gap-5">
            <Field id="firstName" label="First name" required autocomplete="given-name" />
            <Field id="lastName" label="Last name" required autocomplete="family-name" />
          </div>
          <Field id="email" type="email" label="Email address" required autocomplete="email" />
          <Field id="company" label="Company" required autocomplete="organization" />
          <div>
            <Field id="phone" type="tel" label="Phone number" required autocomplete="tel" />
            <span id="phone-error" class="hidden mt-1 block text-xs text-red-700">Please enter a valid phone number</span>
          </div>

          <div class="flex items-start gap-3">
            <input type="checkbox" id="updates" name="updates" class="mt-1 w-4 h-4 rounded-sm border-line accent-navy" />
            <label for="updates" class="text-sm text-gray-600">I would like to receive updates from Dafira about governance insights and platform features</label>
          </div>

          <Button type="submit" class="w-full">Access the summaries</Button>
          <p class="flex flex-wrap gap-x-5 gap-y-1 font-mono text-[11px] uppercase tracking-[0.08em] text-gray-500">
            <span>Secure</span><span>No spam</span><span>Immediate access</span>
          </p>
        </form>
      </div>
    </PageHero>

    <!-- About the summit -->
    <Section>
      <SectionHeader
        eyebrow="About the event"
        title="About the Governance Summit 2025"
        lead="The first Governance Summit brought together governance professionals for a day of keynotes, panels and parallel sessions."
      />
      <div class="grid lg:grid-cols-12 gap-10">
        <div class="lg:col-span-5">
          <div class="bg-white border border-line rounded-md p-6">
            <img src={governanceSummitImage.src} alt="Governance Summit 2025" width="2224" height="500" class="w-full h-auto" loading="lazy" />
          </div>
          <dl class="mt-8 border-t border-line">
            {facts.map((f) => (
              <div class="grid grid-cols-3 gap-4 py-4 border-b border-line">
                <dt class="font-mono text-xs uppercase tracking-[0.08em] text-gray-500 pt-0.5">{f.term}</dt>
                <dd class="col-span-2 text-ink">{f.value}</dd>
              </div>
            ))}
          </dl>
          <Button variant="link" href="https://www.governancesummit.be/summit/Home?lang=nl" target="_blank" rel="noopener noreferrer" class="mt-6">Visit GovernanceSummit.be</Button>
        </div>
        <div class="lg:col-span-6 lg:col-start-7 space-y-6 text-lg text-gray-700 leading-relaxed">
          <p>
            The event took place on 6 June 2025 at Vestar in Antwerp. The Governance Summit brought together board members, CEOs, secretaries-general, top managers, auditors, shareholders, sustainability experts and other professionals working on organisational governance.
          </p>
          <div class="border-s-2 border-primary ps-6">
            <h3 class="font-semibold text-navy">Theme: "Creating good vibes in the boardroom"</h3>
            <p class="mt-2 text-base text-gray-600">How boardrooms can function not only as places of decision-making, but also as drivers of innovation, sustainability and value creation.</p>
          </div>
          <p>
            The programme included keynotes by Randall S. Peterson, Brontie Ansell and Marilieke Engbers, along with sessions on ESG, diversity, corporate culture and leadership.
          </p>
          <p class="text-base text-gray-600">
            The summit was organised by De Bestuurder and its network partners. The session summaries on this page were prepared with Dafira's AI minute builder.
          </p>
        </div>
      </div>
    </Section>

    <!-- AI minute builder -->
    <Section tone="surface" border="both">
      <SectionHeader
        eyebrow="AI minute builder"
        title="The same AI, for your own board meetings"
        lead="The summaries of the summit were prepared with Dafira's AI minute builder. It drafts structured minutes of your board meetings, which your secretary reviews and publishes."
      />
      <FeatureColumns items={[
        { icon: 'document', title: 'Meeting summaries', text: 'A structured draft of the minutes, shortly after the meeting.' },
        { icon: 'tasks', title: 'Action items identified', text: 'Decisions and follow-up tasks extracted from the discussion.' },
        { icon: 'chart', title: 'Key takeaways', text: 'The main points of each agenda item, ready for review.' },
      ]} />
      <div class="flex flex-col sm:flex-row gap-3">
        <Button href="/features/ai-minute-builder">Discover the AI minute builder</Button>
        <Button variant="secondary" href="/try">Try Dafira</Button>
      </div>
    </Section>
  </main>
</Layout>

<link
  rel="stylesheet"
  href="https://cdnjs.cloudflare.com/ajax/libs/intl-tel-input/17.0.8/css/intlTelInput.css"
/>
<script
  is:inline
  src="https://cdnjs.cloudflare.com/ajax/libs/intl-tel-input/17.0.8/js/intlTelInput.min.js"
></script>
<script
  is:inline
  src="https://cdnjs.cloudflare.com/ajax/libs/intl-tel-input/17.0.8/js/utils.js"
></script>

<style is:global>
  /* intl-tel-input: full-width field; colours come from the Field control classes */
  .iti { display: block; width: 100%; }
</style>

<script>
  import { sendForm } from '../utils/sendForm';
  const form = document.getElementById('summaryForm');

  // Initialize phone input
  let phoneInput: any;
  const w = window as any;
  if (typeof window !== 'undefined' && w.intlTelInput) {
    phoneInput = w.intlTelInput(document.getElementById('phone'), {
      utilsScript: "https://cdnjs.cloudflare.com/ajax/libs/intl-tel-input/17.0.8/js/utils.js",
      preferredCountries: ["be", "fr", "nl", "gb", "ch", "dk"],
      separateDialCode: true,
      initialCountry: "be",
      autoPlaceholder: "aggressive",
      formatOnDisplay: true,
    });

    // Add phone validation
    const phoneElement = document.getElementById('phone');
    const phoneError = document.getElementById('phone-error');

    phoneElement?.addEventListener('blur', () => {
      if (phoneInput && phoneInput.isValidNumber()) {
        phoneError?.classList.add('hidden');
      } else {
        phoneError?.classList.remove('hidden');
      }
    });
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();

    // Validate phone number if phoneInput is available
    if (phoneInput && !phoneInput.isValidNumber()) {
      const phoneError = document.getElementById('phone-error');
      phoneError?.classList.remove('hidden');
      return;
    }

    const formData = new FormData(form as HTMLFormElement);
    const data = {
      firstName: formData.get('firstName'),
      lastName: formData.get('lastName'),
      email: formData.get('email'),
      company: formData.get('company'),
      phone: phoneInput ? phoneInput.getNumber() : formData.get('phone'),
      updates: formData.get('updates') === 'on',
      source: 'governance-summit-summary'
    };

    // Get button reference and original text
    const submitButton = (form as HTMLFormElement).querySelector('button[type="submit"]') as HTMLButtonElement;
    const originalText = submitButton?.innerHTML;

    try {
      // Here you would typically send the form data to your backend/CRM
      console.log('Form submitted:', data);

      // Show loading state (real loading spinner)
      if (submitButton) {
        submitButton.innerHTML = `
          <svg class="animate-spin -ms-1 me-3 h-5 w-5 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" aria-hidden="true">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
          </svg>
          Processing...
        `;
        submitButton.disabled = true;
      }

      if (!(await sendForm(form as HTMLFormElement, 'Governance Summit summary request'))) {
        if (submitButton) { submitButton.disabled = false; submitButton.innerHTML = originalText ?? submitButton.innerHTML; }
        return;
      }

      // Redirect to the program page with AI insights
      window.location.href = '/governance-summit-program';

    } catch (error) {
      console.error('Form submission error:', error);
      alert('There was an error submitting the form. Please try again.');

      // Reset button state
      if (submitButton && originalText) {
        submitButton.innerHTML = originalText;
        submitButton.disabled = false;
      }
    }
  });
</script>
