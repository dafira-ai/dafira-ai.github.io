---
import Layout from '../../layouts/Layout.astro';
import BoardAccountability from '../../components/campaigns/BoardAccountability.astro';

const t = {
  hero: {
    eyebrow: 'Responsabilisation du conseil',
    title: 'Des procès-verbaux aux actions : une IA au service de la responsabilisation du conseil',
    lead: 'Ne vous contentez plus de prendre des notes. Transformez chaque décision en tâches traçables, avec responsables, échéances, signatures et statut de résolution, dans un flux sécurisé et conforme au RGPD.',
    primary: { text: 'Commencer l’essai gratuit', href: '/fr/try' },
    secondary: { text: 'Demander une démo', href: '/fr/request-demo' },
    note: 'Sans carte de crédit · Hébergé dans l’UE · Conforme au RGPD',
  },
  card: {
    title: 'Décision → action → clôture',
    meta: 'Registre des résolutions',
    rows: [
      { label: 'R-2026-11', text: 'Approbation du budget', tone: 'ok' as const, status: 'Clôturée' },
      { label: 'R-2026-12', text: 'Audit de sécurité', tone: 'pending' as const, status: 'En cours' },
      { label: 'R-2026-13', text: 'Élargissement du conseil', tone: 'info' as const, status: 'Proposée' },
    ],
    footer: 'Chaque résolution a un responsable et une échéance',
    footerMeta: 'Signatures eIDAS',
    caption: 'Exemple de registre',
  },
  promise: {
    eyebrow: 'La promesse',
    title: 'Des décisions dispersées à une responsabilisation systématique',
    lead: 'Chaque décision du conseil devient une action suivie, avec un responsable clair, des échéances et une preuve d’exécution.',
    items: [
      { icon: 'target', title: 'Décisions → actions', text: 'Les points de décision et résolutions sont détectés dans vos procès-verbaux et convertis en tâches avec responsables, échéances et dépendances.', benefit: 'Aucune décision ne passe entre les mailles' },
      { icon: 'bell', title: 'Responsabilisation sans friction', text: 'Rappels automatiques, relances, journal d’activité et traçabilité jusqu’à la clôture.', benefit: 'Les responsables avancent sans micro-management' },
      { icon: 'signature', title: 'Signatures intégrées', text: 'Validez procès-verbaux et résolutions par signature électronique conforme eIDAS et archivage probant.', benefit: 'Conformité juridique intégrée' },
      { icon: 'list', title: 'Suivi des résolutions', text: 'Statut clair (Proposée, Approuvée, En cours, Bloquée, Clôturée), preuves jointes et horodatage pour l’audit.', benefit: 'Documentation prête pour l’audit' },
    ],
  },
  roles: {
    eyebrow: 'Pour les dirigeants',
    title: 'Conçu pour les CEO et les secrétaires de conseil',
    lead: 'Des rôles différents, un besoin commun : des décisions qui s’exécutent.',
    items: [
      { icon: 'user', role: 'CEO', benefits: [
        'Visibilité en temps réel sur qui fait quoi, et pour quand',
        'Moins de relances, plus de décisions exécutées, une responsabilité plus claire',
        'Un reporting clair au conseil, sans tableur parallèle',
      ] },
      { icon: 'pen', role: 'Secrétaire du conseil', benefits: [
        'Fini le chaos après la réunion : procès-verbal généré, décisions extraites, tâches créées automatiquement',
        'Circuit de signature (procès-verbaux, résolutions) et diffusion sécurisée aux administrateurs',
        'Un dossier de preuve complet pour l’audit et la conformité',
      ] },
    ],
  },
  workflow: {
    eyebrow: 'Flux de travail',
    title: 'Comment ça marche : de la réunion à la responsabilisation',
    steps: [
      { title: 'Capter et générer', text: 'Import d’audio, de notes ou de documents ; l’IA génère un projet de procès-verbal structuré (ordre du jour, décisions, actions, résolutions).' },
      { title: 'Transformer', text: 'Les décisions et résolutions sont détectées et converties en tâches (responsable, échéance, étiquettes, pièces jointes).' },
      { title: 'Valider et signer', text: 'Circuit de signature électronique des procès-verbaux et résolutions. Verrouillage, versionnage et horodatage.' },
      { title: 'Suivre et relancer', text: 'Rappels, notifications, délais personnalisés, relances aux responsables, commentaires et preuves d’exécution.' },
      { title: 'Rendre compte', text: 'Tableaux de bord et exports : statut des résolutions, avancement, retards et risques, et un point « suivi des actions » préparé pour l’ordre du jour suivant.' },
    ],
  },
  modules: {
    eyebrow: 'Modules clés',
    title: 'Tout ce qu’il faut pour une responsabilisation complète',
    lead: 'Des modules conçus pour fonctionner ensemble.',
    items: [
      { icon: 'tasks', title: 'Suivi des actions', text: 'Vues Kanban et liste, filtres (responsable, comité, priorité, échéance), mentions et assignation.', features: ['Tableaux Kanban', 'Filtres', 'Mentions d’équipe', 'Gestion des priorités'] },
      { icon: 'book', title: 'Registre des résolutions', text: 'Registre des résolutions avec statut, base légale, documents associés et votes.', features: ['Conformité juridique', 'Liaison de documents', 'Enregistrement des votes', 'Suivi de statut'] },
      { icon: 'signature', title: 'Signature électronique et approbations', text: 'Signature qualifiée, cachets, certificat de complétion et circuit d’approbation configurable.', features: ['Conformité eIDAS', 'Circuits d’approbation', 'Certificats numériques', 'Pistes d’audit'] },
      { icon: 'shield', title: 'Audit et conformité', text: 'Journal d’activité, pistes d’audit, hébergement UE et conformité RGPD.', features: ['Pistes d’audit complètes', 'Données hébergées dans l’UE', 'Conformité RGPD', 'Journal d’activité'] },
    ],
    links: [
      { text: 'En savoir plus sur la sécurité et les signatures', href: '/fr/security' },
      { text: 'Voir toutes les fonctionnalités', href: '/fr/features' },
    ],
  },
  europe: {
    eyebrow: 'L’Europe d’abord',
    title: 'De la décision à l’exécution, avec des garanties européennes',
    lead: 'Moins de frictions entre la réunion et le suivi, dans une plateforme conçue pour les exigences de gouvernance européennes.',
    callout: 'Hébergement UE, RGPD dès la conception et signatures conformes eIDAS : les données de votre conseil restent en Europe.',
    primary: { text: 'Tester sur votre prochaine réunion', href: '/fr/try' },
    secondary: { text: 'Besoin d’un registre des résolutions prêt pour l’audit ?', href: '/fr/request-demo' },
  },
  faq: {
    title: 'Questions fréquentes',
    subtitle: 'À propos de la responsabilisation du conseil assistée par IA',
    inLanguage: 'fr',
    faqs: [
      { question: 'L’IA peut-elle suivre les décisions et actions issues des procès-verbaux ?', answer: 'Oui. Les décisions et résolutions détectées sont converties en tâches avec responsables et échéances, puis suivies jusqu’à la clôture (rappels, statuts, piste d’audit).' },
      { question: 'Comment assurer le suivi des résolutions du conseil ?', answer: 'Via le registre des résolutions : statut (Proposée, Approuvée, En cours, Bloquée, Clôturée), responsables, échéances, preuves jointes. Les rappels automatiques et tableaux de bord structurent le suivi entre deux réunions.' },
      { question: 'Les signatures électroniques sont-elles juridiquement contraignantes ?', answer: 'Oui. Dafira utilise UniverSign, qui fournit des signatures électroniques qualifiées conformes eIDAS. Elles ont le même statut juridique que les signatures manuscrites dans l’UE et fournissent des pistes d’audit complètes pour la conformité.' },
      { question: 'Comment le suivi des actions évite-t-il les oublis ?', answer: 'Chaque décision devient une action suivie avec responsable, échéance et statut. Les rappels, les circuits d’escalade et la visibilité du tableau de bord évitent qu’un point soit oublié ou retardé sans que l’on s’en aperçoive.' },
    ],
  },
  cta: {
    texts: {
      title: 'Faites de chaque décision du conseil une action suivie',
      subtitle: 'Voyez comment une décision devient une action suivie et exécutée. Sans carte de crédit.',
      cta1: 'Demander une démo',
      cta2: 'Commencer l’essai gratuit',
    },
    links: { cta1: '/fr/request-demo', cta2: '/fr/try' },
  },
};
---

<Layout
  title="Des procès-verbaux aux actions – Responsabilisation du conseil par l'IA | Dafira"
  description="Transformez les procès-verbaux du conseil en actions traçables avec responsables, échéances, signatures électroniques et suivi des résolutions. Hébergé dans l'UE, conforme au RGPD."
>
  <main>
    <BoardAccountability t={t} />
  </main>
</Layout>
