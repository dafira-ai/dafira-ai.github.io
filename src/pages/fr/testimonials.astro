---
import Layout from '../../layouts/Layout.astro';
import { PageHero, Section } from '../../components/ui';
import CustomerQuotes from '../../components/case-studies/CustomerQuotes.astro';
import LocalizedCTA from '../../components/case-studies/LocalizedCTA.astro';

const testimonials = [
  {
    industry: "Association d'accompagnement du secteur associatif",
    title: "La gouvernance du conseil avec Dafira",
    quote: "Je suis persuadée qu'une plateforme comme Dafira favorise une prise de décision plus éclairée au niveau du conseil d'administration.",
    author: "Présidente",
    href: "/fr/case-studies/non-profit-organisation",
  },
  {
    industry: "Groupe de mode coté en bourse",
    title: "La gouvernance du conseil réunie en un lieu sécurisé",
    quote: "Dafira a transformé notre gestion du conseil d'administration, apportant efficacité et clarté à nos processus de gouvernance.",
    author: "Directrice juridique",
    href: "/fr/case-studies/listed-fashion-group",
  },
  {
    industry: "Fonds public d'investissement régional",
    title: "Une plateforme de gouvernance pour des administrateurs publics et privés",
    quote: "Dafira a joué un rôle essentiel dans la modernisation de notre structure de gouvernance et l'amélioration de notre efficacité opérationnelle.",
    author: "CEO",
    href: "/fr/case-studies/public-investment-fund",
  },
  {
    industry: "Société immobilière cotée du secteur des soins",
    title: "Un portail du conseil adapté à ses modèles, ses règles de présence et ses langues",
    quote: "Dafira représente la nouvelle génération de logiciels de gestion du conseil d'administration, facile à utiliser et intégrant l'IA.",
    author: "Juriste et responsable conformité",
    href: "/fr/case-studies/healthcare-real-estate",
  },
];
---

<Layout
  title="Témoignages clients - Dafira"
  description="Comment un groupe de mode coté en bourse, un fonds public d'investissement régional, une société immobilière cotée du secteur des soins et une association d'accompagnement du secteur associatif gèrent leur conseil avec Dafira."
>
  <PageHero
    eyebrow="Témoignages clients"
    title="Comment les conseils travaillent avec Dafira"
    lead="Présidents, directions juridiques, responsables conformité et dirigeants racontent, avec leurs propres mots, comment ils gèrent leur conseil avec Dafira."
  />

  <Section space="lg">
    <CustomerQuotes items={testimonials} linkText="Lire l’étude de cas" />
  </Section>

  <LocalizedCTA />
</Layout>
