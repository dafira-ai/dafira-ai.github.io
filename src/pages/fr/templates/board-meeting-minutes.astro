---
import Layout from '../../../layouts/Layout.astro';
import PreviewCard from '../../../components/templates/minutes/PreviewCard.astro';
import TemplateForm from '../../../components/templates/minutes/TemplateForm.astro';
import FeatureComparison from '../../../components/templates/minutes/FeatureComparison.astro';
import { PageHero, Section, CellGrid } from '../../../components/ui';

const previews = [
  { title: "Format structuré", description: "Sections claires pour l'ordre du jour, les discussions et les décisions", icon: "list" },
  { title: "Conseils de conformité", description: "Repères sur la documentation attendue d'un conseil", icon: "scale" }
];
---

<Layout
  title="Modèle gratuit de procès-verbal de conseil | Format professionnel"
  description="Téléchargez un modèle gratuit de procès-verbal de conseil d'administration : sections claires pour l'ordre du jour, les discussions et les décisions, avec des conseils de bonnes pratiques et de conformité."
>
  <main>
    <PageHero eyebrow="Modèle gratuit" title="Modèle de procès-verbal de conseil" lead="Une structure claire et prête à l'emploi pour vos procès-verbaux, avec des conseils sur les bonnes pratiques et les exigences de documentation.">
      <CellGrid columns={2} class="mt-10">
        {previews.map((preview) => <PreviewCard {...preview} />)}
      </CellGrid>
      <TemplateForm slot="aside" />
    </PageHero>

    <Section space="md">
      <div class="max-w-2xl mb-12">
        <h2 class="text-3xl lg:text-4xl font-semibold text-navy leading-tight">Un bon début. Dafira s'occupe du reste.</h2>
        <p class="mt-4 text-lg text-gray-600 leading-relaxed">De l'enregistrement au procès-verbal signé, au même endroit.</p>
      </div>
      <FeatureComparison />
    </Section>
  </main>
</Layout>
