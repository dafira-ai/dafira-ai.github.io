    after: ', au cours de laquelle nous vous aiderons à démarrer et répondrons à vos questions.',
  },
  expert: {
    alt: '',
    name: 'Échangez avec un spécialiste de la gouvernance',
    role: 'Spécialiste en gouvernance de conseil',
    note: 'Votre experte dédiée pour cette consultation',
  },
  form: {
    firstName: 'Prénom',
    lastName: 'Nom',
    email: 'Email professionnel',
    emailPlaceholder: 'nom@entreprise.com',
    emailError: 'Veuillez utiliser votre adresse email professionnelle (pas gmail.com, hotmail.com, etc.)',
    company: 'Nom de l’entreprise',
    companyUrl: 'Site web de l’entreprise',
    companyUrlPlaceholder: 'https://www.votreentreprise.com',
    urlError: 'Veuillez entrer une URL de site web valide',
    submit: 'Continuer vers la planification',
    confirmed: 'Informations confirmées. Sélectionnez votre créneau ci-dessous.',
  },
  facts: [
    { label: 'Durée', value: '30 minutes' },
    { label: 'Engagement', value: 'Aucun' },
    { label: 'Réservation', value: 'En ligne' },
  ],
  outcomes: {
    eyebrow: 'Pendant la démonstration',
    title: 'Ce que vous obtiendrez de cette démonstration',
    items: [
      { icon: 'play', title: 'Démonstration produit en direct', text: 'Génération des procès-verbaux, création de l’ordre du jour et suivi des décisions, présentés dans un espace de conseil réel.' },
      { icon: 'clipboard', title: 'Évaluation personnalisée', text: 'Une analyse de vos processus actuels et des domaines où Dafira peut vous aider.' },
      { icon: 'list', title: 'Feuille de route de mise en œuvre', text: 'Un plan de déploiement de Dafira pour votre conseil, avec calendrier et bonnes pratiques.' },
      { icon: 'document', title: 'Proposition tarifaire', text: 'Un devis adapté à la taille de votre conseil, à vos besoins et à vos exigences.' },
    ],
  },
  why: {
    eyebrow: 'Pourquoi Dafira',
    title: 'Pourquoi les conseils choisissent Dafira',
    lead: 'Un portail de conseil conçu pour le travail de gouvernance, sécurité et accompagnement compris.',
    items: [
      { icon: 'sparkle', title: 'L’IA intégrée au travail', text: 'L’assistant IA et la rédaction de procès-verbaux assistée par IA font partie de la plateforme, à côté des ordres du jour, dossiers et votes.' },
      { icon: 'lock', title: 'Sécurité entreprise', text: 'Chiffrement, authentification multi-facteurs et protection des données pour chaque conseil et comité.' },
      { icon: 'support', title: 'Mise en œuvre accompagnée', text: 'Une intégration guidée par notre équipe pour rendre votre conseil opérationnel.' },
      { icon: 'target', title: 'Conçu pour les conseils', text: 'Spécialement conçu pour la gouvernance des conseils d’administration, et non adapté d’autres outils.' },
      { icon: 'globe', title: 'Conformité internationale', text: 'Prise en charge des normes et réglementations de gouvernance internationales.' },
    ],
  },
};
---

<Layout title="Demander une démonstration - Logiciel de gestion de conseil Dafira" description="Planifiez une démonstration personnalisée avec une spécialiste de la gouvernance pour découvrir comment Dafira accompagne vos réunions, dossiers, votes et procès-verbaux.">
  <RequestDemoView t={t} />
</Layout>
