---
import Layout from '../../layouts/Layout.astro';
import FAQ from '../../components/FAQ.astro';
import { PageHero, Button, Icon } from '../../components/ui';
import { localizePath } from '../../i18n/routes';

const benefits = [
  {
    "icon": "bolt",
    "title": "Accès complet",
    "description": "Toutes les fonctionnalités de la plateforme dès le premier jour"
  },
  {
    "icon": "target",
    "title": "Sans carte bancaire",
    "description": "Testez toutes les fonctionnalités pendant 14 jours sans informations de paiement"
  },
  {
    "icon": "users",
    "title": "Accès pour toute l'équipe",
    "description": "Invitez tous les membres de votre conseil à découvrir Dafira"
  },
  {
    "icon": "lock",
    "title": "Sécurité de niveau entreprise",
    "description": "Chiffrement et sécurité dès le premier jour"
  }
];

const faqData = {
  "title": "Questions fréquentes",
  "subtitle": "À propos de l'essai gratuit.",
  "inLanguage": "fr",
  "faqs": [
    {
      "question": "Que comprend l'essai gratuit ?",
      "answer": "Vous bénéficiez d'un accès complet à toutes les fonctionnalités de Dafira pendant 14 jours, incluant la gestion documentaire, les outils de réunion et les fonctionnalités collaboratives."
    },
    {
      "question": "Une carte bancaire est-elle nécessaire ?",
      "answer": "Non, vous pouvez démarrer votre essai gratuit sans fournir d'informations de paiement. Nous vous avertirons avant la fin de la période d'essai."
    },
    {
      "question": "Et après l'essai ?",
      "answer": "À l'issue des 14 jours, vous pourrez opter pour l'un de nos forfaits payants. Nous vous accompagnerons pour choisir la formule la plus adaptée à vos besoins."
    }
  ]
};

const trialHref = `${localizePath('fr', '/request-demo')}?from=trial`;
---

<Layout title="Essayez Dafira gratuitement - Essai de 14 jours" description="Essayez Dafira gratuitement pendant 14 jours, accompagné par notre équipe. Aucune carte bancaire requise.">
  <main>
    <PageHero eyebrow="Essai gratuit · 14 jours" title="Commencez votre essai gratuit de Dafira" lead="Essayez Dafira pendant 14 jours avec votre propre conseil. Aucune carte bancaire requise.">
      <dl class="mt-10 grid sm:grid-cols-2 gap-x-8 border-t border-line">
        {benefits.map((b) => (
          <div class="py-5 border-b border-line flex gap-3">
            <Icon name={b.icon} class="w-5 h-5 text-navy mt-0.5" />
            <div>
              <dt class="font-medium text-navy">{b.title}</dt>
              <dd class="mt-1 text-sm text-gray-600 leading-relaxed">{b.description}</dd>
            </div>
          </div>
        ))}
      </dl>

      <div slot="aside" class="border border-line rounded-md bg-white p-6 lg:p-10">
        <Icon name="users" class="w-6 h-6 text-navy" />
        <h2 class="mt-5 text-2xl font-semibold text-navy">Démarrez avec l'aide d'un expert</h2>
        <p class="mt-3 text-gray-600 leading-relaxed">Notre expert vous aide à configurer votre essai gratuit pour que votre conseil utilise Dafira dès le premier jour.</p>
        <Button href={trialHref} size="lg" class="mt-8 w-full">Commencer maintenant</Button>
        <p class="mt-3 text-sm text-gray-500">Sans engagement</p>
      </div>
    </PageHero>


    <FAQ texts={faqData} />
  </main>
</Layout>
