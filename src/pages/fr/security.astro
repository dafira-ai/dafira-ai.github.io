      { icon: 'lock', title: 'Sécurité applicative', text: "Des contrôles au niveau de l'application.", items: ['Authentification à double facteur (2FA)', 'Gestion des sessions', 'Validation des entrées', 'En-têtes de sécurité'] },
      { icon: 'shield', title: 'Protection des données', text: 'Des mesures qui protègent les données stockées.', items: ['Chiffrement en transit et au repos', 'Stockage sécurisé', 'Sauvegardes régulières', "Contrôles d'accès aux données"] },
