---
import Layout from '../../../layouts/Layout.astro';
import GuideHeader from '../../../components/guides/GuideHeader.astro';
import GuideArticle from '../../../components/guides/GuideArticle.astro';
import { Button, Icon } from '../../../components/ui';
import GuideStep from '../../../components/guides/GuideStep.astro';
import GuideSubSection from '../../../components/guides/GuideSubSection.astro';
import GuideStepList from '../../../components/guides/GuideStepList.astro';
import ProTip from '../../../components/guides/ProTip.astro';

const groupSetupSteps = [
  "Accédez à la section Membres > Groupes dans votre tableau de bord",
  "Cliquez sur 'Créer un nouveau groupe' pour configurer un comité",
  "Nommez votre groupe (ex: 'Comité des finances', 'Comité d'audit')",
  "Définissez les droits d'accès aux données historiques",
  "Enregistrez les paramètres du groupe"
];

const inviteMembersSteps = [
  "Rendez-vous dans la section Membres",
  "Cliquez sur 'Inviter des membres'",
  "Saisissez les adresses e-mail des membres",
  "Attribuez le rôle approprié (Administrateur, Membre ou Observateur)",
  "Envoyez les invitations"
];

const beforeMeetingSteps = [
  "Planifiez la réunion en fixant la date, l'heure et le lieu",
  "Créez un ordre du jour détaillé avec les points clés",
  "Téléchargez et organisez les documents pertinents",
  "Envoyez les convocations aux participants"
];

const duringMeetingSteps = [
  "Faites l'appel et vérifiez le quorum",
  "Suivez l'ordre du jour structuré",
  "Enregistrez les discussions importantes",
  "Utilisez la collaboration documentaire en temps réel",
  "Notez les points d'action et les résolutions"
];

const afterMeetingSteps = [
  "Finalisez le procès-verbal",
  "Faites signer le PV par les participants requis",
  "Partagez les minutes approuvées et les résolutions",
  "Suivez l'avancement des points d'action",
  "Préparez la prochaine réunion"
];
---

<Layout title="Démarrer avec Dafira - Guide Complet" description="Bienvenue sur Dafira, votre plateforme complète pour une gouvernance efficace. Ce guide vous accompagnera dans la prise en main et l'organisation de vos conseils d'administration.">
  <main>
    <GuideHeader
        title="Débuter avec Dafira : Votre Guide Complet"
        description="Bienvenue sur Dafira, votre plateforme de gestion de conseil. Découvrez comment optimiser la gestion de votre conseil d'administration étape par étape."
      />
    <GuideArticle>

      <GuideStep
        number={1}
        title="Structurez vos Groupes"
        description="Les groupes dans Dafira permettent d'organiser vos administrateurs en comités, garantissant un accès ciblé aux informations pertinentes."
      >
        <GuideSubSection title="Création des Comités">
          <GuideStepList items={groupSetupSteps} />
        </GuideSubSection>

        <ProTip
          tip="Lors de la configuration des groupes, accordez une attention particulière aux droits d'accès aux données historiques pour assurer un partage d'information approprié tout en préservant la confidentialité."
        />
      </GuideStep>

      <GuideStep
        number={2}
        title="Constituez votre Conseil"
        description="Intégrez vos administrateurs sur Dafira avec les rôles et permissions adaptés."
      >
        <GuideSubSection title="Processus d'invitation des membres">
          <GuideStepList items={inviteMembersSteps} />
        </GuideSubSection>

        <ProTip
          tip="Attribuez les rôles avec précision : les Administrateurs ont un accès complet, les Membres un accès standard à leurs groupes, et les Observateurs des droits de consultation limités."
        />
      </GuideStep>

      <GuideStep
        number={3}
        title="Maîtrisez le Cycle des Réunions"
        description="Une réunion efficace se déroule en trois temps : la préparation, la séance et le suivi. Voici comment optimiser chaque phase avec Dafira."
      >
        <GuideSubSection title="Avant la Réunion">
          <p class="text-gray-600 mb-4">Une préparation minutieuse est la clé du succès. Suivez ces étapes :</p>
          <GuideStepList items={beforeMeetingSteps} />
        </GuideSubSection>

        <GuideSubSection title="Pendant la Réunion">
          <p class="text-gray-600 mb-4">Exploitez les fonctionnalités en temps réel de Dafira pour des échanges productifs :</p>
          <GuideStepList items={duringMeetingSteps} />
        </GuideSubSection>

        <GuideSubSection title="Après la Réunion">
          <p class="text-gray-600 mb-4">Assurez le suivi et maintenez la dynamique avec ces actions post-réunion :</p>
          <GuideStepList items={afterMeetingSteps} />
        </GuideSubSection>

        <ProTip
          tip="Utilisez les outils collaboratifs de Dafira tout au long du processus pour maintenir une source unique de vérité pour tous vos documents."
        />
      </GuideStep>

      <!-- Conclusion -->
      <div class="mt-16 rounded-md p-8 border border-line bg-surface">
        <h2 class="text-2xl font-semibold text-navy mb-4">Prêt pour une Gouvernance Efficace</h2>
        <p class="text-lg text-gray-600 leading-relaxed mb-6">
          Vous disposez maintenant de tous les outils pour piloter efficacement votre conseil d'administration. La bonne gouvernance est un processus continu, et Dafira vous accompagne à chaque étape.
        </p>
      </div>
    </GuideArticle>
  </main>
</Layout>