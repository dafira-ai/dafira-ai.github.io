---
import Layout from '../../../layouts/Layout.astro';
import RoleLanding from '../../../components/industries/RoleLanding.astro';
import { customerQuote, readCaseLabel } from '../../../components/industries/customerQuotes';

const hero = {
  eyebrow: 'Pour les dirigeants',
  title: 'Informer le conseil, selon vos conditions',
  lead: 'Décidez de ce qui parvient au conseil et à quel moment. Dafira vous offre un canal unique et maîtrisé pour les documents du conseil, les mises à jour et le suivi, avec des accès définis par rôle.',
  primary: { text: 'Demander une démo', href: '/fr/request-demo' },
  secondary: { text: 'Nous contacter', href: '/fr/contact' },
  screenshot: { src: '/onboarding-event-detail.png', alt: 'Page de réunion Dafira avec l’ordre du jour, les présences et un vote en attente sur le procès-verbal' },
};

const challenges = {
  title: 'Ce que les dirigeants attendent du fonctionnement du conseil',
  lead: 'Le conseil dépend de la direction pour s’informer. La manière dont l’information est partagée conditionne la qualité des échanges.',
  items: [
    { icon: 'folder', title: 'Maîtrise de l’information', text: 'Un seul espace pour tout ce que reçoit le conseil, pour savoir quelle version chaque administrateur a lue.' },
    { icon: 'clock', title: 'Communication dans les délais', text: 'Diffuser les mises à jour et les documents du conseil à temps, sans dépendre de chaînes d’e-mails.' },
    { icon: 'list', title: 'Équilibre de l’information', text: 'Structurer le dossier du conseil par point de l’ordre du jour, pour que les administrateurs trouvent l’essentiel sans être submergés.' },
    { icon: 'chat', title: 'Réactivité', text: 'Répondre aux questions des administrateurs entre les réunions dans une messagerie sécurisée, en gardant le contexte.' },
  ],
};

const features = {
  title: 'Les outils du dirigeant',
  lead: 'Les fonctions de Dafira que les dirigeants utilisent le plus.',
  items: [
    { icon: 'documents', title: 'Maîtrise des documents', text: 'Partager les documents du conseil depuis un seul endroit et garder la trace de ce qui a été envoyé.', items: ['Diffusion contrôlée', 'Dossier du conseil par point', 'Notifications de mise à jour', 'Historique des versions'] },
    { icon: 'sparkle', title: 'Assistant IA', text: 'Les administrateurs peuvent poser des questions sur les documents du conseil et obtenir des résumés des documents longs.', items: ['Questions sur les documents du conseil', 'Résumés des documents longs', 'Recherche dans les réunions passées'] },
    { icon: 'lock', title: 'Communication sécurisée', text: 'Garder les échanges du conseil hors des messageries et e-mails personnels.', items: ['Messagerie sécurisée du conseil', 'Accès par rôle', 'Piste d’audit'] },
  ],
};

const security = {
  title: 'La sécurité des échanges du conseil',
  lead: 'Les informations du conseil restent au sein du conseil.',
  link: { text: 'En savoir plus sur la sécurité', href: '/fr/security' },
  items: [
    { icon: 'lock', title: 'Chiffrement', text: 'Les données sont chiffrées en transit et au repos, sur l’infrastructure Microsoft Azure.' },
    { icon: 'users', title: 'Contrôle des accès', text: 'Des autorisations par conseil, comité et rôle, pour que l’information n’atteigne que les bonnes personnes.' },
    { icon: 'clipboard', title: 'Piste d’audit', text: 'Une trace des accès aux documents et des décisions prises.' },
  ],
};

const quote = { ...customerQuote('fr', 'pierre'), linkText: readCaseLabel.fr };
---

<Layout title="Logiciel de gestion de conseil d'administration pour dirigeants | Dafira" description="Portail du conseil pour les dirigeants : maîtriser l’information transmise au conseil, diffuser les mises à jour à temps et sécuriser les échanges du conseil.">
  <main>
    <RoleLanding hero={hero} challenges={challenges} features={features} security={security} quote={quote} />
  </main>
</Layout>
