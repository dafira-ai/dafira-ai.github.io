---
import Layout from '../../../layouts/Layout.astro';
import RoleLanding from '../../../components/industries/RoleLanding.astro';
import { customerQuote, readCaseLabel } from '../../../components/industries/customerQuotes';

const hero = {
  eyebrow: 'Pour les administrateurs indépendants',
  title: 'Une supervision indépendante, avec la bonne information',
  lead: 'Lisez le dossier du conseil sur n’importe quel appareil, échangez avec les autres administrateurs non exécutifs dans un espace privé et retrouvez les décisions passées quand vous en avez besoin.',
  primary: { text: 'Demander une démo', href: '/fr/request-demo' },
  secondary: { text: 'Nous contacter', href: '/fr/contact' },
  screenshot: { src: '/onboarding-private-chat.png', alt: 'Messages privés entre membres du conseil dans Dafira' },
};

const challenges = {
  title: 'Ce dont les administrateurs indépendants ont besoin',
  lead: 'L’indépendance suppose de disposer de la même information que la direction, et d’un espace pour en discuter.',
  items: [
    { icon: 'scale', title: 'Préserver l’indépendance', text: 'Des espaces et des échanges privés, distincts de la direction exécutive.' },
    { icon: 'search', title: 'Une supervision efficace', text: 'L’accès aux documents du conseil, aux procès-verbaux et aux décisions passées pour poser des questions éclairées.' },
    { icon: 'users', title: 'Échanges entre pairs', text: 'Des conversations privées entre administrateurs indépendants pour préparer les sujets avant la réunion.' },
    { icon: 'clipboard', title: 'Conflits d’intérêts', text: 'Une trace des accès aux documents et des intérêts déclarés, conservée avec les procès-verbaux.' },
  ],
};

const features = {
  title: 'Fonctionnalités pour les administrateurs indépendants',
  lead: 'Ce que Dafira apporte à une supervision indépendante.',
  items: [
    { icon: 'chat', title: 'Communication privée', text: 'Des canaux sécurisés pour les échanges entre administrateurs indépendants.', items: ['Conversations privées', 'Espaces documentaires séparés', 'Messagerie sécurisée'] },
    { icon: 'documents', title: 'Outils de supervision', text: 'Tout ce qu’il faut pour suivre la société entre les réunions.', items: ['Historique des documents', 'Registre des décisions', 'Suivi des actions', 'Annotations privées'] },
    { icon: 'sparkle', title: 'Assistant IA', text: 'Posez des questions sur les documents du conseil et obtenez des résumés des documents longs avant la réunion.', items: ['Questions sur les documents du conseil', 'Résumés des documents longs'] },
  ],
};

const security = {
  title: 'Sécurité et confidentialité',
  lead: 'Les échanges des administrateurs indépendants restent privés.',
  link: { text: 'En savoir plus sur la sécurité', href: '/fr/security' },
  items: [
    { icon: 'lock', title: 'Accès sécurisé', text: 'Des autorisations par rôle séparent les espaces des administrateurs indépendants de ceux des autres utilisateurs.' },
    { icon: 'clipboard', title: 'Piste d’audit', text: 'Une trace des accès et des modifications des documents, pour la transparence.' },
    { icon: 'shield', title: 'Protection des données', text: 'Chiffrement en transit et au repos, et pratiques de protection des données conformes au RGPD.' },
  ],
};

const quote = { ...customerQuote('fr', 'nathalie'), linkText: readCaseLabel.fr };
---

<Layout title="Logiciel de gestion du conseil pour administrateurs indépendants | Dafira" description="Portail du conseil pour les administrateurs indépendants : espaces privés d’échange, accès aux documents du conseil et aux décisions passées, assistant IA pour les documents longs.">
  <main>
    <RoleLanding hero={hero} challenges={challenges} features={features} security={security} quote={quote} />
  </main>
</Layout>
