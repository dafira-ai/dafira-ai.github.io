---
import Layout from '../../../../layouts/Layout.astro';
import { PageHero, Section, SectionHeader, Button, Icon, FeatureColumns, CellGrid, FeatureList, Screenshot, CTA } from '../../../../components/ui';
import { ctaProps } from '../../../../components/industries/i18n';

const responsibilities = {
  title: 'Vous accompagner dans vos missions d’administrateur',
  lead: 'Ce que le conseil attend de ses membres, et là où Dafira vous aide.',
  items: [
    { icon: 'target', title: 'Supervision stratégique', text: 'Lire les documents du conseil dans leur contexte, avec l’historique des discussions passées à portée de main.' },
    { icon: 'scale', title: 'Devoir fiduciaire', text: 'Décider sur la base d’une information complète et à jour, et en garder la trace.' },
    { icon: 'users', title: 'Relations avec les parties prenantes', text: 'Garder les échanges avec les autres administrateurs et la direction structurés et sécurisés.' },
    { icon: 'tasks', title: 'Suivi', text: 'Suivre les actions et les décisions d’une réunion à l’autre.' },
  ],
};

const roles = {
  title: 'Par rôle',
  lead: 'Des pages dédiées aux différentes fonctions au sein du conseil.',
  link: 'Voir la page du rôle',
  items: [
    { title: 'Administrateur indépendant', icon: 'scale', text: 'Une supervision objective, avec des espaces privés d’échange entre administrateurs indépendants.', href: '/fr/for/independent-director', features: ['Conversations privées', 'Accès aux décisions passées', 'Registre des conflits d’intérêts'] },
    { title: 'Administrateur représentant un actionnaire', icon: 'trend', text: 'Représenter les actionnaires tout en agissant dans l’intérêt de la société.', href: '/fr/for/shareholder-director', features: ['Communication sécurisée', 'Documents du conseil organisés', 'Votes et registre des décisions'] },
  ],
};

const features = {
  title: 'Les outils de chaque administrateur',
  lead: 'Ce que chaque administrateur utilise, quel que soit son rôle.',
  items: [
    { icon: 'sparkle', title: 'Assistant IA', text: 'Posez des questions sur les documents du conseil et obtenez des résumés des documents longs.', items: ['Questions sur les documents du conseil', 'Résumés', 'Recherche dans les réunions passées'] },
    { icon: 'pen', title: 'Collaboration', text: 'Préparer la réunion et en discuter avec le reste du conseil.', items: ['Annotations privées', 'Messagerie sécurisée du conseil', 'Liens de réunion en ligne', 'Documents partagés'] },
    { icon: 'vote', title: 'Décisions', text: 'Voter, signer et retrouver ce qui a été décidé.', items: ['Votes', 'Signature électronique', 'Registre des décisions', 'Actions de suivi'] },
  ],
};

const industries = {
  title: 'Par secteur',
  lead: 'Des pages sectorielles pour les administrateurs des secteurs réglementés.',
  link: 'Voir la page sectorielle',
  items: [
    { id: 'financial-services', icon: 'bank', name: 'Services financiers', text: 'Banques, assureurs et sociétés d’investissement.', features: ['Contexte réglementaire', 'Gestion documentaire sécurisée', 'Réunions des comités'] },
    { id: 'healthcare', icon: 'health', name: 'Santé', text: 'Hôpitaux, prestataires de soins et sciences de la vie.', features: ['Gouvernance clinique à l’ordre du jour', 'Documents confidentiels', 'Réunions des comités'] },
    { id: 'real-estate', icon: 'building', name: 'Immobilier', text: 'Investissement et gestion immobilière.', features: ['Décisions d’investissement', 'Documents de portefeuille', 'Registre des décisions'] },
  ],
};
---

<Layout title="Logiciel pour administrateurs | Portail du conseil Dafira" description="Portail du conseil pour les administrateurs : lire et annoter le dossier du conseil sur n’importe quel appareil, voter, signer et retrouver les décisions passées. Pages par rôle et par secteur.">
  <main>
    <PageHero eyebrow="Pour les administrateurs" title="Le dossier du conseil, les échanges et les décisions, en un seul endroit" lead="Que vous soyez administrateur indépendant, représentant d’un actionnaire ou spécialiste d’un secteur, Dafira vous donne l’information nécessaire pour décider, sur n’importe quel appareil.">
      <Fragment slot="actions">
        <Button href="/fr/request-demo">Demander une démo</Button>
        <Button variant="secondary" href="/fr/contact">Nous contacter</Button>
      </Fragment>
      <Screenshot slot="aside" src="/onboarding-boardpack.png" alt="Dossier du conseil Dafira organisé par point de l’ordre du jour, avec des annotations sur un document" eager />
    </PageHero>

    <Section>
      <SectionHeader title={responsibilities.title} lead={responsibilities.lead} />
      <CellGrid columns={2}>
        {responsibilities.items.map((item) => (
          <div class="bg-white p-8">
            <Icon name={item.icon} class="w-6 h-6 text-navy" />
            <h3 class="mt-5 text-lg font-semibold text-navy">{item.title}</h3>
            <p class="mt-2 text-[15px] text-gray-600 leading-relaxed">{item.text}</p>
          </div>
        ))}
      </CellGrid>
    </Section>

    <Section tone="surface" border="both">
      <SectionHeader title={roles.title} lead={roles.lead} />
      <CellGrid columns={2}>
        {roles.items.map((role) => (
          <a href={role.href} class="group bg-white p-8 lg:p-10 hover:bg-surface transition-colors flex flex-col">
            <Icon name={role.icon} class="w-6 h-6 text-navy" />
            <h3 class="mt-5 text-xl font-semibold text-navy">{role.title}</h3>
            <p class="mt-3 text-gray-600 leading-relaxed">{role.text}</p>
            <FeatureList items={role.features} class="mt-6" />
            <span class="mt-auto pt-8 text-[15px] font-medium text-primary group-hover:text-navy transition-colors">{roles.link}</span>
          </a>
        ))}
      </CellGrid>
    </Section>

    <Section>
      <SectionHeader title={features.title} lead={features.lead} />
      <FeatureColumns items={features.items} />
    </Section>

    <Section tone="surface" border="both">
      <SectionHeader title={industries.title} lead={industries.lead} />
      <CellGrid columns={3}>
        {industries.items.map((item) => (
          <a href={`/fr/for/board-member/industry/${item.id}`} class="group bg-white p-8 hover:bg-surface transition-colors flex flex-col">
            <Icon name={item.icon} class="w-6 h-6 text-navy" />
            <h3 class="mt-5 text-lg font-semibold text-navy">{item.name}</h3>
            <p class="mt-2 text-[15px] text-gray-600 leading-relaxed">{item.text}</p>
            <FeatureList items={item.features} class="mt-6" />
            <span class="mt-auto pt-8 text-[15px] font-medium text-primary group-hover:text-navy transition-colors">{industries.link}</span>
          </a>
        ))}
      </CellGrid>
    </Section>

    <CTA {...ctaProps.fr} />
  </main>
</Layout>
