---
import Layout from '../../../../layouts/Layout.astro';
import Testimonials from '../../../../components/Testimonials.astro';
import { PageHero, Section, SectionHeader, Button, Icon, FeatureColumns, CellGrid, Screenshot, CTA } from '../../../../components/ui';
import { customerQuote } from '../../../../components/industries/customerQuotes';
import { ctaProps } from '../../../../components/industries/i18n';

const dayInLife = {
  title: 'Une journée de conseil, avant et après',
  lead: 'Trois moments de la journée d’un secrétaire du conseil, avec et sans portail du conseil.',
  beforeLabel: 'Sans portail',
  afterLabel: 'Avec Dafira',
  slots: [
    { time: '09:00', before: 'Chercher dans les e-mails la dernière version du dossier du conseil.', after: 'Le dossier du conseil est en un seul endroit, organisé par point de l’ordre du jour, avec son historique des versions.' },
    { time: '14:00', before: 'Prendre des notes détaillées tout en essayant de suivre la discussion.', after: 'Suivre la réunion, avec les présences, les votes et les résolutions enregistrés au fil de l’eau.' },
    { time: '17:30', before: 'Commencer le procès-verbal à partir d’une page blanche.', after: 'Relire un premier projet préparé avec l’assistant de rédaction de procès-verbaux par IA.' },
  ],
};

const painPoints = {
  title: 'Les difficultés courantes',
  lead: 'Le travail quotidien d’un secrétaire du conseil, et la manière dont Dafira le prend en charge.',
  items: [
    { icon: 'documents', title: 'Documents dispersés', text: 'Remplacer les fils d’e-mails et la confusion des versions par une bibliothèque sécurisée unique pour les documents du conseil.' },
    { icon: 'clock', title: 'Procès-verbaux rédigés tard le soir', text: 'L’assistant IA rédige un projet de procès-verbal, en reprenant les actions et les résolutions.' },
    { icon: 'signature', title: 'Relances pour les signatures', text: 'Recueillir électroniquement les signatures des procès-verbaux et des résolutions.' },
    { icon: 'search', title: 'Retrouver les décisions passées', text: 'Rechercher dans l’historique des réunions, procès-verbaux et décisions.' },
  ],
};

const features = {
  title: 'Vos outils de travail',
  lead: 'Les fonctions de Dafira que les secrétaires du conseil utilisent chaque jour.',
  items: [
    { icon: 'sparkle', title: 'Rédaction de PV assistée par IA', text: 'Un premier projet de procès-verbal, à relire et compléter.', items: ['Projet de procès-verbal', 'Suivi des actions', 'Résumés de réunion', 'Assistant IA sur les documents du conseil'] },
    { icon: 'folder', title: 'Documents', text: 'La maîtrise de la documentation du conseil, du projet à la signature.', items: ['Historique des versions', 'Diffusion sécurisée', 'Signature électronique', 'Modèles'] },
    { icon: 'calendar', title: 'Réunions', text: 'De l’invitation au suivi.', items: ['Calendrier et invitations', 'Création d’ordres du jour', 'Présences', 'Tâches et suivi'] },
  ],
};

const industries = {
  title: 'Par secteur',
  lead: 'Dans les secteurs réglementés, les secrétaires du conseil ont des besoins spécifiques en matière de registres.',
  link: 'Voir la page sectorielle',
  items: [
    { id: 'financial-services', icon: 'bank', name: 'Services financiers', text: 'Banques, assureurs et sociétés d’investissement.' },
    { id: 'healthcare', icon: 'health', name: 'Santé', text: 'Hôpitaux, prestataires de soins et sciences de la vie.' },
    { id: 'real-estate', icon: 'building', name: 'Immobilier', text: 'Investissement et gestion immobilière.' },
  ],
};

const testimonials = {
  texts: {
    title: "Ce qu'en disent les équipes du conseil",
    subtitle: 'Secrétaires généraux, juristes et dirigeants sur la gestion de leur conseil avec Dafira.',
    cta: 'Tous les témoignages clients',
    ctaLink: '/fr/testimonials',
  },
  testimonials: (['lore', 'pierre', 'nathalie'] as const).map((k) => {
    const q = customerQuote('fr', k);
    return { quote: q.quote, author: q.author, position: q.role, company: q.company, image: q.image, link: q.link };
  }),
};
---

<Layout title="Logiciel de gestion des réunions pour secrétaires du conseil | Dafira" description="Portail du conseil pour les secrétaires du conseil : dossiers du conseil, ordres du jour, procès-verbaux rédigés avec l’IA, signatures électroniques et historique des décisions consultable.">
  <main>
    <PageHero eyebrow="Pour les secrétaires du conseil" title="Préparer, consigner et suivre chaque réunion du conseil" lead="Dafira prend en charge le travail administratif autour du conseil, de l’ordre du jour au procès-verbal signé, pour que vous puissiez vous concentrer sur le fond.">
      <Fragment slot="actions">
        <Button href="/fr/request-demo">Demander une démo</Button>
        <Button variant="secondary" href="/fr/try">Commencer l’essai gratuit</Button>
      </Fragment>
      <Screenshot slot="aside" src="/applications-picture-meeting.png" alt="Page de réunion Dafira sur ordinateur, tablette et téléphone" eager />
    </PageHero>

    <Section>
      <SectionHeader title={dayInLife.title} lead={dayInLife.lead} />
      <div class="border-t border-line" data-play>
        <div class="hidden md:grid grid-cols-12 gap-6 py-4 border-b border-line font-mono text-xs uppercase tracking-[0.08em] text-gray-500">
          <div class="col-span-2"></div>
          <div class="col-span-5">{dayInLife.beforeLabel}</div>
          <div class="col-span-5">{dayInLife.afterLabel}</div>
        </div>
        {dayInLife.slots.map((slot, i) => (
          <div class="grid md:grid-cols-12 gap-3 md:gap-6 py-6 border-b border-line" data-step style={`--d:${i * 80}`}>
            <div class="md:col-span-2 font-mono text-sm text-primary tabular-nums">{slot.time}</div>
            <div class="md:col-span-5 text-gray-500">
              <span class="md:hidden font-mono text-xs uppercase tracking-[0.08em] block mb-1">{dayInLife.beforeLabel}</span>
              {slot.before}
            </div>
            <div class="md:col-span-5 text-ink">
              <span class="md:hidden font-mono text-xs uppercase tracking-[0.08em] text-gray-500 block mb-1">{dayInLife.afterLabel}</span>
              {slot.after}
            </div>
          </div>
        ))}
      </div>
    </Section>

    <Section tone="surface" border="both">
      <SectionHeader title={painPoints.title} lead={painPoints.lead} />
      <CellGrid columns={2}>
        {painPoints.items.map((item) => (
          <div class="bg-white p-8">
            <Icon name={item.icon} class="w-6 h-6 text-navy" />
            <h3 class="mt-5 text-lg font-semibold text-navy">{item.title}</h3>
            <p class="mt-2 text-[15px] text-gray-600 leading-relaxed">{item.text}</p>
          </div>
        ))}
      </CellGrid>
    </Section>

    <Section>
      <SectionHeader title={features.title} lead={features.lead} />
      <FeatureColumns items={features.items} />
    </Section>

    <Section tone="surface" border="both" space="md">
      <SectionHeader title={industries.title} lead={industries.lead} />
      <CellGrid columns={3}>
        {industries.items.map((item) => (
          <a href={`/fr/for/board-secretary/industry/${item.id}`} class="group bg-white p-8 hover:bg-surface transition-colors flex flex-col">
            <Icon name={item.icon} class="w-6 h-6 text-navy" />
            <h3 class="mt-5 text-lg font-semibold text-navy">{item.name}</h3>
            <p class="mt-2 text-[15px] text-gray-600 leading-relaxed">{item.text}</p>
            <span class="mt-auto pt-6 text-[15px] font-medium text-primary group-hover:text-navy transition-colors">{industries.link}</span>
          </a>
        ))}
      </CellGrid>
    </Section>

    <Testimonials texts={testimonials.texts} testimonials={testimonials.testimonials} />

    <CTA {...ctaProps.fr} />
  </main>
</Layout>
