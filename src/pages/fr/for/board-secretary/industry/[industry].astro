---
import Layout from '../../../../../layouts/Layout.astro';
import IndustryLanding from '../../../../../components/industries/IndustryLanding.astro';
import { industryIds, getIndustry, testimonials } from '../../../../../data/board-secretary-industries';

export function getStaticPaths() {
  return industryIds.map((industry) => ({ params: { industry } }));
}

const { industry } = Astro.params;
const info = getIndustry('fr', industry);

if (!info) {
  return Astro.redirect('/fr/for/board-secretary');
}

const screenshots = {
  'financial-services': { src: '/onboarding-document-list.png', alt: 'Bibliothèque de documents Dafira, classés par réunion' },
  healthcare: { src: '/onboarding-event-detail.png', alt: 'Page de réunion Dafira avec l’ordre du jour, les présences et un vote' },
  'real-estate': { src: '/onboarding-boardpack.png', alt: 'Dossier du conseil Dafira organisé par point de l’ordre du jour, avec annotations' },
};
---

<Layout title={info.seo.title} description={info.seo.description}>
  <main>
    <IndustryLanding
      industry={industry}
      hero={info.hero}
      screenshot={screenshots[industry]}
      challenges={info.challenges}
      features={info.features}
      quoteKey={testimonials[industry]}
      secondary="trial"
    />
  </main>
</Layout>
