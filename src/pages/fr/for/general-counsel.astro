---
import Layout from '../../../layouts/Layout.astro';
import RoleLanding from '../../../components/industries/RoleLanding.astro';
import { customerQuote, readCaseLabel } from '../../../components/industries/customerQuotes';

const hero = {
  eyebrow: 'Pour les directeurs juridiques',
  title: 'Le suivi juridique du conseil, dans un registre unique',
  lead: 'Gardez en ordre les résolutions, les signatures et la piste d’audit. Dafira réunit les documents, procès-verbaux et décisions du conseil en un seul endroit, avec des accès définis par rôle.',
  primary: { text: 'Demander une démo', href: '/fr/request-demo' },
  secondary: { text: 'Nous contacter', href: '/fr/contact' },
  screenshot: { src: '/onboarding-document-list.png', alt: 'Bibliothèque de documents d’un conseil dans Dafira' },
};

const challenges = {
  title: 'Ce dont les directeurs juridiques ont besoin',
  lead: 'La fonction juridique répond du registre du conseil : ce qui a été décidé, par qui, et sur la base de quels documents.',
  items: [
    { icon: 'scale', title: 'Conformité', text: 'Suivre les exigences réglementaires qui s’appliquent au conseil et conserver la preuve de leur respect.' },
    { icon: 'document', title: 'Maîtrise documentaire', text: 'Historique des versions et piste d’audit pour chaque document du conseil.' },
    { icon: 'lock', title: 'Sécurité des données', text: 'Accès par rôle et chiffrement pour les informations confidentielles du conseil.' },
    { icon: 'signature', title: 'Signatures électroniques', text: 'Signer procès-verbaux et résolutions électroniquement, sans impression ni relances.' },
  ],
};

const features = {
  title: 'Fonctionnalités pour les directeurs juridiques',
  lead: 'Les fonctions de Dafira sur lesquelles s’appuient les équipes juridiques.',
  items: [
    { icon: 'shield', title: 'Suivi de la conformité', text: 'Suivre les sujets réglementaires qui concernent le conseil et regrouper les documents associés.', items: ['Sujets réglementaires', 'Piste d’audit', 'Registre des décisions'] },
    { icon: 'folder', title: 'Gestion documentaire', text: 'Un stockage central et sécurisé des documents du conseil, avec historique des versions.', items: ['Historique des versions', 'Suivi des accès', 'Conservation des documents', 'Recherche'] },
    { icon: 'gavel', title: 'Outils de gouvernance', text: 'Les instruments d’un conseil bien tenu, dans un seul espace de travail.', items: ['Gestion des réunions', 'Résolutions et votes', 'Comités', 'Signature électronique'] },
  ],
};

const quote = { ...customerQuote('fr', 'lore'), linkText: readCaseLabel.fr };
---

<Layout title="Logiciel de gestion du conseil pour directeurs juridiques | Dafira" description="Portail du conseil pour les directeurs juridiques : maîtrise documentaire, signatures électroniques, résolutions et piste d’audit pour le registre du conseil.">
  <main>
    <RoleLanding hero={hero} challenges={challenges} features={features} quote={quote} />
  </main>
</Layout>
