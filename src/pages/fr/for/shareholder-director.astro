---
import Layout from '../../../layouts/Layout.astro';
import RoleLanding from '../../../components/industries/RoleLanding.astro';
import { customerQuote, readCaseLabel } from '../../../components/industries/customerQuotes';

const hero = {
  eyebrow: 'Pour les administrateurs représentant un actionnaire',
  title: 'Représenter les actionnaires, avec un registre clair',
  lead: 'Conciliez les intérêts des actionnaires que vous représentez avec ceux de la société. Dafira réunit les documents, les échanges et les décisions du conseil dans un espace sécurisé, avec des accès définis par rôle.',
  primary: { text: 'Demander une démo', href: '/fr/request-demo' },
  secondary: { text: 'Nous contacter', href: '/fr/contact' },
  screenshot: { src: '/onboarding-boardpack.png', alt: 'Dossier du conseil Dafira organisé par point de l’ordre du jour, avec des annotations sur le procès-verbal' },
};

const challenges = {
  title: 'Ce dont les administrateurs actionnaires ont besoin',
  lead: 'Représenter un actionnaire au conseil, c’est composer avec plusieurs attentes à la fois.',
  items: [
    { icon: 'scale', title: 'Concilier les intérêts', text: 'Mettre en balance les attentes des actionnaires et les besoins de la société, avec les faits sous les yeux.' },
    { icon: 'users', title: 'Relations avec les parties prenantes', text: 'Garder les échanges avec les actionnaires représentés structurés et documentés.' },
    { icon: 'mail', title: 'Communication claire', text: 'Partager l’information à temps en respectant la confidentialité des travaux du conseil.' },
    { icon: 'tasks', title: 'Suivi des demandes', text: 'Suivre les questions et actions soulevées au conseil jusqu’à leur clôture.' },
  ],
};

const features = {
  title: 'Fonctionnalités pour les administrateurs actionnaires',
  lead: 'Ce que Dafira apporte à ce rôle.',
  items: [
    { icon: 'chat', title: 'Communication sécurisée', text: 'Les échanges du conseil en un seul endroit plutôt que par e-mail et messageries.', items: ['Messagerie sécurisée du conseil', 'Partage de documents contrôlé', 'Fil d’actualités'] },
    { icon: 'folder', title: 'Bibliothèque de documents', text: 'Documents, procès-verbaux et décisions du conseil, organisés et consultables.', items: ['Dossier du conseil par point', 'Accès par rôle', 'Procès-verbaux et décisions passés', 'Recherche'] },
    { icon: 'sparkle', title: 'Assistant IA', text: 'Posez des questions sur les documents du conseil et obtenez des résumés des documents longs.', items: ['Questions sur les documents du conseil', 'Résumés des documents longs'] },
  ],
};

const security = {
  title: 'Gouvernance et confidentialité',
  lead: 'Partager ce qui doit l’être, et en garder la trace.',
  link: { text: 'En savoir plus sur la sécurité', href: '/fr/security' },
  items: [
    { icon: 'lock', title: 'Contrôle des accès', text: 'Des autorisations par conseil, comité et rôle déterminent qui voit quelle information.' },
    { icon: 'vote', title: 'Votes et décisions', text: 'Votes et résolutions consignés avec la réunion, dans un registre des décisions.' },
    { icon: 'document', title: 'Documentation', text: 'Procès-verbaux, décisions et documents du conseil conservés ensemble, avec une piste d’audit.' },
  ],
};

const quote = { ...customerQuote('fr', 'pierre'), linkText: readCaseLabel.fr };
---

<Layout title="Logiciel de gestion du conseil pour administrateurs actionnaires | Dafira" description="Portail du conseil pour les administrateurs représentant un actionnaire : échanges sécurisés, documents du conseil organisés et registre clair des votes et décisions.">
  <main>
    <RoleLanding hero={hero} challenges={challenges} features={features} security={security} quote={quote} />
  </main>
</Layout>
