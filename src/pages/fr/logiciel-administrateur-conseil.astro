---
import Layout from "../../layouts/Layout.astro";
import BoardMemberSoftware from "../../components/campaigns/BoardMemberSoftware.astro";

const boardMemberFaqs = [
  {
    question: "Est-ce que je garde l'accès à mes documents si je quitte un conseil ?",
    answer: "Oui. Votre archive Dafira One vous appartient, même après la fin de votre mandat."
  },
  {
    question: "Est-ce que Dafira One peut fonctionner avec plusieurs conseils en même temps ?",
    answer: "Oui. Dafira One a été conçu pour centraliser les documents de tous vos conseils en un seul endroit."
  },
  {
    question: "Dafira One est-il sécurisé ?",
    answer: "Dafira One est hébergé dans l'UE, avec un chiffrement de niveau entreprise et une conformité RGPD. Vos documents restent privés et sécurisés."
  },
  {
    question: "Qu'est-ce qui différencie Dafira One de Dafira et d'autres plateformes de gestion de conseil ?",
    answer: "Dafira et les autres plateformes de gestion de conseil sont conçues pour l'organisation. Dafira One est conçu pour l'administrateur individuel : c'est votre espace de travail personnel de conseil."
  }
];

const productStructuredData = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "Dafira One",
  "applicationCategory": "BusinessApplication",
  "description": "Logiciel personnel pour administrateur de conseil, hébergé et sécurisé dans l'UE. Contrairement à Dafira qui sert les organisations, Dafira One est conçu pour les administrateurs individuels pour centraliser les documents de tous leurs conseils, se préparer avec l'IA, et conserver leurs archives pour toujours.",
  "operatingSystem": "Web",
  "url": "https://dafira.ai/fr/logiciel-administrateur-conseil",
  "offers": {
    "@type": "Offer",
    "url": "https://dafira.ai/fr/request-demo",
    "availability": "https://schema.org/InStock"
  },
  "featureList": [
    "Portail personnel et gestion documentaire pour administrateur de conseil",
    "Préparation de réunions alimentée par l'IA pour administrateurs individuels",
    "Archive permanente de documents à travers plusieurs conseils",
    "Aperçus du profil d'administrateur de conseil",
    "Hébergé dans l'UE avec sécurité de niveau entreprise"
  ]
};
const combinedStructuredData = [productStructuredData];

const t = {
  hero: {
    eyebrow: 'Logiciel personnel pour administrateur',
    title: 'Logiciel d’administrateur de conseil, conçu pour vous, pas pour votre conseil',
    lead: 'Dafira One est un logiciel personnel pour administrateur de conseil, entièrement hébergé et sécurisé dans l’UE. Dafira sert les organisations et les portails de conseil classiques sont conçus pour les entreprises ; Dafira One vous donne votre propre portail pour centraliser vos documents, vous préparer avec l’IA et conserver votre archive, à travers tous vos mandats.',
    primary: 'Demander un accès anticipé',
    note: 'Hébergé dans l’UE · Conforme au RGPD · Chiffrement 256 bits',
    imageAlt: 'Interface du logiciel personnel Dafira One pour administrateur de conseil',
  },
  compare: {
    eyebrow: 'Nouveau produit',
    title: 'Dafira vs Dafira One',
    columns: [
      { name: 'Dafira', audience: 'Pour les organisations', items: ['Gestion de conseil pour entreprises', 'Contrôle organisationnel des documents', 'Les données appartiennent à l’entreprise'] },
      { name: 'Dafira One', audience: 'Pour les administrateurs individuels', items: ['Espace personnel pour tous vos conseils', 'Vos documents, votre contrôle', 'Archive à vie, même après vos mandats'] },
    ],
  },
  integrations: {
    title: 'Compatible avec vos plateformes de gouvernance',
    lead: 'Dafira One se synchronise avec les outils que vos conseils utilisent déjà et centralise vos documents dans votre espace personnel.',
    other: 'Autres portails de conseil',
    email: 'E-mail',
    more: 'D’autres à venir',
    note: 'Synchronisation automatique : configurez-la une fois et Dafira One maintient vos documents à jour pour tous vos mandats.',
  },
  portal: {
    title: 'Votre portail personnel et votre gestion documentaire',
    lead: 'Fini les e-mails interminables et les documents éparpillés. Dafira One rassemble les documents, ordres du jour et pièces jointes de vos différents conseils et les organise en réunions et événements.',
    items: [
      { icon: 'document', title: 'Gestion documentaire automatique', text: 'Dafira organise pour les entreprises ; Dafira One organise pour vous, à travers tous vos conseils.' },
      { icon: 'clock', title: 'Une chronologie des réunions et décisions', text: 'Suivez l’évolution des décisions dans tous vos mandats.' },
      { icon: 'lock', title: 'Un espace privé, rien qu’à vous', text: 'Votre espace de travail personnel, indépendant de Dafira ou de toute organisation.' },
    ],
  },
  ai: {
    title: 'Préparez vos réunions de conseil avec l’IA',
    lead: 'Plus besoin de lire seul des centaines de pages. L’IA de Dafira One analyse vos documents, réglementations et rapports pour faire ressortir ce qui compte pour vos responsabilités d’administrateur.',
    items: [
      { icon: 'document', title: 'Synthèses de documents longs', text: 'Concentrez-vous sur les points qui comptent pour la prochaine réunion.' },
      { icon: 'shield', title: 'Points réglementaires et de conformité', text: 'Les exigences réglementaires pertinentes sont signalées dans vos documents.' },
      { icon: 'sparkle', title: 'Des éclairages IA pour vos décisions', text: 'Le contexte de vos documents pour nourrir vos questions et vos décisions.' },
    ],
  },
  archive: {
    title: 'Gardez votre archive de conseil, même après votre mandat',
    lead: 'Votre savoir ne s’arrête pas avec votre mandat. Avec Dafira One, vos documents et notes restent les vôtres : vous constituez au fil du temps votre archive personnelle.',
    items: [
      { icon: 'key', title: 'Accès permanent à vos données', text: 'Vos documents de conseil restent accessibles, quels que soient les changements dans l’organisation.' },
      { icon: 'bank', title: 'Une archive de votre parcours d’administrateur', text: 'Un historique complet de votre expérience de gouvernance.' },
      { icon: 'book', title: 'Votre bibliothèque de gouvernance', text: 'Une base de connaissances pour vos futurs mandats.' },
    ],
  },
  conflicts: {
    title: 'Connaissez vos conseils et repérez les conflits d’intérêts',
    lead: 'Un conseil, ce sont des personnes autant que des documents. Dafira One vous aide à connaître les autres administrateurs et signale discrètement les conflits d’intérêts potentiels.',
    card: {
      title: 'Votre réseau de conseils',
      meta: 'Analyse IA',
      rows: [
        { label: 'M. Davis', text: 'Ancienne CFO, RetailCorp', tone: 'ok' as const, status: 'Aucun conflit' },
        { label: 'J. Dupont', text: 'CEO, ConcurrentCorp · concurrent direct', tone: 'danger' as const, status: 'Concurrent' },
        { label: 'R. Martin', text: 'Associé, FournisseurDroit SARL · services juridiques', tone: 'pending' as const, status: 'Relation' },
      ],
      footer: 'Conflits potentiels signalés avant la réunion',
      caption: 'Illustration · noms fictifs',
    },
    items: [
      { icon: 'search', title: 'Analyse automatique', text: 'L’IA examine les parcours des administrateurs, les relations d’affaires et les mandats croisés pour identifier les conflits potentiels.' },
      { icon: 'bell', title: 'Alertes et recommandations', text: 'Des alertes sur les conflits potentiels, avec des recommandations de récusation sur les points de l’ordre du jour.' },
      { icon: 'users', title: 'Sur tous vos conseils', text: 'Tirez parti de ce que vous savez de tous vos mandats pour maintenir un haut niveau de gouvernance.' },
    ],
  },
  security: {
    title: 'Sécurisé. Hébergé dans l’UE. Toujours à vous.',
    lead: 'Vos données restent en Europe. Dafira One est entièrement hébergé dans l’UE et conforme au RGPD.',
    items: [
      { icon: 'lock', title: 'Chiffrement de niveau entreprise', text: 'Vos documents sont chiffrés en transit et au repos.' },
      { icon: 'globe', title: 'Données stockées dans l’UE', text: 'Hébergement européen et conformité RGPD.' },
      { icon: 'shield', title: 'Architecture axée sur la confidentialité', text: 'Conçu dès le départ avec la confidentialité et la sécurité à l’esprit.' },
    ],
  },
  form: {
    eyebrow: 'Accès anticipé',
    title: 'Obtenez un accès anticipé à Dafira One',
    lead: 'Inscrivez-vous et nous vous contacterons à l’ouverture de l’accès anticipé.',
    benefits: ['Accès anticipé gratuit', 'Hébergé et sécurisé dans l’UE', 'Préparation assistée par l’IA'],
    heading: 'Demander un accès anticipé',
    subheading: 'Moins de deux minutes. Pas de spam ; désinscription à tout moment.',
    firstName: 'Prénom',
    lastName: 'Nom',
    email: 'E-mail professionnel',
    emailPlaceholder: 'votre.email@entreprise.com',
    boardCount: 'Dans combien de conseils siégez-vous actuellement ?',
    boardOptions: [
      { value: '', label: 'Sélectionnez le nombre de conseils' },
      { value: '1', label: '1 conseil' },
      { value: '2', label: '2 conseils' },
      { value: '3', label: '3 conseils' },
      { value: '4', label: '4 conseils' },
      { value: '5+', label: '5 conseils ou plus' },
    ],
    trust: ['Conforme au RGPD', 'Chiffrement 256 bits', 'Centres de données UE'],
    submit: 'Demander l’accès anticipé gratuit',
    privacyBefore: 'En vous inscrivant, vous acceptez notre ',
    privacyLink: 'politique de confidentialité',
    privacyAfter: '. Pas de spam ; désinscription à tout moment.',
    successTitle: 'Merci, vous êtes inscrit',
    successText: 'Vous êtes inscrit pour l’accès anticipé à Dafira One.',
    nextTitle: 'La suite',
    next: ['Des nouvelles de l’avancement du développement', 'Une notification à l’ouverture de l’accès anticipé'],
  },
  faq: {
    title: 'Questions fréquentes',
    subtitle: 'À propos de Dafira One, le logiciel personnel pour administrateur de conseil',
    inLanguage: 'fr',
    faqs: boardMemberFaqs,
  },
};
---

<Layout
  title="Dafira One — Logiciel personnel pour administrateur de conseil | Hébergé UE"
  description="Logiciel personnel pour administrateur de conseil, hébergé dans l'UE. Centralisez les documents de tous vos conseils, préparez vos réunions avec l'IA et conservez votre archive après votre mandat."
  structuredData={combinedStructuredData}
>
  <main>
    <BoardMemberSoftware t={t} formAnchor="logiciel-administrateur-conseil-form" privacyHref="/fr/privacy" />
  </main>
</Layout>
