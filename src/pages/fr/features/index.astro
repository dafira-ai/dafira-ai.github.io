---
import Layout from '../../../layouts/Layout.astro';
import FeatureSection from '../../../components/features/FeatureSection.astro';
import FeatureCTA from '../../../components/features/FeatureCTA.astro';
import { PageHero, Button, Screenshot } from '../../../components/ui';

const meetingFeatures = {
  title: "Préparer et tenir la séance",
  subtitle: "Séances",
  description: "Construisez l'ordre du jour, partagez le dossier du conseil et rédigez le procès-verbal sans quitter la plateforme.",
  image: "/applications-picture-meeting.png",
  imageAlt: "Page d'une séance dans Dafira",
  features: [
    {
      title: "Création de l'ordre du jour assistée par IA",
      description: "Partez d'un modèle, fixez une durée et un type pour chaque point et joignez les documents. Les suggestions s'appuient sur les séances précédentes.",
      icon: "list",
      link: "/fr/features/ai-powered-agenda-builder"
    },
    {
      title: "Collaboration documentaire",
      description: "Les administrateurs annotent le dossier en privé et commentent ensemble les documents partagés, toujours dans leur dernière version.",
      icon: "pen",
      link: "/fr/features/document-collaboration"
    },
    {
      title: "Communication sécurisée",
      description: "Messages privés, fil d'actualité du conseil et partage de fichiers, au sein de la plateforme plutôt que par e-mail ou messagerie.",
      icon: "lock",
      link: "/fr/features/secure-communication"
    },
    {
      title: "Procès-verbaux par IA",
      description: "Un projet de procès-verbal structuré, préparé à partir de l'enregistrement de la séance et aligné sur l'ordre du jour, dans la langue de la séance.",
      icon: "mic",
      link: "/fr/features/ai-minute-builder"
    }
  ]
};

const insightFeatures = {
  title: "Retrouver ce que le conseil sait déjà",
  subtitle: "Information",
  description: "Les documents du conseil sont classés par séance et peuvent être recherchés et interrogés. Chaque réponse renvoie à sa source.",
  image: "/applications-picture-board-chat-mobile.png",
  imageAlt: "Dafira sur mobile",
  features: [
    {
      title: "Assistant IA",
      description: "Posez une question sur le dossier du conseil ou les procès-verbaux passés et obtenez une réponse qui cite le document et la section d'origine.",
      icon: "search",
      link: "/fr/features/ai-assistant"
    },
    {
      title: "Bibliothèque documentaire",
      description: "Les documents du conseil sont organisés par séance et par type, avec une recherche sur l'ensemble de la bibliothèque.",
      icon: "folder"
    },
    {
      title: "Suivi de la conformité",
      description: "Suivez des exigences réglementaires comme la CSRD et voyez quels documents du conseil y répondent.",
      icon: "scale",
      link: "/fr/features/ai-board-compliance-monitoring"
    }
  ]
};

const governanceFeatures = {
  title: "Décider, signer et assurer le suivi",
  subtitle: "Gouvernance",
  description: "Enregistrez les votes et les résolutions, recueillez les signatures et suivez les actions décidées en séance.",
  image: "/applications-picture-board-evaluation.png",
  imageAlt: "Évaluation du conseil dans Dafira",
  features: [
    {
      title: "Tâches et actions",
      description: "Attribuez les actions décidées en séance et suivez-les jusqu'à leur clôture.",
      icon: "tasks"
    },
    {
      title: "Votes et signatures électroniques",
      description: "Les administrateurs votent sur les résolutions et signent électroniquement, via notre partenaire Universign, conforme au règlement eIDAS.",
      icon: "signature"
    },
    {
      title: "Contrôle d'accès par rôle",
      description: "L'accès aux séances, aux documents et aux conversations est défini par conseil, comité et rôle.",
      icon: "users"
    },
    {
      title: "Évaluation du conseil",
      description: "Menez l'évaluation du conseil dans la plateforme et comparez les réponses de chaque administrateur.",
      icon: "chart"
    }
  ]
};
---

<Layout title="Fonctionnalités - Logiciel de gestion de conseil Dafira" description="Les fonctionnalités de Dafira : ordre du jour, dossier du conseil et annotations, assistant IA, procès-verbaux par IA, communication sécurisée, votes et signatures électroniques." image="/features.png">
  <main>
    <PageHero
      eyebrow="Fonctionnalités"
      title="Chaque étape du cycle du conseil, au même endroit"
      lead="Dafira couvre la préparation de la séance, la séance elle-même et son suivi : ordre du jour, dossier du conseil, votes, procès-verbal et signatures. Les administrateurs travaillent dans un seul espace sécurisé, sur tous leurs appareils."
    >
      <Fragment slot="actions">
        <Button href="/fr/request-demo">Demander une démo</Button>
        <Button variant="secondary" href="/fr/pricing">Voir les tarifs</Button>
      </Fragment>
      <Screenshot slot="aside" src="/onboarding-event-detail.png" alt="Page d'une séance dans Dafira avec l'ordre du jour, les présences et un vote ouvert" eager />
    </PageHero>

    <FeatureSection {...meetingFeatures} demoType="meeting" id="meetings" />
    <FeatureSection {...insightFeatures} demoType="insights" reversed={true} tone="surface" id="information" />
    <FeatureSection {...governanceFeatures} demoType="governance" id="governance" />

    <FeatureCTA />
  </main>
</Layout>
