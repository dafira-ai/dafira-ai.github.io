---
import Layout from '../../layouts/Layout.astro';
import { PageHero, Section, Prose } from '../../components/ui';

const sections = [
  {
    title: "Collecte des données",
    items: [
      {
        subtitle: "Données de compte et de contact",
        content: "Lors de votre inscription sur notre plateforme, vous nous communiquez volontairement certaines informations comme votre nom, le nom de votre entreprise, votre adresse électronique, votre numéro de téléphone, votre adresse postale, votre secteur d'activité et votre mot de passe. Nous ne stockons jamais vos données bancaires et faisons appel à des prestataires de paiement tiers certifiés PCI-DSS."
      },
      {
        subtitle: "Données de candidature",
        content: "Dans le cadre des candidatures, nous collectons vos coordonnées et les informations de votre CV. Nous ne demandons que les informations nécessaires au processus de recrutement et ne collectons jamais de données sensibles concernant l'origine ethnique, les opinions politiques, les croyances religieuses ou la vie sexuelle."
      },
      {
        subtitle: "Données de navigation",
        content: "Nous détectons la langue de votre navigateur et votre localisation pour personnaliser votre expérience. Nos serveurs enregistrent des informations basiques comme l'adresse IP, l'heure et la date de visite, la version du navigateur et la source de trafic à des fins statistiques et de sécurité."
      },
      {
        subtitle: "Bases de données clients",
        content: "Les informations contenues dans votre base de données Dafira restent sous votre contrôle et propriété exclusive. Nous ne traitons ces données que selon vos instructions."
      }
    ]
  },
  {
    title: "Utilisation des données",
    items: [
      {
        subtitle: "Données de compte et de contact",
        content: "Utilisées pour la fourniture du service, le support, la facturation et les communications marketing optionnelles. Ces données peuvent être partagées avec les organisateurs et sponsors d'événements si vous vous y inscrivez."
      },
      {
        subtitle: "Données de candidature",
        content: "Traitées uniquement dans le cadre du recrutement et de la préparation du contrat si votre candidature est retenue. Vous pouvez demander leur suppression à tout moment."
      },
      {
        subtitle: "Données de navigation",
        content: "Analysées de manière anonyme pour améliorer nos services. Google reCAPTCHA peut être utilisé pour la sécurité, ne traitant que des scores anonymes."
      },
      {
        subtitle: "Bases de données clients",
        content: "Traitées selon vos instructions pour la fourniture du service. Notre équipe support peut y accéder pour la résolution des problèmes ou à votre demande."
      }
    ]
  },
  {
    title: "Conservation des données",
    items: [
      {
        subtitle: "Données de compte et de contact",
        content: "Conservées le temps nécessaire à la fourniture du service et aux obligations légales."
      },
      {
        subtitle: "Données de candidature",
        content: "Conservées jusqu'à 2 ans pour d'éventuelles opportunités futures, sauf demande contraire. Les données des employés sont conservées selon les obligations légales."
      },
      {
        subtitle: "Données de navigation",
        content: "Généralement conservées pendant 2 mois, sauf nécessité prolongée pour des raisons de sécurité ou légales."
      },
      {
        subtitle: "Base de données client",
        content: "Conservées uniquement pendant la période de service active. Les bases désactivées sont gardées 3 semaines après résiliation, puis détruites."
      }
    ]
  }
];

const contactInfo = {
  email: "info@dafira.ai",
  address: "Dafira - Protection des données\nRue de l'Hôpital 31\n1000 Bruxelles, Belgique"
};
---
<Layout title="Politique de confidentialité - Dafira" description="Nous nous engageons à protéger votre vie privée et à garantir la sécurité de vos données. Découvrez comment nous collectons, utilisons et protégeons vos informations.">
  <main>
    <PageHero eyebrow="Mentions légales" title="Politique de confidentialité" lead="Nous nous engageons à protéger votre vie privée et à garantir la sécurité de vos données. Découvrez comment nous collectons, utilisons et protégeons vos informations." />

    <Section size="prose" space="md">
      <Prose>
        <p class="text-lg">Dafira et ses filiales proposent de nombreux services pour vous aider à gérer votre entreprise, notamment une plateforme pour héberger votre base de données Dafira. Cette politique explique quelles informations nous collectons, pourquoi nous les collectons et comment nous les utilisons.</p>

        {sections.map((section) => (
          <Fragment>
            <h2>{section.title}</h2>
            {section.items.map((item) => (
              <Fragment>
                <h3>{item.subtitle}</h3>
                <p>{item.content}</p>
              </Fragment>
            ))}
          </Fragment>
        ))}

        <h2>Cookies</h2>
        <p>Les cookies sont de petits fichiers texte envoyés par nos serveurs à votre ordinateur lorsque vous accédez à nos services. Nous les utilisons pour faciliter votre navigation, comprendre vos préférences et améliorer nos services. Des services tiers comme Google Analytics peuvent également utiliser des cookies à leurs propres fins.</p>
      </Prose>

      <div class="mt-16 border border-line rounded-md bg-surface p-6 lg:p-8 max-w-[68ch]">
        <h2 class="text-2xl font-semibold text-navy">Nous contacter</h2>
        <p class="mt-3 text-gray-700">Si vous avez des questions concernant cette politique de confidentialité ou vos données personnelles, n'hésitez pas à nous contacter :</p>
        <div class="mt-4 space-y-2 text-gray-700">
              <p>
                <strong>Courriel :</strong> {contactInfo.email}
              </p>
              <p class="whitespace-pre-line">
                <strong>Adresse :</strong>
                {contactInfo.address}
              </p>
        </div>
      </div>
    </Section>
  </main>
</Layout>
