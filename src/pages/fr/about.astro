---
import Layout from '../../layouts/Layout.astro';
import { PageHero, Section, SectionHeader, FeatureColumns } from '../../components/ui';
import MissionVision from '../../components/about/MissionVision.astro';
import FounderStory from '../../components/about/FounderStory.astro';
import TeamMembers from '../../components/about/TeamMembers.astro';
import OfficeCard from '../../components/OfficeCard.astro';
import LocalizedCTA from '../../components/case-studies/LocalizedCTA.astro';

const facts = [
  { label: 'Produit', value: 'Portail du conseil Dafira' },
  { label: 'Bureau', value: 'Bruxelles' },
];

const values = [
  { icon: 'target', title: 'Innovation', text: 'Nous améliorons sans cesse ce qu’un logiciel de conseil apporte à ceux qui l’utilisent.' },
  { icon: 'lock', title: 'Sécurité et confiance', text: 'La protection des données sensibles de nos clients passe en premier.' },
  { icon: 'users', title: 'Partenariat client', text: 'Nous accompagnons les conseils que nous servons à chaque étape.' },
  { icon: 'clock', title: 'Efficacité', text: 'Le travail du conseil doit demander moins de temps et moins de complexité.' },
];

const missionVisionProps = {
  eyebrow: 'Notre raison d’être',
  mission: {
    title: 'Notre mission',
    description: 'Nous développons un logiciel de gestion du conseil simple, qui améliore la gouvernance et la prise de décision, avec',
    aiText: "l'IA comme assistant.",
  },
  vision: {
    title: 'Notre vision',
    description: 'Créer la solution de gouvernance qui permet aux conseils',
    highlightedText: 'de façonner un avenir meilleur.',
  },
};

const founderStoryProps = {
  tagText: 'Notre histoire',
  title: 'La genèse de Dafira',
  story: [
    "Au fil de mes années d'expérience au sein de différents conseils d'administration, j'ai été confronté aux mêmes défis récurrents : une gestion documentaire complexe, des processus décisionnels lourds et la difficulté de maintenir des standards de gouvernance élevés.",
    "L'élément déclencheur fut une réunion cruciale où l'égarement de documents essentiels a entraîné des retards décisionnels majeurs, impactant directement la trajectoire de l'organisation. Cette situation m'a convaincu qu'une alternative était nécessaire.",
    "C'est ainsi qu'est né Dafira. Notre ambition dépassait la simple création d'un portail : nous voulions une plateforme qui réponde aux besoins réels des conseils d'administration.",
    "Aujourd'hui, Dafira aide les conseils à préparer leurs réunions, à décider et à tenir un registre fiable, avec l'IA là où elle fait gagner du temps.",
  ],
  founder: { name: 'Jean-Louis Van Houwe', role: 'Fondateur & CEO' },
};

const teamMembersProps = {
  title: 'Direction',
  subtitle: 'Qui dirige Dafira.',
  team: [
    {
      name: 'Jean-Louis Van Houwe',
      role: 'CEO & Fondateur',
      image: '/jean-louis-van-houwe.jpeg',
      linkedin: 'https://www.linkedin.com/in/jeanlouisvanhouwe/',
      bio: "Engagé dans l'amélioration de la gouvernance d'entreprise par la technologie.",
    },
  ],
};

const offices = [
  { city: 'Bruxelles', country: 'Belgique', image: '/bxl.jpg', address: "Rue de l'Hôpital 31", postalCode: '1000', email: 'info@dafira.ai' },
];
---

<Layout title="À propos - Dafira, Solution Intelligente de Gouvernance" description="Dafira est un portail du conseil développé en Belgique. Notre mission, l'histoire de notre fondateur, l'équipe de direction et notre bureau à Bruxelles." image="/about.png">
  <PageHero
    eyebrow="À propos de Dafira"
    title="Une meilleure gouvernance, pensée pour ceux qui font vivre les conseils"
    lead="Dafira est une plateforme de gestion du conseil développée en Belgique. Nous aidons les conseils à préparer leurs réunions, partager leurs documents, prendre leurs décisions et en garder une trace fiable."
  >
    <dl class="mt-10 pt-8 border-t border-line grid grid-cols-2 sm:grid-cols-4 gap-6">
      {facts.map((f) => (
        <div>
          <dt class="font-mono text-xs uppercase tracking-[0.08em] text-gray-500">{f.label}</dt>
          <dd class="mt-1 text-[15px] text-navy">{f.value}</dd>
        </div>
      ))}
    </dl>
  </PageHero>

  <MissionVision {...missionVisionProps} />
  <FounderStory {...founderStoryProps} />
  <TeamMembers {...teamMembersProps} />

  <Section tone="surface" space="lg" border="top">
    <SectionHeader eyebrow="Valeurs" title="Ce qui guide notre travail" />
    <FeatureColumns columns={4} items={values} />
  </Section>

  <Section space="lg">
    <SectionHeader eyebrow="Bureau" title="Où nous trouver" lead="Écrivez-nous à info@dafira.ai ou rendez-nous visite à Bruxelles." />
    <div class="max-w-md">
      {offices.map((office) => <OfficeCard {...office} />)}
    </div>
  </Section>

  <LocalizedCTA />
</Layout>
