---

<Layout
  title="Dafira | ضفيرة · Le portail des conseils d'administration"
  description="Dafira est le portail des conseils d'administration : ordre du jour, dossier du conseil, votes, signature électronique et procès-verbaux dans un espace sécurisé et conforme au RGPD."
  structuredData={structuredData}
>
  <main class="overflow-hidden">
    <Hero {...hero} />
    <!-- <WhyWeBuildVideo {...whyWeBuildVideoProps} /> — thumbnail still shows the old brand -->
    <Features {...featuresProps} />
    <FeatureShowcase {...featureShowcaseProps} />
    <Timeline {...timelineProps} />
    <SecurityPreview {...securityPreviewProps} />
    <Personas {...personasProps} />
    <Testimonials {...testimonialsProps} />
    <FAQ {...faqProps} />
    <CTA {...ctaProps} />
  </main>
</Layout>

<style>
  main {
    width: 100%;
  }
</style>
