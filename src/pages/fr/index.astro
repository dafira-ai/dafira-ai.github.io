const structuredData = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  name: "Dafira - Questions fréquentes",
  inLanguage: "fr",
  mainEntity: faqProps.texts.faqs.map((faq) => ({
    "@type": "Question",
    name: faq.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: faq.answer,
    },
  })),
};

