---
import Layout from '../../../layouts/Layout.astro';
import MfaPage from '../../../components/security/MfaPage.astro';

const copy = {
  eyebrow: 'Authentification multi-facteurs',
  title: 'Un accès sécurisé aux informations du conseil grâce à la vérification par SMS',
  lead: "Dafira protège les informations du conseil avec l'authentification multi-facteurs (MFA) par SMS. Cette page explique comment la vérification par SMS sécurise l'accès des administrateurs et des équipes de gouvernance.",
  back: { text: 'Vue d’ensemble de la sécurité', href: '/fr/security' },
