      { icon: 'documents', text: 'Distribution sécurisée des dossiers' },
      { icon: 'refresh', text: 'Redondance et sauvegardes' },
    ],
  },
  summary: {
    eyebrow: 'En pratique',
    title: 'Utiliser le MFA par SMS avec Dafira',
    columns: [
      { title: 'Avantages', text: 'Ce que le MFA par SMS apporte au travail du conseil.', items: ['Protection renforcée contre les accès non autorisés', 'Simple pour les administrateurs, aucune application requise', 'Fonctionne sur tous les appareils', "Répond aux exigences de conformité et d'audit", 'Adapté aux réunions hybrides ou à distance', 'Renforce la confiance dans la gouvernance numérique'] },
