---
import Layout from '../../layouts/Layout.astro';
import ContactForm from '../../components/forms/ContactForm.astro';
import { PageHero, Section, Icon } from '../../components/ui';

const office = {
  city: "Bruxelles",
  country: "Belgique",
  image: "/bxl.jpg",
  address: "Rue de l'Hôpital 31",
  postalCode: "1000",
  email: "info@dafira.ai",
};

const contactFormProps = {
  reasons: [
    "Demander une démonstration",
    "Question commerciale",
    "Support technique",
    "Proposition de partenariat",
    "Autre demande"
  ],
  labels: {
    firstName: "Prénom",
    lastName: "Nom",
    email: "Email",
    company: "Entreprise",
    reason: "Motif de contact",
    message: "Message",
    submit: "Envoyer"
  },
  placeholders: {
    reason: "Sélectionnez un motif"
  },
  success: {
    title: "Message envoyé",
    message: "Merci de nous avoir contactés. Nous vous répondrons rapidement."
  }
};
---

<Layout title="Contactez-nous - Logiciel de gestion de conseil Dafira" description="Des questions sur Dafira ? Notre équipe à Bruxelles répond à vos questions sur les démonstrations, les tarifs, le support et les partenariats.">
  <main>
    <PageHero eyebrow="Contact" title="Contactez notre équipe" lead="Des questions sur Dafira ? Notre équipe vous répond pour une démonstration, les tarifs, le support technique ou un partenariat." />

    <Section space="md">
      <div class="grid lg:grid-cols-12 gap-12 lg:gap-10">
        <!-- Contact form -->
        <div class="lg:col-span-7">
          <div class="border border-line rounded-md bg-white p-6 lg:p-8">
            <h2 class="text-2xl font-semibold text-navy mb-8">Envoyez-nous un message</h2>
            <ContactForm {...contactFormProps} />
          </div>
        </div>

        <!-- Contact information -->
        <div class="lg:col-span-4 lg:col-start-9 space-y-12">
          <div>
            <h2 class="font-mono text-xs uppercase tracking-[0.08em] text-gray-500">Notre bureau</h2>
            <figure class="mt-4 border border-line rounded-md overflow-hidden">
              <img loading="lazy" src={office.image} alt="Bureau de Bruxelles" class="w-full h-44 object-cover" />
            </figure>
            <p class="mt-5 text-xl font-semibold text-navy">{office.city}</p>
            <address class="mt-3 not-italic space-y-3 text-gray-700">
              <p class="flex items-start gap-3">
                <Icon name="building" class="w-5 h-5 text-navy mt-0.5" />
                <span>{office.address}<br />{office.postalCode} {office.city}, {office.country}</span>
              </p>
              <p class="flex items-start gap-3">
                <Icon name="mail" class="w-5 h-5 text-navy mt-0.5" />
                <a href={`mailto:${office.email}`} class="text-primary hover:text-navy transition-colors" dir="ltr">{office.email}</a>
              </p>
            </address>
          </div>

          <div class="border-t border-line pt-8">
            <h2 class="font-mono text-xs uppercase tracking-[0.08em] text-gray-500">Suivez-nous</h2>
            <a href="https://www.linkedin.com/company/govrncorp" class="mt-4 inline-flex items-center gap-2 text-gray-700 hover:text-navy transition-colors" rel="noopener" target="_blank">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
              </svg>
              LinkedIn
            </a>
          </div>
        </div>
      </div>
    </Section>
  </main>
</Layout>
