---
import Layout from '../../layouts/Layout.astro';
import MinuteBuilderSavings from '../../components/campaigns/MinuteBuilderSavings.astro';

const t = {
  hero: {
    eyebrow: 'Générateur de procès-verbaux IA',
    title: 'Transformez des heures de prise de notes en un brouillon structuré du procès-verbal',
    lead: 'Les secrétaires de conseil passent de longues soirées à rédiger, réécrire et aligner les procès-verbaux après chaque réunion. Avec le générateur de procès-verbaux IA de Dafira, vous partez d’un brouillon structuré, hébergé dans l’UE, peu après la fin de la réunion, puis vous le relisez et le publiez.',
    primary: { text: 'Commencer l’essai gratuit', href: '/fr/try' },
    secondary: { text: 'Réserver une démo', href: '/fr/request-demo' },
    note: 'Sans carte de crédit · Hébergé dans l’UE · Conforme au RGPD',
  },
  card: {
    title: 'Projet de PV · Conseil d’administration',
    meta: 'Généré après la réunion',
    rows: [
      { label: 'Point 1', text: 'Approbation du PV précédent', tone: 'ok' as const, status: 'Décision' },
      { label: 'Point 2', text: 'Comptes S1 présentés par le CFO', tone: 'neutral' as const, status: 'Pris acte' },
      { label: 'Point 3', text: 'Résolution 2026-14 · Budget capex', tone: 'ok' as const, status: 'Résolution' },
      { label: 'Point 4', text: 'Préparer l’appel d’offres · CFO', tone: 'info' as const, status: 'Action' },
    ],
    footer: 'Brouillon prêt pour la relecture du secrétaire',
    footerMeta: 'Pas encore publié',
    caption: 'Exemple de brouillon',
  },
  pain: {
    eyebrow: 'Le temps perdu',
    title: 'Arrêtez de perdre du temps, concentrez-vous sur les décisions',
    lead: 'Les procès-verbaux manuels ralentissent les conseils. Dafira change cela : vous commencez par un brouillon prêt à relire, pas par une page blanche.',
    items: [
      { icon: 'clock', title: 'Des heures de travail après la réunion', text: 'Les secrétaires de conseil passent des soirées entières à transcrire les notes, formater les documents et s’assurer que rien n’a été oublié.' },
      { icon: 'document', title: 'Brouillons incohérents et versions multiples', text: 'La prise de notes manuelle conduit à des comptes rendus incomplets, des décisions manquées et d’interminables allers-retours.' },
      { icon: 'warning', title: 'Risque d’erreurs ou de décisions oubliées', text: 'Les résolutions et les actions se perdent dans des notes manuscrites ou des documents numériques éparpillés.' },
      { icon: 'calendar', title: 'Pression pour finaliser rapidement', text: 'Les exigences de gouvernance demandent un délai court, que les processus manuels rendent difficile à tenir.' },
    ],
  },
  changes: {
    eyebrow: 'Ce qui change',
    title: 'Du temps gagné après chaque réunion avec le générateur de procès-verbaux IA',
    lead: 'Le travail passe de la rédaction à la relecture. Le secrétaire garde la main sur le texte final.',
    items: [
      { icon: 'sparkle', title: 'Un brouillon peu après la réunion', text: 'Obtenez un brouillon structuré qui suit votre ordre du jour dès la fin de la réunion.' },
      { icon: 'pen', title: 'Relire, pas réécrire', text: 'Vous validez et affinez au lieu de repartir de zéro. Le contrôle éditorial reste entre vos mains.' },
      { icon: 'gavel', title: 'Conçu pour les conseils', text: 'Pensé pour la gouvernance plutôt que pour la transcription générique : il identifie décisions, actions et résolutions.' },
      { icon: 'users', title: 'Publier aux administrateurs en une étape', text: 'Partagez le procès-verbal final avec tous les administrateurs via la plateforme sécurisée et conforme au RGPD.' },
    ],
    link: { text: 'Découvrir le fonctionnement du générateur de procès-verbaux', href: '/fr/features/ai-minute-builder' },
  },
  compare: {
    eyebrow: 'Avant et après',
    title: 'Avant et après Dafira',
    lead: 'Où part le temps après une réunion de conseil, et ce qui change lorsque vous partez d’un brouillon IA.',
    headers: ['Tâche', 'Avant Dafira', 'Avec Dafira'],
    rows: [
      ['Rédaction du procès-verbal', 'Rédigé à partir des notes après la réunion', 'Brouillon IA généré à partir de la réunion'],
      ['Réécriture et alignement', 'Plusieurs tours de corrections et de versions', 'Une relecture d’un brouillon structuré'],
      ['Partage avec les administrateurs', 'E-mails et pièces jointes', 'Publié aux administrateurs depuis la plateforme'],
    ],
    cta: { text: 'Réserver une démo', href: '/fr/request-demo' },
  },
  trust: {
    eyebrow: 'Confiance européenne',
    title: 'Pourquoi les conseils européens font confiance à Dafira',
    lead: 'Dafira est conçu pour les conseils européens et les règles européennes de protection des données.',
    items: [
      { icon: 'globe', title: 'Hébergement UE et conformité RGPD', text: 'Les données de votre conseil sont hébergées en Europe.' },
      { icon: 'lock', title: 'Chiffrement et infrastructure certifiée', text: 'Données chiffrées sur une infrastructure d’hébergement certifiée ISO 27001.' },
      { icon: 'users', title: 'Utilisateurs illimités inclus', text: 'Pas de coût par siège pour les administrateurs et les invités.' },
      { icon: 'sparkle', title: 'IA intégrée à la plateforme', text: 'Le générateur de procès-verbaux fait partie de Dafira, ce n’est pas un module séparé.' },
    ],
  },
  alternatives: {
    eyebrow: 'Comparer les plateformes',
    title: 'Dafira vs OnBoard vs Diligent',
    lead: 'Vous évaluez des portails de conseil ? Nos pages de comparaison détaillent les différences d’hébergement, de modèle tarifaire et de fonctions IA.',
    cards: [
      { title: 'Dafira vs OnBoard', text: 'Hébergement, tarifs et procès-verbaux IA comparés.', href: '/fr/vs/onboard' },
      { title: 'Dafira vs Diligent', text: 'Hébergement, tarifs et procès-verbaux IA comparés.', href: '/fr/vs/diligent' },
    ],
  },
  faq: {
    title: 'Foire aux questions',
    subtitle: 'À propos des procès-verbaux de conseil assistés par IA',
    inLanguage: 'fr',
    faqs: [
      { question: 'À quelle vitesse l’IA peut-elle générer un procès-verbal ?', answer: 'Dafira crée un brouillon quelques minutes après la fin de la réunion : le secrétaire part d’un texte structuré plutôt que d’une page blanche.' },
      { question: 'Les procès-verbaux IA peuvent-ils remplacer un secrétaire ?', answer: 'Non. L’IA fait le gros du travail, mais les secrétaires gardent le contrôle de la relecture, de la validation et de la publication.' },
      { question: 'Est-il sûr de confier les procès-verbaux du conseil à l’IA ?', answer: 'Oui. Dafira est basé dans l’UE, conforme au RGPD et chiffré. Vos données sont hébergées en Europe.' },
      { question: 'Et si je dois personnaliser le procès-verbal ?', answer: 'Vous pouvez relire, modifier et ajouter du contexte. Le brouillon IA est un point de départ, pas un résultat figé.' },
    ],
  },
  cta: {
    texts: {
      title: 'Gagnez des heures après chaque réunion de conseil',
      subtitle: 'Commencez un essai gratuit ou réservez une démo avec votre propre ordre du jour. Sans carte de crédit.',
      cta1: 'Réserver une démo',
      cta2: 'Commencer l’essai gratuit',
    },
    links: { cta1: '/fr/request-demo', cta2: '/fr/try' },
  },
};
---

<Layout
  title="Générateur de procès-verbaux IA – Gagnez des heures | Dafira"
  description="Transformez des heures de prise de notes en un brouillon structuré du procès-verbal. Le générateur de procès-verbaux IA de Dafira pour les secrétaires de conseil. Basé dans l'UE, conforme au RGPD."
>
  <main>
    <MinuteBuilderSavings t={t} />
  </main>
</Layout>
