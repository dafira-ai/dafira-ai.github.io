---
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import PodcastIndex from '../../../components/podcast/PodcastIndex.astro';

const episodes = (await getCollection('podcast'))
  .filter((episode) => episode.data.pubDate.getTime() <= Date.now())
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Layout title="La gouvernance en pratique - Podcast Dafira" description="Découvrez les meilleures pratiques et les dernières tendances en matière de gouvernance d'entreprise et de transformation numérique.">
  <main>
    <PodcastIndex lang="fr" episodes={episodes} />
  </main>
</Layout>
