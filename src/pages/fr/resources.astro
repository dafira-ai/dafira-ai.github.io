---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import ResourceHub from '../../components/resources/ResourceHub.astro';

const copy = {
  eyebrow: 'Ressources',
  title: 'Guides, études et échanges sur la gouvernance des conseils',
  lead: "Guides d'utilisation de Dafira, étude sur l'IA dans la salle du conseil, articles et épisodes de podcast pour les secrétaires de conseil, administrateurs et professionnels de la gouvernance.",
  overview: [
    { icon: 'mic', title: 'Podcasts', text: "Conversations d'experts sur la gouvernance moderne.", href: '/fr/podcast', linkText: 'Écouter les épisodes' },
    { icon: 'document', title: 'Articles', text: 'Actualités et analyses sur la gouvernance.', href: '/fr/blog', linkText: 'Lire les articles' },
    { icon: 'chart', title: 'Études', text: 'Analyses approfondies et livres blancs.', href: '/fr/research/boardroom-ai-adoption', linkText: 'Consulter les études' },
    { icon: 'book', title: 'Guides', text: 'Tutoriels et guides pratiques.', href: '/fr/guides', linkText: 'Explorer les guides' },
  ],
  podcasts: { title: 'Derniers épisodes', link: '/fr/podcast', linkText: 'Tous les podcasts' },
  articles: { title: 'Derniers articles', link: '/fr/blog', linkText: 'Tous les articles' },
  readMore: 'Lire',
};

const categories = [
  {
    eyebrow: 'Guides',
    title: 'Guides et tutoriels',
    description: 'Des guides détaillés pour utiliser toutes les fonctionnalités de Dafira.',
    link: '/fr/guides',
    linkText: 'Tous les guides',
    resources: [
      { title: 'Débuter avec Dafira', description: "Configurer et utiliser Dafira pour votre conseil d'administration.", type: 'Guide', readTime: '10 min de lecture', image: '/applications-picture-meeting.png', link: '/fr/guides/getting-started' },
      { title: "Guide d'authentification", description: 'Créez votre compte, connectez-vous et gérez vos accès en toute sécurité.', type: 'Guide', readTime: '5 min de lecture', image: '/fr-authentication.png', link: '/fr/guides/authentication' },
      { title: 'Gestion du profil', description: 'Mettez à jour vos informations personnelles et vos préférences.', type: 'Guide', readTime: '5 min de lecture', image: '/fr-gestion-du-profile.png', link: '/fr/guides/profile-management' },
    ],
  },
  {
    eyebrow: 'Études',
    title: 'Livres blancs et études',
    description: "Analyses approfondies des tendances en gouvernance d'entreprise.",
    resources: [
      { title: "L'IA dans la salle du conseil", description: "Étude sur les enjeux et opportunités de l'IA pour la gouvernance.", type: 'Étude', readTime: '10 min de lecture', image: '/resources.png', link: '/fr/research/boardroom-ai-adoption' },
    ],
  },
];

const now = Date.now();
const posts = (await getCollection('blog'))
  .filter((p) => p.data.pubDate.getTime() <= now && p.data.lang === 'fr')
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 3);
const podcasts = (await getCollection('podcast'))
  .filter((p) => p.data.pubDate.getTime() <= now)
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 3);
---

<Layout title="Ressources - Logiciel de Gouvernance Dafira" description="Guides, études, articles et podcasts sur la gestion du conseil d'administration et la gouvernance, par l'équipe Dafira." image="/resources.png">
  <ResourceHub lang="fr" copy={copy} categories={categories} posts={posts} podcasts={podcasts} />
</Layout>
