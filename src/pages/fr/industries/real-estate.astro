---
import Layout from '../../../layouts/Layout.astro';
import IndustryLanding from '../../../components/industries/IndustryLanding.astro';

const hero = {
  eyebrow: 'Immobilier',
  title: 'Logiciel de gestion du conseil pour l’immobilier',
  lead: 'Pour les conseils de sociétés d’investissement et de gestion immobilière. Dossiers d’investissement, discussions et décisions du conseil réunis, pour chaque actif.',
};

const challenges = {
  title: 'Les enjeux des conseils immobiliers',
  lead: 'Des engagements durables, qui exigent une trace claire des décisions.',
  items: [
    { icon: 'building', title: 'Suivi du portefeuille', text: 'Suivre un portefeuille d’actifs au travers de documents et de rapports réguliers.' },
    { icon: 'trend', title: 'Décisions d’investissement', text: 'Examiner les dossiers d’acquisition, de cession et de développement avant de décider.' },
    { icon: 'users', title: 'Investisseurs et partenaires', text: 'Partager l’information avec chaque groupe de parties prenantes au bon niveau d’accès.' },
  ],
};

const features = {
  title: 'Ce que Dafira apporte',
  lead: 'Les outils utilisés par les sociétés immobilières.',
  items: [
    { icon: 'folder', title: 'Gestion documentaire', text: 'Un stockage central des dossiers d’investissement et des documents du conseil, organisés par réunion et par point de l’ordre du jour.' },
    { icon: 'sparkle', title: 'Assistant IA', text: 'Poser des questions sur de longs dossiers d’investissement et obtenir des résumés avant la réunion.' },
    { icon: 'vote', title: 'Décisions consignées', text: 'Votes, résolutions et signatures conservés avec chaque réunion, dans un registre des décisions.' },
  ],
};
---

<Layout title="Logiciel de gestion de conseil pour l'immobilier | Dafira" description="Portail du conseil pour les sociétés d’investissement et de gestion immobilière : dossiers d’investissement, réunions du conseil et registre clair des décisions.">
  <main>
    <IndustryLanding
      industry="real-estate"
      hero={hero}
      screenshot={{ src: '/onboarding-boardpack.png', alt: 'Dossier du conseil Dafira organisé par point de l’ordre du jour, avec annotations' }}
      challenges={challenges}
      features={features}
      quoteKey="nathalie"
      secondary="trial"
    />
  </main>
</Layout>
