---
import Layout from '../../../layouts/Layout.astro';
import FamilyBusinessLanding, { type FamilyBusinessContent } from '../../../components/industries/FamilyBusinessLanding.astro';

const content: FamilyBusinessContent = {
  hero: {
    eyebrow: 'Entreprise familiale',
    title: 'Logiciel de gouvernance pour entreprises familiales',
    lead: 'Gestion du conseil et du conseil de famille pour les entreprises familiales multi-entités.',
    screenshotAlt: 'Bibliothèque de documents Dafira, classés par réunion',
  },
  intro: {
    title: 'La gouvernance grandit avec la famille et le groupe',
    paragraphs: [
      'Les entreprises familiales opèrent souvent à travers plusieurs entités, générations et organes de gouvernance. À mesure que les structures se développent, la gouvernance devient plus difficile à gérer avec des e-mails, des lecteurs partagés et des processus informels.',
      'Dafira est une plateforme de gestion du conseil et de la gouvernance qui accompagne les entreprises familiales avec une structure claire, une collaboration sécurisée et une prise de décision documentée, sans complexité inutile.',
    ],
  },
  challenges: {
    title: 'Les défis de gouvernance des entreprises familiales',
    lead: 'Les entreprises familiales font face à des défis de gouvernance différents de ceux des autres sociétés.',
    items: [
      { icon: 'building', title: 'Plusieurs conseils entre holding et sociétés opérationnelles', text: 'Gérer la gouvernance à l’échelle du groupe.' },
      { icon: 'users', title: 'Des conseils de famille à côté des conseils d’administration', text: 'Coordonner plusieurs organes de gouvernance sur une seule plateforme.' },
      { icon: 'lock', title: 'Rôles qui se recoupent et informations sensibles', text: 'Contrôler les accès avec des autorisations strictes et des pistes d’audit.' },
    ],
    consequencesIntro: 'Sans système de gouvernance structuré, cela conduit souvent à :',
    consequences: ['Une visibilité et une traçabilité limitées', 'Une perte de connaissances entre générations', 'Une documentation incohérente', 'Un risque juridique et opérationnel accru'],
  },
  bodies: {
    title: 'Une plateforme pour tous les organes de gouvernance familiale',
    lead: 'Dafira réunit la gouvernance de l’entreprise familiale dans un environnement unique et sécurisé.',
    intro: 'Vous pouvez gérer :',
    items: ['Les conseils d’administration (holding et filiales)', 'Les conseils de famille', 'Les conseils consultatifs', 'Les comités d’investissement, d’audit ou de rémunération'],
    outro: [
      'Chaque organe de gouvernance fonctionne de manière indépendante, avec ses propres membres et rôles, ordres du jour et calendriers de réunion, documents et dossiers du conseil, et paramètres d’accès et d’autorisation.',
      'Les entreprises familiales peuvent ainsi étendre leur gouvernance sans la fragmenter.',
    ],
    features: [
      { icon: 'layers', title: 'Gouvernance multi-entités', text: 'Gérer indépendamment conseils, conseils de famille et comités, chacun avec ses membres, ordres du jour et autorisations.' },
      { icon: 'lock', title: 'Contrôle des accès sécurisé', text: 'Autorisations par rôle, sécurité au niveau des documents et pistes d’audit complètes pour une gouvernance familiale confidentielle.' },
      { icon: 'document', title: 'Prise de décision structurée', text: 'Procès-verbaux rédigés avec l’IA, suivi des actions et historique de gouvernance consultable, pour la continuité à long terme.' },
    ],
  },
  access: {
    title: 'Un accès sécurisé pour les membres de la famille et les administrateurs externes',
    lead: 'Les entreprises familiales associent souvent des membres de la famille à des administrateurs indépendants et à des conseillers.',
    intro: 'Dafira fournit :',
    items: ['Un accès par rôle pour chaque conseil ou comité', 'Des autorisations au niveau des documents', 'Des pistes d’audit complètes et l’historique des versions', 'Une collaboration sécurisée, sans lecteurs partagés ni pièces jointes par e-mail'],
    outro: 'La confidentialité est ainsi préservée, tout en maintenant la transparence là où elle est requise.',
  },
  meetings: {
    title: 'Des réunions structurées et des décisions documentées',
    lead: 'Dafira aide les entreprises familiales à professionnaliser le fonctionnement du conseil, tout en restant pratique et léger.',
    intro: 'Les principales fonctionnalités :',
    items: ['Ordres du jour et dossiers du conseil centralisés', 'Suivi des décisions et des actions', 'Conservation sécurisée des archives de gouvernance', 'Procès-verbaux rédigés avec l’IA pour réduire la charge administrative'],
    outro: 'Toute l’activité de gouvernance est documentée, consultable et accessible aux utilisateurs autorisés.',
  },
  continuity: {
    title: 'Assurer la continuité entre les générations',
    lead: 'Lorsque l’entreprise familiale passe d’une génération à l’autre, la continuité devient essentielle.',
    items: [
      { icon: 'refresh', title: 'Continuité entre générations', text: 'Préserver l’historique de gouvernance et réduire la dépendance aux connaissances informelles.' },
      { icon: 'checkCircle', title: 'Un fonctionnement professionnel', text: 'Ordres du jour, dossiers du conseil et décisions documentées centralisés, sans complexité.' },
      { icon: 'family', title: 'Conçu pour les entreprises familiales', text: 'La prise en charge des structures de groupe, de plusieurs conseils et d’une gouvernance à long terme.' },
    ],
    intro: 'Dafira y contribue en :',
    list: ['Préservant l’historique de gouvernance et les décisions dans le temps', 'Clarifiant les rôles et les responsabilités', 'Réduisant la dépendance aux détenteurs de connaissances informelles', 'Offrant un cadre de gouvernance cohérent entre les entités'],
    outro: 'La gouvernance devient ainsi plus résiliente, quels que soient les changements à la direction.',
  },
  why: {
    title: 'Conçu pour les structures d’entreprises familiales multi-entités',
    lead: 'Contrairement aux outils de collaboration génériques, Dafira est conçu pour la gouvernance.',
    intro: 'Les entreprises familiales choisissent Dafira car il prend en charge :',
    items: ['Les structures de groupe', 'Plusieurs conseils au sein d’une même organisation', 'La continuité de la gouvernance à long terme', 'Un fonctionnement du conseil sécurisé'],
    outro: 'Dafira s’adapte aux structures de gouvernance existantes plutôt que d’imposer un modèle prédéfini.',
  },
  users: {
    title: 'Qui utilise Dafira dans les entreprises familiales ?',
    intro: 'Dafira est utilisé par :',
    items: ['Les actionnaires familiaux', 'Les présidents et membres du conseil', 'Les membres du conseil de famille', 'Les dirigeants et équipes de direction', 'Les administrateurs externes et conseillers', 'Les secrétaires généraux et secrétaires du conseil'],
    outro: 'Chaque utilisateur ne voit que ce qui concerne son rôle.',
  },
  cta: {
    title: 'La gouvernance d’entreprise familiale, en pratique',
    subtitle: 'Dafira aide les entreprises familiales à gérer leur gouvernance avec clarté, structure et sécurité, sans en faire un projet de conseil.',
  },
};
---

<Layout title="Logiciel de gouvernance d'entreprise familiale | Dafira" description="Gestion du conseil et du conseil de famille pour les entreprises familiales multi-entités. Une gouvernance structurée, sans complexité.">
  <main>
    <FamilyBusinessLanding content={content} />
  </main>
</Layout>
