---
import Layout from '../../../layouts/Layout.astro';
import IndustryLanding from '../../../components/industries/IndustryLanding.astro';

const hero = {
  eyebrow: 'Santé',
  title: 'Logiciel de gestion du conseil pour les organisations de santé',
  lead: 'Pour les conseils d’hôpitaux, de prestataires de soins et d’entreprises des sciences de la vie. Préparez les discussions sur la qualité, la sécurité et les finances, et gardez la maîtrise des documents confidentiels.',
};

const challenges = {
  title: 'Les enjeux des conseils du secteur de la santé',
  lead: 'Questions cliniques, financières et réglementaires autour de la même table.',
  items: [
    { icon: 'lock', title: 'Informations sensibles', text: 'Les documents du conseil peuvent contenir des données de santé, que le RGPD traite comme une catégorie particulière.' },
    { icon: 'health', title: 'Gouvernance clinique', text: 'La qualité et la sécurité reviennent à chaque réunion et demandent un registre cohérent.' },
    { icon: 'users', title: 'Parties prenantes multiples', text: 'Administrateurs, corps médical et direction ont chacun besoin du bon niveau d’accès.' },
  ],
};

const features = {
  title: 'Ce que Dafira apporte',
  lead: 'Les outils utilisés par les organisations de santé.',
  items: [
    { icon: 'shield', title: 'Documents du conseil protégés', text: 'Accès par rôle, chiffrement et piste d’audit, avec des pratiques de protection des données conformes au RGPD.' },
    { icon: 'layers', title: 'Comités', text: 'Des espaces distincts pour les comités qualité, audit et autres, chacun avec ses propres membres.' },
    { icon: 'clipboard', title: 'Points récurrents', text: 'Des modèles d’ordre du jour pour les points permanents, comme les rapports qualité et sécurité.' },
  ],
};
---

<Layout title="Logiciel de gestion de conseil pour la santé | Dafira" description="Portail du conseil pour les hôpitaux et organisations de soins : documents confidentiels sous contrôle d’accès, réunions des comités et décisions documentées.">
  <main>
    <IndustryLanding
      industry="healthcare"
      hero={hero}
      screenshot={{ src: '/onboarding-event-detail.png', alt: 'Page de réunion Dafira avec l’ordre du jour, les présences et un vote' }}
      challenges={challenges}
      features={features}
      secondary="trial"
    />
  </main>
</Layout>
