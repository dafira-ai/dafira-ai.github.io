---
import Layout from '../../../layouts/Layout.astro';
import { PageHero, Section, Icon, CellGrid, FeatureList, CTA } from '../../../components/ui';
import { ctaProps } from '../../../components/industries/i18n';

const industries = [
  {
    name: 'Services financiers',
    icon: 'bank',
    description: 'Un travail de conseil sécurisé et documenté pour les banques, assureurs et sociétés d’investissement.',
    link: '/fr/industries/financial-services',
    features: ['Contexte réglementaire pour le conseil', 'Gestion documentaire sécurisée', 'Réunions du conseil et des comités'],
  },
  {
    name: 'Santé',
    icon: 'health',
    description: 'La gestion du conseil pour les hôpitaux, prestataires de soins et entreprises des sciences de la vie.',
    link: '/fr/industries/healthcare',
    features: ['Documents du conseil confidentiels', 'Gouvernance clinique à l’ordre du jour', 'Comités'],
  },
  {
    name: 'Immobilier',
    icon: 'building',
    description: 'La gestion du conseil pour les sociétés d’investissement et de gestion immobilière.',
    link: '/fr/industries/real-estate',
    features: ['Dossiers d’investissement', 'Suivi du portefeuille', 'Registre des décisions'],
  },
  {
    name: 'Entreprise familiale',
    icon: 'family',
    description: 'La gestion du conseil et du conseil de famille pour les entreprises familiales multi-entités.',
    link: '/fr/industries/family-business',
    features: ['Plusieurs organes de gouvernance', 'Accès par rôle', 'Continuité entre générations'],
  },
];
---

<Layout title="Solutions sectorielles | Logiciel de gestion de conseil Dafira" description="Dafira par secteur : gestion du conseil pour les services financiers, la santé, l’immobilier et les entreprises familiales.">
  <main>
    <PageHero eyebrow="Secteurs" title="La gestion du conseil, par secteur" lead="Le cycle du conseil est partout le même ; le contexte, non. Découvrez comment Dafira accompagne les conseils des organisations réglementées et familiales." />

    <Section>
      <CellGrid columns={2}>
        {industries.map((industry) => (
          <a href={industry.link} class="group bg-white p-8 lg:p-10 hover:bg-surface transition-colors flex flex-col">
            <Icon name={industry.icon} class="w-6 h-6 text-navy" />
            <h2 class="mt-5 text-xl font-semibold text-navy">{industry.name}</h2>
            <p class="mt-3 text-gray-600 leading-relaxed">{industry.description}</p>
            <FeatureList items={industry.features} class="mt-6" />
            <span class="mt-auto pt-8 inline-flex items-center gap-2 text-[15px] font-medium text-primary group-hover:text-navy transition-colors">
              Voir la page sectorielle
              <svg class="w-4 h-4 rtl-flip" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M9 5l7 7-7 7" />
              </svg>
            </span>
          </a>
        ))}
      </CellGrid>
    </Section>

    <CTA {...ctaProps.fr} />
  </main>
</Layout>
