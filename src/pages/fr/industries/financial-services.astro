---
import Layout from '../../../layouts/Layout.astro';
import IndustryLanding from '../../../components/industries/IndustryLanding.astro';

const hero = {
  eyebrow: 'Services financiers',
  title: 'Logiciel de gestion du conseil pour les services financiers',
  lead: 'Un travail de conseil sécurisé et documenté pour les banques, assureurs et sociétés d’investissement. Documents du conseil et des comités, décisions et signatures en un seul endroit, avec des accès définis par rôle.',
};

const challenges = {
  title: 'Les enjeux des conseils du secteur financier',
  lead: 'La réglementation façonne l’ordre du jour, et les superviseurs attendent un registre clair.',
  items: [
    { icon: 'scale', title: 'Exigences réglementaires', text: 'Des textes comme DORA, la CSRD et le RGPD confient des responsabilités précises au conseil.' },
    { icon: 'shield', title: 'Surveillance des risques', text: 'Les comités des risques et d’audit ont besoin d’une information complète et à jour avant chaque réunion.' },
    { icon: 'leaf', title: 'Reporting de durabilité', text: 'Le conseil supervise la déclaration de durabilité et la manière dont elle est préparée.' },
    { icon: 'lock', title: 'Informations confidentielles', text: 'Les documents du conseil ne doivent atteindre que les destinataires prévus, par un canal sécurisé.' },
  ],
};

const features = {
  title: 'Ce que Dafira apporte',
  lead: 'Les outils utilisés par les institutions financières.',
  items: [
    { icon: 'shield', title: 'Suivi de la conformité', text: 'Suivre les sujets réglementaires qui concernent le conseil, avec les documents associés.' },
    { icon: 'sparkle', title: 'Assistant IA', text: 'Poser des questions sur de longs documents du conseil et obtenir des résumés avant la réunion.' },
    { icon: 'folder', title: 'Gestion documentaire sécurisée', text: 'Stockage et partage chiffrés des documents du conseil et des comités, avec des accès par rôle.' },
    { icon: 'clipboard', title: 'Piste d’audit', text: 'Une trace des accès aux documents et des décisions prises.' },
  ],
};
---

<Layout title="Logiciel de gestion de conseil pour les services financiers | Dafira" description="Portail du conseil pour les banques, assureurs et sociétés d’investissement : documents du conseil et des comités, décisions et signatures dans un espace sécurisé, avec le contexte réglementaire en vue.">
  <main>
    <IndustryLanding
      industry="financial-services"
      hero={hero}
      screenshot={{ src: '/onboarding-document-list.png', alt: 'Bibliothèque de documents Dafira, classés par réunion' }}
      challenges={challenges}
      features={features}
      quoteKey="pierre"
      secondary="trial"
    />
  </main>
</Layout>
