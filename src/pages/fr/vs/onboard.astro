---
import Layout from '../../../layouts/Layout.astro';
import ComparisonPage from '../../../components/vs/ComparisonPage.astro';
import type { CriterionKey } from '../../../components/vs/copy';

// Criteria compared on this page. The Dafira side of each criterion comes from components/vs/copy.ts;
// the OnBoard side lists questions to check with the vendor (no claims about OnBoard are made here).
const criteria: { key: CriterionKey; label: string; questions: string[] }[] = [
  {
    key: 'ux',
    label: "Expérience utilisateur",
    questions: [
      "Quelle formation les administrateurs doivent-ils suivre avant leur première séance ?",
      "L’espace s’adapte-t-il à vos conseils, comités et rôles ?",
      "Comment un utilisateur occasionnel retrouve-t-il le dossier en cours ?",
    ],
  },
  {
    key: 'docs',
    label: "Gestion documentaire",
    questions: [
      "Comment les dossiers sont-ils constitués et mis à jour après envoi ?",
      "Existe-t-il un historique des versions pour chaque document ?",
      "Les administrateurs peuvent-ils annoter en privé ?",
    ],
  },
  {
    key: 'mobile',
    label: "Expérience mobile",
    questions: [
      "Quelles fonctionnalités sont disponibles sur tablette et téléphone ?",
      "Les documents sont-ils consultables hors ligne, et comment est-ce sécurisé ?",
      "Toutes les fonctionnalités du poste de travail sont-elles disponibles sur mobile ?",
    ],
  },
  {
    key: 'ai',
    label: "Intégration IA",
    questions: [
      "Quelles fonctionnalités IA sont incluses, et dans quelle offre ?",
      "Où les documents sont-ils traités lorsque l’IA est utilisée ?",
      "Les projets de procès-verbal peuvent-ils être rédigés dans les langues de votre conseil ?",
    ],
  },
];

// Customer quotes, verbatim.
const quotes = [
  { quote: "Dafira a transformé notre gestion de conseil, apportant plus d'efficacité et de clarté dans nos processus de gouvernance.", author: "Directrice juridique", position: "", company: "Groupe de mode coté en bourse", link: "/case-studies/listed-fashion-group" },
  { quote: "Dafira a considérablement simplifié notre gestion documentaire, rendant nos préparations de réunions plus efficaces et permettant à notre conseil de se concentrer sur la prise de décision.", author: "CEO", position: "", company: "Fonds public d'investissement régional", link: "/case-studies/public-investment-fund" },
  { quote: "Dafira incarne la nouvelle génération de logiciels de conseil, facile à utiliser et avec une intégration IA performante.", author: "Juriste et responsable conformité", position: "", company: "Société immobilière cotée du secteur des soins", link: "/fr/case-studies/healthcare-real-estate" },
];
---

<Layout
  title="OnBoard vs Dafira : comparatif de portails du conseil | Dafira"
  description="Comparez Dafira et OnBoard sur la facilité d’utilisation, la gestion documentaire, l’usage mobile et l’IA : ce que propose Dafira, et les questions à poser à OnBoard. Essai gratuit de 14 jours, sans carte bancaire."
>
  <ComparisonPage
    lang="fr"
    competitor="OnBoard"
    title="Alternative à OnBoard : comment Dafira se compare"
    lead="Si vous évaluez OnBoard ou envisagez un changement, cette page présente ce que Dafira propose pour chaque critère et ce qu’il convient de vérifier auprès de OnBoard. Vous pouvez ensuite tester Dafira avec votre propre dossier du conseil pendant 14 jours."
    criteria={criteria}
    quotes={quotes}
  />
</Layout>
