---
import Layout from '../../../layouts/Layout.astro';
import ComparisonPage from '../../../components/vs/ComparisonPage.astro';
import type { CriterionKey } from '../../../components/vs/copy';

// Criteria compared on this page. The Dafira side of each criterion comes from components/vs/copy.ts;
// the Diligent side lists questions to check with the vendor (no claims about Diligent are made here).
const criteria: { key: CriterionKey; label: string; questions: string[] }[] = [
  {
    key: 'ux',
    label: "Expérience utilisateur",
    questions: [
      "Quelle formation les administrateurs doivent-ils suivre avant leur première séance ?",
      "L’espace s’adapte-t-il à vos conseils, comités et rôles ?",
      "Comment un utilisateur occasionnel retrouve-t-il le dossier en cours ?",
    ],
  },
  {
    key: 'ai',
    label: "Capacités IA",
    questions: [
      "Quelles fonctionnalités IA sont incluses, et dans quelle offre ?",
      "Où les documents sont-ils traités lorsque l’IA est utilisée ?",
      "Les projets de procès-verbal peuvent-ils être rédigés dans les langues de votre conseil ?",
    ],
  },
  {
    key: 'pricing',
    label: "Modèle tarifaire",
    questions: [
      "Le prix est-il fixé par conseil, par utilisateur ou par module ?",
      "Quelle est la durée minimale d’engagement ?",
      "Quelles fonctionnalités sont vendues en option ?",
    ],
  },
  {
    key: 'implementation',
    label: "Déploiement",
    questions: [
      "Combien de mois prend un déploiement type ?",
      "Qu’attend-on de votre équipe informatique ?",
      "Qui reprend vos archives existantes, et à quel coût ?",
    ],
  },
];

// Customer quotes, verbatim.
const quotes = [
  { quote: "Dafira a complètement transformé nos processus de gouvernance, apportant plus d'efficacité et de clarté.", author: "Directrice juridique", position: "", company: "Groupe de mode coté en bourse", link: "/case-studies/listed-fashion-group" },
  { quote: "Dafira a considérablement simplifié notre gestion documentaire, rendant nos préparations de réunions plus efficaces et permettant à notre conseil de se concentrer sur la prise de décision.", author: "CEO", position: "", company: "Fonds public d'investissement régional", link: "/case-studies/public-investment-fund" },
  { quote: "Dafira incarne la nouvelle génération de logiciels de gouvernance, facile à utiliser et doté d'une IA intégrée.", author: "Juriste et responsable conformité", position: "", company: "Société immobilière cotée du secteur des soins", link: "/fr/case-studies/healthcare-real-estate" },
];
---

<Layout
  title="Diligent vs Dafira : comparatif de portails du conseil | Dafira"
  description="Comparez Dafira et Diligent sur la facilité d’utilisation, l’IA, la tarification et le déploiement : ce que propose Dafira, et les questions à poser à Diligent. Essai gratuit de 14 jours, sans carte bancaire."
>
  <ComparisonPage
    lang="fr"
    competitor="Diligent"
    title="Alternative à Diligent : comment Dafira se compare"
    lead="Si vous évaluez Diligent ou envisagez un changement, cette page présente ce que Dafira propose pour chaque critère et ce qu’il convient de vérifier auprès de Diligent. Vous pouvez ensuite tester Dafira avec votre propre dossier du conseil pendant 14 jours."
    criteria={criteria}
    quotes={quotes}
  />
</Layout>
