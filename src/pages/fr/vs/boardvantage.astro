---
import Layout from '../../../layouts/Layout.astro';
import ComparisonPage from '../../../components/vs/ComparisonPage.astro';
import type { CriterionKey } from '../../../components/vs/copy';

// Criteria compared on this page. The Dafira side of each criterion comes from components/vs/copy.ts;
// the Boardvantage side lists questions to check with the vendor (no claims about Boardvantage are made here).
const criteria: { key: CriterionKey; label: string; questions: string[] }[] = [
  {
    key: 'ux',
    label: "Expérience utilisateur",
    questions: [
      "Quelle formation les administrateurs doivent-ils suivre avant leur première séance ?",
      "L’espace s’adapte-t-il à vos conseils, comités et rôles ?",
      "Comment un utilisateur occasionnel retrouve-t-il le dossier en cours ?",
    ],
  },
  {
    key: 'ai',
    label: "Capacités IA",
    questions: [
      "Quelles fonctionnalités IA sont incluses, et dans quelle offre ?",
      "Où les documents sont-ils traités lorsque l’IA est utilisée ?",
      "Les projets de procès-verbal peuvent-ils être rédigés dans les langues de votre conseil ?",
    ],
  },
  {
    key: 'docs',
    label: "Gestion documentaire",
    questions: [
      "Comment les dossiers sont-ils constitués et mis à jour après envoi ?",
      "Existe-t-il un historique des versions pour chaque document ?",
      "Les administrateurs peuvent-ils annoter en privé ?",
    ],
  },
  {
    key: 'implementation',
    label: "Déploiement",
    questions: [
      "Combien de temps prend une mise en place pour un conseil comme le vôtre ?",
      "Qu’attend-on de votre équipe informatique ?",
      "Quelles étapes de configuration nécessitent votre équipe informatique ?",
    ],
  },
];

// Customer quotes, verbatim.
const quotes = [
  { quote: "Dafira a transformé notre gouvernance, apportant plus d'efficacité et de clarté dans nos processus.", author: "Directrice juridique", position: "", company: "Groupe de mode coté en bourse", link: "/case-studies/listed-fashion-group" },
  { quote: "Dafira a considérablement simplifié notre gestion documentaire, rendant nos préparations de réunions plus efficaces et permettant à notre conseil de se concentrer sur la prise de décision.", author: "CEO", position: "", company: "Fonds public d'investissement régional", link: "/case-studies/public-investment-fund" },
  { quote: "Dafira incarne la nouvelle génération de logiciels de gouvernance, facile à utiliser et intégrant l'IA.", author: "Juriste et responsable conformité", position: "", company: "Société immobilière cotée du secteur des soins", link: "/fr/case-studies/healthcare-real-estate" },
];
---

<Layout
  title="Boardvantage vs Dafira : comparatif de portails du conseil | Dafira"
  description="Comparez Dafira et Boardvantage sur la facilité d’utilisation, l’IA, la gestion documentaire et le déploiement : ce que propose Dafira, et les questions à poser à Boardvantage. Essai gratuit de 14 jours, sans carte bancaire."
>
  <ComparisonPage
    lang="fr"
    competitor="Boardvantage"
    title="Alternative à Boardvantage : comment Dafira se compare"
    lead="Si vous évaluez Boardvantage ou envisagez un changement, cette page présente ce que Dafira propose pour chaque critère et ce qu’il convient de vérifier auprès de Boardvantage. Vous pouvez ensuite tester Dafira avec votre propre dossier du conseil pendant 14 jours."
    criteria={criteria}
    quotes={quotes}
  />
</Layout>
