---

<Layout title="Tarifs - Logiciel de gestion de conseil Dafira" description="Tarification simple et transparente à partir de 149€/mois. Choisissez le forfait adapté à votre conseil." >
  <main>
    <PageHero
      eyebrow="Tarifs"
      title="Une tarification simple et transparente"
      lead="Trois forfaits reposant sur le même socle sécurisé. Toutes nos offres incluent les fonctionnalités essentielles ; vous choisissez le niveau de collaboration, de conformité et de support."
    />

    <Section space="md">
      <PricingTiers {...pricingTexts} />
    </Section>

    <Section tone="surface" border="top">
      <SectionHeader eyebrow="Accompagnement et support" title="Support et formation à chaque étape" lead="Chaque forfait inclut l'intégration, la formation et le support de notre équipe." />
      <FeatureColumns items={supportColumns} />
    </Section>

    <FAQ texts={faqData} />

    <CTA {...ctaProps} />
  </main>
</Layout>
