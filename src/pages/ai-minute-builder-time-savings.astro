---
import Layout from '../layouts/Layout.astro';
import MinuteBuilderSavings from '../components/campaigns/MinuteBuilderSavings.astro';

const t = {
  hero: {
    eyebrow: 'AI minute builder',
    title: 'Turn hours of manual note-taking into a structured draft of the minutes',
    lead: 'Board secretaries spend long evenings drafting, rewriting and aligning minutes after every meeting. With the Dafira AI minute builder you start from a structured, EU-hosted draft shortly after the meeting ends, then review and publish it.',
    primary: { text: 'Start free trial', href: '/try' },
    secondary: { text: 'Book a demo', href: '/request-demo' },
    note: 'No credit card required · EU-hosted · GDPR compliant',
  },
  card: {
    title: 'Draft minutes · Board of Directors',
    meta: 'Generated after the meeting',
    rows: [
      { label: 'Item 1', text: 'Approval of previous minutes', tone: 'ok' as const, status: 'Decision' },
      { label: 'Item 2', text: 'H1 accounts presented by the CFO', tone: 'neutral' as const, status: 'Noted' },
      { label: 'Item 3', text: 'Resolution 2026-14 · Capex budget', tone: 'ok' as const, status: 'Resolution' },
      { label: 'Item 4', text: 'Prepare supplier tender · CFO', tone: 'info' as const, status: 'Action' },
    ],
    footer: 'Draft ready for the secretary to review',
    footerMeta: 'Not yet published',
    caption: 'Sample draft',
  },
  pain: {
    eyebrow: 'The time drain',
    title: 'Stop wasting time, focus on decisions',
    lead: 'Manual minutes slow boards down. Dafira changes this: you start from a ready-to-review draft, not a blank page.',
    items: [
      { icon: 'clock', title: 'Hours of post-meeting work', text: 'Board secretaries spend entire evenings transcribing notes, formatting documents and making sure nothing was missed.' },
      { icon: 'document', title: 'Inconsistent drafts and multiple versions', text: 'Manual note-taking leads to incomplete records, missed decisions and endless back-and-forth revisions.' },
      { icon: 'warning', title: 'Risk of errors or missing key decisions', text: 'Resolutions and action items get lost in handwritten notes or scattered digital documents.' },
      { icon: 'calendar', title: 'Pressure to finalise minutes quickly', text: 'Governance requirements call for a quick turnaround, which manual processes make difficult.' },
    ],
  },
  changes: {
    eyebrow: 'What changes',
    title: 'Time back after every meeting with the AI minute builder',
    lead: 'The work moves from writing to reviewing. The secretary stays in charge of the final text.',
    items: [
      { icon: 'sparkle', title: 'A draft shortly after the meeting', text: 'Get a structured draft that follows your agenda as soon as the meeting ends.' },
      { icon: 'pen', title: 'Review, not rewrite', text: 'You validate and refine instead of starting from scratch. Full editorial control stays with you.' },
      { icon: 'gavel', title: 'Built for board meetings', text: 'Designed for governance rather than generic transcription: it identifies decisions, actions and resolutions.' },
      { icon: 'users', title: 'Publish to directors in one step', text: 'Share the final minutes with all directors through the secure, GDPR-compliant platform.' },
    ],
    link: { text: 'Discover how the AI minute builder works', href: '/features/ai-minute-builder' },
  },
  compare: {
    eyebrow: 'Before and after',
    title: 'Before and after Dafira',
    lead: 'Where the time goes after a board meeting, and what changes when you start from an AI draft.',
    headers: ['Task', 'Before Dafira', 'With Dafira'],
    rows: [
      ['Drafting minutes', 'Written from notes after the meeting', 'AI draft generated from the meeting'],
      ['Rewriting and aligning', 'Several rounds of edits and versions', 'One review of a structured draft'],
      ['Sharing with directors', 'Emails and attachments', 'Published to directors from the platform'],
    ],
    cta: { text: 'Book a demo', href: '/request-demo' },
  },
  trust: {
    eyebrow: 'European trust',
    title: 'Why European boards trust Dafira',
    lead: 'Dafira is designed for European boards and European data protection rules.',
    items: [
      { icon: 'globe', title: 'EU hosting and GDPR compliance', text: 'Your board data is hosted in Europe.' },
      { icon: 'lock', title: 'Encryption and certified infrastructure', text: 'Encrypted data on ISO 27001-certified hosting infrastructure.' },
      { icon: 'users', title: 'Unlimited users included', text: 'No per-seat costs for directors and guests.' },
      { icon: 'sparkle', title: 'AI built into the platform', text: 'The minute builder is part of Dafira, not a separate add-on.' },
    ],
  },
  alternatives: {
    eyebrow: 'Comparing platforms',
    title: 'Dafira vs OnBoard vs Diligent',
    lead: 'Evaluating board portals? Our comparison pages set out the differences in hosting, pricing model and AI features.',
    cards: [
      { title: 'Dafira vs OnBoard', text: 'Hosting, pricing and AI minutes compared.', href: '/vs/onboard' },
      { title: 'Dafira vs Diligent', text: 'Hosting, pricing and AI minutes compared.', href: '/vs/diligent' },
    ],
  },
  faq: {
    title: 'Frequently asked questions',
    subtitle: 'About AI-assisted board minutes',
    inLanguage: 'en',
    faqs: [
      { question: 'How fast can AI generate minutes?', answer: 'Dafira creates a draft within minutes after the meeting ends, so the secretary starts from a structured text instead of a blank page.' },
      { question: 'Can AI minutes replace a secretary?', answer: 'No. AI does the heavy lifting, but secretaries remain in control for review, validation and publication.' },
      { question: 'Is it safe to let AI handle board minutes?', answer: 'Yes. Dafira is EU-based, GDPR compliant and encrypted. Your data is hosted in Europe.' },
      { question: 'What if I need to customise the minutes?', answer: 'You can review, edit and add context. The AI draft is a starting point, not a rigid output.' },
    ],
  },
  cta: {
    texts: {
      title: 'Save hours after every board meeting',
      subtitle: 'Start a free trial or book a demo with your own agenda. No credit card required.',
      cta1: 'Book a demo',
      cta2: 'Start free trial',
    },
    links: { cta1: '/request-demo', cta2: '/try' },
  },
};
---

<Layout
  title="AI Meeting Minutes Generator – Save Hours | Dafira"
  description="Turn hours of manual note-taking into a structured draft of the minutes. Dafira's AI minute builder for board secretaries. EU-based, GDPR compliant."
>
  <main>
    <MinuteBuilderSavings t={t} />
  </main>
</Layout>
