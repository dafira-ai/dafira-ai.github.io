---
import Layout from '../layouts/Layout.astro';
import { PageHero, Section, Prose } from '../components/ui';

const sections = [
  {
    title: "Information We Collect",
    items: [
      {
        subtitle: "Account and Contact Data",
        content: "When you register on our website, you voluntarily provide information including name, company name, email address, phone number, postal address, business sector, and password. We never store credit card information and rely on trusted third-party PCI-DSS-compliant payment processors."
      },
      {
        subtitle: "Job Application Data",
        content: "For job applications, we collect contact information and details from your CV. We only request information necessary for the recruitment process and never collect sensitive personal information about racial origin, political opinions, religious beliefs, or sexual life."
      },
      {
        subtitle: "Browser Data",
        content: "We detect browser language and geolocation to customize your experience. Our servers record basic information like IP address, visit time/date, browser version, and referral source for statistical and security purposes."
      },
      {
        subtitle: "Customer Databases",
        content: "Information in your Dafira database remains under your full control and ownership. We only process this data on your behalf according to your instructions."
      }
    ]
  },
  {
    title: "How We Use Information",
    items: [
      {
        subtitle: "Account and Contact Data",
        content: "Used for service provision, support, billing, and optional marketing communications. Data may be shared with event organizers and sponsors if you register for events."
      },
      {
        subtitle: "Job Application Data",
        content: "Processed solely for recruitment purposes and contract preparation if selected. You may request deletion at any time."
      },
      {
        subtitle: "Browser Data",
        content: "Analyzed anonymously for service improvement. Google reCAPTCHA may be used for security, processing only anonymous scores."
      },
      {
        subtitle: "Customer Databases",
        content: "Processed according to your instructions for service provision. Support staff may access data for troubleshooting or upon your request."
      }
    ]
  },
  {
    title: "Data Retention",
    items: [
      {
        subtitle: "Account and Contact Data",
        content: "Retained as long as necessary for service provision and legal requirements."
      },
      {
        subtitle: "Job Application Data",
        content: "Kept up to 2 years for potential future opportunities unless requested otherwise. Employee data retained per legal requirements."
      },
      {
        subtitle: "Browser Data",
        content: "Typically retained for 2 months unless needed longer for security or legal purposes."
      },
      {
        subtitle: "Customer Database",
        content: "Retained only during active service period. Deactivated databases kept for 3 weeks after cancellation, then destroyed."
      }
    ]
  }
];

const contactInfo = {
  email: "info@dafira.ai",
  address: "Dafira - Data Protection\nRue de l'Hôpital 31\n1000 Brussels, Belgium"
};
---
<Layout title="Privacy Policy - Dafira" description="We are committed to protecting your privacy and ensuring the security of your data. Learn how we collect, use, and protect your information.">
  <main>
    <PageHero eyebrow="Legal" title="Privacy Policy" lead="We are committed to protecting your privacy and ensuring the security of your data. Learn how we collect, use, and protect your information." />

    <Section size="prose" space="md">
      <Prose>
        <p class="text-lg">Dafira and its affiliates offer many services to help you run your business, including a platform to host your Dafira database. This policy explains what information we collect, why we collect it, and how we use it.</p>

        {sections.map((section) => (
          <Fragment>
            <h2>{section.title}</h2>
            {section.items.map((item) => (
              <Fragment>
                <h3>{item.subtitle}</h3>
                <p>{item.content}</p>
              </Fragment>
            ))}
          </Fragment>
        ))}

        <h2>Cookies</h2>
        <p>Cookies are small bits of text sent by our servers to your computer when you access our services. We use them to support your activities, understand preferences, and improve our services. Third-party services like Google Analytics may also use cookies for their own purposes.</p>
      </Prose>

      <div class="mt-16 border border-line rounded-md bg-surface p-6 lg:p-8 max-w-[68ch]">
        <h2 class="text-2xl font-semibold text-navy">Contact Us</h2>
        <p class="mt-3 text-gray-700">If you have any questions about this Privacy Policy or concerns about your personal data, please contact us:</p>
        <div class="mt-4 space-y-2 text-gray-700">
              <p>
                <strong>Email:</strong> {contactInfo.email}
              </p>
              <p class="whitespace-pre-line">
                <strong>Address:</strong>
                {contactInfo.address}
              </p>
        </div>
      </div>
    </Section>
    <p class="pb-12 px-4 text-center text-xs text-gray-500">This site is protected by reCAPTCHA and the Google
      <a href="https://policies.google.com/privacy" class="underline underline-offset-2 hover:text-navy">Privacy Policy</a> and
      <a href="https://policies.google.com/terms" class="underline underline-offset-2 hover:text-navy">Terms of Service</a> apply.</p>
  </main>
</Layout>
