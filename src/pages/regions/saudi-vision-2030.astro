---
import Layout from '../../layouts/Layout.astro';
import { PageHero, Section, SectionHeader, Button, Icon, CellGrid, FeatureList, Callout, Screenshot, CTA } from '../../components/ui';

// Source: CMA Corporate Governance Regulations, English translation of the official Arabic text.
// Issued by CMA Board Resolution 8-16-2017 (13/2/2017G), amended by Resolution 8-5-2023 (18/1/2023G).
// Paraphrased, not quoted; article numbers checked against that text.
const cgrUrl = 'https://cma.gov.sa/en/RulesRegulations/Regulations/Pages/default.aspx';

const requirements = [
  {
    article: 'Art. 30(b)',
    requirement: 'The board meets at least four times a year, and at least once every three months.',
    dafira: 'Board and committee meetings planned in one calendar, with invitations sent to every member.',
  },
  {
    article: 'Art. 30(c)',
    requirement: 'The invitation reaches each member at least five days before the meeting, with the agenda and the necessary documents, except for urgent meetings.',
    dafira: 'The agenda and the board pack are published together with the invitation.',
  },
  {
    article: 'Art. 33',
    requirement: 'The board approves the agenda at the start of the meeting; any member may propose items, and objections are recorded in the minutes.',
    dafira: 'Agenda builder with items per section; objections and additions recorded in the minutes.',
  },
  {
    article: 'Art. 31',
    requirement: 'Unresolved remarks by members, and any opinion that differs from a board resolution, are recorded in detail in the minutes.',
    dafira: 'The minutes keep dissenting opinions and remarks alongside the resolution they relate to.',
  },
  {
    article: 'Art. 35(a)(1)',
    requirement: 'The secretary documents each meeting: discussions, place, date, start and end times, attendees, decisions and voting results, kept in an organised register. The minutes are signed by the chair of the meeting, the attending members and the secretary.',
    dafira: 'Attendance, votes and resolutions recorded with the meeting and kept in a decision log; minutes drafted with the AI minute builder and signed electronically.',
  },
  {
    article: 'Art. 35(a)(6–7)',
    requirement: 'Draft minutes are presented to members for their opinion before signature, and members receive a copy of the signed minutes promptly.',
    dafira: 'Draft minutes shared in the board pack, where members can annotate them before signature, then circulated once signed.',
  },
  {
    article: 'Art. 38',
    requirement: 'Management provides board and committee members with complete, clear and accurate information in due course.',
    dafira: 'One document library per board and committee, with access by role and an AI assistant to question long papers.',
  },
  {
    article: 'Art. 39',
    requirement: 'The board sets up mechanisms to assess annually the performance of the board, its members, its committees and executive management.',
    dafira: 'Board evaluation questionnaires, with results kept alongside the board’s records.',
  },
];

const security = [
  'Hosted on Microsoft Azure infrastructure',
  'Encryption in transit and at rest',
  'Access by board, committee and role',
  'Multi-factor authentication',
  'Audit trail of access and decisions',
  'Data protection practices aligned with the GDPR',
];

const roles = [
  { icon: 'user', title: 'Chair and CEO', text: 'Keep the board informed between meetings.', href: '/for/ceo' },
  { icon: 'gavel', title: 'General counsel', text: 'Resolutions, signatures and the audit trail.', href: '/for/general-counsel' },
  { icon: 'clipboard', title: 'Board secretary', text: 'Invitations, board packs, minutes and the register.', href: '/for/board-secretary' },
  { icon: 'scale', title: 'Independent director', text: 'Information and private discussion for independent oversight.', href: '/for/independent-director' },
];
---

<Layout
  title="Board Governance in Saudi Arabia: CMA Regulations and Vision 2030 | Dafira"
  description="How a board portal supports the board process set out in the CMA Corporate Governance Regulations: meetings, invitations, minutes, signatures, a register of decisions and board evaluation."
>
  <main>
    <PageHero
      eyebrow="Saudi Arabia · Vision 2030"
      title="Board governance in Saudi Arabia"
      lead="The Capital Market Authority’s Corporate Governance Regulations set out how boards of listed companies meet, record their decisions and keep their records. Dafira supports that process: invitations, board packs, minutes, signatures and a register of decisions."
    >
      <Fragment slot="actions">
        <Button href="/request-demo">Book a demo</Button>
        <Button variant="secondary" href="/contact">Contact sales</Button>
      </Fragment>
      <Screenshot slot="aside" src="/onboarding-event-detail.png" alt="Dafira meeting page with the agenda, attendance and a vote on the minutes" eager />
    </PageHero>


    <Section space="md">
      <div class="grid lg:grid-cols-12 gap-10">
        <div class="lg:col-span-5">
          <SectionHeader layout="stacked" eyebrow="Context" title="Vision 2030 and the CMA framework" class="mb-0" />
        </div>
        <div class="lg:col-span-6 lg:col-start-7 space-y-4 text-gray-600 leading-relaxed">
          <p>Vision 2030 includes a Financial Sector Development Program that aims to develop a diversified and effective financial sector, including a developed capital market.</p>
          <p>For companies listed on the Saudi Exchange, board requirements are set by the Capital Market Authority in its Corporate Governance Regulations. They were issued in 2017 and amended in January 2023 following the new Companies Law. They are mandatory for companies listed on the Main Market, with some exceptions for guiding provisions, and largely guiding for the Parallel Market (Article 2).</p>
          <p>The Regulations also set the composition of the board: at least two independent directors, or one third of the board, whichever is greater (Article 16).</p>
          <div class="pt-2 flex flex-col sm:flex-row gap-x-8 gap-y-2">
            <Button variant="link" href={cgrUrl} target="_blank" rel="noopener noreferrer">CMA rules and regulations</Button>
            <Button variant="link" href="https://www.vision2030.gov.sa/en" target="_blank" rel="noopener noreferrer">Vision 2030 official site</Button>
          </div>
        </div>
      </div>
    </Section>

    <Section tone="surface" border="both">
      <SectionHeader
        eyebrow="CMA Corporate Governance Regulations"
        title="What the Regulations ask of the board process"
        lead="Selected provisions on meetings, minutes and records, summarised, with the part of Dafira that supports each one. The board and its secretary remain responsible for compliance."
      />
      <div class="border-t border-line">
        <div class="hidden lg:grid grid-cols-12 gap-8 py-4 border-b border-line font-mono text-xs uppercase tracking-[0.08em] text-gray-500">
          <div class="col-span-2">Article</div>
          <div class="col-span-5">Requirement (summary)</div>
          <div class="col-span-5">In Dafira</div>
        </div>
        {requirements.map((row) => (
          <div class="grid lg:grid-cols-12 gap-3 lg:gap-8 py-6 border-b border-line">
            <p class="lg:col-span-2 font-mono text-sm text-navy">{row.article}</p>
            <p class="lg:col-span-5 text-[15px] text-gray-700 leading-relaxed">{row.requirement}</p>
            <p class="lg:col-span-5 text-[15px] text-ink leading-relaxed">{row.dafira}</p>
          </div>
        ))}
      </div>
      <Callout class="mt-10 max-w-3xl">
        Summaries based on the English translation of the Corporate Governance Regulations published by the CMA (Board Resolution 8-16-2017, amended by Resolution 8-5-2023). Arabic is the official language of the Regulations, and the current version is on the CMA website. This page is for information and is not legal advice.
      </Callout>
    </Section>

    <Section>
      <div class="grid lg:grid-cols-12 gap-10">
        <div class="lg:col-span-5">
          <SectionHeader layout="stacked" eyebrow="Security" title="Confidential board information" lead="Board papers and minutes stay within the board." class="mb-8" />
          <Button variant="link" href="/security">Read about security</Button>
        </div>
        <div class="lg:col-span-6 lg:col-start-7">
          <FeatureList items={security} columns={2} />
          <p class="mt-8 text-gray-600 leading-relaxed">Hosting location and local data protection requirements, including the Personal Data Protection Law, are discussed with each organisation before deployment.</p>
        </div>
      </div>
    </Section>

    <Section tone="surface" border="top">
      <SectionHeader title="By role" lead="How each member of the board works with Dafira." />
      <CellGrid columns={4}>
        {roles.map((role) => (
          <a href={role.href} class="group bg-white p-6 lg:p-8 hover:bg-surface transition-colors flex flex-col">
            <Icon name={role.icon} class="w-6 h-6 text-navy" />
            <h3 class="mt-5 text-lg font-semibold text-navy">{role.title}</h3>
            <p class="mt-2 text-[15px] text-gray-600 leading-relaxed">{role.text}</p>
            <span class="mt-auto pt-6 text-[15px] font-medium text-primary group-hover:text-navy transition-colors">View role page</span>
          </a>
        ))}
      </CellGrid>
    </Section>

    <CTA />
  </main>
</Layout>
