---
import Layout from '../../layouts/Layout.astro';
import GuideHeader from '../../components/guides/GuideHeader.astro';
import GuideArticle from '../../components/guides/GuideArticle.astro';
import { Button, Icon } from '../../components/ui';
import GuideStep from '../../components/guides/GuideStep.astro';
import GuideSubSection from '../../components/guides/GuideSubSection.astro';
import GuideStepList from '../../components/guides/GuideStepList.astro';
import ProTip from '../../components/guides/ProTip.astro';

const networkRequirements = [
  "Allow HTTPS traffic (port 443) for all domains",
  "Allow WSS traffic (port 443) for api.dafira.ai",
  "Configure firewall rules to permit access",
  "Ensure DNS resolution for all domains",
  "Test connectivity to all required domains"
];

const troubleshootingSteps = [
  "Check your internet connection",
  "Verify firewall settings",
  "Clear browser cache and cookies",
  "Try a different browser",
  "Contact IT if issues persist"
];
---

<Layout title="Domains and Protocols Guide - Dafira">
  <main>
    <GuideHeader
        title="Understanding Dafira's Domains and Protocols"
        description="Complete guide to the domains and protocols used by Dafira, including network requirements and troubleshooting tips."
      />
    <GuideArticle>

      <GuideStep
        number={1}
        title="Core Domains Overview"
        description="Learn about the essential domains that power Dafira's functionality:"
      >
        <div class="space-y-6">

          <div class="border border-line rounded-md p-6">
            <div class="flex items-start gap-4">
              <Icon name="folder" class="w-5 h-5 text-navy mt-1" />
              <div>
                <h4 class="font-semibold text-navy mb-2">Storage Domain</h4>
                <p class="text-gray-600 mb-2">stgovrnprodfr001.blob.core.windows.net</p>
                <p class="text-sm text-gray-500">Secure storage for static files and documents</p>
              </div>
            </div>
          </div>

          <div class="border border-line rounded-md p-6">
            <div class="flex items-start gap-4">
              <Icon name="link" class="w-5 h-5 text-navy mt-1" />
              <div>
                <h4 class="font-semibold text-navy mb-2">API Domain</h4>
                <p class="text-gray-600 mb-2">prod.api.ongovrn.com</p>
                <p class="text-sm text-gray-500">Backend services and data processing</p>
              </div>
            </div>
          </div>

          <div class="border border-line rounded-md p-6">
            <div class="flex items-start gap-4">
              <Icon name="refresh" class="w-5 h-5 text-navy mt-1" />
              <div>
                <h4 class="font-semibold text-navy mb-2">WebSocket Domain</h4>
                <p class="text-gray-600 mb-2">api.dafira.ai</p>
                <p class="text-sm text-gray-500">Real-time updates and notifications</p>
              </div>
            </div>
          </div>

          <div class="border border-line rounded-md p-6">
            <div class="flex items-start gap-4">
              <Icon name="pen" class="w-5 h-5 text-navy mt-1" />
              <div>
                <h4 class="font-semibold text-navy mb-2">Signature Domain</h4>
                <p class="text-gray-600 mb-2">apps.universign.com</p>
                <p class="text-sm text-gray-500">E-signature services integration</p>
              </div>
            </div>
          </div>
        </div>

        <ProTip
          tip="Save these domains to your IT team's allowlist to ensure uninterrupted access to Dafira."
        />
      </GuideStep>

      <GuideStep
        number={2}
        title="Network Requirements"
        description="Ensure your network is properly configured to use Dafira:"
      >
        <div class="mb-8">
          <GuideStepList items={networkRequirements} />
        </div>

        <GuideSubSection title="Protocol Details">
          <div class="grid md:grid-cols-2 gap-4">
            <div class="border border-line rounded-md p-5">
              <h4 class="font-semibold text-navy mb-2">HTTPS (Port 443)</h4>
              <ul class="text-sm text-gray-600 space-y-1">
                <li>Secure web traffic</li>
                <li>Encrypted data transfer</li>
                <li>Required for all domains</li>
              </ul>
            </div>
            <div class="border border-line rounded-md p-5">
              <h4 class="font-semibold text-navy mb-2">WSS (Port 443)</h4>
              <ul class="text-sm text-gray-600 space-y-1">
                <li>Real-time communication</li>
                <li>Live updates</li>
                <li>Required for api.dafira.ai</li>
              </ul>
            </div>
          </div>
        </GuideSubSection>
      </GuideStep>

      <GuideStep
        number={3}
        title="Troubleshooting Connection Issues"
        description="If you experience connection problems, follow these steps:"
      >
        <div class="mb-8">
          <GuideStepList items={troubleshootingSteps} />
        </div>

        <ProTip
          tip="Use your browser's developer tools (F12) to check for any blocked requests or connection errors."
        />

        <GuideSubSection title="Common Issues">
          <div class="space-y-4">
            <div class="border border-line rounded-md p-5">
              <h4 class="font-semibold text-navy mb-2">Connection Timeout</h4>
              <p class="text-sm text-gray-600">Usually indicates a firewall issue or network restriction. Contact your IT team to verify domain access.</p>
            </div>
            <div class="border border-line rounded-md p-5">
              <h4 class="font-semibold text-navy mb-2">WebSocket Error</h4>
              <p class="text-sm text-gray-600">Check if your network allows WebSocket connections. Some corporate networks may block them.</p>
            </div>
            <div class="border border-line rounded-md p-5">
              <h4 class="font-semibold text-navy mb-2">SSL Certificate Error</h4>
              <p class="text-sm text-gray-600">Ensure your system's date and time are correct, and your browser is up to date.</p>
            </div>
          </div>
        </GuideSubSection>
      </GuideStep>

      <!-- Quick Reference -->
      <div class="mt-16 rounded-md p-8 border border-line bg-surface">
        <h2 class="text-2xl font-semibold text-navy mb-4">Quick Reference</h2>
        <div class="grid md:grid-cols-2 gap-6">
          <div>
            <h3 class="font-semibold text-navy mb-2">Required Domains</h3>
            <ul class="space-y-2 text-gray-600 text-sm">
              <li>stgovrnprodfr001.blob.core.windows.net</li>
              <li>prod.api.ongovrn.com</li>
              <li>api.dafira.ai</li>
              <li>apps.universign.com</li>
            </ul>
          </div>
          <div>
            <h3 class="font-semibold text-navy mb-2">Required Ports</h3>
            <ul class="space-y-2 text-gray-600 text-sm">
              <li>HTTPS: 443 (TCP)</li>
              <li>WSS: 443 (TCP)</li>
            </ul>
          </div>
        </div>
      </div>

      <!-- Help Section -->
      <div class="mt-8 rounded-md p-8 border border-line">
        <h2 class="text-2xl font-semibold text-navy mb-4">Need Help?</h2>
        <p class="text-gray-600 mb-6">
          Having trouble connecting to Dafira? Our technical support team is here to help.
        </p>
        <div class="flex flex-wrap gap-3 df-guide-actions">
          <Button href="/contact">Contact Support</Button>
          <Button href="/guides" variant="secondary">View All Guides</Button>
        </div>
      </div>
    </GuideArticle>
  </main>
</Layout>