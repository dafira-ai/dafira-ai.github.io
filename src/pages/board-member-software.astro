---
import Layout from "../layouts/Layout.astro";
import BoardMemberSoftware from "../components/campaigns/BoardMemberSoftware.astro";

const boardMemberFaqs = [
  {
    question: "Do I keep access to my documents if I leave a board?",
    answer: "Yes. Your Dafira One archive remains yours, even after your mandate ends."
  },
  {
    question: "Can Dafira One work with multiple boards at the same time?",
    answer: "Yes. Dafira One was designed to centralise documents across all your boards in one place."
  },
  {
    question: "How secure is Dafira One?",
    answer: "Dafira One is EU hosted, with enterprise-grade encryption and GDPR compliance. Your documents remain private and secured."
  },
  {
    question: "What makes Dafira One different from Dafira and other board management platforms?",
    answer: "Dafira and other board management platforms are built for the organisation. Dafira One is built for the individual board member: it is your personal board workspace."
  }
];

const productStructuredData = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "Dafira One",
  "applicationCategory": "BusinessApplication",
  "description": "Personal board member software, EU hosted & secured. Unlike Dafira which serves organizations, Dafira One is built for individual board members to centralize documents from all their boards, prepare with AI, and keep their archive forever.",
  "operatingSystem": "Web",
  "url": "https://dafira.ai/board-member-software",
  "offers": {
    "@type": "Offer",
    "url": "https://dafira.ai/request-demo",
    "availability": "https://schema.org/InStock"
  },
  "featureList": [
    "Personal board portal & document management",
    "AI-powered meeting preparation for individual board members",
    "Permanent document archive across multiple boards",
    "Board member profile insights",
    "EU-hosted with enterprise-grade security"
  ]
};
const combinedStructuredData = [productStructuredData];

const t = {
  hero: {
    eyebrow: 'Personal board member software',
    title: 'Board member software, built for you, not your board',
    lead: 'Dafira One is personal board member software, fully EU-hosted and secured. Dafira serves organisations and traditional board portals are built for companies; Dafira One gives you your own board portal to centralise documents, prepare with AI and keep your archive, across all your boards.',
    primary: 'Request early access',
    note: 'EU hosted · GDPR compliant · 256-bit encryption',
    imageAlt: 'Dafira One personal board member software interface',
  },
  compare: {
    eyebrow: 'New product',
    title: 'Dafira vs Dafira One',
    columns: [
      { name: 'Dafira', audience: 'For organisations', items: ['Board management for companies', 'Organisational document control', 'Data belongs to the company'] },
      { name: 'Dafira One', audience: 'For individual board members', items: ['Personal workspace across all boards', 'Your documents, your control', 'Lifetime archive, even after mandates'] },
    ],
  },
  integrations: {
    title: 'Connects to your board platforms',
    lead: 'Dafira One syncs with the platforms your boards already use and brings your documents into one personal workspace.',
    other: 'Other board portals',
    email: 'Email',
    more: 'More to come',
    note: 'Automatic synchronisation: set it up once and Dafira One keeps your documents up to date across all your board positions.',
  },
  portal: {
    title: 'Your personal board portal and document management',
    lead: 'Stop losing time in email threads. Dafira One collects your board documents, agendas and attachments from different boards and arranges them into a clear structure of meetings and events.',
    items: [
      { icon: 'document', title: 'Automatic document management', text: 'Dafira organises for companies; Dafira One organises for you personally, across all your boards.' },
      { icon: 'clock', title: 'A timeline of meetings and decisions', text: 'Follow how decisions evolve across all your board positions.' },
      { icon: 'lock', title: 'One private space, just for you', text: 'Your personal board workspace, independent from Dafira or any organisation.' },
    ],
  },
  ai: {
    title: 'Prepare for board meetings with AI',
    lead: 'No need to read hundreds of pages unaided. Dafira One’s AI reviews your documents, regulations and reports to surface what matters for your responsibilities as a board member.',
    items: [
      { icon: 'document', title: 'Summaries of lengthy documents', text: 'Focus on the points that matter for the next meeting.' },
      { icon: 'shield', title: 'Compliance and regulation highlights', text: 'Relevant regulatory requirements flagged in your documents.' },
      { icon: 'sparkle', title: 'AI insights to support your decisions', text: 'Context from your documents to inform your questions and decisions.' },
    ],
  },
  archive: {
    title: 'Keep your board archive, even after your mandate',
    lead: 'Your knowledge does not end when your mandate does. Dafira One keeps your documents and notes yours, so you build a personal board archive over time.',
    items: [
      { icon: 'key', title: 'Permanent access to your data', text: 'Your board documents remain accessible regardless of organisational changes.' },
      { icon: 'bank', title: 'A lifetime archive of your board work', text: 'Build a complete record of your governance experience.' },
      { icon: 'book', title: 'Your personal governance library', text: 'A knowledge base for future board positions.' },
    ],
  },
  conflicts: {
    title: 'Know your boards and spot conflicts of interest',
    lead: 'A board is about people as much as documents. Dafira One helps you understand your fellow board members and discreetly flags potential conflicts of interest.',
    card: {
      title: 'Your board network',
      meta: 'AI analysis',
      rows: [
        { label: 'M. Davis', text: 'Former CFO, RetailCorp', tone: 'ok' as const, status: 'No conflict' },
        { label: 'J. Smith', text: 'CEO, CompetitorCorp · direct competitor', tone: 'danger' as const, status: 'Competitor' },
        { label: 'R. Brown', text: 'Partner, VendorLaw LLC · provides legal services', tone: 'pending' as const, status: 'Relationship' },
      ],
      footer: 'Potential conflicts flagged before the meeting',
      caption: 'Illustration · fictional names',
    },
    items: [
      { icon: 'search', title: 'Automatic screening', text: 'AI reviews board member backgrounds, business relationships and cross-board positions to identify potential conflicts.' },
      { icon: 'bell', title: 'Alerts and recommendations', text: 'Alerts about potential conflicts, with recommendations for recusal on agenda items.' },
      { icon: 'users', title: 'Across all your boards', text: 'Use what you know from all your board positions to keep governance standards high.' },
    ],
  },
  security: {
    title: 'Secured. EU hosted. Always yours.',
    lead: 'Your data stays in Europe. Dafira One is fully EU-hosted and GDPR compliant.',
    items: [
      { icon: 'lock', title: 'Enterprise-grade encryption', text: 'Your documents are encrypted in transit and at rest.' },
      { icon: 'globe', title: 'Data stored in the EU', text: 'European data hosting and GDPR compliance.' },
      { icon: 'shield', title: 'Privacy-first architecture', text: 'Designed from the start with privacy and security in mind.' },
    ],
  },
  form: {
    eyebrow: 'Early access',
    title: 'Get early access to Dafira One',
    lead: 'Register your interest and we will contact you when early access opens.',
    benefits: ['Free early access', 'EU hosted and secured', 'AI-assisted preparation'],
    heading: 'Request early access',
    subheading: 'Takes less than two minutes. No spam; unsubscribe at any time.',
    firstName: 'First name',
    lastName: 'Last name',
    email: 'Professional email',
    emailPlaceholder: 'your.email@company.com',
    boardCount: 'How many boards do you currently serve on?',
    boardOptions: [
      { value: '', label: 'Select number of boards' },
      { value: '1', label: '1 board' },
      { value: '2', label: '2 boards' },
      { value: '3', label: '3 boards' },
      { value: '4', label: '4 boards' },
      { value: '5+', label: '5 or more boards' },
    ],
    trust: ['GDPR compliant', '256-bit encryption', 'EU data centres'],
    submit: 'Request free early access',
    privacyBefore: 'By signing up, you agree to our ',
    privacyLink: 'privacy policy',
    privacyAfter: '. No spam; unsubscribe at any time.',
    successTitle: 'Thank you, you are on the list',
    successText: 'You are registered for early access to Dafira One.',
    nextTitle: 'What happens next',
    next: ['Updates on our development progress', 'A notification when early access opens'],
  },
  faq: {
    title: 'Frequently asked questions',
    subtitle: 'About Dafira One, personal board member software',
    inLanguage: 'en',
    faqs: boardMemberFaqs,
  },
};
---

<Layout
  title="Dafira One — Secured EU Hosted Board Member Software"
  description="Personal board member software, EU hosted & secured. Centralise documents from all your boards, prepare with AI, and keep your archive after your mandate."
  structuredData={combinedStructuredData}
>
  <main>
    <BoardMemberSoftware t={t} formAnchor="board-member-software-form" privacyHref="/privacy" />
  </main>
</Layout>
