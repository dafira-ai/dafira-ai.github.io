---
import Layout from '../layouts/Layout.astro';
import SecurityOverview from '../components/security/SecurityOverview.astro';

const copy = {
  eyebrow: 'Security',
  title: 'How Dafira protects board information',
  lead: 'The security measures built into the platform, and the partners we rely on for hosting, electronic signature and document processing.',
  heroLink: { text: 'Multi-factor authentication', href: '/security/mfa' },
  measures: {
    eyebrow: 'Measures',
    title: 'Security built into the platform',
    lead: 'Controls that protect board documents, discussions and decisions.',
    items: [
      { icon: 'building', title: 'Hosted on Microsoft Azure', text: 'Dafira runs on Microsoft Azure’s cloud platform and benefits from its security measures.' },
      { icon: 'shield', title: 'Data protection', text: 'Data protection practices aligned with GDPR requirements and industry standards.' },
      { icon: 'lock', title: 'Encryption', text: 'Data is encrypted in transit and at rest.' },
      { icon: 'phone', title: 'Multi-factor authentication', text: 'A one-time code sent by SMS adds a second step to the password before a user can open board information.', link: { text: 'How it works', href: '/security/mfa' } },
      { icon: 'key', title: 'Role-based access control', text: 'Access is managed by role, with an audit trail of activity.' },
    ],
    contact: { title: 'Questions from your IT or risk team', text: 'Write to us and we will answer your questions about how Dafira handles security.', link: { text: 'Contact us', href: '/contact' } },
  },
  layers: {
    eyebrow: 'Defence in depth',
    title: 'Three layers of protection',
    lead: 'Security is applied at the infrastructure, application and data levels.',
    items: [
      { icon: 'building', title: 'Infrastructure security', text: 'Microsoft Azure’s cloud infrastructure.', items: ['High-availability data centres', 'Network security controls', 'DDoS protection', 'Regular security updates'] },
      { icon: 'lock', title: 'Application security', text: 'Controls at the application level.', items: ['Multi-factor authentication (MFA)', 'Session management', 'Input validation', 'Security headers'] },
      { icon: 'shield', title: 'Data protection', text: 'Measures that protect stored data.', items: ['Encryption in transit and at rest', 'Secure data storage', 'Regular backups', 'Data access controls'] },
    ],
  },
  partners: {
    eyebrow: 'Partners',
    title: 'Who we work with',
    lead: 'Specialist providers for hosting, electronic signature and document processing.',
    items: [
      { name: 'Microsoft Azure', logo: '/azure-logo.png', role: 'Infrastructure', text: 'Our infrastructure provider. Microsoft Azure holds certifications including ISO 27001, FedRAMP, SOC and HIPAA.', items: ['Global data centre network', 'Threat protection', 'Continuous security monitoring', 'Compliance frameworks'] },
      { name: 'Universign', logo: '/universign-logo.png', role: 'Electronic signature', text: 'Our electronic signature partner, compliant with the eIDAS regulation.', items: ['Qualified electronic signatures', 'Legal compliance', 'Secure document handling', 'Audit trails'] },
      { name: 'Apryse', logo: '/apryse-logo.png', role: 'Document processing', text: 'Our document processing partner, with multiple compliance certifications.', items: ['Secure document processing', 'Access control', 'Encryption', 'Compliance features'] },
    ],
  },
};
---

<Layout title="Security - Dafira Board Management Software" description="How Dafira protects board information: Microsoft Azure hosting, encryption, SMS multi-factor authentication, role-based access and audit trails, with Universign and Apryse as partners.">
  <SecurityOverview copy={copy} />
</Layout>
