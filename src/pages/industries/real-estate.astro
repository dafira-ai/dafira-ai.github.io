---
import Layout from '../../layouts/Layout.astro';
import IndustryLanding from '../../components/industries/IndustryLanding.astro';

const hero = {
  eyebrow: 'Real estate',
  title: 'Board management software for real estate',
  lead: 'For boards of property investment and management companies. Investment files, board discussions and decisions kept together, for every asset.',
};

const challenges = {
  title: 'What real estate boards deal with',
  lead: 'Long-term commitments that need a clear decision trail.',
  items: [
    { icon: 'building', title: 'Portfolio oversight', text: 'Follow a portfolio of assets through regular board papers and reports.' },
    { icon: 'trend', title: 'Investment decisions', text: 'Review acquisition, disposal and development files before deciding.' },
    { icon: 'users', title: 'Investors and partners', text: 'Share information with each stakeholder group at the right level of access.' },
  ],
};

const features = {
  title: 'What Dafira provides',
  lead: 'Board tools used by real estate companies.',
  items: [
    { icon: 'folder', title: 'Document management', text: 'Central storage for investment files and board papers, organised by meeting and agenda item.' },
    { icon: 'sparkle', title: 'AI assistant', text: 'Ask questions about long investment files and get summaries before the meeting.' },
    { icon: 'vote', title: 'Decisions on record', text: 'Votes, resolutions and signatures kept with each meeting, in a decision log.' },
  ],
};
---

<Layout title="Real Estate Board Management Software | Dafira" description="Board portal for property investment and management companies: investment files, board meetings and a clear record of decisions.">
  <main>
    <IndustryLanding
      industry="real-estate"
      hero={hero}
      screenshot={{ src: '/onboarding-boardpack.png', alt: 'Dafira board pack organised by agenda item, with annotations' }}
      challenges={challenges}
      features={features}
      quoteKey="nathalie"
      secondary="trial"
    />
  </main>
</Layout>
