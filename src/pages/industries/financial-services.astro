---
import Layout from '../../layouts/Layout.astro';
import IndustryLanding from '../../components/industries/IndustryLanding.astro';

const hero = {
  eyebrow: 'Financial services',
  title: 'Board management software for financial services',
  lead: 'Secure, documented board work for banks, insurers and investment firms. Board and committee papers, decisions and signatures in one place, with access set by role.',
};

const challenges = {
  title: 'What financial services boards deal with',
  lead: 'Regulation shapes the agenda, and supervisors expect a clear record.',
  items: [
    { icon: 'scale', title: 'Regulatory requirements', text: 'Texts such as DORA, CSRD and the GDPR put specific responsibilities on the board.' },
    { icon: 'shield', title: 'Risk oversight', text: 'Risk and audit committees need complete, current information before each meeting.' },
    { icon: 'leaf', title: 'Sustainability reporting', text: 'The board oversees the sustainability statement and how it is prepared.' },
    { icon: 'lock', title: 'Confidential information', text: 'Board papers must reach only the intended people, through a secure channel.' },
  ],
};

const features = {
  title: 'What Dafira provides',
  lead: 'Board tools used by financial institutions.',
  items: [
    { icon: 'shield', title: 'Compliance monitoring', text: 'Follow the regulatory topics that concern the board, with the related documents.' },
    { icon: 'sparkle', title: 'AI assistant', text: 'Ask questions about long board papers and get summaries before the meeting.' },
    { icon: 'folder', title: 'Secure document management', text: 'Encrypted storage and sharing of board and committee papers, with access by role.' },
    { icon: 'clipboard', title: 'Audit trail', text: 'A record of access to documents and of the decisions taken.' },
  ],
};
---

<Layout title="Financial Services Board Management Software | Dafira" description="Board portal for banks, insurers and investment firms: board and committee papers, decisions and signatures in one secure place, with the regulatory context in view.">
  <main>
    <IndustryLanding
      industry="financial-services"
      hero={hero}
      screenshot={{ src: '/onboarding-document-list.png', alt: 'Dafira document library, with board papers grouped by meeting' }}
      challenges={challenges}
      features={features}
      quoteKey="pierre"
      secondary="trial"
    />
  </main>
</Layout>
