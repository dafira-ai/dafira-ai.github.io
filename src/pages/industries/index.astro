---
import Layout from '../../layouts/Layout.astro';
import { PageHero, Section, Icon, CellGrid, FeatureList, CTA } from '../../components/ui';

const industries = [
  {
    name: 'Financial services',
    icon: 'bank',
    description: 'Secure, documented board work for banks, insurers and investment firms.',
    link: '/industries/financial-services',
    features: ['Regulatory context for the board', 'Secure document management', 'Board and committee meetings'],
  },
  {
    name: 'Healthcare',
    icon: 'health',
    description: 'Board management for hospitals, care providers and life sciences companies.',
    link: '/industries/healthcare',
    features: ['Confidential board papers', 'Clinical governance on the agenda', 'Committees'],
  },
  {
    name: 'Real estate',
    icon: 'building',
    description: 'Board management for property investment and management companies.',
    link: '/industries/real-estate',
    features: ['Investment files', 'Portfolio oversight', 'Decision log'],
  },
  {
    name: 'Family business',
    icon: 'family',
    description: 'Board and family council management for multi-entity family businesses.',
    link: '/industries/family-business',
    features: ['Several governance bodies', 'Access by role', 'Continuity across generations'],
  },
];
---

<Layout title="Industry Solutions | Dafira Board Management Software" description="Dafira by sector: board management for financial services, healthcare, real estate and family businesses.">
  <main>
    <PageHero eyebrow="Industries" title="Board management by sector" lead="The board cycle is the same everywhere; the context is not. See how Dafira supports boards in regulated and family-owned organisations." />

    <Section>
      <CellGrid columns={2}>
        {industries.map((industry) => (
          <a href={industry.link} class="group bg-white p-8 lg:p-10 hover:bg-surface transition-colors flex flex-col">
            <Icon name={industry.icon} class="w-6 h-6 text-navy" />
            <h2 class="mt-5 text-xl font-semibold text-navy">{industry.name}</h2>
            <p class="mt-3 text-gray-600 leading-relaxed">{industry.description}</p>
            <FeatureList items={industry.features} class="mt-6" />
            <span class="mt-auto pt-8 inline-flex items-center gap-2 text-[15px] font-medium text-primary group-hover:text-navy transition-colors">
              View sector page
              <svg class="w-4 h-4 rtl-flip" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M9 5l7 7-7 7" />
              </svg>
            </span>
          </a>
        ))}
      </CellGrid>
    </Section>

    <CTA />
  </main>
</Layout>
