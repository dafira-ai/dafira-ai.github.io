---
import Layout from '../../layouts/Layout.astro';
import IndustryLanding from '../../components/industries/IndustryLanding.astro';

const hero = {
  eyebrow: 'Healthcare',
  title: 'Board management software for healthcare organisations',
  lead: 'For boards of hospitals, care providers and life sciences companies. Prepare quality, safety and financial discussions, and keep confidential papers under control.',
};

const challenges = {
  title: 'What healthcare boards deal with',
  lead: 'Clinical, financial and regulatory matters at the same table.',
  items: [
    { icon: 'lock', title: 'Sensitive information', text: 'Board papers can contain health data, which the GDPR treats as a special category.' },
    { icon: 'health', title: 'Clinical governance', text: 'Quality and safety come back at every meeting and need a consistent record.' },
    { icon: 'users', title: 'Many stakeholders', text: 'Board members, medical staff and management each need the right level of access.' },
  ],
};

const features = {
  title: 'What Dafira provides',
  lead: 'Board tools used by healthcare organisations.',
  items: [
    { icon: 'shield', title: 'Protected board papers', text: 'Role-based access, encryption and an audit trail, with data protection practices aligned with the GDPR.' },
    { icon: 'layers', title: 'Committees', text: 'Separate spaces for quality, audit and other committees, each with its own members.' },
    { icon: 'clipboard', title: 'Recurring agenda items', text: 'Agenda templates for standing items such as quality and safety reports.' },
  ],
};
---

<Layout title="Healthcare Board Management Software | Dafira" description="Board portal for hospitals and care organisations: confidential board papers under access control, committee meetings and documented decisions.">
  <main>
    <IndustryLanding
      industry="healthcare"
      hero={hero}
      screenshot={{ src: '/onboarding-event-detail.png', alt: 'Dafira meeting page with the agenda, attendance and a vote' }}
      challenges={challenges}
      features={features}
      secondary="trial"
    />
  </main>
</Layout>
