---
import Layout from '../../layouts/Layout.astro';
import FamilyBusinessLanding, { type FamilyBusinessContent } from '../../components/industries/FamilyBusinessLanding.astro';

const content: FamilyBusinessContent = {
  hero: {
    eyebrow: 'Family business',
    title: 'Family business governance software',
    lead: 'Board and family council management for multi-entity family businesses.',
    screenshotAlt: 'Dafira document library, with board papers grouped by meeting',
  },
  intro: {
    title: 'Governance grows with the family and the group',
    paragraphs: [
      'Family businesses often operate across multiple entities, generations and governance bodies. As structures grow, governance becomes harder to manage with email, shared drives and informal processes.',
      'Dafira is a board and governance management platform that supports family businesses with clear structure, secure collaboration and documented decision-making, without adding unnecessary complexity.',
    ],
  },
  challenges: {
    title: 'Governance challenges in family businesses',
    lead: 'Family businesses face governance challenges that differ from those of other companies.',
    items: [
      { icon: 'building', title: 'Multiple boards across holding and operating companies', text: 'Manage governance across group structures.' },
      { icon: 'users', title: 'Family councils alongside formal boards', text: 'Coordinate several governance bodies in one platform.' },
      { icon: 'lock', title: 'Overlapping roles and sensitive information', text: 'Control access with strict permissions and audit trails.' },
    ],
    consequencesIntro: 'Without a structured governance system, this often leads to:',
    consequences: ['Limited visibility and traceability', 'Knowledge loss between generations', 'Inconsistent documentation', 'Increased legal and operational risk'],
  },
  bodies: {
    title: 'One platform for all family governance bodies',
    lead: 'Dafira brings family business governance together in a single, secure environment.',
    intro: 'You can manage:',
    items: ['Boards of directors (holding and subsidiaries)', 'Family councils', 'Advisory boards', 'Investment, audit or remuneration committees'],
    outro: [
      'Each governance body operates independently, with its own members and roles, agendas and meeting schedules, documents and board packs, and access and permission settings.',
      'This allows family businesses to extend governance without fragmentation.',
    ],
    features: [
      { icon: 'layers', title: 'Multi-entity governance', text: 'Manage boards, family councils and committees independently, each with its own members, agendas and permissions.' },
      { icon: 'lock', title: 'Secure access control', text: 'Role-based permissions, document-level security and full audit trails for confidential family governance.' },
      { icon: 'document', title: 'Structured decision-making', text: 'AI-drafted minutes, action tracking and a searchable governance history for long-term continuity.' },
    ],
  },
  access: {
    title: 'Secure access for family members and external directors',
    lead: 'Family businesses often combine family stakeholders with independent board members and advisers.',
    intro: 'Dafira provides:',
    items: ['Role-based access per board or committee', 'Document-level permissions', 'Full audit trails and version history', 'Secure collaboration without shared drives or email attachments'],
    outro: 'This keeps information confidential while maintaining transparency where required.',
  },
  meetings: {
    title: 'Structured meetings and documented decisions',
    lead: 'Dafira helps family businesses professionalise board operations while remaining practical and lightweight.',
    intro: 'Key capabilities include:',
    items: ['Central agendas and board packs', 'Decision and action tracking', 'Secure storage of historical governance records', 'AI-drafted meeting minutes to reduce administrative effort'],
    outro: 'All governance activity is documented, searchable and accessible to authorised users.',
  },
  continuity: {
    title: 'Supporting continuity across generations',
    lead: 'As family businesses pass from one generation to the next, continuity becomes critical.',
    items: [
      { icon: 'refresh', title: 'Generational continuity', text: 'Preserve governance history and reduce reliance on informal knowledge.' },
      { icon: 'checkCircle', title: 'Professional operations', text: 'Central agendas, board packs and documented decisions, without complexity.' },
      { icon: 'family', title: 'Built for family business', text: 'Support for group structures, several boards and long-term governance.' },
    ],
    intro: 'Dafira supports this by:',
    list: ['Preserving governance history and decisions over time', 'Clarifying roles and responsibilities', 'Reducing reliance on informal knowledge holders', 'Providing a consistent governance framework across entities'],
    outro: 'This makes governance more resilient, whatever the changes in leadership.',
  },
  why: {
    title: 'Built for multi-entity family business structures',
    lead: 'Unlike generic collaboration tools, Dafira is built for governance.',
    intro: 'Family businesses choose Dafira because it supports:',
    items: ['Group structures', 'Multiple boards within one organisation', 'Long-term governance continuity', 'Secure board operations'],
    outro: 'Dafira adapts to existing governance structures rather than imposing a predefined model.',
  },
  users: {
    title: 'Who uses Dafira in family businesses?',
    intro: 'Dafira is used by:',
    items: ['Family shareholders', 'Chairs and board members', 'Family council members', 'CEOs and executive teams', 'External directors and advisers', 'Corporate and board secretaries'],
    outro: 'Each user sees only what is relevant to their role.',
  },
  cta: {
    title: 'Family business governance, made practical',
    subtitle: 'Dafira helps family businesses manage governance with clarity, structure and security, without turning governance into a consulting project.',
  },
};
---

<Layout title="Family Business Governance Software | Dafira" description="Board and family council management for multi-entity family businesses. Structured governance without complexity.">
  <main>
    <FamilyBusinessLanding content={content} />
  </main>
</Layout>
