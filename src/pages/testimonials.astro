---
import Layout from '../layouts/Layout.astro';
import { PageHero, Section } from '../components/ui';
import CustomerQuotes from '../components/case-studies/CustomerQuotes.astro';
import LocalizedCTA from '../components/case-studies/LocalizedCTA.astro';

const testimonials = [
  {
    industry: "Non-profit support organisation",
    title: "Board governance with Dafira",
    quote: "I'm convinced that a platform like Dafira enables better decision-making at the board level.",
    author: "President",
    href: "/case-studies/non-profit-organisation",
  },
  {
    industry: "Listed fashion group",
    title: "Board governance in one secure place",
    quote: "Dafira has transformed how we manage our board operations, bringing efficiency and clarity to our governance processes.",
    author: "General Counsel",
    href: "/case-studies/listed-fashion-group",
  },
  {
    industry: "Regional public investment fund",
    title: "One governance platform for public and private board members",
    quote: "Dafira has been instrumental in modernizing our governance structure and improving operational efficiency.",
    author: "CEO",
    href: "/case-studies/public-investment-fund",
  },
  {
    industry: "Listed healthcare real estate company",
    title: "A board portal that fits its templates, attendance rules and languages",
    quote: "Dafira embraced the next generation of Board management software, easy to use and with AI integration.",
    author: "Paralegal & Compliance Officer",
    href: "/case-studies/healthcare-real-estate",
  },
];
---

<Layout
  title="Customer Success Stories - Dafira"
  description="How a listed fashion group, a regional public investment fund, a listed healthcare real estate company and a non-profit support organisation run their board with Dafira."
>
  <PageHero
    eyebrow="Customer stories"
    title="How boards work with Dafira"
    lead="Chairs, general counsels, compliance officers and CEOs describe, in their own words, how they run their board with Dafira."
  />

  <Section space="lg">
    <CustomerQuotes items={testimonials} linkText="Read the case study" />
  </Section>

  <LocalizedCTA />
</Layout>
