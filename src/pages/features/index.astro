---
import Layout from '../../layouts/Layout.astro';
import FeatureSection from '../../components/features/FeatureSection.astro';
import FeatureCTA from '../../components/features/FeatureCTA.astro';
import { PageHero, Button, Screenshot } from '../../components/ui';

const meetingFeatures = {
  title: "Prepare and run the meeting",
  subtitle: "Meetings",
  description: "Build the agenda, share the board pack and take the minutes without leaving the platform.",
  image: "/applications-picture-meeting.png",
  imageAlt: "Meeting page in Dafira",
  features: [
    {
      title: "AI agenda builder",
      description: "Start from a template, set a duration and a type for each item and attach the documents. Suggestions come from previous meetings.",
      icon: "list",
      link: "/features/ai-powered-agenda-builder"
    },
    {
      title: "Document collaboration",
      description: "Directors annotate the board pack privately and comment together on shared documents, always on the latest version.",
      icon: "pen",
      link: "/features/document-collaboration"
    },
    {
      title: "Secure board communication",
      description: "Private messages, a board news feed and file sharing, kept inside the platform rather than in email or messaging apps.",
      icon: "lock",
      link: "/features/secure-communication"
    },
    {
      title: "AI minute builder",
      description: "A structured draft of the minutes, prepared from the meeting recording and aligned with the agenda, in the language of the meeting.",
      icon: "mic",
      link: "/features/ai-minute-builder"
    },
  ]
};

const insightFeatures = {
  title: "Find what the board already knows",
  subtitle: "Information",
  description: "Board documents are filed by meeting and can be searched and questioned. Every answer points to its source.",
  image: "/applications-picture-board-chat-mobile.png",
  imageAlt: "Dafira on mobile",
  features: [
    {
      title: "AI assistant",
      description: "Ask a question about the board pack or past minutes and get an answer that cites the document and section it comes from.",
      icon: "search",
      link: "/features/ai-assistant"
    },
    {
      title: "Document library",
      description: "Board materials are organised by meeting and by type, with search across the whole library.",
      icon: "folder"
    },
    {
      title: "Compliance monitoring",
      description: "Follow regulatory requirements such as CSRD and see which board documents address them.",
      icon: "scale",
      link: "/features/ai-board-compliance-monitoring"
    }
  ]
};

const governanceFeatures = {
  title: "Decide, sign and follow up",
  subtitle: "Governance",
  description: "Record votes and resolutions, collect signatures and follow the actions agreed in the meeting.",
  image: "/applications-picture-board-evaluation.png",
  imageAlt: "Board evaluation in Dafira",
  features: [
    {
      title: "Tasks and action items",
      description: "Assign the actions agreed in the meeting and follow them until they are closed.",
      icon: "tasks"
    },
    {
      title: "Votes and electronic signatures",
      description: "Directors vote on resolutions and sign documents electronically, with signatures handled by our eIDAS-compliant partner Universign.",
      icon: "signature"
    },
    {
      title: "Role-based access control",
      description: "Access to meetings, documents and conversations is set by board, committee and role.",
      icon: "users"
    },
    {
      title: "Board evaluation",
      description: "Run the board evaluation in the platform and compare the answers of each director.",
      icon: "chart"
    }
  ]
};
---

<Layout title="Features - Dafira Board Management Software" description="Dafira's board management features: agenda builder, board pack and annotations, AI assistant, AI minute builder, secure communication, votes and electronic signatures." image="/features.png">
  <main>
    <PageHero
      eyebrow="Features"
      title="Every step of the board cycle, in one place"
      lead="Dafira covers the preparation of the meeting, the meeting itself and the follow-up: agenda, board pack, votes, minutes and signatures. Directors work in one secure workspace, on any device."
    >
      <Fragment slot="actions">
        <Button href="/request-demo">Book a demo</Button>
        <Button variant="secondary" href="/pricing">View pricing</Button>
      </Fragment>
      <Screenshot slot="aside" src="/onboarding-event-detail.png" alt="Meeting page in Dafira with the agenda, attendance and an open vote" eager />
    </PageHero>

    <FeatureSection {...meetingFeatures} demoType="meeting" id="meetings" />
    <FeatureSection {...insightFeatures} demoType="insights" reversed={true} tone="surface" id="information" />
    <FeatureSection {...governanceFeatures} demoType="governance" id="governance" />

    <FeatureCTA />
  </main>
</Layout>
