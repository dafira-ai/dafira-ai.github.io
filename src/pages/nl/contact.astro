---
import Layout from '../../layouts/Layout.astro';
import ContactForm from '../../components/forms/ContactForm.astro';
import { PageHero, Section, Icon } from '../../components/ui';

const office = {
  city: "Brussel",
  country: "België",
  image: "/bxl.jpg",
  address: "Gasthuisstraat 31",
  postalCode: "1000",
  email: "info@dafira.ai",
};

const contactFormProps = {
  reasons: [
    "Demo aanvragen",
    "Commerciële vraag",
    "Technische ondersteuning",
    "Partnerschapsvoorstel",
    "Andere vraag"
  ],
  labels: {
    firstName: "Voornaam",
    lastName: "Achternaam",
    email: "E-mail",
    company: "Bedrijf",
    reason: "Reden van contact",
    message: "Bericht",
    submit: "Versturen"
  },
  placeholders: {
    reason: "Kies een reden"
  },
  success: {
    title: "Bericht verzonden",
    message: "Bedankt voor uw bericht. We nemen snel contact met u op."
  }
};
---

<Layout title="Neem contact op - Dafira Bestuurssoftware" description="Vragen over Dafira? Ons team in Brussel beantwoordt vragen over demo's, prijzen, ondersteuning en partnerschappen.">
  <main>
    <PageHero eyebrow="Contact" title="Neem contact op met ons team" lead="Vragen over Dafira? Ons team helpt u graag met een demo, prijzen, technische ondersteuning of een partnerschap." />

    <Section space="md">
      <div class="grid lg:grid-cols-12 gap-12 lg:gap-10">
        <!-- Contact form -->
        <div class="lg:col-span-7">
          <div class="border border-line rounded-md bg-white p-6 lg:p-8">
            <h2 class="text-2xl font-semibold text-navy mb-8">Stuur ons een bericht</h2>
            <ContactForm {...contactFormProps} />
          </div>
        </div>

        <!-- Contact information -->
        <div class="lg:col-span-4 lg:col-start-9 space-y-12">
          <div>
            <h2 class="font-mono text-xs uppercase tracking-[0.08em] text-gray-500">Ons kantoor</h2>
            <figure class="mt-4 border border-line rounded-md overflow-hidden">
              <img loading="lazy" src={office.image} alt="Kantoor in Brussel" class="w-full h-44 object-cover" />
            </figure>
            <p class="mt-5 text-xl font-semibold text-navy">{office.city}</p>
            <address class="mt-3 not-italic space-y-3 text-gray-700">
              <p class="flex items-start gap-3">
                <Icon name="building" class="w-5 h-5 text-navy mt-0.5" />
                <span>{office.address}<br />{office.postalCode} {office.city}, {office.country}</span>
              </p>
              <p class="flex items-start gap-3">
                <Icon name="mail" class="w-5 h-5 text-navy mt-0.5" />
                <a href={`mailto:${office.email}`} class="text-primary hover:text-navy transition-colors" dir="ltr">{office.email}</a>
              </p>
            </address>
          </div>

          <div class="border-t border-line pt-8">
            <h2 class="font-mono text-xs uppercase tracking-[0.08em] text-gray-500">Volg ons</h2>
            <a href="https://www.linkedin.com/company/govrncorp" class="mt-4 inline-flex items-center gap-2 text-gray-700 hover:text-navy transition-colors" rel="noopener" target="_blank">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
              </svg>
              LinkedIn
            </a>
          </div>
        </div>
      </div>
    </Section>
  </main>
</Layout>
