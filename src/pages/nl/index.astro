<Layout
  title="Dafira | ضفيرة · Het portaal voor raden van bestuur"
  description="Dafira is het portaal voor raden van bestuur: agenda, bestuursdossier, stemmingen, elektronische handtekening en notulen in één beveiligde, AVG-conforme omgeving."
  structuredData={structuredData}
>
  <main class="overflow-hidden">
    <Hero {...hero} />
    <!-- <WhyWeBuildVideo {...whyWeBuildVideoProps} /> — thumbnail still shows the old brand -->
    <Features {...featuresProps} />
    <FeatureShowcase {...featureShowcaseProps} />
    <Timeline {...timelineProps} />
    <SecurityPreview {...securityPreviewProps} />
    <Personas {...personasProps} />
    <Testimonials {...testimonialsProps} />
    <FAQ {...faqProps} />
    <CTA {...ctaProps} />
  </main>
</Layout>

<style>
  main {
    width: 100%;
  }
</style>
