---
import Layout from "../../layouts/Layout.astro";
import BoardMemberSoftware from "../../components/campaigns/BoardMemberSoftware.astro";

const boardMemberFaqs = [
  {
    question: "Behoud ik toegang tot mijn documenten als ik een bestuur verlaat?",
    answer: "Ja. Uw Dafira One-archief blijft van u, ook na het einde van uw mandaat."
  },
  {
    question: "Kan Dafira One werken met meerdere besturen tegelijkertijd?",
    answer: "Ja. Dafira One is ontworpen om documenten van al uw besturen op één plek te centraliseren."
  },
  {
    question: "Hoe veilig is Dafira One?",
    answer: "Dafira One is EU-gehost, met versleuteling op ondernemingsniveau en AVG-conformiteit. Uw documenten blijven privé en beveiligd."
  },
  {
    question: "Wat maakt Dafira One anders dan Dafira en andere bestuursmanagementplatforms?",
    answer: "Dafira en andere bestuursmanagementplatforms zijn gebouwd voor de organisatie. Dafira One is gebouwd voor het individuele bestuurslid: het is uw persoonlijke bestuurswerkruimte."
  }
];

const productStructuredData = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "Dafira One",
  "applicationCategory": "BusinessApplication",
  "description": "Persoonlijke bestuurslid software, EU gehost & beveiligd. In tegenstelling tot Dafira dat organisaties dient, is Dafira One gebouwd voor individuele bestuursleden om documenten van al hun besturen te centraliseren, voorbereiden met AI, en hun archief voor altijd te bewaren.",
  "operatingSystem": "Web",
  "url": "https://dafira.ai/nl/bestuurssoftware",
  "offers": {
    "@type": "Offer",
    "url": "https://dafira.ai/nl/request-demo",
    "availability": "https://schema.org/InStock"
  },
  "featureList": [
    "Persoonlijke bestuursportaal & documentbeheer",
    "AI-gedreven vergadervoorbereiding voor individuele bestuursleden",
    "Permanent documentarchief over meerdere besturen",
    "Bestuurslid profiel inzichten",
    "EU-gehost met enterprise-grade beveiliging"
  ]
};
const combinedStructuredData = productStructuredData;

const t = {
  hero: {
    eyebrow: 'Persoonlijke bestuurssoftware',
    title: 'Bestuurssoftware, gebouwd voor u, niet voor uw bestuur',
    lead: 'Dafira One is persoonlijke bestuurssoftware, volledig EU-gehost en beveiligd. Dafira bedient organisaties en klassieke bestuursportalen zijn gebouwd voor bedrijven; Dafira One geeft u uw eigen bestuursportaal om documenten te centraliseren, u met AI voor te bereiden en uw archief te bewaren, over al uw mandaten heen.',
    primary: 'Vraag vroege toegang aan',
    note: 'EU-gehost · AVG-conform · 256-bit versleuteling',
    imageAlt: 'Interface van Dafira One, persoonlijke bestuurssoftware',
  },
  compare: {
    eyebrow: 'Nieuw product',
    title: 'Dafira vs Dafira One',
    columns: [
      { name: 'Dafira', audience: 'Voor organisaties', items: ['Bestuursbeheer voor bedrijven', 'Documentbeheer door de organisatie', 'Gegevens behoren toe aan het bedrijf'] },
      { name: 'Dafira One', audience: 'Voor individuele bestuursleden', items: ['Persoonlijke werkruimte voor al uw besturen', 'Uw documenten, uw controle', 'Levenslang archief, ook na uw mandaten'] },
    ],
  },
  integrations: {
    title: 'Verbindt met uw bestuursplatformen',
    lead: 'Dafira One synchroniseert met de platformen die uw besturen al gebruiken en brengt uw documenten samen in één persoonlijke werkruimte.',
    other: 'Andere bestuursportalen',
    email: 'E-mail',
    more: 'Meer volgt',
    note: 'Automatische synchronisatie: stel het één keer in en Dafira One houdt uw documenten actueel voor al uw bestuursfuncties.',
  },
  portal: {
    title: 'Uw persoonlijk bestuursportaal en documentbeheer',
    lead: 'Geen tijd meer verliezen in e-mailthreads. Dafira One verzamelt uw bestuursdocumenten, agenda’s en bijlagen van verschillende besturen en ordent ze in vergaderingen en gebeurtenissen.',
    items: [
      { icon: 'document', title: 'Automatisch documentbeheer', text: 'Dafira organiseert voor bedrijven; Dafira One organiseert voor u persoonlijk, over al uw besturen heen.' },
      { icon: 'clock', title: 'Een tijdlijn van vergaderingen en besluiten', text: 'Volg hoe besluiten evolueren in al uw bestuursfuncties.' },
      { icon: 'lock', title: 'Eén privéruimte, alleen voor u', text: 'Uw persoonlijke bestuurswerkruimte, onafhankelijk van Dafira of welke organisatie ook.' },
    ],
  },
  ai: {
    title: 'Bereid bestuursvergaderingen voor met AI',
    lead: 'U hoeft niet langer honderden pagina’s alleen door te nemen. De AI van Dafira One analyseert uw documenten, regelgeving en rapporten en brengt naar voren wat telt voor uw verantwoordelijkheden als bestuurslid.',
    items: [
      { icon: 'document', title: 'Samenvattingen van lange documenten', text: 'Focus op de punten die belangrijk zijn voor de volgende vergadering.' },
      { icon: 'shield', title: 'Aandachtspunten voor compliance en regelgeving', text: 'Relevante regelgevende vereisten gemarkeerd in uw documenten.' },
      { icon: 'sparkle', title: 'AI-inzichten voor uw besluiten', text: 'Context uit uw documenten om uw vragen en besluiten te onderbouwen.' },
    ],
  },
  archive: {
    title: 'Bewaar uw bestuursarchief, ook na uw mandaat',
    lead: 'Uw kennis stopt niet wanneer uw mandaat eindigt. Met Dafira One blijven uw documenten en notities van u, zodat u gaandeweg een persoonlijk bestuursarchief opbouwt.',
    items: [
      { icon: 'key', title: 'Blijvende toegang tot uw gegevens', text: 'Uw bestuursdocumenten blijven toegankelijk, ongeacht veranderingen in de organisatie.' },
      { icon: 'bank', title: 'Een archief van uw bestuurswerk', text: 'Een volledig overzicht van uw governance-ervaring.' },
      { icon: 'book', title: 'Uw persoonlijke governancebibliotheek', text: 'Een kennisbank voor toekomstige bestuursfuncties.' },
    ],
  },
  conflicts: {
    title: 'Ken uw besturen en herken belangenconflicten',
    lead: 'Een bestuur draait evenveel om mensen als om documenten. Dafira One helpt u uw medebestuurders te kennen en signaleert discreet mogelijke belangenconflicten.',
    card: {
      title: 'Uw bestuursnetwerk',
      meta: 'AI-analyse',
      rows: [
        { label: 'M. Davis', text: 'Voormalig CFO, RetailCorp', tone: 'ok' as const, status: 'Geen conflict' },
        { label: 'J. Smith', text: 'CEO, CompetitorCorp · directe concurrent', tone: 'danger' as const, status: 'Concurrent' },
        { label: 'R. Brown', text: 'Partner, VendorLaw LLC · levert juridische diensten', tone: 'pending' as const, status: 'Relatie' },
      ],
      footer: 'Mogelijke conflicten gesignaleerd vóór de vergadering',
      caption: 'Illustratie · fictieve namen',
    },
    items: [
      { icon: 'search', title: 'Automatische screening', text: 'AI bekijkt achtergronden van bestuursleden, zakelijke relaties en kruisende mandaten om mogelijke conflicten te herkennen.' },
      { icon: 'bell', title: 'Meldingen en aanbevelingen', text: 'Meldingen over mogelijke conflicten, met aanbevelingen voor onthouding bij agendapunten.' },
      { icon: 'users', title: 'Over al uw besturen', text: 'Gebruik wat u weet uit al uw bestuursfuncties om de governance-standaard hoog te houden.' },
    ],
  },
  security: {
    title: 'Beveiligd. EU-gehost. Altijd van u.',
    lead: 'Uw gegevens blijven in Europa. Dafira One is volledig EU-gehost en AVG-conform.',
    items: [
      { icon: 'lock', title: 'Versleuteling op ondernemingsniveau', text: 'Uw documenten zijn versleuteld tijdens transport en opslag.' },
      { icon: 'globe', title: 'Gegevens opgeslagen in de EU', text: 'Europese hosting en AVG-conformiteit.' },
      { icon: 'shield', title: 'Privacy by design', text: 'Van bij het begin ontworpen met privacy en beveiliging voorop.' },
    ],
  },
  form: {
    eyebrow: 'Vroege toegang',
    title: 'Krijg vroege toegang tot Dafira One',
    lead: 'Schrijf u in en we nemen contact op zodra de vroege toegang opent.',
    benefits: ['Gratis vroege toegang', 'EU-gehost en beveiligd', 'Voorbereiding met AI'],
    heading: 'Vraag vroege toegang aan',
    subheading: 'Duurt minder dan twee minuten. Geen spam; altijd uitschrijven mogelijk.',
    firstName: 'Voornaam',
    lastName: 'Achternaam',
    email: 'Zakelijk e-mailadres',
    emailPlaceholder: 'uw.email@bedrijf.com',
    boardCount: 'In hoeveel besturen zetelt u momenteel?',
    boardOptions: [
      { value: '', label: 'Selecteer het aantal besturen' },
      { value: '1', label: '1 bestuur' },
      { value: '2', label: '2 besturen' },
      { value: '3', label: '3 besturen' },
      { value: '4', label: '4 besturen' },
      { value: '5+', label: '5 of meer besturen' },
    ],
    trust: ['AVG-conform', '256-bit versleuteling', 'EU-datacenters'],
    submit: 'Vraag gratis vroege toegang aan',
    privacyBefore: 'Door u in te schrijven gaat u akkoord met ons ',
    privacyLink: 'privacybeleid',
    privacyAfter: '. Geen spam; altijd uitschrijven mogelijk.',
    successTitle: 'Bedankt, u staat op de lijst',
    successText: 'U bent ingeschreven voor vroege toegang tot Dafira One.',
    nextTitle: 'Wat volgt',
    next: ['Updates over de voortgang van de ontwikkeling', 'Een melding zodra de vroege toegang opent'],
  },
  faq: {
    title: 'Veelgestelde vragen',
    subtitle: 'Over Dafira One, persoonlijke bestuurssoftware',
    inLanguage: 'nl',
    faqs: boardMemberFaqs,
  },
};
---

<Layout
  title="Dafira One — Persoonlijke bestuurssoftware | EU-gehost en beveiligd"
  description="Persoonlijke bestuurssoftware, EU-gehost. Centraliseer de documenten van al uw besturen, bereid vergaderingen voor met AI en bewaar uw archief na uw mandaat."
  structuredData={combinedStructuredData}
>
  <main>
    <BoardMemberSoftware t={t} formAnchor="bestuurssoftware-form" privacyHref="/nl/privacy" />
  </main>
</Layout>
