---
import Layout from '../../../layouts/Layout.astro';
import ComparisonPage from '../../../components/vs/ComparisonPage.astro';
import type { CriterionKey } from '../../../components/vs/copy';

// Criteria compared on this page. The Dafira side of each criterion comes from components/vs/copy.ts;
// the OnBoard side lists questions to check with the vendor (no claims about OnBoard are made here).
const criteria: { key: CriterionKey; label: string; questions: string[] }[] = [
  {
    key: 'ux',
    label: "Gebruikservaring",
    questions: [
      "Hoeveel opleiding hebben bestuurders nodig vóór hun eerste vergadering?",
      "Kan de omgeving worden afgestemd op uw besturen, comités en rollen?",
      "Hoe vindt een occasionele gebruiker het actuele vergaderdossier?",
    ],
  },
  {
    key: 'docs',
    label: "Documentbeheer",
    questions: [
      "Hoe worden vergaderdossiers samengesteld en bijgewerkt na verzending?",
      "Is er een versiegeschiedenis per document?",
      "Kunnen bestuurders persoonlijk annoteren?",
    ],
  },
  {
    key: 'mobile',
    label: "Mobiele ervaring",
    questions: [
      "Welke functies zijn beschikbaar op tablet en telefoon?",
      "Kunnen documenten offline worden gelezen, en hoe is dat beveiligd?",
      "Zijn alle functies van de desktop ook beschikbaar op mobiel?",
    ],
  },
  {
    key: 'ai',
    label: "AI-integratie",
    questions: [
      "Welke AI-functies zijn inbegrepen, en in welk pakket?",
      "Waar worden documenten verwerkt wanneer AI wordt gebruikt?",
      "Kunnen ontwerpnotulen worden opgesteld in de talen van uw bestuur?",
    ],
  },
];

// Customer quotes, verbatim.
const quotes = [
  { quote: "Dafira heeft getransformeerd hoe wij onze bestuursactiviteiten beheren, met meer efficiëntie en duidelijkheid in onze governance processen.", author: "General Counsel", position: "", company: "Beursgenoteerde modegroep", link: "/case-studies/listed-fashion-group" },
  { quote: "Dafira heeft ons documentbeheer enorm vereenvoudigd, waardoor onze vergadervoorbereidingen efficiënter verlopen en ons bestuur zich kan focussen op besluitvorming.", author: "CEO", position: "", company: "Regionaal publiek investeringsfonds", link: "/case-studies/public-investment-fund" },
  { quote: "Dafira omarmt de volgende generatie van bestuurssoftware, gebruiksvriendelijk en met AI-integratie.", author: "Paralegal en compliance officer", position: "", company: "Beursgenoteerde zorgvastgoedvennootschap", link: "/nl/case-studies/healthcare-real-estate" },
];
---

<Layout
  title="OnBoard vs Dafira: vergelijking van bestuursportalen | Dafira"
  description="Vergelijk Dafira en OnBoard op gebruiksgemak, documentbeheer, mobiel gebruik en AI-functies: wat Dafira biedt, en de vragen om aan OnBoard te stellen. Gratis proefperiode van 14 dagen, geen creditcard."
>
  <ComparisonPage
    lang="nl"
    competitor="OnBoard"
    title="Alternatief voor OnBoard: hoe Dafira zich verhoudt"
    lead="Evalueert u OnBoard of overweegt u een overstap? Deze pagina zet per criterium op een rij wat Dafira biedt en wat u bij OnBoard kunt nagaan. Daarna test u Dafira 14 dagen met uw eigen vergaderdossier."
    criteria={criteria}
    quotes={quotes}
  />
</Layout>
