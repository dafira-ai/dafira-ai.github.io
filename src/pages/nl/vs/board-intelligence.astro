---
import Layout from '../../../layouts/Layout.astro';
import ComparisonPage from '../../../components/vs/ComparisonPage.astro';
import type { CriterionKey } from '../../../components/vs/copy';

// Criteria compared on this page. The Dafira side of each criterion comes from components/vs/copy.ts;
// the Board Intelligence side lists questions to check with the vendor (no claims about Board Intelligence are made here).
const criteria: { key: CriterionKey; label: string; questions: string[] }[] = [
  {
    key: 'ux',
    label: "Gebruiksgemak",
    questions: [
      "Hoeveel opleiding hebben bestuurders nodig vóór hun eerste vergadering?",
      "Kan de omgeving worden afgestemd op uw besturen, comités en rollen?",
      "Dekt de tool de volledige vergadercyclus, of vooral de rapportering aan het bestuur?",
    ],
  },
  {
    key: 'ai',
    label: "AI-mogelijkheden",
    questions: [
      "Welke AI-functies zijn inbegrepen, en in welk pakket?",
      "Waar worden documenten verwerkt wanneer AI wordt gebruikt?",
      "Kunnen ontwerpnotulen worden opgesteld in de talen van uw bestuur?",
    ],
  },
  {
    key: 'docs',
    label: "Documentbeheer",
    questions: [
      "Hoe worden vergaderdossiers samengesteld en bijgewerkt na verzending?",
      "Is er een versiegeschiedenis per document?",
      "Kunnen bestuurders persoonlijk annoteren?",
    ],
  },
  {
    key: 'support',
    label: "Bestuursondersteuning",
    questions: [
      "Welke ondersteuningsuren en kanalen zijn inbegrepen in uw pakket?",
      "Is ondersteuning beschikbaar in uw taal?",
      "Hebt u een vaste contactpersoon?",
    ],
  },
];

// Customer quotes, verbatim.
const quotes = [
  { quote: "Dafira heeft getransformeerd hoe wij onze bestuurszaken beheren, met meer efficiëntie en duidelijkheid in onze processen.", author: "General Counsel", position: "", company: "Beursgenoteerde modegroep", link: "/case-studies/listed-fashion-group" },
  { quote: "Dafira heeft ons documentbeheer enorm vereenvoudigd, waardoor onze vergadervoorbereidingen efficiënter verlopen en ons bestuur zich kan focussen op besluitvorming.", author: "CEO", position: "", company: "Regionaal publiek investeringsfonds", link: "/case-studies/public-investment-fund" },
  { quote: "Dafira omarmt de volgende generatie bestuurssoftware, gebruiksvriendelijk en met AI-integratie.", author: "Paralegal en compliance officer", position: "", company: "Beursgenoteerde zorgvastgoedvennootschap", link: "/nl/case-studies/healthcare-real-estate" },
];
---

<Layout
  title="Board Intelligence vs Dafira: vergelijking van bestuursportalen | Dafira"
  description="Vergelijk Dafira en Board Intelligence op gebruiksgemak, AI-functies, documentbeheer en ondersteuning: wat Dafira biedt, en de vragen om aan Board Intelligence te stellen. Gratis proefperiode van 14 dagen, geen creditcard."
>
  <ComparisonPage
    lang="nl"
    competitor="Board Intelligence"
    title="Alternatief voor Board Intelligence: hoe Dafira zich verhoudt"
    lead="Evalueert u Board Intelligence of overweegt u een overstap? Deze pagina zet per criterium op een rij wat Dafira biedt en wat u bij Board Intelligence kunt nagaan. Daarna test u Dafira 14 dagen met uw eigen vergaderdossier."
    criteria={criteria}
    quotes={quotes}
  />
</Layout>
