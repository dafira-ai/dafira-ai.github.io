---
import Layout from '../../../layouts/Layout.astro';
import ComparisonPage from '../../../components/vs/ComparisonPage.astro';
import type { CriterionKey } from '../../../components/vs/copy';

// Criteria compared on this page. The Dafira side of each criterion comes from components/vs/copy.ts;
// the BoardEffect side lists questions to check with the vendor (no claims about BoardEffect are made here).
const criteria: { key: CriterionKey; label: string; questions: string[] }[] = [
  {
    key: 'ux',
    label: "Gebruiksgemak",
    questions: [
      "Hoeveel opleiding hebben bestuurders nodig vóór hun eerste vergadering?",
      "Kan de omgeving worden afgestemd op uw besturen, comités en rollen?",
      "Hoe vindt een occasionele gebruiker het actuele vergaderdossier?",
    ],
  },
  {
    key: 'ai',
    label: "AI-mogelijkheden",
    questions: [
      "Welke AI-functies zijn inbegrepen, en in welk pakket?",
      "Waar worden documenten verwerkt wanneer AI wordt gebruikt?",
      "Kunnen ontwerpnotulen worden opgesteld in de talen van uw bestuur?",
    ],
  },
  {
    key: 'docs',
    label: "Documentbeheer",
    questions: [
      "Hoe worden vergaderdossiers samengesteld en bijgewerkt na verzending?",
      "Is er een versiegeschiedenis per document?",
      "Kunnen bestuurders persoonlijk annoteren?",
    ],
  },
  {
    key: 'supportImplementation',
    label: "Support & implementatie",
    questions: [
      "Hoe lang duurt een opstart, en wie voert die uit?",
      "Welke ondersteuningsuren en kanalen zijn inbegrepen in uw pakket?",
      "Hebt u een vaste contactpersoon?",
    ],
  },
];

// Customer quotes, verbatim.
const quotes = [
  { quote: "Dafira heeft onze bestuurlijke processen getransformeerd en brengt efficiëntie en duidelijkheid.", author: "General Counsel", position: "", company: "Beursgenoteerde modegroep", link: "/nl/case-studies/listed-fashion-group" },
  { quote: "Dafira heeft ons documentbeheer enorm vereenvoudigd, waardoor onze vergaderingen efficiënter verlopen en we ons kunnen focussen op besluitvorming.", author: "CEO", position: "", company: "Regionaal publiek investeringsfonds", link: "/nl/case-studies/public-investment-fund" },
  { quote: "Dafira omarmt de volgende generatie bestuurssoftware, gebruiksvriendelijk en met AI-integratie.", author: "Paralegal en compliance officer", position: "", company: "Beursgenoteerde zorgvastgoedvennootschap", link: "/nl/case-studies/healthcare-real-estate" },
];
---

<Layout
  title="BoardEffect vs Dafira: vergelijking van bestuursportalen | Dafira"
  description="Vergelijk Dafira en BoardEffect op gebruiksgemak, AI-functies, documentbeheer en ondersteuning en opstart: wat Dafira biedt, en de vragen om aan BoardEffect te stellen. Gratis proefperiode van 14 dagen, geen creditcard."
>
  <ComparisonPage
    lang="nl"
    competitor="BoardEffect"
    title="Alternatief voor BoardEffect: hoe Dafira zich verhoudt"
    lead="Evalueert u BoardEffect of overweegt u een overstap? Deze pagina zet per criterium op een rij wat Dafira biedt en wat u bij BoardEffect kunt nagaan. Daarna test u Dafira 14 dagen met uw eigen vergaderdossier."
    criteria={criteria}
    quotes={quotes}
  />
</Layout>
