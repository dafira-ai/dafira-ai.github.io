---
import Layout from '../../../layouts/Layout.astro';
import ComparisonPage from '../../../components/vs/ComparisonPage.astro';
import type { CriterionKey } from '../../../components/vs/copy';

// Criteria compared on this page. The Dafira side of each criterion comes from components/vs/copy.ts;
// the Diligent side lists questions to check with the vendor (no claims about Diligent are made here).
const criteria: { key: CriterionKey; label: string; questions: string[] }[] = [
  {
    key: 'ux',
    label: "Gebruiksgemak",
    questions: [
      "Hoeveel opleiding hebben bestuurders nodig vóór hun eerste vergadering?",
      "Kan de omgeving worden afgestemd op uw besturen, comités en rollen?",
      "Hoe vindt een occasionele gebruiker het actuele vergaderdossier?",
    ],
  },
  {
    key: 'ai',
    label: "AI-mogelijkheden",
    questions: [
      "Welke AI-functies zijn inbegrepen, en in welk pakket?",
      "Waar worden documenten verwerkt wanneer AI wordt gebruikt?",
      "Kunnen ontwerpnotulen worden opgesteld in de talen van uw bestuur?",
    ],
  },
  {
    key: 'pricing',
    label: "Prijsmodel",
    questions: [
      "Is de prijs per bestuur, per gebruiker of per module?",
      "Wat is de minimale contractduur?",
      "Welke functies worden als optie verkocht?",
    ],
  },
  {
    key: 'implementation',
    label: "Implementatie",
    questions: [
      "Hoeveel maanden duurt een doorsnee uitrol?",
      "Wat wordt verwacht van uw IT-team?",
      "Wie zet uw bestaande archief over, en tegen welke kost?",
    ],
  },
];

// Customer quotes, verbatim.
const quotes = [
  { quote: "Dafira heeft onze bestuurlijke processen volledig getransformeerd, met meer efficiëntie en duidelijkheid als resultaat.", author: "General Counsel", position: "", company: "Beursgenoteerde modegroep", link: "/case-studies/listed-fashion-group" },
  { quote: "Dafira heeft ons documentbeheer enorm vereenvoudigd, waardoor onze vergadervoorbereidingen efficiënter verlopen en ons bestuur zich kan focussen op besluitvorming.", author: "CEO", position: "", company: "Regionaal publiek investeringsfonds", link: "/case-studies/public-investment-fund" },
  { quote: "Dafira omarmt de volgende generatie bestuurssoftware, gebruiksvriendelijk en met AI-integratie.", author: "Paralegal en compliance officer", position: "", company: "Beursgenoteerde zorgvastgoedvennootschap", link: "/nl/case-studies/healthcare-real-estate" },
];
---

<Layout
  title="Diligent vs Dafira: vergelijking van bestuursportalen | Dafira"
  description="Vergelijk Dafira en Diligent op gebruiksgemak, AI-functies, prijsmodel en implementatie: wat Dafira biedt, en de vragen om aan Diligent te stellen. Gratis proefperiode van 14 dagen, geen creditcard."
>
  <ComparisonPage
    lang="nl"
    competitor="Diligent"
    title="Alternatief voor Diligent: hoe Dafira zich verhoudt"
    lead="Evalueert u Diligent of overweegt u een overstap? Deze pagina zet per criterium op een rij wat Dafira biedt en wat u bij Diligent kunt nagaan. Daarna test u Dafira 14 dagen met uw eigen vergaderdossier."
    criteria={criteria}
    quotes={quotes}
  />
</Layout>
