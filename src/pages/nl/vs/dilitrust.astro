---
import Layout from '../../../layouts/Layout.astro';
import ComparisonPage from '../../../components/vs/ComparisonPage.astro';
import type { CriterionKey } from '../../../components/vs/copy';

// Criteria compared on this page. The Dafira side of each criterion comes from components/vs/copy.ts;
// the DiliTrust side lists questions to check with the vendor (no claims about DiliTrust are made here).
const criteria: { key: CriterionKey; label: string; questions: string[] }[] = [
  {
    key: 'ux',
    label: "Gebruikerservaring",
    questions: [
      "Hoeveel opleiding hebben bestuurders nodig vóór hun eerste vergadering?",
      "Kan de omgeving worden afgestemd op uw besturen, comités en rollen?",
      "Hoe vindt een occasionele gebruiker het actuele vergaderdossier?",
    ],
  },
  {
    key: 'ai',
    label: "AI-mogelijkheden",
    questions: [
      "Welke AI-functies zijn inbegrepen, en in welk pakket?",
      "Waar worden documenten verwerkt wanneer AI wordt gebruikt?",
      "Kunnen ontwerpnotulen worden opgesteld in de talen van uw bestuur?",
    ],
  },
  {
    key: 'docs',
    label: "Documentbeheer",
    questions: [
      "Hoe worden vergaderdossiers samengesteld en bijgewerkt na verzending?",
      "Is er een versiegeschiedenis per document?",
      "Kunnen bestuurders persoonlijk annoteren?",
    ],
  },
  {
    key: 'implementation',
    label: "Implementatie",
    questions: [
      "Hoe lang duurt een opstart voor een bestuur zoals het uwe?",
      "Wat wordt verwacht van uw IT-team?",
      "Wie zet uw bestaande archief over, en tegen welke kost?",
    ],
  },
];

// Customer quotes, verbatim.
const quotes = [
  { quote: "Dafira heeft onze bestuursvergaderingen getransformeerd, met meer efficiëntie en duidelijkheid in onze governance processen.", author: "General Counsel", position: "", company: "Beursgenoteerde modegroep", link: "/nl/case-studies/listed-fashion-group" },
  { quote: "Dafira heeft ons documentbeheer enorm vereenvoudigd, waardoor onze vergadervoorbereidingen efficiënter verlopen en ons bestuur zich kan focussen op besluitvorming.", author: "CEO", position: "", company: "Regionaal publiek investeringsfonds", link: "/nl/case-studies/public-investment-fund" },
  { quote: "Dafira omarmt de volgende generatie van bestuursmanagement software, gebruiksvriendelijk en met AI-integratie.", author: "Paralegal en compliance officer", position: "", company: "Beursgenoteerde zorgvastgoedvennootschap", link: "/nl/case-studies/healthcare-real-estate" },
];
---

<Layout
  title="DiliTrust vs Dafira: vergelijking van bestuursportalen | Dafira"
  description="Vergelijk Dafira en DiliTrust op gebruiksgemak, AI-functies, documentbeheer en implementatie: wat Dafira biedt, en de vragen om aan DiliTrust te stellen. Gratis proefperiode van 14 dagen, geen creditcard."
>
  <ComparisonPage
    lang="nl"
    competitor="DiliTrust"
    title="Alternatief voor DiliTrust: hoe Dafira zich verhoudt"
    lead="Evalueert u DiliTrust of overweegt u een overstap? Deze pagina zet per criterium op een rij wat Dafira biedt en wat u bij DiliTrust kunt nagaan. Daarna test u Dafira 14 dagen met uw eigen vergaderdossier."
    criteria={criteria}
    quotes={quotes}
  />
</Layout>
