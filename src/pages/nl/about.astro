---
import Layout from '../../layouts/Layout.astro';
import { PageHero, Section, SectionHeader, FeatureColumns } from '../../components/ui';
import MissionVision from '../../components/about/MissionVision.astro';
import FounderStory from '../../components/about/FounderStory.astro';
import TeamMembers from '../../components/about/TeamMembers.astro';
import OfficeCard from '../../components/OfficeCard.astro';
import LocalizedCTA from '../../components/case-studies/LocalizedCTA.astro';

const facts = [
  { label: 'Product', value: 'Dafira bestuursportaal' },
  { label: 'Kantoor', value: 'Brussel' },
];

const values = [
  { icon: 'target', title: 'Innovatie', text: 'We verbeteren voortdurend wat bestuurssoftware betekent voor wie ermee werkt.' },
  { icon: 'lock', title: 'Veiligheid en vertrouwen', text: 'De bescherming van gevoelige gegevens van onze klanten staat voorop.' },
  { icon: 'users', title: 'Partnerschap', text: 'We staan de besturen die we bedienen bij, bij elke stap.' },
  { icon: 'clock', title: 'Efficiëntie', text: 'Bestuurswerk hoort minder tijd en minder complexiteit te vragen.' },
];

const missionVisionProps = {
  eyebrow: 'Waarom we bestaan',
  mission: {
    title: 'Onze missie',
    description: 'Wij ontwikkelen eenvoudige bestuurssoftware die governance en besluitvorming verbetert, met',
    aiText: 'AI als assistent.',
  },
  vision: {
    title: 'Onze visie',
    description: 'De governance-oplossing creëren die besturen in staat stelt',
    highlightedText: 'een betere toekomst vorm te geven.',
  },
};

const founderStoryProps = {
  tagText: 'Ons verhaal',
  title: 'Het ontstaan van Dafira',
  story: [
    'Tijdens mijn jarenlange ervaring in verschillende raden van bestuur kwam ik steeds dezelfde uitdagingen tegen: complex documentbeheer, omslachtige besluitvormingsprocessen en de uitdaging om hoge bestuursnormen te handhaven.',
    'Het kantelpunt was een cruciale vergadering waar het kwijtraken van essentiële documenten leidde tot grote vertragingen in de besluitvorming, met directe gevolgen voor de koers van de organisatie. Deze situatie overtuigde mij dat er een beter alternatief moest komen.',
    'Zo ontstond Dafira. Onze ambitie reikte verder dan alleen een portaal: we wilden een platform dat inspeelt op de echte noden van besturen.',
    'Vandaag helpt Dafira besturen om vergaderingen voor te bereiden, te beslissen en een betrouwbaar verslag bij te houden, met AI waar het tijd bespaart.',
  ],
  founder: { name: 'Jean-Louis Van Houwe', role: 'Oprichter & CEO' },
};

const teamMembersProps = {
  title: 'Directie',
  subtitle: 'Wie Dafira leidt.',
  team: [
    {
      name: 'Jean-Louis Van Houwe',
      role: 'CEO & Oprichter',
      image: '/jean-louis-van-houwe.jpeg',
      linkedin: 'https://www.linkedin.com/in/jeanlouisvanhouwe/',
      bio: 'Zet zich in om corporate governance te verbeteren met technologie.',
    },
  ],
};

const offices = [
  { city: 'Brussel', country: 'België', image: '/bxl.jpg', address: "Gasthuisstraat 31", postalCode: '1000', email: 'info@dafira.ai' },
];
---

<Layout title="Over Ons - Dafira, Intelligente Governance Oplossing" description="Dafira is een bestuursportaal ontwikkeld in België. Onze missie, het verhaal van onze oprichter, het directieteam en ons kantoor in Brussel." image="/about.png">
  <PageHero
    eyebrow="Over Dafira"
    title="Beter bestuur, gebouwd voor wie besturen draaiende houdt"
    lead="Dafira is een platform voor bestuursbeheer, ontwikkeld in België. We helpen besturen om vergaderingen voor te bereiden, documenten te delen, beslissingen te nemen en er een betrouwbaar verslag van bij te houden."
  >
    <dl class="mt-10 pt-8 border-t border-line grid grid-cols-2 sm:grid-cols-4 gap-6">
      {facts.map((f) => (
        <div>
          <dt class="font-mono text-xs uppercase tracking-[0.08em] text-gray-500">{f.label}</dt>
          <dd class="mt-1 text-[15px] text-navy">{f.value}</dd>
        </div>
      ))}
    </dl>
  </PageHero>

  <MissionVision {...missionVisionProps} />
  <FounderStory {...founderStoryProps} />
  <TeamMembers {...teamMembersProps} />

  <Section tone="surface" space="lg" border="top">
    <SectionHeader eyebrow="Waarden" title="Wat ons werk stuurt" />
    <FeatureColumns columns={4} items={values} />
  </Section>

  <Section space="lg">
    <SectionHeader eyebrow="Kantoor" title="Waar u ons vindt" lead="Schrijf naar info@dafira.ai of bezoek ons kantoor in Brussel." />
    <div class="max-w-md">
      {offices.map((office) => <OfficeCard {...office} />)}
    </div>
  </Section>

  <LocalizedCTA />
</Layout>
