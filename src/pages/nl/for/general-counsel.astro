---
import Layout from '../../../layouts/Layout.astro';
import RoleLanding from '../../../components/industries/RoleLanding.astro';
import { customerQuote, readCaseLabel } from '../../../components/industries/customerQuotes';

const hero = {
  eyebrow: 'Voor juridisch adviseurs',
  title: 'Juridisch toezicht op het bestuur, in één register',
  lead: 'Houd resoluties, handtekeningen en de audittrail op orde. Dafira bewaart bestuursdocumenten, notulen en besluiten op één plek, met toegang per rol.',
  primary: { text: 'Demo aanvragen', href: '/nl/request-demo' },
  secondary: { text: 'Contact opnemen', href: '/nl/contact' },
  screenshot: { src: '/onboarding-document-list.png', alt: 'Documentenbibliotheek van een bestuur in Dafira' },
};

const challenges = {
  title: 'Wat juridisch adviseurs nodig hebben',
  lead: 'De juridische functie staat in voor het bestuursregister: wat werd besloten, door wie en op basis van welke documenten.',
  items: [
    { icon: 'scale', title: 'Compliance', text: 'De regelgevende vereisten voor het bestuur opvolgen en bewijs bewaren van hoe eraan voldaan werd.' },
    { icon: 'document', title: 'Documentcontrole', text: 'Versiegeschiedenis en een audittrail voor elk bestuursdocument.' },
    { icon: 'lock', title: 'Gegevensbeveiliging', text: 'Rolgebaseerde toegang en versleuteling voor vertrouwelijke bestuursinformatie.' },
    { icon: 'signature', title: 'Elektronische handtekeningen', text: 'Notulen en resoluties elektronisch ondertekenen, zonder afdrukken en handtekeningen najagen.' },
  ],
};

const features = {
  title: 'Functies voor juridisch adviseurs',
  lead: 'De onderdelen van Dafira waarop juridische teams rekenen.',
  items: [
    { icon: 'shield', title: 'Compliance-opvolging', text: 'Regelgevende onderwerpen volgen die het bestuur aangaan en de bijbehorende documenten bijeenhouden.', items: ['Regelgevende onderwerpen', 'Audittrail', 'Besluitenregister'] },
    { icon: 'folder', title: 'Documentbeheer', text: 'Beveiligde, centrale opslag van bestuursstukken, met versiegeschiedenis.', items: ['Versiegeschiedenis', 'Toegangsregistratie', 'Bewaring van documenten', 'Zoeken'] },
    { icon: 'gavel', title: 'Governance-tools', text: 'De instrumenten van een goed georganiseerd bestuur, in één werkruimte.', items: ['Vergaderbeheer', 'Resoluties en stemmingen', 'Comités', 'Elektronische handtekening'] },
  ],
};

const quote = { ...customerQuote('nl', 'lore'), linkText: readCaseLabel.nl };
---

<Layout title="Bestuurssoftware voor juridisch adviseurs | Dafira" description="Bestuursportaal voor juridisch adviseurs: documentcontrole, elektronische handtekeningen, resoluties en een audittrail voor het bestuursregister.">
  <main>
    <RoleLanding hero={hero} challenges={challenges} features={features} quote={quote} />
  </main>
</Layout>
