---
import Layout from '../../../../../layouts/Layout.astro';
import IndustryLanding from '../../../../../components/industries/IndustryLanding.astro';
import { industryIds, getIndustry, testimonials } from '../../../../../data/board-secretary-industries';

export function getStaticPaths() {
  return industryIds.map((industry) => ({ params: { industry } }));
}

const { industry } = Astro.params;
const info = getIndustry('nl', industry);

if (!info) {
  return Astro.redirect('/nl/for/board-secretary');
}

const screenshots = {
  'financial-services': { src: '/onboarding-document-list.png', alt: 'Documentenbibliotheek van Dafira, geordend per vergadering' },
  healthcare: { src: '/onboarding-event-detail.png', alt: 'Vergaderpagina in Dafira met de agenda, aanwezigheden en een stemming' },
  'real-estate': { src: '/onboarding-boardpack.png', alt: 'Bestuursdossier in Dafira per agendapunt, met annotaties' },
};
---

<Layout title={info.seo.title} description={info.seo.description}>
  <main>
    <IndustryLanding
      industry={industry}
      hero={info.hero}
      screenshot={screenshots[industry]}
      challenges={info.challenges}
      features={info.features}
      quoteKey={testimonials[industry]}
      secondary="trial"
    />
  </main>
</Layout>
