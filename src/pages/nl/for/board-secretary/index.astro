---
import Layout from '../../../../layouts/Layout.astro';
import Testimonials from '../../../../components/Testimonials.astro';
import { PageHero, Section, SectionHeader, Button, Icon, FeatureColumns, CellGrid, Screenshot, CTA } from '../../../../components/ui';
import { customerQuote } from '../../../../components/industries/customerQuotes';
import { ctaProps } from '../../../../components/industries/i18n';

const dayInLife = {
  title: 'Een vergaderdag, voor en na',
  lead: 'Drie momenten uit de dag van een bestuurssecretaris, met en zonder bestuursportaal.',
  beforeLabel: 'Zonder portaal',
  afterLabel: 'Met Dafira',
  slots: [
    { time: '09:00', before: 'In e-mailketens zoeken naar de laatste versie van het bestuursdossier.', after: 'Het bestuursdossier staat op één plek, geordend per agendapunt, met versiegeschiedenis.' },
    { time: '14:00', before: 'Uitgebreide notities nemen en tegelijk de bespreking volgen.', after: 'De vergadering volgen, terwijl aanwezigheden, stemmingen en resoluties meteen worden vastgelegd.' },
    { time: '17:30', before: 'De notulen van nul beginnen.', after: 'Een eerste ontwerp nalezen, opgesteld met de AI-notulenbouwer.' },
  ],
};

const painPoints = {
  title: 'Veelvoorkomende uitdagingen',
  lead: 'Het dagelijkse werk van een bestuurssecretaris, en hoe Dafira ermee omgaat.',
  items: [
    { icon: 'documents', title: 'Verspreide documenten', text: 'Vervang e-mailketens en versieverwarring door één beveiligde bibliotheek voor bestuursstukken.' },
    { icon: 'clock', title: 'Notulen tot laat op de avond', text: 'De AI-notulenbouwer stelt een ontwerp van de notulen op, met actiepunten en resoluties overgenomen.' },
    { icon: 'signature', title: 'Handtekeningen najagen', text: 'Handtekeningen onder notulen en resoluties elektronisch verzamelen.' },
    { icon: 'search', title: 'Eerdere besluiten terugvinden', text: 'Zoeken in de geschiedenis van vergaderingen, notulen en besluiten.' },
  ],
};

const features = {
  title: 'Waarmee u werkt',
  lead: 'De onderdelen van Dafira die bestuurssecretarissen dagelijks gebruiken.',
  items: [
    { icon: 'sparkle', title: 'AI-notulenbouwer', text: 'Een eerste ontwerp van de notulen, om na te lezen en aan te vullen.', items: ['Ontwerpnotulen', 'Opvolging van actiepunten', 'Samenvattingen van vergaderingen', 'AI-assistent op bestuursdocumenten'] },
    { icon: 'folder', title: 'Documenten', text: 'Controle over de bestuursdocumentatie, van ontwerp tot handtekening.', items: ['Versiegeschiedenis', 'Beveiligde verspreiding', 'Elektronische handtekening', 'Sjablonen'] },
    { icon: 'calendar', title: 'Vergaderingen', text: 'Van de uitnodiging tot de opvolging.', items: ['Kalender en uitnodigingen', 'Agendabouwer', 'Aanwezigheden', 'Taken en opvolging'] },
  ],
};

const industries = {
  title: 'Per sector',
  lead: 'Bestuurssecretarissen in gereglementeerde sectoren hebben specifieke noden op het vlak van registers.',
  link: 'Bekijk de sectorpagina',
  items: [
    { id: 'financial-services', icon: 'bank', name: 'Financiële dienstverlening', text: 'Banken, verzekeraars en beleggingsondernemingen.' },
    { id: 'healthcare', icon: 'health', name: 'Zorg', text: 'Ziekenhuizen, zorgaanbieders en life sciences.' },
    { id: 'real-estate', icon: 'building', name: 'Vastgoed', text: 'Vastgoedbelegging en -beheer.' },
  ],
};

const testimonials = {
  texts: {
    title: 'Wat bestuursteams zeggen',
    subtitle: "Secretarissen, juristen en CEO's over het werken met Dafira voor hun bestuur.",
    cta: 'Alle klantverhalen',
    ctaLink: '/nl/testimonials',
  },
  testimonials: (['lore', 'pierre', 'nathalie'] as const).map((k) => {
    const q = customerQuote('nl', k);
    return { quote: q.quote, author: q.author, position: q.role, company: q.company, image: q.image, link: q.link };
  }),
};
---

<Layout title="Bestuurssoftware voor bestuurssecretarissen | Dafira" description="Bestuursportaal voor bestuurssecretarissen: bestuursdossiers, agenda's, AI-ontwerpnotulen, elektronische handtekeningen en een doorzoekbare besluitenhistoriek.">
  <main>
    <PageHero eyebrow="Voor bestuurssecretarissen" title="Elke bestuursvergadering voorbereiden, vastleggen en opvolgen" lead="Dafira neemt het administratieve werk rond het bestuur voor zijn rekening, van de agenda tot de ondertekende notulen, zodat u zich op de inhoud kunt concentreren.">
      <Fragment slot="actions">
        <Button href="/nl/request-demo">Demo aanvragen</Button>
        <Button variant="secondary" href="/nl/try">Gratis proefperiode starten</Button>
      </Fragment>
      <Screenshot slot="aside" src="/applications-picture-meeting.png" alt="Vergaderpagina in Dafira op computer, tablet en telefoon" eager />
    </PageHero>

    <Section>
      <SectionHeader title={dayInLife.title} lead={dayInLife.lead} />
      <div class="border-t border-line" data-play>
        <div class="hidden md:grid grid-cols-12 gap-6 py-4 border-b border-line font-mono text-xs uppercase tracking-[0.08em] text-gray-500">
          <div class="col-span-2"></div>
          <div class="col-span-5">{dayInLife.beforeLabel}</div>
          <div class="col-span-5">{dayInLife.afterLabel}</div>
        </div>
        {dayInLife.slots.map((slot, i) => (
          <div class="grid md:grid-cols-12 gap-3 md:gap-6 py-6 border-b border-line" data-step style={`--d:${i * 80}`}>
            <div class="md:col-span-2 font-mono text-sm text-primary tabular-nums">{slot.time}</div>
            <div class="md:col-span-5 text-gray-500">
              <span class="md:hidden font-mono text-xs uppercase tracking-[0.08em] block mb-1">{dayInLife.beforeLabel}</span>
              {slot.before}
            </div>
            <div class="md:col-span-5 text-ink">
              <span class="md:hidden font-mono text-xs uppercase tracking-[0.08em] text-gray-500 block mb-1">{dayInLife.afterLabel}</span>
              {slot.after}
            </div>
          </div>
        ))}
      </div>
    </Section>

    <Section tone="surface" border="both">
      <SectionHeader title={painPoints.title} lead={painPoints.lead} />
      <CellGrid columns={2}>
        {painPoints.items.map((item) => (
          <div class="bg-white p-8">
            <Icon name={item.icon} class="w-6 h-6 text-navy" />
            <h3 class="mt-5 text-lg font-semibold text-navy">{item.title}</h3>
            <p class="mt-2 text-[15px] text-gray-600 leading-relaxed">{item.text}</p>
          </div>
        ))}
      </CellGrid>
    </Section>

    <Section>
      <SectionHeader title={features.title} lead={features.lead} />
      <FeatureColumns items={features.items} />
    </Section>

    <Section tone="surface" border="both" space="md">
      <SectionHeader title={industries.title} lead={industries.lead} />
      <CellGrid columns={3}>
        {industries.items.map((item) => (
          <a href={`/nl/for/board-secretary/industry/${item.id}`} class="group bg-white p-8 hover:bg-surface transition-colors flex flex-col">
            <Icon name={item.icon} class="w-6 h-6 text-navy" />
            <h3 class="mt-5 text-lg font-semibold text-navy">{item.name}</h3>
            <p class="mt-2 text-[15px] text-gray-600 leading-relaxed">{item.text}</p>
            <span class="mt-auto pt-6 text-[15px] font-medium text-primary group-hover:text-navy transition-colors">{industries.link}</span>
          </a>
        ))}
      </CellGrid>
    </Section>

    <Testimonials texts={testimonials.texts} testimonials={testimonials.testimonials} />

    <CTA {...ctaProps.nl} />
  </main>
</Layout>
