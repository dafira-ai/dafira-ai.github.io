---
import Layout from '../../../../layouts/Layout.astro';
import { PageHero, Section, SectionHeader, Button, Icon, FeatureColumns, CellGrid, FeatureList, Screenshot, CTA } from '../../../../components/ui';
import { ctaProps } from '../../../../components/industries/i18n';

const responsibilities = {
  title: 'Ondersteuning bij uw taken als bestuurder',
  lead: 'Wat het bestuur van zijn leden verwacht, en waar Dafira helpt.',
  items: [
    { icon: 'target', title: 'Strategisch toezicht', text: 'De bestuursstukken in hun context lezen, met de historiek van eerdere besprekingen bij de hand.' },
    { icon: 'scale', title: 'Fiduciaire plicht', text: 'Beslissen op basis van volledige, actuele informatie, en die besluiten vastleggen.' },
    { icon: 'users', title: 'Relatie met belanghebbenden', text: 'Het overleg met medebestuurders en management gestructureerd en beveiligd houden.' },
    { icon: 'tasks', title: 'Opvolging', text: 'Actiepunten en besluiten van de ene vergadering naar de volgende opvolgen.' },
  ],
};

const roles = {
  title: 'Per rol',
  lead: 'Pagina’s voor de specifieke posities in het bestuur.',
  link: 'Bekijk de rolpagina',
  items: [
    { title: 'Onafhankelijk bestuurder', icon: 'scale', text: 'Objectief toezicht, met privéruimtes voor overleg tussen onafhankelijke bestuurders.', href: '/nl/for/independent-director', features: ['Privégesprekken', 'Toegang tot eerdere besluiten', 'Registratie van belangenconflicten'] },
    { title: 'Aandeelhouder-bestuurder', icon: 'trend', text: 'Aandeelhouders vertegenwoordigen en tegelijk handelen in het belang van de onderneming.', href: '/nl/for/shareholder-director', features: ['Beveiligde communicatie', 'Geordende bestuursstukken', 'Stemmingen en besluitenregister'] },
  ],
};

const features = {
  title: 'Tools voor elk bestuurslid',
  lead: 'Wat elke bestuurder gebruikt, ongeacht de rol.',
  items: [
    { icon: 'sparkle', title: 'AI-assistent', text: 'Stel vragen over de bestuursstukken en krijg samenvattingen van lange documenten.', items: ['Vragen over bestuursdocumenten', 'Samenvattingen', 'Zoeken in eerdere vergaderingen'] },
    { icon: 'pen', title: 'Samenwerking', text: 'De vergadering samen met de rest van het bestuur voorbereiden en bespreken.', items: ['Privé-annotaties', 'Beveiligde bestuurschat', 'Links naar online vergaderingen', 'Gedeelde documenten'] },
    { icon: 'vote', title: 'Besluiten', text: 'Stemmen, ondertekenen en terugvinden wat besloten werd.', items: ['Stemmen', 'Elektronische handtekening', 'Besluitenregister', 'Actiepunten'] },
  ],
};

const industries = {
  title: 'Per sector',
  lead: 'Sectorpagina’s voor bestuurders in gereglementeerde sectoren.',
  link: 'Bekijk de sectorpagina',
  items: [
    { id: 'financial-services', icon: 'bank', name: 'Financiële dienstverlening', text: 'Banken, verzekeraars en beleggingsondernemingen.', features: ['Regelgevend kader', 'Beveiligd documentbeheer', 'Comitévergaderingen'] },
    { id: 'healthcare', icon: 'health', name: 'Zorg', text: 'Ziekenhuizen, zorgaanbieders en life sciences.', features: ['Klinische governance op de agenda', 'Vertrouwelijke stukken', 'Comitévergaderingen'] },
    { id: 'real-estate', icon: 'building', name: 'Vastgoed', text: 'Vastgoedbelegging en -beheer.', features: ['Investeringsbesluiten', 'Portefeuillestukken', 'Besluitenregister'] },
  ],
};
---

<Layout title="Bestuurssoftware voor bestuursleden | Dafira Bestuursportaal" description="Bestuursportaal voor bestuurders: lees en annoteer het bestuursdossier op elk toestel, stem, onderteken en vind eerdere besluiten terug. Pagina's per rol en per sector.">
  <main>
    <PageHero eyebrow="Voor bestuursleden" title="Het bestuursdossier, de bespreking en de besluiten, op één plek" lead="Of u nu onafhankelijk bestuurder, vertegenwoordiger van een aandeelhouder of sectorspecialist bent, Dafira geeft u de informatie die u nodig hebt om te beslissen, op elk toestel.">
      <Fragment slot="actions">
        <Button href="/nl/request-demo">Demo aanvragen</Button>
        <Button variant="secondary" href="/nl/contact">Contact opnemen</Button>
      </Fragment>
      <Screenshot slot="aside" src="/onboarding-boardpack.png" alt="Bestuursdossier in Dafira per agendapunt, met annotaties op een document" eager />
    </PageHero>

    <Section>
      <SectionHeader title={responsibilities.title} lead={responsibilities.lead} />
      <CellGrid columns={2}>
        {responsibilities.items.map((item) => (
          <div class="bg-white p-8">
            <Icon name={item.icon} class="w-6 h-6 text-navy" />
            <h3 class="mt-5 text-lg font-semibold text-navy">{item.title}</h3>
            <p class="mt-2 text-[15px] text-gray-600 leading-relaxed">{item.text}</p>
          </div>
        ))}
      </CellGrid>
    </Section>

    <Section tone="surface" border="both">
      <SectionHeader title={roles.title} lead={roles.lead} />
      <CellGrid columns={2}>
        {roles.items.map((role) => (
          <a href={role.href} class="group bg-white p-8 lg:p-10 hover:bg-surface transition-colors flex flex-col">
            <Icon name={role.icon} class="w-6 h-6 text-navy" />
            <h3 class="mt-5 text-xl font-semibold text-navy">{role.title}</h3>
            <p class="mt-3 text-gray-600 leading-relaxed">{role.text}</p>
            <FeatureList items={role.features} class="mt-6" />
            <span class="mt-auto pt-8 text-[15px] font-medium text-primary group-hover:text-navy transition-colors">{roles.link}</span>
          </a>
        ))}
      </CellGrid>
    </Section>

    <Section>
      <SectionHeader title={features.title} lead={features.lead} />
      <FeatureColumns items={features.items} />
    </Section>

    <Section tone="surface" border="both">
      <SectionHeader title={industries.title} lead={industries.lead} />
      <CellGrid columns={3}>
        {industries.items.map((item) => (
          <a href={`/nl/for/board-member/industry/${item.id}`} class="group bg-white p-8 hover:bg-surface transition-colors flex flex-col">
            <Icon name={item.icon} class="w-6 h-6 text-navy" />
            <h3 class="mt-5 text-lg font-semibold text-navy">{item.name}</h3>
            <p class="mt-2 text-[15px] text-gray-600 leading-relaxed">{item.text}</p>
            <FeatureList items={item.features} class="mt-6" />
            <span class="mt-auto pt-8 text-[15px] font-medium text-primary group-hover:text-navy transition-colors">{industries.link}</span>
          </a>
        ))}
      </CellGrid>
    </Section>

    <CTA {...ctaProps.nl} />
  </main>
</Layout>
