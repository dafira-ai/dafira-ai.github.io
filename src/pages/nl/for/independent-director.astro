---
import Layout from '../../../layouts/Layout.astro';
import RoleLanding from '../../../components/industries/RoleLanding.astro';
import { customerQuote, readCaseLabel } from '../../../components/industries/customerQuotes';

const hero = {
  eyebrow: 'Voor onafhankelijke bestuurders',
  title: 'Onafhankelijk toezicht, met de juiste informatie',
  lead: 'Lees het bestuursdossier op elk toestel, bespreek zaken met andere niet-uitvoerende bestuurders in een privéruimte en vind eerdere besluiten terug wanneer u ze nodig hebt.',
  primary: { text: 'Demo aanvragen', href: '/nl/request-demo' },
  secondary: { text: 'Contact opnemen', href: '/nl/contact' },
  screenshot: { src: '/onboarding-private-chat.png', alt: 'Privéberichten tussen bestuursleden in Dafira' },
};

const challenges = {
  title: 'Wat onafhankelijke bestuurders nodig hebben',
  lead: 'Onafhankelijkheid vraagt dezelfde informatie als het management, en ruimte om die te bespreken.',
  items: [
    { icon: 'scale', title: 'Onafhankelijk blijven', text: 'Privéruimtes en gesprekken, gescheiden van het uitvoerend management.' },
    { icon: 'search', title: 'Doeltreffend toezicht', text: 'Toegang tot de bestuursstukken, eerdere notulen en besluiten om onderbouwde vragen te stellen.' },
    { icon: 'users', title: 'Overleg onder collega’s', text: 'Privégesprekken waarin onafhankelijke bestuurders zaken voor de vergadering voorbereiden.' },
    { icon: 'clipboard', title: 'Belangenconflicten', text: 'Een spoor van wie welk document raadpleegde en van gemelde belangen, bewaard bij de notulen.' },
  ],
};

const features = {
  title: 'Functies voor onafhankelijke bestuurders',
  lead: 'Wat Dafira biedt om onafhankelijk toezicht te ondersteunen.',
  items: [
    { icon: 'chat', title: 'Privécommunicatie', text: 'Beveiligde kanalen voor overleg tussen onafhankelijke bestuurders.', items: ['Privégesprekken', 'Aparte documentruimtes', 'Beveiligde berichten'] },
    { icon: 'documents', title: 'Toezichtstools', text: 'Alles wat nodig is om de onderneming tussen vergaderingen te volgen.', items: ['Documentgeschiedenis', 'Besluitenregister', 'Opvolging van actiepunten', 'Privé-annotaties'] },
    { icon: 'sparkle', title: 'AI-assistent', text: 'Stel vragen over de bestuursstukken en krijg samenvattingen van lange documenten voor de vergadering.', items: ['Vragen over bestuursdocumenten', 'Samenvattingen van lange stukken'] },
  ],
};

const security = {
  title: 'Beveiliging en vertrouwelijkheid',
  lead: 'De gesprekken van onafhankelijke bestuurders blijven privé.',
  link: { text: 'Meer over beveiliging', href: '/nl/security' },
  items: [
    { icon: 'lock', title: 'Beveiligde toegang', text: 'Rolgebaseerde rechten houden de ruimtes van onafhankelijke bestuurders gescheiden van andere gebruikers.' },
    { icon: 'clipboard', title: 'Audittrail', text: 'Een spoor van documenttoegang en wijzigingen, voor transparantie.' },
    { icon: 'shield', title: 'Gegevensbescherming', text: 'Versleuteling tijdens transport en in opslag, en praktijken voor gegevensbescherming in lijn met de AVG.' },
  ],
};

const quote = { ...customerQuote('nl', 'nathalie'), linkText: readCaseLabel.nl };
---

<Layout title="Bestuurssoftware voor onafhankelijke bestuurders | Dafira" description="Bestuursportaal voor onafhankelijke bestuurders: privéruimtes voor overleg, toegang tot bestuursstukken en eerdere besluiten, en een AI-assistent voor lange documenten.">
  <main>
    <RoleLanding hero={hero} challenges={challenges} features={features} security={security} quote={quote} />
  </main>
</Layout>
