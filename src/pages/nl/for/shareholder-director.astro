---
import Layout from '../../../layouts/Layout.astro';
import RoleLanding from '../../../components/industries/RoleLanding.astro';
import { customerQuote, readCaseLabel } from '../../../components/industries/customerQuotes';

const hero = {
  eyebrow: 'Voor aandeelhouder-bestuurders',
  title: 'Vertegenwoordig aandeelhouders, met een duidelijk register',
  lead: 'Breng de belangen van de aandeelhouders die u vertegenwoordigt in evenwicht met die van de onderneming. Dafira bewaart bestuursstukken, besprekingen en besluiten op één beveiligde plek, met toegang per rol.',
  primary: { text: 'Demo aanvragen', href: '/nl/request-demo' },
  secondary: { text: 'Contact opnemen', href: '/nl/contact' },
  screenshot: { src: '/onboarding-boardpack.png', alt: 'Bestuursdossier in Dafira per agendapunt, met annotaties op de notulen' },
};

const challenges = {
  title: 'Wat aandeelhouder-bestuurders nodig hebben',
  lead: 'Een aandeelhouder vertegenwoordigen in het bestuur betekent verschillende verwachtingen tegelijk behartigen.',
  items: [
    { icon: 'scale', title: 'Belangen afwegen', text: 'De verwachtingen van aandeelhouders afwegen tegen de noden van de onderneming, met de feiten voor u.' },
    { icon: 'users', title: 'Relatie met belanghebbenden', text: 'Het contact met de aandeelhouders die u vertegenwoordigt gestructureerd en gedocumenteerd houden.' },
    { icon: 'mail', title: 'Heldere communicatie', text: 'Informatie tijdig delen met respect voor de vertrouwelijkheid van bestuurszaken.' },
    { icon: 'tasks', title: 'Opvolging van vragen', text: 'Vragen en actiepunten uit het bestuur opvolgen tot ze afgerond zijn.' },
  ],
};

const features = {
  title: 'Functies voor aandeelhouder-bestuurders',
  lead: 'Wat Dafira biedt om de rol te ondersteunen.',
  items: [
    { icon: 'chat', title: 'Beveiligde communicatie', text: 'Bestuursgesprekken op één plek in plaats van e-mail en berichtenapps.', items: ['Beveiligde bestuurschat', 'Gecontroleerd delen van documenten', 'Nieuwsfeed voor updates'] },
    { icon: 'folder', title: 'Documentenbibliotheek', text: 'Bestuursstukken, notulen en besluiten, geordend en doorzoekbaar.', items: ['Bestuursdossier per agendapunt', 'Toegang per rol', 'Eerdere notulen en besluiten', 'Zoeken'] },
    { icon: 'sparkle', title: 'AI-assistent', text: 'Stel vragen over de bestuursstukken en krijg samenvattingen van lange documenten.', items: ['Vragen over bestuursdocumenten', 'Samenvattingen van lange stukken'] },
  ],
};

const security = {
  title: 'Governance en vertrouwelijkheid',
  lead: 'Deel wat gedeeld moet worden, en houd daar een spoor van bij.',
  link: { text: 'Meer over beveiliging', href: '/nl/security' },
  items: [
    { icon: 'lock', title: 'Toegangsbeheer', text: 'Rechten per bestuur, comité en rol bepalen wie welke informatie ziet.' },
    { icon: 'vote', title: 'Stemmingen en besluiten', text: 'Stemmingen en resoluties vastgelegd bij de vergadering, in een besluitenregister.' },
    { icon: 'document', title: 'Documentatie', text: 'Notulen, besluiten en bestuursstukken samen bewaard, met een audittrail.' },
  ],
};

const quote = { ...customerQuote('nl', 'pierre'), linkText: readCaseLabel.nl };
---

<Layout title="Bestuurssoftware voor aandeelhouder-bestuurders | Dafira" description="Bestuursportaal voor aandeelhouder-bestuurders: beveiligde bestuurscommunicatie, geordende bestuursstukken en een duidelijk register van stemmingen en besluiten.">
  <main>
    <RoleLanding hero={hero} challenges={challenges} features={features} security={security} quote={quote} />
  </main>
</Layout>
