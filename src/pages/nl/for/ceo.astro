---
import Layout from '../../../layouts/Layout.astro';
import RoleLanding from '../../../components/industries/RoleLanding.astro';
import { customerQuote, readCaseLabel } from '../../../components/industries/customerQuotes';

const hero = {
  eyebrow: 'Voor CEO’s',
  title: 'Houd het bestuur geïnformeerd, op uw voorwaarden',
  lead: 'Bepaal wat het bestuur bereikt en wanneer. Dafira biedt u één gecontroleerd kanaal voor bestuursstukken, updates en opvolging, met toegang per rol.',
  primary: { text: 'Demo aanvragen', href: '/nl/request-demo' },
  secondary: { text: 'Contact opnemen', href: '/nl/contact' },
  screenshot: { src: '/onboarding-event-detail.png', alt: 'Vergaderpagina in Dafira met de agenda, aanwezigheden en een openstaande stemming over de notulen' },
};

const challenges = {
  title: 'Wat CEO’s van het bestuursproces nodig hebben',
  lead: 'Het bestuur is voor zijn informatie afhankelijk van het management. De manier waarop die gedeeld wordt, bepaalt de kwaliteit van de bespreking.',
  items: [
    { icon: 'folder', title: 'Controle over informatie', text: 'Eén bibliotheek voor alles wat het bestuur ontvangt, zodat u weet welke versie elke bestuurder gelezen heeft.' },
    { icon: 'clock', title: 'Tijdige communicatie', text: 'Updates en bestuursstukken op tijd verspreiden, zonder lange e-mailketens.' },
    { icon: 'list', title: 'Evenwichtige informatie', text: 'Het bestuursdossier per agendapunt ordenen, zodat bestuurders vinden wat telt zonder overladen te worden.' },
    { icon: 'chat', title: 'Bereikbaarheid', text: 'Vragen van bestuurders tussen vergaderingen beantwoorden in een beveiligde bestuurschat, met de context erbij.' },
  ],
};

const features = {
  title: 'Tools voor de CEO',
  lead: 'De onderdelen van Dafira die CEO’s het vaakst gebruiken.',
  items: [
    { icon: 'documents', title: 'Documentcontrole', text: 'Bestuursstukken vanuit één plek delen en bijhouden wat verstuurd werd.', items: ['Gecontroleerde verspreiding', 'Bestuursdossier per agendapunt', 'Meldingen bij updates', 'Versiegeschiedenis'] },
    { icon: 'sparkle', title: 'AI-assistent', text: 'Bestuurders kunnen vragen stellen over de bestuursstukken en samenvattingen van lange documenten krijgen.', items: ['Vragen over bestuursdocumenten', 'Samenvattingen van lange stukken', 'Zoeken in eerdere vergaderingen'] },
    { icon: 'lock', title: 'Beveiligde communicatie', text: 'Bestuursgesprekken weg van persoonlijke e-mail en berichtenapps.', items: ['Beveiligde bestuurschat', 'Toegang per rol', 'Audittrail'] },
  ],
};

const security = {
  title: 'Beveiliging van de bestuurscommunicatie',
  lead: 'Bestuursinformatie blijft binnen het bestuur.',
  link: { text: 'Meer over beveiliging', href: '/nl/security' },
  items: [
    { icon: 'lock', title: 'Versleuteling', text: 'Gegevens worden versleuteld tijdens transport en in opslag, op de infrastructuur van Microsoft Azure.' },
    { icon: 'users', title: 'Toegangsbeheer', text: 'Rechten per bestuur, comité en rol, zodat informatie alleen de bedoelde personen bereikt.' },
    { icon: 'clipboard', title: 'Audittrail', text: 'Een spoor van de toegang tot documenten en van de genomen besluiten.' },
  ],
};

const quote = { ...customerQuote('nl', 'pierre'), linkText: readCaseLabel.nl };
---

<Layout title="Bestuurssoftware voor CEO's | Dafira" description="Bestuursportaal voor CEO's: bepaal hoe informatie het bestuur bereikt, verspreid updates op tijd en houd de bestuurscommunicatie beveiligd.">
  <main>
    <RoleLanding hero={hero} challenges={challenges} features={features} security={security} quote={quote} />
  </main>
</Layout>
