---
import Layout from '../../../layouts/Layout.astro';
import PreviewCard from '../../../components/templates/minutes/PreviewCard.astro';
import TemplateForm from '../../../components/templates/minutes/TemplateForm.astro';
import FeatureComparison from '../../../components/templates/minutes/FeatureComparison.astro';
import { PageHero, Section, CellGrid } from '../../../components/ui';

const previews = [
  { title: "Gestructureerde opbouw", description: "Duidelijke secties voor agenda, besprekingen en besluiten", icon: "list" },
  { title: "Compliance-richtlijnen", description: "Aandachtspunten voor de documentatie die een bestuur moet bijhouden", icon: "scale" }
];
---

<Layout
  title="Gratis sjabloon voor bestuursnotulen | Professioneel formaat"
  description="Download een gratis sjabloon voor bestuursnotulen met duidelijke secties voor agenda, besprekingen en besluiten, inclusief tips over best practices en compliance."
>
  <main>
    <PageHero eyebrow="Gratis sjabloon" title="Sjabloon voor bestuursnotulen" lead="Een duidelijke, gebruiksklare structuur voor uw notulen, met richtlijnen over best practices en documentatievereisten.">
      <CellGrid columns={2} class="mt-10">
        {previews.map((preview) => <PreviewCard {...preview} />)}
      </CellGrid>
      <TemplateForm slot="aside" />
    </PageHero>

    <Section space="md">
      <div class="max-w-2xl mb-12">
        <h2 class="text-3xl lg:text-4xl font-semibold text-navy leading-tight">Een goed begin. Dafira doet de rest.</h2>
        <p class="mt-4 text-lg text-gray-600 leading-relaxed">Van opname tot ondertekende notulen, op één plek.</p>
      </div>
      <FeatureComparison />
    </Section>
  </main>
</Layout>
