---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import ResourceHub from '../../components/resources/ResourceHub.astro';

const copy = {
  eyebrow: 'Kenniscentrum',
  title: 'Handleidingen, onderzoek en gesprekken over bestuur',
  lead: 'Handleidingen voor Dafira, onderzoek naar AI in de bestuurskamer, artikelen en podcastafleveringen voor bestuurssecretarissen, bestuurders en governanceprofessionals.',
  overview: [
    { icon: 'mic', title: 'Podcasts', text: 'Gesprekken over modern bestuursbeheer.', href: '/nl/podcast', linkText: 'Luister afleveringen' },
    { icon: 'document', title: 'Artikelen', text: 'Praktische artikelen over governance en bestuurswerk.', href: '/nl/blog', linkText: 'Lees artikelen' },
    { icon: 'chart', title: 'Onderzoek', text: 'Onderzoeksrapporten en whitepapers.', href: '/nl/research/boardroom-ai-adoption', linkText: 'Bekijk onderzoek' },
    { icon: 'book', title: 'Handleidingen', text: 'Stapsgewijze hulp voor Dafira-gebruikers.', href: '/nl/guides', linkText: 'Verken handleidingen' },
  ],
  podcasts: { title: 'Laatste afleveringen', link: '/nl/podcast', linkText: 'Alle podcasts' },
  articles: { title: 'Laatste artikelen', link: '/nl/blog', linkText: 'Alle artikelen' },
  readMore: 'Lezen',
};

const categories = [
  {
    eyebrow: 'Handleidingen',
    title: 'Handleidingen en tutorials',
    description: 'Stapsgewijze handleidingen om het beste uit Dafira te halen.',
    link: '/nl/guides',
    linkText: 'Alle handleidingen',
    resources: [
      { title: 'Aan de slag met Dafira', description: 'Dafira opzetten en gebruiken met uw bestuur.', type: 'Handleiding', readTime: '10 min leestijd', image: '/applications-picture-meeting.png', link: '/nl/guides/getting-started' },
      { title: 'Authenticatie & beveiliging', description: 'Toegang en beveiliging voor uw bestuursleden beheren.', type: 'Handleiding', readTime: '8 min leestijd', image: '/en-authentication.jpg', link: '/nl/guides/authentication' },
      { title: 'Uw profiel beheren', description: 'Uw Dafira-profiel aanpassen en bijhouden.', type: 'Handleiding', readTime: '5 min leestijd', image: '/profile-management.jpg', link: '/nl/guides/profile-management' },
    ],
  },
  {
    eyebrow: 'Onderzoek',
    title: 'Whitepapers en onderzoek',
    description: 'Diepgaande analyses en onderzoek naar bestuursbeheer.',
    resources: [
      { title: 'De toekomst van AI in de bestuurskamer', description: 'Onderzoeksrapport over de uitdagingen en kansen van AI-adoptie in bestuursbeheer.', type: 'Onderzoek', readTime: '10 min leestijd', image: '/resources.png', link: '/nl/research/boardroom-ai-adoption' },
    ],
  },
];

const now = Date.now();
const posts = (await getCollection('blog'))
  .filter((p) => p.data.pubDate.getTime() <= now && p.data.lang === 'nl')
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 3);
const podcasts = (await getCollection('podcast'))
  .filter((p) => p.data.pubDate.getTime() <= now)
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 3);
---

<Layout title="Kennisbank - Dafira Bestuurssoftware" description="Handleidingen, onderzoek, artikelen en podcasts over bestuursbeheer en governance, door het Dafira-team." image="/resources.png">
  <ResourceHub lang="nl" copy={copy} categories={categories} posts={posts} podcasts={podcasts} />
</Layout>
