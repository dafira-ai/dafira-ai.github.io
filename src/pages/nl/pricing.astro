---

<Layout title="Prijzen - Dafira Bestuurssoftware" description="Eenvoudige en transparante prijzen vanaf €149/maand. Kies het pakket dat bij uw bestuur past." >
  <main>
    <PageHero
      eyebrow="Prijzen"
      title="Eenvoudige en transparante prijzen"
      lead="Drie pakketten op dezelfde beveiligde basis. Alle pakketten bevatten onze kernfuncties; u kiest hoe ver u gaat in samenwerking, compliance en ondersteuning."
    />

    <Section space="md">
      <PricingTiers {...pricingTexts} />
    </Section>

    <Section tone="surface" border="top">
      <SectionHeader eyebrow="Onboarding en ondersteuning" title="Ondersteuning en training bij elke stap" lead="Elk pakket omvat onboarding, training en ondersteuning door ons team." />
      <FeatureColumns items={supportColumns} />
    </Section>

    <FAQ texts={faqData} />

    <CTA {...ctaProps} />
  </main>
</Layout>
