---
import Layout from '../../layouts/Layout.astro';
import MinuteBuilderSavings from '../../components/campaigns/MinuteBuilderSavings.astro';

const t = {
  hero: {
    eyebrow: 'AI-notulenbouwer',
    title: 'Van uren handmatige notities naar een gestructureerd concept van de notulen',
    lead: 'Bestuurssecretarissen besteden na elke vergadering lange avonden aan het opstellen, herschrijven en afstemmen van notulen. Met de AI-notulenbouwer van Dafira begint u kort na de vergadering met een gestructureerd, in de EU gehost concept, dat u daarna nakijkt en publiceert.',
    primary: { text: 'Start gratis proefperiode', href: '/nl/try' },
    secondary: { text: 'Boek een demo', href: '/nl/request-demo' },
    note: 'Geen creditcard nodig · EU-gehost · AVG-conform',
  },
  card: {
    title: 'Conceptnotulen · Raad van bestuur',
    meta: 'Gegenereerd na de vergadering',
    rows: [
      { label: 'Punt 1', text: 'Goedkeuring vorige notulen', tone: 'ok' as const, status: 'Besluit' },
      { label: 'Punt 2', text: 'Jaarrekening H1 toegelicht door de CFO', tone: 'neutral' as const, status: 'Kennisname' },
      { label: 'Punt 3', text: 'Resolutie 2026-14 · Capex-budget', tone: 'ok' as const, status: 'Resolutie' },
      { label: 'Punt 4', text: 'Leveranciersaanbesteding voorbereiden · CFO', tone: 'info' as const, status: 'Actie' },
    ],
    footer: 'Concept klaar voor nazicht door de secretaris',
    footerMeta: 'Nog niet gepubliceerd',
    caption: 'Voorbeeldconcept',
  },
  pain: {
    eyebrow: 'Verloren tijd',
    title: 'Stop met tijd verspillen, focus op beslissingen',
    lead: 'Handmatige notulen vertragen besturen. Dafira verandert dit: u begint met een concept dat klaar is voor nazicht, niet met een blanco pagina.',
    items: [
      { icon: 'clock', title: 'Uren werk na de vergadering', text: 'Bestuurssecretarissen besteden hele avonden aan het uitwerken van notities, het opmaken van documenten en het controleren of niets gemist is.' },
      { icon: 'document', title: 'Inconsistente concepten en meerdere versies', text: 'Handmatige notulen leiden tot onvolledige verslagen, gemiste beslissingen en eindeloze revisierondes.' },
      { icon: 'warning', title: 'Risico op fouten of gemiste beslissingen', text: 'Resoluties en actiepunten raken verloren in handgeschreven notities of verspreide digitale documenten.' },
      { icon: 'calendar', title: 'Druk om notulen snel af te ronden', text: 'Governance-vereisten vragen een snelle afhandeling, wat met handmatige processen moeilijk is.' },
    ],
  },
  changes: {
    eyebrow: 'Wat verandert',
    title: 'Tijd terug na elke vergadering met de AI-notulenbouwer',
    lead: 'Het werk verschuift van schrijven naar nakijken. De secretaris houdt de eindtekst in handen.',
    items: [
      { icon: 'sparkle', title: 'Een concept kort na de vergadering', text: 'Ontvang een gestructureerd concept dat uw agenda volgt zodra de vergadering eindigt.' },
      { icon: 'pen', title: 'Nakijken, niet herschrijven', text: 'U valideert en verfijnt in plaats van opnieuw te beginnen. De redactionele controle blijft bij u.' },
      { icon: 'gavel', title: 'Gemaakt voor bestuursvergaderingen', text: 'Ontworpen voor governance in plaats van generieke transcriptie: het herkent beslissingen, acties en resoluties.' },
      { icon: 'users', title: 'In één stap naar de bestuurders', text: 'Deel de definitieve notulen met alle bestuurders via het beveiligde, AVG-conforme platform.' },
    ],
    link: { text: 'Ontdek hoe de AI-notulenbouwer werkt', href: '/nl/features/ai-minute-builder' },
  },
  compare: {
    eyebrow: 'Voor en na',
    title: 'Voor en na Dafira',
    lead: 'Waar de tijd naartoe gaat na een bestuursvergadering, en wat verandert wanneer u vertrekt van een AI-concept.',
    headers: ['Taak', 'Voor Dafira', 'Met Dafira'],
    rows: [
      ['Notulen opstellen', 'Na de vergadering uitgeschreven uit notities', 'AI-concept gegenereerd uit de vergadering'],
      ['Herschrijven en afstemmen', 'Meerdere rondes van correcties en versies', 'Eén nazicht van een gestructureerd concept'],
      ['Delen met bestuurders', 'E-mails en bijlagen', 'Vanuit het platform gepubliceerd aan de bestuurders'],
    ],
    cta: { text: 'Boek een demo', href: '/nl/request-demo' },
  },
  trust: {
    eyebrow: 'Europees vertrouwen',
    title: 'Waarom Europese besturen Dafira vertrouwen',
    lead: 'Dafira is ontworpen voor Europese besturen en de Europese regels voor gegevensbescherming.',
    items: [
      { icon: 'globe', title: 'EU-hosting en AVG-naleving', text: 'De gegevens van uw bestuur worden in Europa gehost.' },
      { icon: 'lock', title: 'Versleuteling en gecertificeerde infrastructuur', text: 'Versleutelde gegevens op ISO 27001-gecertificeerde hostinginfrastructuur.' },
      { icon: 'users', title: 'Onbeperkt aantal gebruikers', text: 'Geen kosten per gebruiker voor bestuurders en gasten.' },
      { icon: 'sparkle', title: 'AI ingebouwd in het platform', text: 'De notulenbouwer maakt deel uit van Dafira en is geen aparte add-on.' },
    ],
  },
  alternatives: {
    eyebrow: 'Platformen vergelijken',
    title: 'Dafira vs OnBoard vs Diligent',
    lead: 'Evalueert u bestuursportalen? Onze vergelijkingspagina’s zetten de verschillen in hosting, prijsmodel en AI-functies op een rij.',
    cards: [
      { title: 'Dafira vs OnBoard', text: 'Hosting, prijzen en AI-notulen vergeleken.', href: '/nl/vs/onboard' },
      { title: 'Dafira vs Diligent', text: 'Hosting, prijzen en AI-notulen vergeleken.', href: '/nl/vs/diligent' },
    ],
  },
  faq: {
    title: 'Veelgestelde vragen',
    subtitle: 'Over AI-ondersteunde bestuursnotulen',
    inLanguage: 'nl',
    faqs: [
      { question: 'Hoe snel kan AI notulen genereren?', answer: 'Dafira maakt binnen enkele minuten na afloop van de vergadering een concept, zodat de secretaris vertrekt van een gestructureerde tekst in plaats van een blanco pagina.' },
      { question: 'Kunnen AI-notulen een secretaris vervangen?', answer: 'Nee. AI doet het zware werk, maar secretarissen houden de controle over nazicht, validatie en publicatie.' },
      { question: 'Is het veilig om AI bestuursnotulen te laten verwerken?', answer: 'Ja. Dafira is EU-gebaseerd, AVG-conform en versleuteld. Uw gegevens worden in Europa gehost.' },
      { question: 'Wat als ik de notulen moet aanpassen?', answer: 'U kunt nakijken, bewerken en context toevoegen. Het AI-concept is een startpunt, geen vaste uitvoer.' },
    ],
  },
  cta: {
    texts: {
      title: 'Bespaar uren na elke bestuursvergadering',
      subtitle: 'Start een gratis proefperiode of boek een demo met uw eigen agenda. Geen creditcard nodig.',
      cta1: 'Boek een demo',
      cta2: 'Start gratis proefperiode',
    },
    links: { cta1: '/nl/request-demo', cta2: '/nl/try' },
  },
};
---

<Layout
  title="AI-notulengenerator – Bespaar uren | Dafira"
  description="Van uren handmatige notities naar een gestructureerd concept van de notulen. De AI-notulenbouwer van Dafira voor bestuurssecretarissen. EU-gebaseerd, AVG-conform."
>
  <main>
    <MinuteBuilderSavings t={t} />
  </main>
</Layout>
