---
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import PodcastIndex from '../../../components/podcast/PodcastIndex.astro';

const episodes = (await getCollection('podcast'))
  .filter((episode) => episode.data.pubDate.getTime() <= Date.now())
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Layout title="Bestuur in de praktijk - Podcast Dafira" description="Gesprekken over modern bestuursbeheer, governance en digitale transformatie.">
  <main>
    <PodcastIndex lang="nl" episodes={episodes} />
  </main>
</Layout>
