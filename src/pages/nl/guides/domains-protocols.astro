---
import Layout from '../../../layouts/Layout.astro';
import GuideHeader from '../../../components/guides/GuideHeader.astro';
import GuideArticle from '../../../components/guides/GuideArticle.astro';
import { Button, Icon } from '../../../components/ui';
import GuideStep from '../../../components/guides/GuideStep.astro';
import GuideSubSection from '../../../components/guides/GuideSubSection.astro';
import GuideStepList from '../../../components/guides/GuideStepList.astro';
import ProTip from '../../../components/guides/ProTip.astro';

const netwerkVereisten = [
  "HTTPS-verkeer (poort 443) toestaan voor alle domeinen",
  "WSS-verkeer (poort 443) toestaan voor api.dafira.ai",
  "Firewallregels configureren voor toegang",
  "DNS-resolutie verzekeren voor alle domeinen",
  "Connectiviteit testen met alle vereiste domeinen"
];

const probleemoplossingsStappen = [
  "Controleer uw internetverbinding",
  "Verifieer firewallinstellingen", 
  "Wis browser cache en cookies",
  "Probeer een andere browser",
  "Neem contact op met IT bij aanhoudende problemen"
];
---

<Layout title="Domeinen en Protocollen Gids - Dafira">
  <main>
    <GuideHeader
        title="Inzicht in Dafira's Domeinen en Protocollen"
        description="Complete handleiding over de domeinen en protocollen die Dafira gebruikt, inclusief netwerkvereisten en probleemoplossingstips."
      />
    <GuideArticle>

      <GuideStep
        number={1}
        title="Overzicht Kerndomeinen"
        description="Leer meer over de essentiële domeinen die Dafira's functionaliteit mogelijk maken:"
      >
        <div class="space-y-6">

          <div class="border border-line rounded-md p-6">
            <div class="flex items-start gap-4">
              <Icon name="folder" class="w-5 h-5 text-navy mt-1" />
              <div>
                <h4 class="font-semibold text-navy mb-2">Opslagdomein</h4>
                <p class="text-gray-600 mb-2">stgovrnprodfr001.blob.core.windows.net</p>
                <p class="text-sm text-gray-500">Beveiligde opslag voor statische bestanden en documenten</p>
              </div>
            </div>
          </div>

          <div class="border border-line rounded-md p-6">
            <div class="flex items-start gap-4">
              <Icon name="link" class="w-5 h-5 text-navy mt-1" />
              <div>
                <h4 class="font-semibold text-navy mb-2">API Domein</h4>
                <p class="text-gray-600 mb-2">prod.api.ongovrn.com</p>
                <p class="text-sm text-gray-500">Backend diensten en gegevensverwerking</p>
              </div>
            </div>
          </div>

          <div class="border border-line rounded-md p-6">
            <div class="flex items-start gap-4">
              <Icon name="refresh" class="w-5 h-5 text-navy mt-1" />
              <div>
                <h4 class="font-semibold text-navy mb-2">WebSocket Domein</h4>
                <p class="text-gray-600 mb-2">api.dafira.ai</p>
                <p class="text-sm text-gray-500">Realtime updates en notificaties</p>
              </div>
            </div>
          </div>

          <div class="border border-line rounded-md p-6">
            <div class="flex items-start gap-4">
              <Icon name="pen" class="w-5 h-5 text-navy mt-1" />
              <div>
                <h4 class="font-semibold text-navy mb-2">Handtekeningdomein</h4>
                <p class="text-gray-600 mb-2">apps.universign.com</p>
                <p class="text-sm text-gray-500">Integratie van elektronische handtekeningen</p>
              </div>
            </div>
          </div>
        </div>

        <ProTip
          tip="Voeg deze domeinen toe aan de allowlist van uw IT-team om ononderbroken toegang tot Dafira te garanderen."
        />
      </GuideStep>

      <GuideStep
        number={2}
        title="Netwerkvereisten"
        description="Zorg ervoor dat uw netwerk correct is geconfigureerd voor het gebruik van Dafira:"
      >
        <div class="mb-8">
          <GuideStepList items={netwerkVereisten} />
        </div>

        <GuideSubSection title="Protocol Details">
          <div class="grid md:grid-cols-2 gap-4">
            <div class="border border-line rounded-md p-5">
              <h4 class="font-semibold text-navy mb-2">HTTPS (Poort 443)</h4>
              <ul class="text-sm text-gray-600 space-y-1">
                <li>Beveiligd webverkeer</li>
                <li>Versleutelde gegevensoverdracht</li>
                <li>Vereist voor alle domeinen</li>
              </ul>
            </div>
            <div class="border border-line rounded-md p-5">
              <h4 class="font-semibold text-navy mb-2">WSS (Poort 443)</h4>
              <ul class="text-sm text-gray-600 space-y-1">
                <li>Realtime communicatie</li>
                <li>Live updates</li>
                <li>Vereist voor api.dafira.ai</li>
              </ul>
            </div>
          </div>
        </GuideSubSection>
      </GuideStep>

      <GuideStep
        number={3}
        title="Verbindingsproblemen Oplossen"
        description="Volg deze stappen als u verbindingsproblemen ervaart:"
      >
        <div class="mb-8">
          <GuideStepList items={probleemoplossingsStappen} />
        </div>

        <ProTip
          tip="Gebruik de ontwikkelaarstools van uw browser (F12) om geblokkeerde verzoeken of verbindingsfouten te controleren."
        />

        <GuideSubSection title="Veelvoorkomende Problemen">
          <div class="space-y-4">
            <div class="border border-line rounded-md p-5">
              <h4 class="font-semibold text-navy mb-2">Verbinding Time-out</h4>
              <p class="text-sm text-gray-600">Duidt meestal op een firewall-probleem of netwerkbeperking. Neem contact op met uw IT-team om domeintoegang te verifiëren.</p>
            </div>
            <div class="border border-line rounded-md p-5">
              <h4 class="font-semibold text-navy mb-2">WebSocket Fout</h4>
              <p class="text-sm text-gray-600">Controleer of uw netwerk WebSocket-verbindingen toestaat. Sommige bedrijfsnetwerken kunnen deze blokkeren.</p>
            </div>
            <div class="border border-line rounded-md p-5">
              <h4 class="font-semibold text-navy mb-2">SSL-certificaat Fout</h4>
              <p class="text-sm text-gray-600">Controleer of de datum en tijd van uw systeem correct zijn en of uw browser up-to-date is.</p>
            </div>
          </div>
        </GuideSubSection>
      </GuideStep>

      <!-- Snelle Referentie -->
      <div class="mt-16 rounded-md p-8 border border-line bg-surface">
        <h2 class="text-2xl font-semibold text-navy mb-4">Snelle Referentie</h2>
        <div class="grid md:grid-cols-2 gap-6">
          <div>
            <h3 class="font-semibold text-navy mb-2">Vereiste Domeinen</h3>
            <ul class="space-y-2 text-gray-600 text-sm">
              <li>stgovrnprodfr001.blob.core.windows.net</li>
              <li>prod.api.ongovrn.com</li>
              <li>api.dafira.ai</li>
              <li>apps.universign.com</li>
            </ul>
          </div>
          <div>
            <h3 class="font-semibold text-navy mb-2">Vereiste Poorten</h3>
            <ul class="space-y-2 text-gray-600 text-sm">
              <li>HTTPS: 443 (TCP)</li>
              <li>WSS: 443 (TCP)</li>
            </ul>
          </div>
        </div>
      </div>

      <!-- Hulp Sectie -->
      <div class="mt-8 rounded-md p-8 border border-line">
        <h2 class="text-2xl font-semibold text-navy mb-4">Hulp Nodig?</h2>
        <p class="text-gray-600 mb-6">
          Heeft u problemen met de verbinding met Dafira? Ons technische supportteam staat voor u klaar.
        </p>
        <div class="flex flex-wrap gap-3 df-guide-actions">
          <Button href="/nl/contact">Contact Support</Button>
          <Button href="/nl/guides" variant="secondary">Bekijk Alle Handleidingen</Button>
        </div>
      </div>
    </GuideArticle>
  </main>
</Layout>