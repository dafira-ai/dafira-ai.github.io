---
import Layout from '../../../layouts/Layout.astro';
import GuideHeader from '../../../components/guides/GuideHeader.astro';
import GuideArticle from '../../../components/guides/GuideArticle.astro';
import { Button, Icon } from '../../../components/ui';
import GuideStep from '../../../components/guides/GuideStep.astro';
import GuideSubSection from '../../../components/guides/GuideSubSection.astro';
import GuideStepList from '../../../components/guides/GuideStepList.astro';
import ProTip from '../../../components/guides/ProTip.astro';

const groepInstellingStappen = [
  "Ga naar Leden > Groepen in uw dashboard",
  "Klik op 'Nieuwe Groep Aanmaken' om een commissie in te stellen",
  "Geef uw groep een naam (bijv. 'Financiële Commissie', 'Auditcommissie')",
  "Configureer toegangsrechten voor historische gegevens",
  "Sla uw groepsinstellingen op"
];

const ledenUitnodigenStappen = [
  "Ga naar de sectie Leden",
  "Klik op 'Leden Uitnodigen'",
  "Voer e-mailadressen van leden in",
  "Selecteer de juiste rol (Beheerder, Lid of Waarnemer)",
  "Verstuur uitnodigingen"
];

const voorVergaderingStappen = [
  "Plan de vergadering met datum, tijd en locatie",
  "Stel een gedetailleerde agenda op met kernpunten",
  "Upload en organiseer relevante documenten",
  "Verstuur vergaderuitnodigingen naar deelnemers"
];

const tijdensVergaderingStappen = [
  "Neem aanwezigheid op en bevestig quorum",
  "Volg de gestructureerde agenda",
  "Leg belangrijke discussies vast",
  "Gebruik realtime documentensamenwerking",
  "Registreer actiepunten en besluiten"
];

const naVergaderingStappen = [
  "Werk de notulen af",
  "Laat notulen ondertekenen door vereiste deelnemers",
  "Deel goedgekeurde notulen en besluiten",
  "Monitor voortgang van actiepunten",
  "Bereid de volgende vergadering voor"
];
---

<Layout title="Aan de slag met Dafira - Complete Handleiding" description="Welkom bij Dafira—uw complete platform voor efficiënt bestuur en governance. Deze handleiding begeleidt u door de essentiële stappen om te starten en effectieve bestuursvergaderingen te organiseren.">
  <main>
    <GuideHeader
        title="Aan de slag met Dafira: Uw Complete Handleiding"
        description="Welkom bij Dafira—uw complete platform voor efficiënt bestuur en governance. Deze handleiding begeleidt u door de essentiële stappen om te starten en effectieve bestuursvergaderingen te organiseren."
      />
    <GuideArticle>

      <GuideStep
        number={1}
        title="Groepen Instellen"
        description="Groepen in Dafira helpen u bij het organiseren van uw bestuursleden in commissies, zodat de juiste mensen toegang hebben tot de juiste informatie."
      >
        <GuideSubSection title="Groepen aanmaken voor commissies">
          <GuideStepList items={groepInstellingStappen} />
        </GuideSubSection>

        <ProTip
          tip="Let bij het instellen van groepen goed op de toegangsrechten voor historische gegevens om passende informatiedeling te waarborgen met behoud van vertrouwelijkheid."
        />
      </GuideStep>

      <GuideStep
        number={2}
        title="Bestuursleden Uitnodigen"
        description="Voeg uw bestuursleden toe aan Dafira met de juiste rollen en rechten."
      >
        <GuideSubSection title="Proces voor het uitnodigen van leden">
          <GuideStepList items={ledenUitnodigenStappen} />
        </GuideSubSection>

        <ProTip
          tip="Wijs rollen zorgvuldig toe: Beheerders hebben volledige systeemtoegang, Leden hebben standaardtoegang tot hun toegewezen groepen, en Waarnemers hebben beperkte kijkrechten."
        />
      </GuideStep>

      <GuideStep
        number={3}
        title="De Vergadercyclus Beheersen"
        description="Succesvolle bestuursvergaderingen verlopen in drie fasen: Voor, Tijdens en Na. Hier leest u hoe u elke fase effectief beheert met Dafira."
      >
        <GuideSubSection title="Voor de vergadering">
          <p class="text-gray-600 mb-4">Goede voorbereiding zorgt voor productieve vergaderingen. Volg deze stappen voor een succesvolle start:</p>
          <GuideStepList items={voorVergaderingStappen} />
        </GuideSubSection>

        <GuideSubSection title="Tijdens de vergadering">
          <p class="text-gray-600 mb-4">Gebruik Dafira's realtime functies voor efficiënte discussie en besluitvorming:</p>
          <GuideStepList items={tijdensVergaderingStappen} />
        </GuideSubSection>

        <GuideSubSection title="Na de vergadering">
          <p class="text-gray-600 mb-4">Zorg voor opvolging en behoud momentum met deze acties na de vergadering:</p>
          <GuideStepList items={naVergaderingStappen} />
        </GuideSubSection>

        <ProTip
          tip="Gebruik Dafira's documentsamenwerkingsfuncties tijdens alle vergaderfasen om één centrale bron voor alle bestuursmaterialen te behouden."
        />
      </GuideStep>

      <!-- Conclusie -->
      <div class="mt-16 rounded-md p-8 border border-line bg-surface">
        <h2 class="text-2xl font-semibold text-navy mb-4">Klaar voor Effectief Bestuur</h2>
        <p class="text-lg text-gray-600 leading-relaxed mb-6">
          U bent nu uitgerust om Dafira te gebruiken voor effectief bestuursbeheer. Onthoud dat succesvol bestuursbeheer een doorlopend proces is, en Dafira staat klaar om u bij elke stap te ondersteunen.
        </p>
      </div>
    </GuideArticle>
  </main>
</Layout>