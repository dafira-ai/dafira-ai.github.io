---
import Layout from '../../layouts/Layout.astro';
import { PageHero, Section } from '../../components/ui';
import CustomerQuotes from '../../components/case-studies/CustomerQuotes.astro';
import LocalizedCTA from '../../components/case-studies/LocalizedCTA.astro';

const testimonials = [
  {
    industry: "Vzw ter ondersteuning van de non-profitsector",
    title: "Bestuursgovernance met Dafira",
    quote: "Ik ben ervan overtuigd dat een platform als Dafira betere besluitvorming op bestuursniveau mogelijk maakt.",
    author: "Voorzitter",
    href: "/nl/case-studies/non-profit-organisation",
  },
  {
    industry: "Beursgenoteerde modegroep",
    title: "Bestuurswerk op één beveiligde plek",
    quote: "Dafira heeft ons bestuursbeheer getransformeerd door efficiëntie en duidelijkheid te brengen in onze governanceprocessen.",
    author: "General Counsel",
    href: "/nl/case-studies/listed-fashion-group",
  },
  {
    industry: "Regionaal publiek investeringsfonds",
    title: "Één governanceplatform voor publieke en private bestuurders",
    quote: "Dafira heeft een essentiële rol gespeeld bij het moderniseren van onze bestuursstructuur en het verbeteren van onze operationele efficiëntie.",
    author: "CEO",
    href: "/nl/case-studies/public-investment-fund",
  },
  {
    industry: "Beursgenoteerde zorgvastgoedvennootschap",
    title: "Een bestuursportaal dat past bij haar sjablonen, aanwezigheidsregels en talen",
    quote: "Dafira vertegenwoordigt de nieuwe generatie bestuursbeheersoftware, gebruiksvriendelijk en met AI-integratie.",
    author: "Paralegal en compliance officer",
    href: "/nl/case-studies/healthcare-real-estate",
  },
];
---

<Layout
  title="Klantgetuigenissen - Dafira"
  description="Hoe een beursgenoteerde modegroep, een regionaal publiek investeringsfonds, een beursgenoteerde zorgvastgoedvennootschap en een vzw ter ondersteuning van de non-profitsector hun bestuur organiseren met Dafira."
>
  <PageHero
    eyebrow="Klantverhalen"
    title="Hoe besturen werken met Dafira"
    lead="Voorzitters, juristen, compliance officers en CEO's vertellen in hun eigen woorden hoe zij hun bestuur organiseren met Dafira."
  />

  <Section space="lg">
    <CustomerQuotes items={testimonials} linkText="Lees het klantverhaal" />
  </Section>

  <LocalizedCTA />
</Layout>
