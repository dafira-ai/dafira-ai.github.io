const copy = {
  eyebrow: 'Beveiliging',
  title: 'Hoe Dafira bestuursinformatie beschermt',
  lead: 'De beveiligingsmaatregelen in het platform, en de partners op wie we rekenen voor hosting, elektronische handtekening en documentverwerking.',
  heroLink: { text: 'Multi-factor authenticatie', href: '/nl/security/mfa' },
  measures: {
    eyebrow: 'Maatregelen',
    title: 'Beveiliging ingebouwd in het platform',
    lead: 'Controles die bestuursdocumenten, besprekingen en beslissingen beschermen.',
    items: [
      { icon: 'building', title: 'Gehost op Microsoft Azure', text: 'Dafira draait op het cloudplatform van Microsoft Azure en profiteert van de beveiligingsmaatregelen ervan.' },
      { icon: 'shield', title: 'Gegevensbescherming', text: 'Gegevensbeschermingspraktijken conform de AVG en industriestandaarden.' },
      { icon: 'lock', title: 'Versleuteling', text: 'Gegevens worden versleuteld tijdens transport en in rust.' },
      { icon: 'phone', title: 'Multi-factor authenticatie', text: 'Een eenmalige code via SMS voegt een tweede stap toe aan het wachtwoord voordat een gebruiker bestuursinformatie kan openen.', link: { text: 'Zo werkt het', href: '/nl/security/mfa' } },
      { icon: 'key', title: 'Rolgebaseerde toegang', text: 'Toegang wordt per rol beheerd, met een audittrail van de activiteit.' },
    ],
    contact: { title: 'Vragen van uw IT- of risicoteam', text: 'Schrijf ons: we beantwoorden uw vragen over de beveiliging van Dafira.', link: { text: 'Contact opnemen', href: '/nl/contact' } },
  },
  layers: {
    eyebrow: 'Gelaagde beveiliging',
    title: 'Drie beschermingslagen',
    lead: 'Beveiliging op het niveau van infrastructuur, applicatie en gegevens.',
    items: [
      { icon: 'building', title: 'Infrastructuurbeveiliging', text: 'De cloudinfrastructuur van Microsoft Azure.', items: ['Hoogbeschikbare datacenters', 'Netwerkbeveiligingscontroles', 'DDoS-bescherming', 'Regelmatige beveiligingsupdates'] },
      { icon: 'lock', title: 'Applicatiebeveiliging', text: 'Controles op applicatieniveau.', items: ['Tweefactorauthenticatie (2FA)', 'Sessiebeheer', 'Invoervalidatie', 'Beveiligingsheaders'] },
      { icon: 'shield', title: 'Gegevensbescherming', text: 'Maatregelen die opgeslagen gegevens beschermen.', items: ['Versleuteling tijdens transport en in rust', 'Beveiligde opslag', 'Regelmatige back-ups', 'Gegevenstoegangscontroles'] },
    ],
  },
  partners: {
    eyebrow: 'Partners',
    title: 'Met wie we werken',
    lead: 'Gespecialiseerde leveranciers voor hosting, elektronische handtekening en documentverwerking.',
    items: [
      { name: 'Microsoft Azure', logo: '/azure-logo.png', role: 'Infrastructuur', text: 'Onze infrastructuurprovider. Microsoft Azure beschikt onder meer over ISO 27001-, FedRAMP-, SOC- en HIPAA-certificeringen.', items: ['Wereldwijd netwerk van datacenters', 'Bescherming tegen dreigingen', 'Continue beveiligingsmonitoring', 'Compliance-frameworks'] },
      { name: 'Universign', logo: '/universign-logo.png', role: 'Elektronische handtekening', text: 'Onze partner voor elektronische handtekeningen, conform de eIDAS-verordening.', items: ['Gekwalificeerde elektronische handtekeningen', 'Wettelijke compliance', 'Beveiligd documentbeheer', 'Audittrails'] },
      { name: 'Apryse', logo: '/apryse-logo.png', role: 'Documentverwerking', text: 'Onze partner voor documentverwerking, met meerdere compliancecertificeringen.', items: ['Beveiligde documentverwerking', 'Toegangscontrole', 'Versleuteling', 'Compliance-functionaliteiten'] },
    ],
  },
};
---

<Layout title="Beveiliging - Dafira Bestuursbeheersoftware" description="Hoe Dafira bestuursinformatie beschermt: hosting op Microsoft Azure, versleuteling, multi-factor authenticatie via SMS, rolgebaseerde toegang en audittrails, met Universign en Apryse als partners.">
  <SecurityOverview copy={copy} />
</Layout>
