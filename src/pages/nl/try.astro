---
import Layout from '../../layouts/Layout.astro';
import FAQ from '../../components/FAQ.astro';
import { PageHero, Button, Icon } from '../../components/ui';
import { localizePath } from '../../i18n/routes';

const benefits = [
  {
    "icon": "bolt",
    "title": "Volledige toegang",
    "description": "Alle functies van het platform vanaf de eerste dag"
  },
  {
    "icon": "target",
    "title": "Geen creditcard nodig",
    "description": "Test alle functies 14 dagen zonder betalingsgegevens"
  },
  {
    "icon": "users",
    "title": "Toegang voor het hele team",
    "description": "Nodig al uw bestuursleden uit om Dafira te ontdekken"
  },
  {
    "icon": "lock",
    "title": "Enterprise-beveiliging",
    "description": "Versleuteling en beveiliging vanaf dag één"
  }
];

const faqData = {
  "title": "Veelgestelde vragen",
  "subtitle": "Over de gratis proefperiode.",
  "inLanguage": "nl",
  "faqs": [
    {
      "question": "Wat is inbegrepen bij de gratis proefperiode?",
      "answer": "U krijgt gedurende 14 dagen volledige toegang tot alle Dafira-functionaliteiten, inclusief documentbeheer, vergadertools en samenwerkingsfuncties."
    },
    {
      "question": "Is een creditcard nodig?",
      "answer": "Nee, u kunt uw gratis proefperiode starten zonder betalingsgegevens. We informeren u voor het einde van de proefperiode."
    },
    {
      "question": "Wat gebeurt er na de proefperiode?",
      "answer": "Na 14 dagen kunt u kiezen uit een van onze betaalde abonnementen. We helpen u graag bij het kiezen van het plan dat het beste bij uw behoeften past."
    }
  ]
};

const trialHref = `${localizePath('nl', '/request-demo')}?from=trial`;
---

<Layout title="Probeer Dafira gratis - Proefperiode van 14 dagen" description="Probeer Dafira 14 dagen gratis, met begeleiding van ons team. Geen creditcard vereist.">
  <main>
    <PageHero eyebrow="Gratis proefperiode · 14 dagen" title="Start uw gratis proefperiode van Dafira" lead="Probeer Dafira 14 dagen met uw eigen bestuur. Geen creditcard vereist.">
      <dl class="mt-10 grid sm:grid-cols-2 gap-x-8 border-t border-line">
        {benefits.map((b) => (
          <div class="py-5 border-b border-line flex gap-3">
            <Icon name={b.icon} class="w-5 h-5 text-navy mt-0.5" />
            <div>
              <dt class="font-medium text-navy">{b.title}</dt>
              <dd class="mt-1 text-sm text-gray-600 leading-relaxed">{b.description}</dd>
            </div>
          </div>
        ))}
      </dl>

      <div slot="aside" class="border border-line rounded-md bg-white p-6 lg:p-10">
        <Icon name="users" class="w-6 h-6 text-navy" />
        <h2 class="mt-5 text-2xl font-semibold text-navy">Start met begeleiding van een expert</h2>
        <p class="mt-3 text-gray-600 leading-relaxed">Onze expert helpt u bij het opzetten van uw gratis proefperiode, zodat uw bestuur Dafira vanaf dag één kan gebruiken.</p>
        <Button href={trialHref} size="lg" class="mt-8 w-full">Nu beginnen</Button>
        <p class="mt-3 text-sm text-gray-500">Geen verplichting</p>
      </div>
    </PageHero>


    <FAQ texts={faqData} />
  </main>
</Layout>
