---
import Layout from '../../layouts/Layout.astro';
import { PageHero, Section, Prose } from '../../components/ui';

const sections = [
  {
    title: "Gegevensverzameling",
    items: [
      {
        subtitle: "Account- en contactgegevens",
        content: "Bij uw registratie op ons platform verstrekt u vrijwillig bepaalde informatie zoals uw naam, bedrijfsnaam, e-mailadres, telefoonnummer, postadres, sector en wachtwoord. Wij slaan nooit uw bankgegevens op en maken gebruik van PCI-DSS gecertificeerde betalingsdienstaanbieders."
      },
      {
        subtitle: "Sollicitatiegegevens", 
        content: "Voor sollicitaties verzamelen we uw contactgegevens en CV-informatie. We vragen alleen informatie die noodzakelijk is voor het wervingsproces en verzamelen nooit gevoelige gegevens over etnische afkomst, politieke opvattingen, religieuze overtuigingen of seksuele geaardheid."
      },
      {
        subtitle: "Navigatiegegevens",
        content: "We detecteren uw browserinstellingen en locatie om uw ervaring te personaliseren. Onze servers registreren basisinformatie zoals IP-adres, tijd en datum van bezoek, browserversie en verkeersbron voor statistische doeleinden en beveiliging."
      },
      {
        subtitle: "Klantendatabases",
        content: "De informatie in uw Dafira database blijft onder uw controle en exclusieve eigendom. Wij verwerken deze gegevens alleen volgens uw instructies."
      }
    ]
  },
  {
    title: "Gegevensgebruik",
    items: [
      {
        subtitle: "Account- en contactgegevens",
        content: "Gebruikt voor dienstverlening, ondersteuning, facturering en optionele marketingcommunicatie. Deze gegevens kunnen worden gedeeld met organisatoren en sponsors van evenementen als u zich daarvoor inschrijft."
      },
      {
        subtitle: "Sollicitatiegegevens",
        content: "Alleen verwerkt in het kader van werving en contractvoorbereiding bij een succesvolle sollicitatie. U kunt op elk moment verzoeken om verwijdering."
      },
      {
        subtitle: "Navigatiegegevens",
        content: "Anoniem geanalyseerd om onze diensten te verbeteren. Google reCAPTCHA kan worden gebruikt voor beveiliging, waarbij alleen anonieme scores worden verwerkt."
      },
      {
        subtitle: "Klantendatabases",
        content: "Verwerkt volgens uw instructies voor dienstverlening. Ons supportteam kan toegang krijgen voor probleemoplossing of op uw verzoek."
      }
    ]
  },
  {
    title: "Gegevensbewaring",
    items: [
      {
        subtitle: "Account- en contactgegevens",
        content: "Bewaard voor de duur noodzakelijk voor dienstverlening en wettelijke verplichtingen."
      },
      {
        subtitle: "Sollicitatiegegevens",
        content: "Bewaard tot 2 jaar voor mogelijke toekomstige kansen, tenzij anders verzocht. Werknemersgegevens worden bewaard volgens wettelijke verplichtingen."
      },
      {
        subtitle: "Navigatiegegevens",
        content: "Doorgaans 2 maanden bewaard, tenzij langer nodig voor beveiligings- of juridische redenen."
      },
      {
        subtitle: "Klantendatabase",
        content: "Alleen bewaard tijdens actieve dienstverlening. Gedeactiveerde databases worden 3 weken na beëindiging bewaard en daarna vernietigd."
      }
    ]
  }
];

const contactInfo = {
  email: "info@dafira.ai",
  address: "Dafira - Gegevensbescherming\nGasthuisstraat 31\n1000 Brussel, België"
};
---
<Layout title="Privacybeleid - Dafira Bestuurssoftware" description="Wij zetten ons in voor de bescherming van uw privacy en de beveiliging van uw gegevens. Ontdek hoe wij uw informatie verzamelen, gebruiken en beschermen.">
  <main>
    <PageHero eyebrow="Juridisch" title="Privacybeleid" lead="Wij zetten ons in voor de bescherming van uw privacy en de beveiliging van uw gegevens. Ontdek hoe wij uw informatie verzamelen, gebruiken en beschermen." />

    <Section size="prose" space="md">
      <Prose>
        <p class="text-lg">Dafira en haar dochterondernemingen bieden diverse diensten aan om u te helpen bij het beheren van uw organisatie, waaronder een platform voor het hosten van uw Dafira database. Dit beleid legt uit welke informatie we verzamelen, waarom we deze verzamelen en hoe we deze gebruiken.</p>

        {sections.map((section) => (
          <Fragment>
            <h2>{section.title}</h2>
            {section.items.map((item) => (
              <Fragment>
                <h3>{item.subtitle}</h3>
                <p>{item.content}</p>
              </Fragment>
            ))}
          </Fragment>
        ))}

        <h2>Cookies</h2>
        <p>Cookies zijn kleine tekstbestanden die door onze servers naar uw computer worden gestuurd wanneer u onze diensten gebruikt. We gebruiken ze om uw navigatie te vergemakkelijken, uw voorkeuren te begrijpen en onze diensten te verbeteren. Diensten van derden zoals Google Analytics kunnen ook cookies gebruiken voor hun eigen doeleinden.</p>
      </Prose>

      <div class="mt-16 border border-line rounded-md bg-surface p-6 lg:p-8 max-w-[68ch]">
        <h2 class="text-2xl font-semibold text-navy">Contact opnemen</h2>
        <p class="mt-3 text-gray-700">Als u vragen heeft over dit privacybeleid of uw persoonsgegevens, aarzel dan niet om contact met ons op te nemen:</p>
        <div class="mt-4 space-y-2 text-gray-700">
              <p>
                <strong>E-mail:</strong> {contactInfo.email}
              </p>
              <p class="whitespace-pre-line">
                <strong>Adres:</strong>
                {contactInfo.address}
              </p>
        </div>
      </div>
    </Section>
  </main>
</Layout>
