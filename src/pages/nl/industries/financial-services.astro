---
import Layout from '../../../layouts/Layout.astro';
import IndustryLanding from '../../../components/industries/IndustryLanding.astro';

const hero = {
  eyebrow: 'Financiële dienstverlening',
  title: 'Bestuurssoftware voor de financiële sector',
  lead: 'Beveiligd, gedocumenteerd bestuurswerk voor banken, verzekeraars en beleggingsondernemingen. Stukken van bestuur en comités, besluiten en handtekeningen op één plek, met toegang per rol.',
};

const challenges = {
  title: 'Waar besturen in de financiële sector mee te maken hebben',
  lead: 'Regelgeving bepaalt mee de agenda, en toezichthouders verwachten een duidelijk register.',
  items: [
    { icon: 'scale', title: 'Regelgevende vereisten', text: 'Teksten zoals DORA, CSRD en de AVG leggen specifieke verantwoordelijkheden bij het bestuur.' },
    { icon: 'shield', title: 'Risicotoezicht', text: 'Risico- en auditcomités hebben voor elke vergadering volledige, actuele informatie nodig.' },
    { icon: 'leaf', title: 'Duurzaamheidsrapportering', text: 'Het bestuur houdt toezicht op de duurzaamheidsverklaring en op hoe die wordt opgesteld.' },
    { icon: 'lock', title: 'Vertrouwelijke informatie', text: 'Bestuursstukken mogen alleen de bedoelde personen bereiken, via een beveiligd kanaal.' },
  ],
};

const features = {
  title: 'Wat Dafira biedt',
  lead: 'Bestuurstools die financiële instellingen gebruiken.',
  items: [
    { icon: 'shield', title: 'Compliance-opvolging', text: 'De regelgevende onderwerpen volgen die het bestuur aangaan, met de bijbehorende documenten.' },
    { icon: 'sparkle', title: 'AI-assistent', text: 'Stel vragen over lange bestuursstukken en krijg samenvattingen voor de vergadering.' },
    { icon: 'folder', title: 'Beveiligd documentbeheer', text: 'Versleutelde opslag en uitwisseling van stukken van bestuur en comités, met toegang per rol.' },
    { icon: 'clipboard', title: 'Audittrail', text: 'Een spoor van de toegang tot documenten en van de genomen besluiten.' },
  ],
};
---

<Layout title="Bestuurssoftware voor Financiële Dienstverlening | Dafira" description="Bestuursportaal voor banken, verzekeraars en beleggingsondernemingen: stukken van bestuur en comités, besluiten en handtekeningen op één beveiligde plek, met het regelgevend kader in beeld.">
  <main>
    <IndustryLanding
      industry="financial-services"
      hero={hero}
      screenshot={{ src: '/onboarding-document-list.png', alt: 'Documentenbibliotheek van Dafira, geordend per vergadering' }}
      challenges={challenges}
      features={features}
      quoteKey="pierre"
      secondary="trial"
    />
  </main>
</Layout>
