---
import Layout from '../../../layouts/Layout.astro';
import IndustryLanding from '../../../components/industries/IndustryLanding.astro';

const hero = {
  eyebrow: 'Zorg',
  title: 'Bestuurssoftware voor zorgorganisaties',
  lead: 'Voor besturen van ziekenhuizen, zorgaanbieders en life-sciencesbedrijven. Bereid besprekingen over kwaliteit, veiligheid en financiën voor en houd vertrouwelijke stukken onder controle.',
};

const challenges = {
  title: 'Waar besturen in de zorg mee te maken hebben',
  lead: 'Klinische, financiële en regelgevende vragen aan dezelfde tafel.',
  items: [
    { icon: 'lock', title: 'Gevoelige informatie', text: 'Bestuursstukken kunnen gezondheidsgegevens bevatten, die de AVG als bijzondere categorie behandelt.' },
    { icon: 'health', title: 'Klinische governance', text: 'Kwaliteit en veiligheid komen op elke vergadering terug en vragen een consequent register.' },
    { icon: 'users', title: 'Veel belanghebbenden', text: 'Bestuursleden, medische staf en directie hebben elk het juiste toegangsniveau nodig.' },
  ],
};

const features = {
  title: 'Wat Dafira biedt',
  lead: 'Bestuurstools die zorgorganisaties gebruiken.',
  items: [
    { icon: 'shield', title: 'Beschermde bestuursstukken', text: 'Toegang per rol, versleuteling en een audittrail, met praktijken voor gegevensbescherming in lijn met de AVG.' },
    { icon: 'layers', title: 'Comités', text: 'Aparte ruimtes voor kwaliteits-, audit- en andere comités, elk met eigen leden.' },
    { icon: 'clipboard', title: 'Terugkerende agendapunten', text: 'Agendasjablonen voor vaste punten zoals kwaliteits- en veiligheidsrapporten.' },
  ],
};
---

<Layout title="Bestuurssoftware voor de zorgsector | Dafira" description="Bestuursportaal voor ziekenhuizen en zorgorganisaties: vertrouwelijke bestuursstukken onder toegangscontrole, comitévergaderingen en gedocumenteerde besluiten.">
  <main>
    <IndustryLanding
      industry="healthcare"
      hero={hero}
      screenshot={{ src: '/onboarding-event-detail.png', alt: 'Vergaderpagina in Dafira met de agenda, aanwezigheden en een stemming' }}
      challenges={challenges}
      features={features}
      secondary="trial"
    />
  </main>
</Layout>
