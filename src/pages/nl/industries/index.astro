---
import Layout from '../../../layouts/Layout.astro';
import { PageHero, Section, Icon, CellGrid, FeatureList, CTA } from '../../../components/ui';
import { ctaProps } from '../../../components/industries/i18n';

const industries = [
  {
    name: 'Financiële dienstverlening',
    icon: 'bank',
    description: 'Beveiligd, gedocumenteerd bestuurswerk voor banken, verzekeraars en beleggingsondernemingen.',
    link: '/nl/industries/financial-services',
    features: ['Regelgevend kader voor het bestuur', 'Beveiligd documentbeheer', 'Vergaderingen van bestuur en comités'],
  },
  {
    name: 'Zorg',
    icon: 'health',
    description: 'Bestuursbeheer voor ziekenhuizen, zorgaanbieders en life-sciencesbedrijven.',
    link: '/nl/industries/healthcare',
    features: ['Vertrouwelijke bestuursstukken', 'Klinische governance op de agenda', 'Comités'],
  },
  {
    name: 'Vastgoed',
    icon: 'building',
    description: 'Bestuursbeheer voor vastgoedbeleggings- en beheerondernemingen.',
    link: '/nl/industries/real-estate',
    features: ['Investeringsdossiers', 'Portefeuilletoezicht', 'Besluitenregister'],
  },
  {
    name: 'Familiebedrijf',
    icon: 'family',
    description: 'Beheer van bestuur en familieraad voor familiebedrijven met meerdere entiteiten.',
    link: '/nl/industries/family-business',
    features: ['Meerdere bestuursorganen', 'Toegang per rol', 'Continuïteit over generaties heen'],
  },
];
---

<Layout title="Sectoroplossingen | Dafira Bestuurssoftware" description="Dafira per sector: bestuursbeheer voor financiële dienstverlening, zorg, vastgoed en familiebedrijven.">
  <main>
    <PageHero eyebrow="Sectoren" title="Bestuursbeheer per sector" lead="De bestuurscyclus is overal dezelfde, de context niet. Bekijk hoe Dafira besturen ondersteunt in gereglementeerde organisaties en familiebedrijven." />

    <Section>
      <CellGrid columns={2}>
        {industries.map((industry) => (
          <a href={industry.link} class="group bg-white p-8 lg:p-10 hover:bg-surface transition-colors flex flex-col">
            <Icon name={industry.icon} class="w-6 h-6 text-navy" />
            <h2 class="mt-5 text-xl font-semibold text-navy">{industry.name}</h2>
            <p class="mt-3 text-gray-600 leading-relaxed">{industry.description}</p>
            <FeatureList items={industry.features} class="mt-6" />
            <span class="mt-auto pt-8 inline-flex items-center gap-2 text-[15px] font-medium text-primary group-hover:text-navy transition-colors">
              Bekijk de sectorpagina
              <svg class="w-4 h-4 rtl-flip" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M9 5l7 7-7 7" />
              </svg>
            </span>
          </a>
        ))}
      </CellGrid>
    </Section>

    <CTA {...ctaProps.nl} />
  </main>
</Layout>
