---

<Layout title="Governancesoftware voor familiebedrijven | Dafira" description="Beheer van bestuur en familieraad voor familiebedrijven met meerdere entiteiten. Gestructureerde governance zonder complexiteit.">
  <main>
    <FamilyBusinessLanding content={content} />
  </main>
</Layout>
