---
import Layout from '../../../layouts/Layout.astro';
import IndustryLanding from '../../../components/industries/IndustryLanding.astro';

const hero = {
  eyebrow: 'Vastgoed',
  title: 'Bestuurssoftware voor vastgoed',
  lead: 'Voor besturen van vastgoedbeleggings- en beheerondernemingen. Investeringsdossiers, bestuursbesprekingen en besluiten samen bewaard, voor elk actief.',
};

const challenges = {
  title: 'Waar vastgoedbesturen mee te maken hebben',
  lead: 'Langlopende verbintenissen die een duidelijk besluitvormingsspoor vragen.',
  items: [
    { icon: 'building', title: 'Portefeuilletoezicht', text: 'Een portefeuille van activa opvolgen via regelmatige bestuursstukken en rapporten.' },
    { icon: 'trend', title: 'Investeringsbesluiten', text: 'Aankoop-, verkoop- en ontwikkelingsdossiers doornemen voordat er beslist wordt.' },
    { icon: 'users', title: 'Investeerders en partners', text: 'Informatie delen met elke groep belanghebbenden op het juiste toegangsniveau.' },
  ],
};

const features = {
  title: 'Wat Dafira biedt',
  lead: 'Bestuurstools die vastgoedondernemingen gebruiken.',
  items: [
    { icon: 'folder', title: 'Documentbeheer', text: 'Centrale opslag van investeringsdossiers en bestuursstukken, geordend per vergadering en agendapunt.' },
    { icon: 'sparkle', title: 'AI-assistent', text: 'Stel vragen over lange investeringsdossiers en krijg samenvattingen voor de vergadering.' },
    { icon: 'vote', title: 'Vastgelegde besluiten', text: 'Stemmingen, resoluties en handtekeningen bewaard bij elke vergadering, in een besluitenregister.' },
  ],
};
---

<Layout title="Bestuurssoftware voor Vastgoed | Dafira" description="Bestuursportaal voor vastgoedbeleggings- en beheerondernemingen: investeringsdossiers, bestuursvergaderingen en een duidelijk besluitenregister.">
  <main>
    <IndustryLanding
      industry="real-estate"
      hero={hero}
      screenshot={{ src: '/onboarding-boardpack.png', alt: 'Bestuursdossier in Dafira per agendapunt, met annotaties' }}
      challenges={challenges}
      features={features}
      quoteKey="nathalie"
      secondary="trial"
    />
  </main>
</Layout>
