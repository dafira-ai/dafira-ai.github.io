---
import Layout from '../../../layouts/Layout.astro';
import FeatureSection from '../../../components/features/FeatureSection.astro';
import FeatureCTA from '../../../components/features/FeatureCTA.astro';
import { PageHero, Button, Screenshot } from '../../../components/ui';

const meetingFeatures = {
  title: "De vergadering voorbereiden en leiden",
  subtitle: "Vergaderingen",
  description: "Stel de agenda op, deel het bestuursdossier en maak de notulen zonder het platform te verlaten.",
  image: "/applications-picture-meeting.png",
  imageAlt: "Vergaderpagina in Dafira",
  features: [
    {
      title: "AI-agendabouwer",
      description: "Vertrek van een sjabloon, geef elk punt een duur en een type en voeg de documenten toe. Suggesties komen uit eerdere vergaderingen.",
      icon: "list",
      link: "/nl/features/ai-powered-agenda-builder"
    },
    {
      title: "Samenwerken aan documenten",
      description: "Bestuurders annoteren het dossier persoonlijk en geven samen opmerkingen bij gedeelde documenten, altijd in de laatste versie.",
      icon: "pen",
      link: "/nl/features/document-collaboration"
    },
    {
      title: "Beveiligde communicatie",
      description: "Privéberichten, een nieuwsfeed voor het bestuur en bestandsdeling, binnen het platform in plaats van via e-mail of chatapps.",
      icon: "lock",
      link: "/nl/features/secure-communication"
    },
    {
      title: "AI-notulen",
      description: "Een gestructureerd ontwerp van de notulen, opgesteld op basis van de opname en afgestemd op de agenda, in de taal van de vergadering.",
      icon: "mic",
      link: "/nl/features/ai-minute-builder"
    }
  ]
};

const insightFeatures = {
  title: "Terugvinden wat het bestuur al weet",
  subtitle: "Informatie",
  description: "Bestuursdocumenten worden per vergadering bewaard en kunnen doorzocht en bevraagd worden. Elk antwoord verwijst naar zijn bron.",
  image: "/applications-picture-board-chat-mobile.png",
  imageAlt: "Dafira op mobiel",
  features: [
    {
      title: "AI-assistent",
      description: "Stel een vraag over het bestuursdossier of eerdere notulen en krijg een antwoord met vermelding van het document en de sectie.",
      icon: "search",
      link: "/nl/features/ai-assistant"
    },
    {
      title: "Documentbibliotheek",
      description: "Bestuursdocumenten zijn geordend per vergadering en per type, met zoeken in de hele bibliotheek.",
      icon: "folder"
    },
    {
      title: "Compliance monitoring",
      description: "Volg regelgeving zoals CSRD op en zie welke bestuursdocumenten eraan beantwoorden.",
      icon: "scale",
      link: "/nl/features/ai-board-compliance-monitoring"
    }
  ]
};

const governanceFeatures = {
  title: "Beslissen, ondertekenen en opvolgen",
  subtitle: "Governance",
  description: "Leg stemmingen en resoluties vast, verzamel handtekeningen en volg de acties op die in de vergadering zijn afgesproken.",
  image: "/applications-picture-board-evaluation.png",
  imageAlt: "Bestuursevaluatie in Dafira",
  features: [
    {
      title: "Taken en actiepunten",
      description: "Wijs de acties uit de vergadering toe en volg ze op tot ze afgerond zijn.",
      icon: "tasks"
    },
    {
      title: "Stemmingen en elektronische handtekeningen",
      description: "Bestuurders stemmen over resoluties en tekenen elektronisch, via onze eIDAS-conforme partner Universign.",
      icon: "signature"
    },
    {
      title: "Toegangsbeheer per rol",
      description: "Toegang tot vergaderingen, documenten en gesprekken wordt ingesteld per bestuur, comité en rol.",
      icon: "users"
    },
    {
      title: "Bestuursevaluatie",
      description: "Voer de bestuursevaluatie uit in het platform en vergelijk de antwoorden van elke bestuurder.",
      icon: "chart"
    }
  ]
};
---

<Layout title="Functionaliteiten - Dafira bestuurssoftware" description="De functionaliteiten van Dafira: agenda, bestuursdossier en annotaties, AI-assistent, AI-notulen, beveiligde communicatie, stemmingen en elektronische handtekeningen." image="/features.png">
  <main>
    <PageHero
      eyebrow="Functionaliteiten"
      title="Elke stap van de bestuurscyclus, op één plek"
      lead="Dafira ondersteunt de voorbereiding van de vergadering, de vergadering zelf en de opvolging: agenda, bestuursdossier, stemmingen, notulen en handtekeningen. Bestuurders werken in één beveiligde omgeving, op elk toestel."
    >
      <Fragment slot="actions">
        <Button href="/nl/request-demo">Demo aanvragen</Button>
        <Button variant="secondary" href="/nl/pricing">Prijzen bekijken</Button>
      </Fragment>
      <Screenshot slot="aside" src="/onboarding-event-detail.png" alt="Vergaderpagina in Dafira met de agenda, de aanwezigheden en een open stemming" eager />
    </PageHero>

    <FeatureSection {...meetingFeatures} demoType="meeting" id="meetings" />
    <FeatureSection {...insightFeatures} demoType="insights" reversed={true} tone="surface" id="information" />
    <FeatureSection {...governanceFeatures} demoType="governance" id="governance" />

    <FeatureCTA />
  </main>
</Layout>
