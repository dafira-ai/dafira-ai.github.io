---
import Layout from '../../layouts/Layout.astro';
import BoardAccountability from '../../components/campaigns/BoardAccountability.astro';

const t = {
  hero: {
    eyebrow: 'Bestuurlijke verantwoording',
    title: 'Van notulen naar acties: AI die bestuurlijke verantwoording ondersteunt',
    lead: 'Neem niet alleen notities. Zet elk besluit om in traceerbare taken met eigenaren, deadlines, handtekeningen en resolutiestatus, in een veilige, AVG-conforme workflow.',
    primary: { text: 'Start gratis proefperiode', href: '/nl/try' },
    secondary: { text: 'Vraag een demo aan', href: '/nl/request-demo' },
    note: 'Geen creditcard nodig · EU-gehost · AVG-conform',
  },
  card: {
    title: 'Besluit → actie → afgerond',
    meta: 'Resolutieregister',
    rows: [
      { label: 'R-2026-11', text: 'Goedkeuring budget', tone: 'ok' as const, status: 'Afgesloten' },
      { label: 'R-2026-12', text: 'Beveiligingsaudit', tone: 'pending' as const, status: 'In uitvoering' },
      { label: 'R-2026-13', text: 'Uitbreiding van het bestuur', tone: 'info' as const, status: 'Voorgesteld' },
    ],
    footer: 'Elke resolutie heeft een eigenaar en een deadline',
    footerMeta: 'eIDAS-handtekeningen',
    caption: 'Voorbeeldregister',
  },
  promise: {
    eyebrow: 'De belofte',
    title: 'Van verspreide besluiten naar systematische verantwoording',
    lead: 'Elk bestuursbesluit wordt een gevolgde actie met duidelijk eigenaarschap, deadlines en bewijs van uitvoering.',
    items: [
      { icon: 'target', title: 'Besluiten → acties', text: 'Besluitpunten en resoluties worden in uw notulen herkend en omgezet in taken met eigenaren, deadlines en afhankelijkheden.', benefit: 'Geen besluiten die door de mazen glippen' },
      { icon: 'bell', title: 'Verantwoording zonder wrijving', text: 'Automatische herinneringen, opvolging, een activiteitenlogboek en traceerbaarheid tot afsluiting.', benefit: 'Eigenaren blijven op schema zonder micromanagement' },
      { icon: 'signature', title: 'Geïntegreerde ondertekening', text: 'Valideer notulen en resoluties met een eIDAS-conforme elektronische handtekening en bewijskrachtige archivering.', benefit: 'Juridische conformiteit ingebouwd' },
      { icon: 'list', title: 'Opvolging van resoluties', text: 'Duidelijke status (Voorgesteld, Goedgekeurd, In uitvoering, Geblokkeerd, Afgesloten), bijgevoegd bewijs en tijdstempels voor audit.', benefit: 'Auditklare documentatie' },
    ],
  },
  roles: {
    eyebrow: 'Voor bestuursleiders',
    title: 'Gemaakt voor CEO’s en bestuurssecretarissen',
    lead: 'Verschillende rollen, een gedeelde behoefte: besluiten die uitgevoerd worden.',
    items: [
      { icon: 'user', role: 'CEO', benefits: [
        'Realtime zicht op wie wat doet, en tegen wanneer',
        'Minder opvolgberichten, meer uitgevoerde besluiten, duidelijkere verantwoordelijkheid',
        'Heldere rapportering aan de raad, zonder parallelle spreadsheets',
      ] },
      { icon: 'pen', role: 'Bestuurssecretaris', benefits: [
        'Geen chaos meer na de vergadering: notulen gegenereerd, besluiten geëxtraheerd, taken automatisch aangemaakt',
        'Handtekeningworkflow (notulen, resoluties) en veilige verspreiding naar bestuurders',
        'Een volledig bewijsdossier voor audit en compliance',
      ] },
    ],
  },
  workflow: {
    eyebrow: 'Workflow',
    title: 'Hoe het werkt: van vergadering tot verantwoording',
    steps: [
      { title: 'Vastleggen en genereren', text: 'Importeer audio, notities of documenten; de AI genereert een gestructureerd notulenconcept (agenda, besluiten, acties, resoluties).' },
      { title: 'Omzetten', text: 'Besluiten en resoluties worden herkend en omgezet in taken (eigenaar, deadline, tags, bijlagen).' },
      { title: 'Valideren en ondertekenen', text: 'Elektronische handtekeningworkflow voor notulen en resoluties. Vergrendeling, versiebeheer en tijdstempels.' },
      { title: 'Volgen en opvolgen', text: 'Herinneringen, meldingen, eigen termijnen, opvolging van eigenaren, opmerkingen en uitvoeringsbewijs.' },
      { title: 'Rapporteren', text: 'Dashboards en exports: resolutiestatus, voortgang, vertragingen en risico’s, en een agendapunt ‘actieopvolging’ voorbereid voor de volgende vergadering.' },
    ],
  },
  modules: {
    eyebrow: 'Kernmodules',
    title: 'Alles wat u nodig heeft voor volledige verantwoording',
    lead: 'Modules die ontworpen zijn om samen te werken.',
    items: [
      { icon: 'tasks', title: 'Actietracker', text: 'Kanban- en lijstweergave, filters (eigenaar, comité, prioriteit, deadline), vermeldingen en toewijzing.', features: ['Kanbanborden', 'Filters', 'Teamvermeldingen', 'Prioriteitenbeheer'] },
      { icon: 'book', title: 'Resolutieregister', text: 'Register van resoluties met status, juridische basis, bijbehorende documenten en stemmingen.', features: ['Juridische conformiteit', 'Documentkoppeling', 'Stemregistratie', 'Statusopvolging'] },
      { icon: 'signature', title: 'E-handtekening en goedkeuringen', text: 'Gekwalificeerde handtekening, zegels, voltooiingscertificaat en een configureerbare goedkeuringsworkflow.', features: ['eIDAS-conformiteit', 'Goedkeuringsworkflows', 'Digitale certificaten', 'Audittrails'] },
      { icon: 'shield', title: 'Audit en compliance', text: 'Activiteitenlog, audittrails, EU-hosting en AVG-conformiteit.', features: ['Volledige audittrails', 'Gegevens in de EU', 'AVG-conformiteit', 'Activiteitenlog'] },
    ],
    links: [
      { text: 'Meer over beveiliging en e-handtekeningen', href: '/nl/security' },
      { text: 'Bekijk alle functies', href: '/nl/features' },
    ],
  },
  europe: {
    eyebrow: 'Europa eerst',
    title: 'Van besluit tot uitvoering, met Europese waarborgen',
    lead: 'Minder wrijving tussen vergadering en opvolging, in een platform gebouwd voor Europese governance-vereisten.',
    callout: 'EU-hosting, AVG by design en eIDAS-conforme handtekeningen: de gegevens van uw bestuur blijven in Europa.',
    primary: { text: 'Test op uw volgende vergadering', href: '/nl/try' },
    secondary: { text: 'Een auditklaar resolutieregister nodig?', href: '/nl/request-demo' },
  },
  faq: {
    title: 'Veelgestelde vragen',
    subtitle: 'Over AI-ondersteunde bestuurlijke verantwoording',
    inLanguage: 'nl',
    faqs: [
      { question: 'Kunnen AI-notulen besluiten en acties volgen?', answer: 'Ja. De AI herkent besluiten en resoluties in uw notulen en zet ze om in uitvoerbare taken met eigenaren en deadlines. Elk item wordt gevolgd tot het afgerond is, met herinneringen, statusupdates en een controleerbaar spoor.' },
      { question: 'Hoe volgen we bestuursresoluties op?', answer: 'Gebruik het resolutieregister om de status te volgen (Voorgesteld, Goedgekeurd, In uitvoering, Geblokkeerd, Afgesloten), bewijs bij te voegen, eigenaren toe te wijzen en deadlines in te stellen. Automatische herinneringen en dashboards maken opvolging deel van de gewone bestuursprocedure.' },
      { question: 'Zijn elektronische handtekeningen juridisch bindend?', answer: 'Ja. Dafira gebruikt UniverSign, dat eIDAS-conforme gekwalificeerde elektronische handtekeningen biedt. Die hebben in de EU dezelfde juridische status als handgeschreven handtekeningen en bieden volledige audittrails voor compliance.' },
      { question: 'Hoe voorkomt actieopvolging dat zaken door de mazen glippen?', answer: 'Elk besluit wordt een gevolgde actie met eigenaar, deadline en status. Herinneringen, escalatieworkflows en zicht via het dashboard zorgen ervoor dat niets vergeten wordt of ongemerkt vertraging oploopt.' },
    ],
  },
  cta: {
    texts: {
      title: 'Maak van elk bestuursbesluit een gevolgde actie',
      subtitle: 'Zie hoe een besluit een gevolgde, uitgevoerde actie wordt. Geen creditcard nodig.',
      cta1: 'Vraag een demo aan',
      cta2: 'Start gratis proefperiode',
    },
    links: { cta1: '/nl/request-demo', cta2: '/nl/try' },
  },
};
---

<Layout
  title="Van notulen naar acties – AI voor bestuurlijke verantwoording | Dafira"
  description="Zet bestuursnotulen om in traceerbare acties met eigenaren, deadlines, e-handtekeningen en opvolging van resoluties. EU-gehost en AVG-conform."
>
  <main>
    <BoardAccountability t={t} />
  </main>
</Layout>
