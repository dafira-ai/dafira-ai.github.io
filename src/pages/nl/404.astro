---
import Layout from '../../layouts/Layout.astro';
import { PageHero, Section } from '../../components/ui';
import BoardResolution from '../../components/404/BoardResolution.astro';
import NavigationSuggestions from '../../components/404/NavigationSuggestions.astro';

const suggestions = [
  {
    "text": "Home",
    "href": "/nl",
    "icon": "home",
    "description": "Terug naar de startpagina."
  },
  {
    "text": "Functies",
    "href": "/nl/features",
    "icon": "layers",
    "description": "Wat Dafira voor uw bestuur doet."
  },
  {
    "text": "Beveiliging",
    "href": "/nl/security",
    "icon": "shield",
    "description": "Hoe bestuursgegevens beschermd worden."
  },
  {
    "text": "Klantverhalen",
    "href": "/nl/testimonials",
    "icon": "users",
    "description": "Hoe andere besturen Dafira gebruiken."
  },
  {
    "text": "Kenniscentrum",
    "href": "/nl/resources",
    "icon": "book",
    "description": "Handleidingen, onderzoek en artikelen."
  },
  {
    "text": "Contact",
    "href": "/nl/contact",
    "icon": "mail",
    "description": "Stel ons uw vraag rechtstreeks."
  }
];

const currentDate = new Date().toLocaleDateString('nl-BE');
const labels = {
  "title": "Besluit 404",
  "date": "Datum",
  "whereas": "Overwegende dat de gevraagde pagina niet gevonden kan worden;",
  "resolved": "Besluit dat de bezoeker naar een geschiktere pagina wordt verwezen.",
  "status": "Status",
  "approved": "Goedgekeurd"
};
---

<Layout title="404 - Pagina niet gevonden | Dafira" description="De pagina die u zoekt bestaat niet of is verplaatst." noindex>
  <PageHero eyebrow="Fout 404" title="Deze pagina werd niet gevonden" lead="Het adres is misschien verkeerd getypt, of de pagina is verplaatst. De links hieronder leiden naar de belangrijkste delen van de site.">
    <Fragment slot="aside">
      <BoardResolution date={currentDate} labels={labels} />
    </Fragment>
  </PageHero>

  <Section space="md">
    <h2 class="font-mono text-xs uppercase tracking-[0.08em] text-gray-500 mb-6">Waar naartoe</h2>
    <NavigationSuggestions suggestions={suggestions} />
  </Section>
</Layout>

<script>
  const url = new URL(window.location.href);
  if (url.pathname.endsWith('/')) {
    url.pathname = url.pathname.slice(0, -1);
    window.location.replace(url.href);
  }
</script>
