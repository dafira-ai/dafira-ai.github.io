---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import ResourceHub from '../components/resources/ResourceHub.astro';

const copy = {
  eyebrow: 'Resources',
  title: 'Guides, research and conversations on board governance',
  lead: 'Guides to using Dafira, research on AI in the boardroom, articles and podcast episodes for board secretaries, directors and governance professionals.',
  overview: [
    { icon: 'mic', title: 'Podcasts', text: 'Conversations on modern board management.', href: '/podcast', linkText: 'Browse episodes' },
    { icon: 'document', title: 'Articles', text: 'Practical articles on governance and board work.', href: '/blog', linkText: 'Read articles' },
    { icon: 'chart', title: 'Research', text: 'Research reports and whitepapers.', href: '/research/boardroom-ai-adoption', linkText: 'View research' },
    { icon: 'book', title: 'Guides', text: 'Step-by-step help for Dafira users.', href: '/guides', linkText: 'Explore guides' },
  ],
  podcasts: { title: 'Latest podcast episodes', link: '/podcast', linkText: 'All episodes' },
  articles: { title: 'Latest articles', link: '/blog', linkText: 'All articles' },
  readMore: 'Read',
};

const categories = [
  {
    eyebrow: 'Guides',
    title: 'Guides and tutorials',
    description: 'Step-by-step guides to help you make the most of Dafira.',
    link: '/guides',
    linkText: 'All guides',
    resources: [
      { title: 'Getting Started with Dafira', description: 'Setting up and using Dafira for your board.', type: 'Guide', readTime: '10 min read', image: '/applications-picture-meeting.png', link: '/guides/getting-started' },
      { title: 'Authentication Guide', description: 'Setting up and managing authentication for your board members.', type: 'Guide', readTime: '8 min read', image: '/en-authentication.jpg', link: '/guides/authentication' },
      { title: 'Managing Your Profile', description: 'Customising and maintaining your Dafira profile.', type: 'Guide', readTime: '5 min read', image: '/profile-management.jpg', link: '/guides/profile-management' },
    ],
  },
  {
    eyebrow: 'Research',
    title: 'Whitepapers and research',
    description: 'In-depth analysis and research on board management.',
    resources: [
      { title: 'The Future of AI in the Boardroom', description: 'Research report on the challenges and opportunities of AI adoption in board management.', type: 'Research Paper', readTime: '10 min read', image: '/resources.png', link: '/research/boardroom-ai-adoption' },
    ],
  },
];

const now = Date.now();
const posts = (await getCollection('blog'))
  .filter((p) => p.data.pubDate.getTime() <= now && (!p.data.lang || p.data.lang === 'en'))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 3);
const podcasts = (await getCollection('podcast'))
  .filter((p) => p.data.pubDate.getTime() <= now)
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 3);
---

<Layout title="Resources - Dafira Board Management Software" description="Guides, research, articles and podcasts on board management and governance, from the Dafira team." image="/resources.png">
  <ResourceHub lang="en" copy={copy} categories={categories} posts={posts} podcasts={podcasts} />
</Layout>
