---
import Layout from '../layouts/Layout.astro';
import { PageHero, Section, SectionHeader, Button, FeatureColumns, Quote, Callout, CTA } from '../components/ui';
import ProductCard from '../components/campaigns/ProductCard.astro';

const painPoints = [
  {
    icon: 'calendar',
    title: 'Before: the evening before the board meeting',
    items: [
      'Going through emails to piece together the agenda',
      'Hunting down documents scattered across different platforms',
      'Working late to format everything',
      'Hoping you did not miss anything important',
    ],
  },
  {
    icon: 'pen',
    title: 'During the meeting: note-taking under pressure',
    items: [
      'Trying to capture every word while following the discussion',
      'Missing key decisions because you are focused on writing',
      'Juggling multiple devices and documents',
      'Keeping up with the pace of the conversation',
    ],
  },
  {
    icon: 'clock',
    title: 'After the meeting: the real work begins',
    items: [
      'Spending hours transcribing notes',
      'Going back through recordings to catch what you missed',
      'Chasing board members for clarifications',
      'Manually tracking action items and deadlines',
      'Handling "that is not what I said" feedback',
    ],
  },
];

const solutions = [
  {
    icon: 'document',
    title: 'Before the meeting: preparation in one place',
    items: [
      'Agendas built from previous meeting actions',
      'Relevant documents and reports attached to the meeting',
      'Meeting structure and timing set up in advance',
    ],
  },
  {
    icon: 'mic',
    title: 'During the meeting: the AI records, you chair',
    items: [
      'Decisions are captured as the meeting runs',
      'Action items are identified with their owners',
      'You can focus on facilitating, not on note-taking',
    ],
  },
  {
    icon: 'sparkle',
    title: 'After the meeting: a structured draft of the minutes',
    items: [
      'Draft minutes available shortly after the meeting',
      'Decisions clearly documented',
      'Action items distributed to their owners',
      'Audit trail built in',
    ],
  },
];
---

<Layout
  title="Stop Wasting Hours on Board Minutes | AI Draft Minutes | Dafira"
  description="Board secretaries lose hours on manual preparation and minutes. Dafira's AI minute builder drafts structured minutes after the meeting. Estimate your own time savings. Free trial."
>
  <main>
    <PageHero
      eyebrow="Board minutes"
      title="Stop losing hours on manual board minutes"
      lead="Board secretaries spend entire evenings on preparation, notes and follow-up. Dafira takes on the routine work before, during and after the meeting, so you review instead of writing from scratch."
    >
      <Fragment slot="actions">
        <Button href="/try">Start free trial</Button>
        <Button variant="secondary" href="#calculator">Estimate your time savings</Button>
      </Fragment>
      <p class="mt-6 font-mono text-xs uppercase tracking-[0.08em] text-gray-500">No credit card required · AI features included · Cancel anytime</p>
      <ProductCard
        slot="aside"
        class="lg:ms-6"
        title="Board meeting tomorrow"
        meta="Sunday · 23:47"
        rows={[
          { label: 'To do', text: 'Find the Q3 financial reports', tone: 'danger', status: 'Missing' },
          { label: 'To do', text: 'Format the agenda (again)', tone: 'pending', status: 'Open' },
          { label: 'To do', text: 'Print copies for every director', tone: 'pending', status: 'Open' },
          { label: 'To do', text: 'Prepare note-taking sheets', tone: 'neutral', status: 'Open' },
        ]}
        footer="Another late night before the meeting"
        footerMeta="Without Dafira"
        caption="Illustration"
      />
    </PageHero>

    <!-- Pain points -->
    <Section>
      <SectionHeader
        eyebrow="The reality"
        title="The reality of manual board management"
        lead="Before, during and after each meeting, the secretary carries most of the administrative load."
      />
      <FeatureColumns items={painPoints} />
      <div class="mt-4 flex flex-col sm:flex-row sm:items-center gap-4 border-t border-line pt-8">
        <p class="text-lg text-navy font-medium">Sound familiar? See how Dafira handles this for your board.</p>
        <Button variant="link" href="/request-demo" class="sm:ms-auto">Get a personalised demo</Button>
      </div>
    </Section>

    <!-- Solution -->
    <Section tone="surface" border="both">
      <SectionHeader
        eyebrow="With Dafira"
        title="What if AI handled the routine work?"
        lead="Your evenings back, no weekend preparation and no rush after the meeting. The secretary stays in control of what is published."
      />
      <FeatureColumns items={solutions} />
      <div class="mt-4 flex flex-col sm:flex-row gap-3">
        <Button href="/try">Start free trial</Button>
        <Button variant="secondary" href="#calculator">Estimate my savings first</Button>
      </div>
    </Section>

    <!-- Calculator -->
    <Section id="calculator" size="narrow">
      <SectionHeader
        layout="stacked"
        eyebrow="Time savings calculator"
        title="How much time do board meetings cost you?"
        lead="Enter your own figures to estimate the time you spend on board administration and what you could save."
      />

      <div class="grid md:grid-cols-2 gap-px bg-line border border-line rounded-md overflow-hidden">
        <div class="bg-white p-6 lg:p-8">
          <label for="meetings" class="block font-medium text-navy">Board meetings (and committees) per year</label>
          <input type="range" id="meetings" value="24" min="6" max="60" step="2" class="mt-6 w-full accent-navy cursor-pointer" />
          <div class="mt-2 flex justify-between font-mono text-xs text-gray-500"><span>6</span><span>60</span></div>
          <p class="mt-6 font-mono text-3xl text-navy tabular-nums"><span id="meetings-display">24</span> <span class="text-base text-gray-500">meetings / year</span></p>
          <p class="mt-1 text-sm text-gray-600">About <span id="meetings-monthly">2</span> per month</p>
        </div>
        <div class="bg-white p-6 lg:p-8">
          <label for="hours-per-meeting" class="block font-medium text-navy">Hours per meeting (preparation, minutes, follow-up)</label>
          <input type="range" id="hours-per-meeting" value="10" min="3" max="25" step="1" class="mt-6 w-full accent-navy cursor-pointer" />
          <div class="mt-2 flex justify-between font-mono text-xs text-gray-500"><span>3</span><span>25</span></div>
          <p class="mt-6 font-mono text-3xl text-navy tabular-nums"><span id="hours-display">10</span> <span class="text-base text-gray-500">hours / meeting</span></p>
          <p class="mt-1 text-sm text-gray-600"><span id="breakdown">~3h prep + 4h minutes + 3h follow-up</span></p>
        </div>
      </div>

      <div class="mt-8 border border-line rounded-md bg-surface p-6 lg:p-8" aria-live="polite">
        <h3 class="text-xl font-semibold text-navy">Your estimated time savings with Dafira</h3>
        <dl class="mt-6 grid sm:grid-cols-3 gap-8">
          <div class="border-t border-navy pt-4">
            <dt class="font-mono text-xs uppercase tracking-[0.08em] text-gray-500">Time spent today</dt>
            <dd class="mt-2 font-mono text-4xl text-navy tabular-nums"><span id="total-hours">20</span>h <span class="text-base text-gray-500">/ month</span></dd>
          </div>
          <div class="border-t border-navy pt-4">
            <dt class="font-mono text-xs uppercase tracking-[0.08em] text-gray-500">Estimated time saved</dt>
            <dd class="mt-2 font-mono text-4xl text-navy tabular-nums"><span id="saved-hours">12.0</span>h <span class="text-base text-gray-500">/ month</span></dd>
          </div>
          <div class="border-t border-navy pt-4">
            <dt class="font-mono text-xs uppercase tracking-[0.08em] text-gray-500">Per year</dt>
            <dd class="mt-2 font-mono text-4xl text-navy tabular-nums"><span id="yearly-saved-days">18</span> <span class="text-base text-gray-500">working days</span></dd>
          </div>
        </dl>
        <Callout tone="note" title="How this estimate is calculated" class="mt-8">
          Time spent = meetings per year × hours per meeting, divided by 12. The saving assumes Dafira removes 60% of that time; this is an assumption for illustration, not a measured result, and your own figures will vary. Working days are counted as 8 hours. The preparation / minutes / follow-up split is a rough 30 / 40 / 30 estimate.
        </Callout>
        <div class="mt-8 flex flex-col sm:flex-row gap-3">
          <Button href="/try">Start free trial</Button>
          <Button variant="secondary" href="/request-demo">See it in action</Button>
        </div>
      </div>
    </Section>

    <!-- Customer -->
    <Section tone="surface" border="both">
      <div class="grid lg:grid-cols-12 gap-10">
        <div class="lg:col-span-4">
          <SectionHeader layout="stacked" eyebrow="Customer story" title="What board teams say" class="!mb-0" />
        </div>
        <div class="lg:col-span-8">
          <Quote
            size="lg"
            quote="Dafira has transformed how we manage our board operations, bringing efficiency and clarity to our governance processes."
            author="General Counsel"
            company="Listed fashion group"
            href="/case-studies/listed-fashion-group"
            linkText="Read the case study"
          />
        </div>
      </div>
    </Section>

    <CTA
      texts={{
        title: 'Start your free trial',
        subtitle: 'Set up your first meeting and see the AI minute builder with your own agenda. No credit card required.',
        cta1: 'Start free trial',
        cta2: 'Talk to our team',
      }}
      links={{ cta1: '/try', cta2: '/contact' }}
    />
  </main>
</Layout>

<script>
  function calculateEnhanced() {
    const yearlyMeetings = parseInt((document.getElementById('meetings') as HTMLInputElement)?.value) || 0;
    const hoursPerMeeting = parseInt((document.getElementById('hours-per-meeting') as HTMLInputElement)?.value) || 0;

    const monthlyMeetings = (yearlyMeetings / 12).toFixed(1);
    const monthlyHours = (yearlyMeetings / 12) * hoursPerMeeting;
    const yearlyHours = yearlyMeetings * hoursPerMeeting;

    // Assumption stated on the page: 60% of the time is saved
    const savedMonthly = monthlyHours * 0.6;
    const savedYearly = yearlyHours * 0.6;

    // Breakdown (rough 30 / 40 / 30 estimate, stated on the page)
    const prepHours = Math.round(hoursPerMeeting * 0.3);
    const minutesHours = Math.round(hoursPerMeeting * 0.4);
    const followupHours = Math.round(hoursPerMeeting * 0.3);

    // Working days saved (8-hour days)
    const daysSaved = (savedYearly / 8).toFixed(0);

    const set = (id: string, value: string) => {
      const el = document.getElementById(id);
      if (el) el.textContent = value;
    };
    set('meetings-display', yearlyMeetings.toString());
    set('meetings-monthly', monthlyMeetings);
    set('hours-display', hoursPerMeeting.toString());
    set('breakdown', `~${prepHours}h prep + ${minutesHours}h minutes + ${followupHours}h follow-up`);
    set('total-hours', Math.round(monthlyHours).toString());
    set('saved-hours', savedMonthly.toFixed(1));
    set('yearly-saved-days', daysSaved);
  }

  ['meetings', 'hours-per-meeting'].forEach((id) => {
    document.getElementById(id)?.addEventListener('input', calculateEnhanced);
  });
  calculateEnhanced();
</script>
