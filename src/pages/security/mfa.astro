---
import Layout from '../../layouts/Layout.astro';
import MfaPage from '../../components/security/MfaPage.astro';

const copy = {
  eyebrow: 'Multi-factor authentication',
  title: 'Secure access to board information with SMS verification',
  lead: 'Dafira protects board information with SMS-based multi-factor authentication (MFA). This page explains how SMS verification secures access for directors and governance teams.',
  back: { text: 'Security overview', href: '/security' },
  what: {
    eyebrow: 'What MFA is',
    title: 'What MFA is, and why it matters for boards',
    paragraphs: [
      'Board environments involve highly confidential information: strategy, finance, audit materials, legal documentation and executive discussions. Secure authentication is essential.',
      'Multi-factor authentication (MFA) adds a second verification step, beyond a password, so that only authorised individuals can access the platform.',
      'In Dafira, this second step is a code sent by SMS: a quick and reliable way to confirm a user’s identity before granting access to governance data.',
    ],
  },
  why: {
    eyebrow: 'Risks addressed',
    title: 'Why SMS-based MFA matters for governance',
    lead: 'SMS verification reduces the risk of:',
    threats: ['Unauthorised access', 'Password theft or sharing', 'Phishing attacks', 'Impersonation', 'Account takeover', 'Exposure of confidential documents'],
    note: [
      'Even if a password is compromised, access to Dafira still requires the unique code sent by SMS to the user’s registered mobile number.',
      'For boards, committees and executive teams, this is an important safeguard.',
    ],
  },
  boards: {
    eyebrow: 'Designed for boards',
    title: 'MFA for boards, committees and governance teams',
    items: [
      { icon: 'user', title: 'Simple for directors', text: 'Board members often work across devices and locations. SMS MFA works without an authenticator app or technical set-up.' },
      { icon: 'desktop', title: 'Secure access anywhere', text: 'Whether logging in from a laptop, tablet or mobile phone, users receive the code by SMS, including when travelling.' },
      { icon: 'lock', title: 'Protection for governance data', text: 'SMS MFA secures access to:', items: ['Board packs and agendas', 'Confidential attachments', 'Annotated documents', 'Votes and resolutions', 'AI-generated meeting minutes', 'Internal discussions', 'Governance archives'] },
    ],
  },
  how: {
    eyebrow: 'How it works',
    title: 'How multi-factor authentication works in Dafira',
    lead: 'Dafira uses SMS verification to strengthen login security.',
    steps: [
      'The user enters their email address and password',
      'Dafira sends a unique, time-limited code by SMS',
      'The user enters the code',
      'Access is granted only if both steps succeed',
    ],
    note: 'Access is restricted to the person who controls the registered mobile number, without adding complexity for the user.',
  },
  regulated: {
    eyebrow: 'Regulated organisations',
    title: 'For European and regulated organisations',
    lead: 'SMS MFA helps organisations meet internal and external expectations for secure authentication.',
    orgsTitle: 'Particularly relevant for',
    orgs: ['Listed companies', 'Financial services and insurance', 'Municipalities and public institutions', 'Hospitals and education', 'Private companies with strategic boards'],
    complianceTitle: 'Supports compliance with',
    compliance: ['GDPR security expectations', 'Internal IT and risk policies', 'Audit and supervisory requirements'],
  },
  framework: {
    eyebrow: 'Security framework',
    title: 'Part of Dafira’s security framework',
    lead: 'SMS MFA works alongside the other security measures of the platform.',
    items: [
      { icon: 'globe', text: 'EU-based data hosting' },
      { icon: 'lock', text: 'Encryption at rest and in transit' },
      { icon: 'key', text: 'Role-based access and permissions' },
      { icon: 'list', text: 'Detailed audit trails and activity logs' },
      { icon: 'documents', text: 'Secure distribution of board packs' },
      { icon: 'refresh', text: 'Redundancy and backups' },
    ],
  },
  summary: {
    eyebrow: 'In practice',
    title: 'Using SMS MFA with Dafira',
    columns: [
      { title: 'Benefits', text: 'What SMS MFA brings to board work.', items: ['Stronger protection against unauthorised access', 'Easy for board members, no app needed', 'Works on any device', 'Supports compliance and audit requirements', 'Suited to hybrid or remote board meetings', 'Reinforces trust in digital governance'] },
      { title: 'Who should activate it', text: 'We recommend enabling SMS MFA for:', items: ['All board members', 'Management committees', 'Executive leadership', 'Board secretaries', 'Audit, risk and remuneration committees', 'External advisors and observers'] },
      { title: 'Where it applies', text: 'SMS MFA secures access to all Dafira features:', items: ['AI minutes', 'Board pack builder', 'Agenda management', 'Resolution management', 'Document library and archives', 'Cross-committee collaboration', 'Annotation and preparation tools'] },
    ],
  },
  cta: {
    title: 'Set up SMS MFA for your board',
    subtitle: 'Our team can guide you through best practices and configuration options.',
    cta1: 'Book a demo',
    cta2: 'Talk to our team',
    link1: '/request-demo',
    link2: '/contact',
  },
};
---

<Layout
  title="Multi-Factor Authentication (MFA) via SMS for Secure Board Access | Dafira"
  description="Dafira protects board information with SMS-based multi-factor authentication (MFA). Learn how SMS verification secures access for directors and governance teams."
>
  <MfaPage copy={copy} />
</Layout>
