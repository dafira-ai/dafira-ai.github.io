---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import PodcastIndex from '../../components/podcast/PodcastIndex.astro';

const episodes = (await getCollection('podcast'))
  .filter((episode) => episode.data.pubDate.getTime() <= Date.now())
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Layout title="Governance Matters Podcast - Dafira" description="Conversations on modern board management, governance and digital transformation.">
  <main>
    <PodcastIndex lang="en" episodes={episodes} />
  </main>
</Layout>
