---
import Layout from '../layouts/Layout.astro';
import TermsLayout from '../components/terms/TermsLayout.astro';
import TableOfContents from '../components/terms/TableOfContents.astro';
import TermsHeader from '../components/terms/TermsHeader.astro';
import { termsSections } from '../data/terms-sections';

import TermsContent from '../components/terms/TermsContent.astro';
const lastUpdate = "April 2021";
---

<Layout title="Terms and Conditions - Dafira (Dafira)" description="Please read these terms and conditions carefully before using our services.">
  <main>
    <TermsHeader eyebrow="Legal" lastUpdate={lastUpdate} />
    <TermsLayout title="Terms and Conditions">
      <TableOfContents slot="sidebar" sections={termsSections} />
      <div>
        {termsSections.map((section) => (
          <TermsContent key={section.key} title={section.title} sections={section.sections} />
        ))}
        
      </div>
    </TermsLayout>
    <div class="text-xs text-gray-500 text-center pb-12 px-4">
      This site is protected by reCAPTCHA and the Google
      <a href="https://policies.google.com/privacy" class="underline underline-offset-2 hover:text-navy">Privacy Policy</a> and
      <a href="https://policies.google.com/terms" class="underline underline-offset-2 hover:text-navy">Terms of Service</a> apply.
    </div>
  </main>
</Layout>