---
import { getEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import ResearchPaper from '../../components/ResearchPaper.astro';

// The paper itself (src/content/research/boardroom-ai-adoption.md) is the single source of truth for this page.
const entry = await getEntry('research', 'boardroom-ai-adoption');
if (!entry) throw new Error('Missing research entry: boardroom-ai-adoption');
const { Content, headings } = await entry.render();
const toc = headings.filter((h) => h.depth === 2).map((h) => ({ id: h.slug, text: h.text }));

const structuredData = {
  "@context": "https://schema.org",
  "@type": "ScholarlyArticle",
  "headline": entry.data.title,
  "abstract": entry.data.abstract,
  "author": { "@type": "Person", "name": entry.data.authors },
  "datePublished": entry.data.date,
  "publisher": { "@type": "Organization", "name": "Dafira" }
};
---

<Layout title="The Future of AI in the Boardroom | Dafira Research" description="A study with a UK business school on how boards approach AI in board management: barriers, needs and implementation recommendations." structuredData={structuredData}>
  <main>
    <ResearchPaper title={entry.data.title} authors={entry.data.authors} institution={entry.data.institution} date={entry.data.date} abstract={entry.data.abstract} toc={toc}>
      <Content />
    </ResearchPaper>
  </main>
</Layout>
