---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import BlogIndex from '../../components/blog/BlogIndex.astro';

const posts = await getCollection('blog', ({ data }) => (!data.lang || data.lang === 'en'));
const sortedPosts = posts
  .filter((post) => post.data.pubDate.getTime() <= Date.now())
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Layout title="Blog - Dafira Board Management Insights" description="Articles on board management, governance and technology: guides and good practices for board secretaries and directors.">
  <main>
    <BlogIndex lang="en" posts={sortedPosts} />
  </main>
</Layout>
