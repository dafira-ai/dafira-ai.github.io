---
import Layout from "../../layouts/Layout.astro";
import CTA from "../../components/CTA.astro";
import { PageHero, Section, SectionHeader, FeatureColumns, Field, Button, Badge, Icon, Screenshot } from "../../components/ui";

const guideFeatures = [
  {
    icon: "target",
    title: "Director features deep-dive",
    text: "Breakdown of the tools board members use: voting systems, board packs and collaboration features.",
  },
  {
    icon: "settings",
    title: "Administrator capabilities",
    text: "Guide to meeting management, document control and governance tools for secretaries and administrators.",
  },
  {
    icon: "lock",
    title: "Security and compliance",
    text: "Analysis of security protocols, data protection and regulatory compliance.",
  },
];

const previews = [
  {
    image: "/buyer-guide-preview-1.png",
    alt: "Buyer's guide preview, page 1",
    caption: "In-depth feature analysis",
  },
  {
    image: "/buyer-guide-preview-2.png",
    alt: "Buyer's guide preview, page 2",
    caption: "ROI calculator and comparison matrix",
  },
];
---

<Layout title="2025 Board Management Software Buyer's Guide | Expert Analysis">
  <main>
    <PageHero
      eyebrow="Buyer's guide"
      title="The guide to choosing board management software"
      lead="A structured analysis of board portals to help you make the right choice for your organisation: features, administration, security and compliance."
    >
      <div class="mt-8"><Badge tone="info">Updated for 2025</Badge></div>

      <div slot="aside" class="border border-line rounded-md bg-white p-6 lg:p-8">
        <h2 class="text-2xl font-semibold text-navy">Get your free guide</h2>
        <p class="mt-2 text-gray-600">Receive the full guide to share with your board.</p>

        <form id="downloadForm" class="mt-6 space-y-5" method="POST">
          <div class="grid sm:grid-cols-2 gap-4">
            <Field id="firstName" label="First name" required placeholder="John" autocomplete="given-name" />
            <Field id="lastName" label="Last name" required placeholder="Smith" autocomplete="family-name" />
          </div>
          <Field id="email" type="email" label="Work email" required placeholder="john@company.com" autocomplete="email" />
          <Field id="company" label="Company" required placeholder="Acme Inc." autocomplete="organization" />

          <Button type="submit" class="w-full">Download the free guide</Button>

          <ul class="flex flex-wrap items-center gap-x-6 gap-y-2 pt-2 text-sm text-gray-600">
            <li class="flex items-center gap-2"><Icon name="shield" class="w-4 h-4 text-navy" />GDPR compliant</li>
            <li class="flex items-center gap-2"><Icon name="lock" class="w-4 h-4 text-navy" />SSL secure</li>
          </ul>
        </form>

        <div id="successMessage" class="hidden" role="status">
          <Icon name="checkCircle" class="w-8 h-8 text-emerald-700" />
          <h3 class="mt-4 text-xl font-semibold text-navy">Thank you</h3>
          <p class="mt-2 text-gray-600">Your download will begin automatically.</p>
        </div>
      </div>
    </PageHero>

    <!-- Guide preview -->
    <Section>
      <SectionHeader eyebrow="Preview" title="A look inside the guide" />
      <div class="grid md:grid-cols-2 gap-8">
        {previews.map((p) => (
          <Screenshot src={p.image} alt={p.alt} caption={p.caption} />
        ))}
      </div>
      <div class="mt-10">
        <Button href="#downloadForm" variant="secondary">Download the guide</Button>
      </div>
    </Section>

    <!-- What's inside -->
    <Section tone="surface" border="top">
      <SectionHeader
        eyebrow="Contents"
        title="What you will find inside"
        lead="A practical resource to help you make an informed decision for your organisation."
      />
      <FeatureColumns items={guideFeatures} />
    </Section>

    <CTA />
  </main>
</Layout>

<style is:global>
  #downloadForm input[aria-invalid="true"] {
    border-color: rgb(185 28 28);
  }
</style>

<script>
  import { sendForm } from '../../utils/sendForm';
  const form = document.getElementById("downloadForm") as HTMLFormElement;
  const successMessage = document.getElementById("successMessage");

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (!(await sendForm(form as HTMLFormElement, 'Buyer guide download'))) return;
    form.classList.add("hidden");
    successMessage?.classList.remove("hidden");
  });

  const inputs = form?.querySelectorAll("input");
  inputs?.forEach((input) => {
    input.addEventListener("input", () => {
      if (input.checkValidity()) {
        input.removeAttribute("aria-invalid");
      } else {
        input.setAttribute("aria-invalid", "true");
      }
    });
  });
</script>
