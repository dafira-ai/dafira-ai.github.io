---
import Layout from "../../layouts/Layout.astro";
import CTA from "../../components/CTA.astro";
import { PageHero, Section, SectionHeader, FeatureColumns, FeatureList, Button, Icon } from "../../components/ui";

const guideHref = "/blog/corporate-secretary-role-responsibilities-tools";

const guideFeatures = [
  {
    icon: "clipboard",
    title: "Complete role overview",
    text: "The corporate secretary's responsibilities, from board support to compliance management.",
  },
  {
    icon: "graduation",
    title: "Qualifications and career path",
    text: "Required certifications, skills and professional development opportunities.",
  },
  {
    icon: "chart",
    title: "Salary and compensation",
    text: "Compensation ranges across organisation sizes and industries.",
  },
  {
    icon: "settings",
    title: "Essential tools and technology",
    text: "Recommendations for board management software and governance platforms.",
  },
  {
    icon: "scale",
    title: "Governance best practices",
    text: "Practical ways to support board directors and maintain sound corporate governance.",
  },
  {
    icon: "trend",
    title: "Future trends",
    text: "ESG governance, digital change and the evolving corporate secretary role.",
  },
];

const benefits = [
  "Complete understanding of the corporate secretary role and responsibilities",
  "Insights into required qualifications and certifications",
  "Salary benchmarks across different organization sizes",
  "Technology recommendations to streamline governance processes",
  "Best practices for supporting board directors effectively",
  "Career development strategies for governance professionals",
];

const audience = [
  "Current corporate secretaries seeking to enhance their practice",
  "Professionals aspiring to corporate secretary roles",
  "Board administrators and governance coordinators",
  "Legal professionals with governance responsibilities",
  "Board directors seeking to understand the corporate secretary function",
  "Organizations evaluating governance technology solutions",
];

const reasons = [
  { title: "Meeting management", text: "Prepare board and committee meetings with scheduling, agenda creation and minute-taking in one place." },
  { title: "Secure document management", text: "Centralised, encrypted storage for governance documents with granular access controls." },
  { title: "Compliance tracking", text: "Follow regulatory requirements and filing deadlines across jurisdictions." },
  { title: "Collaboration", text: "Secure communication between board directors, executives and advisors." },
];
---

<Layout title="Corporate Secretary Guide: Role, Responsibilities & Tools | Dafira">
  <main>
    <PageHero
      eyebrow="Governance guide"
      title="The complete guide to the corporate secretary role"
      lead="What you need to know about the corporate secretary role: qualifications, responsibilities and the tools that support board directors and corporate governance."
    >
      <div slot="aside" class="border border-line rounded-md bg-white p-6 lg:p-8">
        <h2 class="text-2xl font-semibold text-navy">Read the complete guide</h2>
        <p class="mt-2 text-gray-600">What the guide covers:</p>
        <FeatureList items={benefits.slice(0, 4)} class="mt-5" />
        <Button href={guideHref} class="mt-8 w-full">Read the guide</Button>
        <p class="mt-4 flex items-center gap-2 text-sm text-gray-600">
          <Icon name="book" class="w-4 h-4 text-navy" />
          Free access, no registration required
        </p>
      </div>
    </PageHero>

    <!-- What you'll learn -->
    <Section>
      <SectionHeader
        eyebrow="Contents"
        title="What you will learn"
        lead="A resource for current and aspiring corporate secretaries, board administrators and governance professionals."
      />
      <FeatureColumns items={guideFeatures} />
    </Section>

    <!-- Topics and audience -->
    <Section tone="surface" border="top">
      <div class="grid lg:grid-cols-12 gap-12">
        <div class="lg:col-span-6">
          <h2 class="text-3xl lg:text-4xl font-semibold text-navy leading-tight">Essential topics covered</h2>
          <FeatureList items={benefits} class="mt-8" />
        </div>
        <div class="lg:col-span-5 lg:col-start-8">
          <h3 class="text-xl font-semibold text-navy">Who should read this guide?</h3>
          <FeatureList items={audience} class="mt-6" />
        </div>
      </div>
    </Section>

    <!-- Tools -->
    <Section border="top">
      <SectionHeader
        eyebrow="Tools"
        title="Why corporate secretaries use Dafira"
        lead="Board management platforms let corporate secretaries spend more time on governance work and less on manual administration."
      />
      <div class="grid gap-px bg-line border border-line rounded-md overflow-hidden md:grid-cols-2 lg:grid-cols-4">
        {reasons.map((r) => (
          <div class="bg-white p-6 lg:p-8">
            <h3 class="text-lg font-semibold text-navy">{r.title}</h3>
            <p class="mt-2 text-[15px] text-gray-600 leading-relaxed">{r.text}</p>
          </div>
        ))}
      </div>
      <div class="mt-10 flex flex-col sm:flex-row gap-3">
        <Button href={guideHref}>Access the complete guide</Button>
        <Button href="/request-demo" variant="secondary">Request a demo</Button>
      </div>
    </Section>

    <CTA />
  </main>
</Layout>
