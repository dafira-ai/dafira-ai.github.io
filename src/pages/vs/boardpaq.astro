---
import Layout from '../../layouts/Layout.astro';
import ComparisonPage from '../../components/vs/ComparisonPage.astro';
import type { CriterionKey } from '../../components/vs/copy';

// Criteria compared on this page. The Dafira side of each criterion comes from components/vs/copy.ts;
// the BoardPaq side lists questions to check with the vendor (no claims about BoardPaq are made here).
const criteria: { key: CriterionKey; label: string; questions: string[] }[] = [
  {
    key: 'ux',
    label: "User experience",
    questions: [
      "How much training do directors need before their first meeting?",
      "Can the workspace be adapted to your boards, committees and roles?",
      "How do occasional users find the current board pack?",
    ],
  },
  {
    key: 'ai',
    label: "AI capabilities",
    questions: [
      "Which AI features are included, and in which plan?",
      "Where are documents processed when AI features are used?",
      "Can draft minutes be produced in the languages your board uses?",
    ],
  },
  {
    key: 'docs',
    label: "Document management",
    questions: [
      "How are board packs assembled and updated after they are sent?",
      "Is there a version history for each document?",
      "Can directors annotate privately?",
    ],
  },
  {
    key: 'supportSecurity',
    label: "Support & security",
    questions: [
      "Which security certifications and hosting locations apply to your data?",
      "Is two-factor authentication available to all users?",
      "Which support hours and channels are included in your plan?",
    ],
  },
];

// Customer quotes, verbatim.
const quotes = [
  { quote: "Dafira has transformed how we manage our board operations, bringing efficiency and clarity to our governance processes.", author: "General Counsel", position: "", company: "Listed fashion group", link: "/case-studies/listed-fashion-group" },
  { quote: "Dafira has simplified our document management tremendously, making our meeting preparations more efficient and allowing our board to focus on decision-making.", author: "CEO", position: "", company: "Regional public investment fund", link: "/case-studies/public-investment-fund" },
  { quote: "Dafira embraced the next generation of Board management software, easy to use and with AI integration.", author: "Paralegal & Compliance Officer", position: "", company: "Listed healthcare real estate company", link: "/case-studies/healthcare-real-estate" },
];
---

<Layout
  title="BoardPaq vs Dafira: board portal comparison | Dafira"
  description="Compare Dafira and BoardPaq on ease of use, AI features, document management and security and support: what Dafira offers, and the questions to ask BoardPaq. Free 14-day trial, no credit card."
>
  <ComparisonPage
    lang="en"
    competitor="BoardPaq"
    title="BoardPaq alternative: how Dafira compares"
    lead="If you are evaluating BoardPaq or considering a change, this page sets out what Dafira offers on each criterion and what to check with BoardPaq. You can then test Dafira with your own board pack for 14 days."
    criteria={criteria}
    quotes={quotes}
  />
</Layout>
