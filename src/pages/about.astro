---
import Layout from '../layouts/Layout.astro';
import { PageHero, Section, SectionHeader, FeatureColumns } from '../components/ui';
import MissionVision from '../components/about/MissionVision.astro';
import FounderStory from '../components/about/FounderStory.astro';
import TeamMembers from '../components/about/TeamMembers.astro';
import OfficeCard from '../components/OfficeCard.astro';
import LocalizedCTA from '../components/case-studies/LocalizedCTA.astro';

const facts = [
  { label: 'Product', value: 'Dafira board portal' },
  { label: 'Office', value: 'Brussels' },
];

const values = [
  { icon: 'target', title: 'Innovation', text: 'We keep improving what board software can do for the people who use it.' },
  { icon: 'lock', title: 'Security and trust', text: 'Protecting our clients’ sensitive information comes first.' },
  { icon: 'users', title: 'Client success', text: 'We work as partners to the boards we serve, at every step.' },
  { icon: 'clock', title: 'Efficiency', text: 'Board work should take less time and involve less complexity.' },
];

const offices = [
  { city: 'Brussels', country: 'Belgium', image: '/bxl.jpg', address: "Rue de l'Hôpital 31", postalCode: '1000', email: 'info@dafira.ai' },
];
---

<Layout title="About Us - Dafira Board Management Software" description="Dafira is a board portal built in Belgium. Our mission, our founder's story, the leadership team and our office in Brussels." image="/about.png">
  <PageHero
    eyebrow="About Dafira"
    title="Better governance, built for the people who run boards"
    lead="Dafira is a board management platform developed in Belgium. We help boards prepare meetings, share documents, take decisions and keep a proper record."
  >
    <dl class="mt-10 pt-8 border-t border-line grid grid-cols-2 sm:grid-cols-4 gap-6">
      {facts.map((f) => (
        <div>
          <dt class="font-mono text-xs uppercase tracking-[0.08em] text-gray-500">{f.label}</dt>
          <dd class="mt-1 text-[15px] text-navy">{f.value}</dd>
        </div>
      ))}
    </dl>
  </PageHero>

  <MissionVision />
  <FounderStory />
  <TeamMembers />

  <Section tone="surface" space="lg" border="top">
    <SectionHeader eyebrow="Values" title="What guides our work" />
    <FeatureColumns columns={4} items={values} />
  </Section>

  <Section space="lg">
    <SectionHeader eyebrow="Office" title="Where to find us" lead="Write to info@dafira.ai or visit our office in Brussels." />
    <div class="max-w-md">
      {offices.map((office) => <OfficeCard {...office} />)}
    </div>
  </Section>

  <LocalizedCTA />
</Layout>
