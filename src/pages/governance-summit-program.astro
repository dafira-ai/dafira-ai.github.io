---

<Layout
  title={pageTitle}
  description={pageDescription}
  noindex={true}
>
  <main>
    <PageHero
      eyebrow="Governance Summit 2025 · 6 juni 2025"
      title="Volledig programma en samenvattingen"
      lead="Het volledige programma en de samenvattingen van de sessies van de eerste Governance Summit, opgesteld met de AI van Dafira."
    >
      <div slot="aside" class="bg-white border border-line rounded-md p-6 lg:p-8">
        <img src={governanceSummitImage.src} alt="Governance Summit 2025" width="2224" height="500" class="w-full h-auto" />
      </div>
    </PageHero>

    <Section>
      <SectionHeader eyebrow="Programma" title="Vrijdag 6 juni 2025" lead="Sessies, sprekers en tijden. Open een sessie om de samenvatting te lezen." />

      <ol class="border-t border-line">
        {programSessions.map((session) => {
          const muted = session.type === 'break' || session.type === 'networking';
          return (
            <li class="grid md:grid-cols-12 gap-4 md:gap-8 py-8 border-b border-line">
              <div class="md:col-span-3 lg:col-span-2">
                <p class:list={['font-mono text-sm tabular-nums', muted ? 'text-gray-500' : 'text-navy']}>{session.time}</p>
                {session.language && <Badge class="mt-2">{session.language}</Badge>}
              </div>
              <div class="md:col-span-9 lg:col-span-10">
                <h3 class:list={['font-semibold', muted ? 'text-lg text-gray-600' : 'text-xl text-navy']}>{session.title}</h3>
                {session.speakers && <p class="mt-1 text-gray-600">{session.speakers.join(' · ')}</p>}

                {session.type === 'parallel' && session.sessions ? (
                  <div class="mt-6">
                    <p class="font-mono text-xs uppercase tracking-[0.08em] text-gray-500">Parallelle sessies</p>
                    <ul class="mt-3 grid gap-px bg-line border border-line rounded-md overflow-hidden">
                      {session.sessions.map((parallelSession) => (
                        <li class="bg-white p-5">
                          <h4 class="font-semibold text-navy">
                            {parallelSession.title}
                            {parallelSession.language && <Badge class="ms-2 align-middle">{parallelSession.language}</Badge>}
                          </h4>
                          <p class="mt-1 text-sm text-gray-600">{parallelSession.speaker}</p>
                          {parallelSession.summaryHtml && (
                            <details class="group mt-4 border-t border-line pt-3">
                              <summary class="flex items-center gap-2 cursor-pointer list-none [&::-webkit-details-marker]:hidden text-sm font-medium text-primary hover:text-navy transition-colors">
                                <Icon name="document" class="w-4 h-4" />
                                Read the summary
                              </summary>
                              <Prose class="mt-4"><Fragment set:html={parallelSession.summaryHtml} /></Prose>
                            </details>
                          )}
                        </li>
                      ))}
                    </ul>
                  </div>
                ) : (
                  session.summaryHtml && (
                    <details class="group mt-5 border-t border-line pt-3">
                      <summary class="flex items-center gap-2 cursor-pointer list-none [&::-webkit-details-marker]:hidden text-sm font-medium text-primary hover:text-navy transition-colors">
                        <Icon name="document" class="w-4 h-4" />
                        Read the summary
                      </summary>
                      <Prose class="mt-4"><Fragment set:html={session.summaryHtml} /></Prose>
                    </details>
                  )
                )}
              </div>
            </li>
          );
        })}
      </ol>
    </Section>

    <CTA
      texts={{
        title: 'Minutes and summaries for your own board meetings',
        subtitle: 'The same AI minute builder drafts structured minutes of your board meetings, which your secretary reviews and publishes.',
        cta1: 'Try Dafira',
        cta2: 'Request a demo',
      }}
      links={{ cta1: '/try', cta2: '/request-demo' }}
    />
  </main>
</Layout>
