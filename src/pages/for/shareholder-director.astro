---
import Layout from '../../layouts/Layout.astro';
import RoleLanding from '../../components/industries/RoleLanding.astro';
import { customerQuote, readCaseLabel } from '../../components/industries/customerQuotes';

const hero = {
  eyebrow: 'For shareholder directors',
  title: 'Represent shareholders, with a clear record',
  lead: 'Balance the interests of the shareholders you represent with those of the company. Dafira keeps board papers, discussions and decisions in one secure place, with access set by role.',
  primary: { text: 'Book a demo', href: '/request-demo' },
  secondary: { text: 'Contact sales', href: '/contact' },
  screenshot: { src: '/onboarding-boardpack.png', alt: 'Dafira board pack organised by agenda item, with annotations on the minutes' },
};

const challenges = {
  title: 'What shareholder directors need',
  lead: 'Representing a shareholder on the board means handling several sets of expectations at once.',
  items: [
    { icon: 'scale', title: 'Balancing interests', text: 'Weigh shareholder expectations against the company’s needs, with the facts in front of you.' },
    { icon: 'users', title: 'Stakeholder relations', text: 'Keep exchanges with the shareholders you represent structured and documented.' },
    { icon: 'mail', title: 'Clear communication', text: 'Share information on time while respecting the confidentiality of board matters.' },
    { icon: 'tasks', title: 'Follow-up of requests', text: 'Track questions and action items raised at the board until they are closed.' },
  ],
};

const features = {
  title: 'Features for shareholder directors',
  lead: 'What Dafira provides to support the role.',
  items: [
    { icon: 'chat', title: 'Secure communication', text: 'Board conversations in one place instead of email and messaging apps.', items: ['Secure board chat', 'Controlled document sharing', 'News feed for updates'] },
    { icon: 'folder', title: 'Document library', text: 'Board papers, minutes and decisions, organised and searchable.', items: ['Board pack by agenda item', 'Access by role', 'Past minutes and decisions', 'Search'] },
    { icon: 'sparkle', title: 'AI assistant', text: 'Ask questions about the board papers and get summaries of long documents.', items: ['Questions on board documents', 'Summaries of long papers'] },
  ],
};

const security = {
  title: 'Governance and confidentiality',
  lead: 'Share what should be shared, and keep a record of it.',
  link: { text: 'Read about security', href: '/security' },
  items: [
    { icon: 'lock', title: 'Access control', text: 'Permissions by board, committee and role determine who sees which information.' },
    { icon: 'vote', title: 'Voting and decisions', text: 'Votes and resolutions recorded with the meeting, in a decision log.' },
    { icon: 'document', title: 'Documentation', text: 'Minutes, decisions and board papers kept together, with an audit trail.' },
  ],
};

const quote = { ...customerQuote('en', 'pierre'), linkText: readCaseLabel.en };
---

<Layout title="Board Management Software for Shareholder Directors | Dafira" description="Board portal for shareholder directors: secure board communication, organised board papers and a clear record of votes and decisions.">
  <main>
    <RoleLanding hero={hero} challenges={challenges} features={features} security={security} quote={quote} />
  </main>
</Layout>
