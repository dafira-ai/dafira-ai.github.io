---
import Layout from '../../layouts/Layout.astro';
import RoleLanding from '../../components/industries/RoleLanding.astro';
import { customerQuote, readCaseLabel } from '../../components/industries/customerQuotes';

const hero = {
  eyebrow: 'For independent directors',
  title: 'Independent oversight, with the right information',
  lead: 'Read the board pack on any device, discuss matters with fellow non-executive directors in a private space, and find past decisions when you need them.',
  primary: { text: 'Book a demo', href: '/request-demo' },
  secondary: { text: 'Contact sales', href: '/contact' },
  screenshot: { src: '/onboarding-private-chat.png', alt: 'Dafira private messages between board members' },
};

const challenges = {
  title: 'What independent directors need',
  lead: 'Independence depends on having the same information as management, and room to discuss it.',
  items: [
    { icon: 'scale', title: 'Maintaining independence', text: 'Private spaces and conversations, separate from executive management.' },
    { icon: 'search', title: 'Effective oversight', text: 'Access to the board papers, past minutes and decisions to ask informed questions.' },
    { icon: 'users', title: 'Discussion among peers', text: 'Private conversations for independent directors to prepare matters before the meeting.' },
    { icon: 'clipboard', title: 'Conflicts of interest', text: 'A record of who accessed which document and of declared interests, kept with the minutes.' },
  ],
};

const features = {
  title: 'Features for independent directors',
  lead: 'What Dafira provides to support independent oversight.',
  items: [
    { icon: 'chat', title: 'Private communication', text: 'Secure channels for discussions among independent directors.', items: ['Private conversations', 'Separate document spaces', 'Secure messaging'] },
    { icon: 'documents', title: 'Oversight tools', text: 'Everything needed to follow the company between meetings.', items: ['Document history', 'Decision log', 'Action item follow-up', 'Private annotations'] },
    { icon: 'sparkle', title: 'AI assistant', text: 'Ask questions about the board papers and get summaries of long documents before the meeting.', items: ['Questions on board documents', 'Summaries of long papers'] },
  ],
};

const security = {
  title: 'Security and confidentiality',
  lead: 'Independent directors’ conversations stay private.',
  link: { text: 'Read about security', href: '/security' },
  items: [
    { icon: 'lock', title: 'Secure access', text: 'Role-based permissions keep independent directors’ spaces separate from other users.' },
    { icon: 'clipboard', title: 'Audit trail', text: 'A record of document access and changes, for transparency.' },
    { icon: 'shield', title: 'Data protection', text: 'Encryption in transit and at rest, and data protection practices aligned with the GDPR.' },
  ],
};

const quote = { ...customerQuote('en', 'nathalie'), linkText: readCaseLabel.en };
---

<Layout title="Board Management Software for Independent Directors | Dafira" description="Board portal for independent directors: private spaces for discussion, access to board papers and past decisions, and an AI assistant for long documents.">
  <main>
    <RoleLanding hero={hero} challenges={challenges} features={features} security={security} quote={quote} />
  </main>
</Layout>
