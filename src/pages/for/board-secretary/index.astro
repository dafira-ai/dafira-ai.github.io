---
import Layout from '../../../layouts/Layout.astro';
import Testimonials from '../../../components/Testimonials.astro';
import { PageHero, Section, SectionHeader, Button, Icon, FeatureColumns, CellGrid, Screenshot, CTA } from '../../../components/ui';
import { customerQuote } from '../../../components/industries/customerQuotes';

const dayInLife = {
  title: 'A board day, before and after',
  lead: 'Three moments in a board secretary’s day, with and without a board portal.',
  beforeLabel: 'Without a portal',
  afterLabel: 'With Dafira',
  slots: [
    { time: '09:00', before: 'Searching email threads for the latest version of the board pack.', after: 'The board pack is in one place, organised by agenda item, with its version history.' },
    { time: '14:00', before: 'Taking detailed notes while trying to follow the discussion.', after: 'Following the meeting, with attendance, votes and resolutions recorded as they happen.' },
    { time: '17:30', before: 'Starting the minutes from scratch.', after: 'Reviewing a first draft prepared with the AI minute builder.' },
  ],
};

const painPoints = {
  title: 'Common challenges',
  lead: 'The daily work of a board secretary, and how Dafira handles it.',
  items: [
    { icon: 'documents', title: 'Scattered documents', text: 'Replace email threads and version confusion with one secure library for board papers.' },
    { icon: 'clock', title: 'Late-night minute writing', text: 'The AI minute builder drafts the minutes, with action items and resolutions carried over.' },
    { icon: 'signature', title: 'Chasing signatures', text: 'Collect signatures on minutes and resolutions electronically.' },
    { icon: 'search', title: 'Finding past decisions', text: 'Search the history of meetings, minutes and decisions.' },
  ],
};

const features = {
  title: 'What you work with',
  lead: 'The parts of Dafira board secretaries use every day.',
  items: [
    { icon: 'sparkle', title: 'AI minute builder', text: 'A first draft of the minutes, for you to review and complete.', items: ['Draft minutes', 'Action item follow-up', 'Meeting summaries', 'AI assistant on board documents'] },
    { icon: 'folder', title: 'Documents', text: 'Control of the board documentation, from draft to signature.', items: ['Version history', 'Secure distribution', 'E-signature', 'Templates'] },
    { icon: 'calendar', title: 'Meetings', text: 'From the invitation to the follow-up.', items: ['Calendar and invitations', 'Agenda builder', 'Attendance', 'Tasks and follow-up'] },
  ],
};

const industries = {
  title: 'By sector',
  lead: 'Board secretaries in regulated sectors have specific record-keeping needs.',
  link: 'View sector page',
  items: [
    { id: 'financial-services', icon: 'bank', name: 'Financial services', text: 'Banks, insurers and investment firms.' },
    { id: 'healthcare', icon: 'health', name: 'Healthcare', text: 'Hospitals, care providers and life sciences.' },
    { id: 'real-estate', icon: 'building', name: 'Real estate', text: 'Property investment and management.' },
  ],
};

const testimonials = {
  texts: {
    title: 'What board teams say',
    subtitle: 'Secretaries, general counsels and CEOs on running their board with Dafira.',
    cta: 'All customer stories',
    ctaLink: '/testimonials',
  },
  testimonials: (['lore', 'pierre', 'nathalie'] as const).map((k) => {
    const q = customerQuote('en', k);
    return { quote: q.quote, author: q.author, position: q.role, company: q.company, image: q.image, link: q.link };
  }),
};
---

<Layout title="Board Meeting Management Software for Board Secretaries | Dafira" description="Board portal for board secretaries: board packs, agendas, AI-drafted minutes, e-signatures and a searchable history of decisions.">
  <main>
    <PageHero eyebrow="For board secretaries" title="Prepare, record and follow up on every board meeting" lead="Dafira takes care of the administrative work around the board, from the agenda to the signed minutes, so you can concentrate on the substance.">
      <Fragment slot="actions">
        <Button href="/request-demo">Book a demo</Button>
        <Button variant="secondary" href="/try">Start a free trial</Button>
      </Fragment>
      <Screenshot slot="aside" src="/applications-picture-meeting.png" alt="Dafira meeting page on desktop, tablet and phone" eager />
    </PageHero>

    <Section>
      <SectionHeader title={dayInLife.title} lead={dayInLife.lead} />
      <div class="border-t border-line" data-play>
        <div class="hidden md:grid grid-cols-12 gap-6 py-4 border-b border-line font-mono text-xs uppercase tracking-[0.08em] text-gray-500">
          <div class="col-span-2"></div>
          <div class="col-span-5">{dayInLife.beforeLabel}</div>
          <div class="col-span-5">{dayInLife.afterLabel}</div>
        </div>
        {dayInLife.slots.map((slot, i) => (
          <div class="grid md:grid-cols-12 gap-3 md:gap-6 py-6 border-b border-line" data-step style={`--d:${i * 80}`}>
            <div class="md:col-span-2 font-mono text-sm text-primary tabular-nums">{slot.time}</div>
            <div class="md:col-span-5 text-gray-500">
              <span class="md:hidden font-mono text-xs uppercase tracking-[0.08em] block mb-1">{dayInLife.beforeLabel}</span>
              {slot.before}
            </div>
            <div class="md:col-span-5 text-ink">
              <span class="md:hidden font-mono text-xs uppercase tracking-[0.08em] text-gray-500 block mb-1">{dayInLife.afterLabel}</span>
              {slot.after}
            </div>
          </div>
        ))}
      </div>
    </Section>

    <Section tone="surface" border="both">
      <SectionHeader title={painPoints.title} lead={painPoints.lead} />
      <CellGrid columns={2}>
        {painPoints.items.map((item) => (
          <div class="bg-white p-8">
            <Icon name={item.icon} class="w-6 h-6 text-navy" />
            <h3 class="mt-5 text-lg font-semibold text-navy">{item.title}</h3>
            <p class="mt-2 text-[15px] text-gray-600 leading-relaxed">{item.text}</p>
          </div>
        ))}
      </CellGrid>
    </Section>

    <Section>
      <SectionHeader title={features.title} lead={features.lead} />
      <FeatureColumns items={features.items} />
    </Section>

    <Section tone="surface" border="both" space="md">
      <SectionHeader title={industries.title} lead={industries.lead} />
      <CellGrid columns={3}>
        {industries.items.map((item) => (
          <a href={`/for/board-secretary/industry/${item.id}`} class="group bg-white p-8 hover:bg-surface transition-colors flex flex-col">
            <Icon name={item.icon} class="w-6 h-6 text-navy" />
            <h3 class="mt-5 text-lg font-semibold text-navy">{item.name}</h3>
            <p class="mt-2 text-[15px] text-gray-600 leading-relaxed">{item.text}</p>
            <span class="mt-auto pt-6 text-[15px] font-medium text-primary group-hover:text-navy transition-colors">{industries.link}</span>
          </a>
        ))}
      </CellGrid>
    </Section>

    <Testimonials texts={testimonials.texts} testimonials={testimonials.testimonials} />

    <CTA />
  </main>
</Layout>
