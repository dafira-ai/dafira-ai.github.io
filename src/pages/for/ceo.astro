---
import Layout from '../../layouts/Layout.astro';
import RoleLanding from '../../components/industries/RoleLanding.astro';
import { customerQuote, readCaseLabel } from '../../components/industries/customerQuotes';

const hero = {
  eyebrow: 'For CEOs',
  title: 'Keep the board informed, on your terms',
  lead: 'Decide what reaches the board and when. Dafira gives you one controlled channel for board papers, updates and follow-up, with access set by role.',
  primary: { text: 'Book a demo', href: '/request-demo' },
  secondary: { text: 'Contact sales', href: '/contact' },
  screenshot: { src: '/onboarding-event-detail.png', alt: 'Dafira meeting page with the agenda, attendance and a pending vote on the minutes' },
};

const challenges = {
  title: 'What CEOs need from the board process',
  lead: 'The board relies on management for information. The way it is shared shapes the quality of the discussion.',
  items: [
    { icon: 'folder', title: 'Information control', text: 'One repository for everything the board receives, so you know which version each director has read.' },
    { icon: 'clock', title: 'Timely communication', text: 'Circulate updates and board papers on schedule, without relying on email chains.' },
    { icon: 'list', title: 'Information balance', text: 'Structure the board pack by agenda item so directors can find what matters without being overloaded.' },
    { icon: 'chat', title: 'Responsiveness', text: 'Answer director questions between meetings in a secure board chat, with the context kept.' },
  ],
};

const features = {
  title: 'Tools for the CEO',
  lead: 'The parts of Dafira CEOs use most often.',
  items: [
    { icon: 'documents', title: 'Document control', text: 'Share board papers from one place and keep track of what was sent.', items: ['Controlled distribution', 'Board pack by agenda item', 'Update notifications', 'Version history'] },
    { icon: 'sparkle', title: 'AI assistant', text: 'Directors can ask questions about the board papers and get summaries of long documents.', items: ['Questions on board documents', 'Summaries of long papers', 'Search across past meetings'] },
    { icon: 'lock', title: 'Secure communication', text: 'Keep board conversations out of personal email and messaging apps.', items: ['Secure board chat', 'Role-based access', 'Audit trail'] },
  ],
};

const security = {
  title: 'Security for board communication',
  lead: 'Board information stays within the board.',
  link: { text: 'Read about security', href: '/security' },
  items: [
    { icon: 'lock', title: 'Encryption', text: 'Data is encrypted in transit and at rest, on Microsoft Azure infrastructure.' },
    { icon: 'users', title: 'Access control', text: 'Permissions by board, committee and role, so information reaches only the intended people.' },
    { icon: 'clipboard', title: 'Audit trail', text: 'A record of access to documents and of the decisions taken.' },
  ],
};

const quote = { ...customerQuote('en', 'pierre'), linkText: readCaseLabel.en };
---

<Layout title="Board Management Software for CEOs | Dafira" description="Board portal for CEOs: control how information reaches the board, circulate updates on time and keep board communication secure.">
  <main>
    <RoleLanding hero={hero} challenges={challenges} features={features} security={security} quote={quote} />
  </main>
</Layout>
