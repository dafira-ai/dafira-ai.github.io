---
import Layout from '../../layouts/Layout.astro';
import RoleLanding from '../../components/industries/RoleLanding.astro';
import { customerQuote, readCaseLabel } from '../../components/industries/customerQuotes';

const hero = {
  eyebrow: 'For general counsel',
  title: 'Legal oversight of the board, in one record',
  lead: 'Keep resolutions, signatures and the audit trail in order. Dafira holds board documents, minutes and decisions in one place, with access set by role.',
  primary: { text: 'Book a demo', href: '/request-demo' },
  secondary: { text: 'Contact sales', href: '/contact' },
  screenshot: { src: '/onboarding-document-list.png', alt: 'Dafira document library for a board' },
};

const challenges = {
  title: 'What general counsel need',
  lead: 'The legal function answers for the board record: what was decided, by whom, on the basis of which documents.',
  items: [
    { icon: 'scale', title: 'Compliance', text: 'Follow the regulatory requirements that apply to the board and keep evidence of how they were met.' },
    { icon: 'document', title: 'Document control', text: 'Version history and an audit trail for every board document.' },
    { icon: 'lock', title: 'Data security', text: 'Role-based access and encryption for confidential board information.' },
    { icon: 'signature', title: 'Electronic signatures', text: 'Sign minutes and resolutions electronically, without printing and chasing signatures.' },
  ],
};

const features = {
  title: 'Features for general counsel',
  lead: 'The parts of Dafira legal teams rely on.',
  items: [
    { icon: 'shield', title: 'Compliance monitoring', text: 'Follow regulatory topics relevant to the board and keep the related documents together.', items: ['Regulatory topics', 'Audit trail', 'Decision log'] },
    { icon: 'folder', title: 'Document management', text: 'Secure, central storage for board materials, with version history.', items: ['Version history', 'Access tracking', 'Document retention', 'Search'] },
    { icon: 'gavel', title: 'Governance tools', text: 'The instruments of a well-run board, in one workspace.', items: ['Meeting management', 'Resolutions and voting', 'Committees', 'E-signature'] },
  ],
};

const quote = { ...customerQuote('en', 'lore'), linkText: readCaseLabel.en };
---

<Layout title="Board Management Software for General Counsel | Dafira" description="Board portal for general counsel: document control, electronic signatures, resolutions and an audit trail for the board record.">
  <main>
    <RoleLanding hero={hero} challenges={challenges} features={features} quote={quote} />
  </main>
</Layout>
