---
import Layout from '../../../../layouts/Layout.astro';
import IndustryLanding from '../../../../components/industries/IndustryLanding.astro';
import { industryIds, getIndustry, testimonials } from '../../../../data/board-member-industries';

export function getStaticPaths() {
  return industryIds.map((industry) => ({ params: { industry } }));
}

const { industry } = Astro.params;
const info = getIndustry('en', industry);

if (!info) {
  return Astro.redirect('/for/board-member');
}

const screenshots = {
  'financial-services': { src: '/onboarding-document-list.png', alt: 'Dafira document library, with board papers grouped by meeting' },
  healthcare: { src: '/onboarding-event-detail.png', alt: 'Dafira meeting page with the agenda, attendance and a vote' },
  'real-estate': { src: '/onboarding-boardpack.png', alt: 'Dafira board pack organised by agenda item, with annotations' },
};
---

<Layout title={info.seo.title} description={info.seo.description}>
  <main>
    <IndustryLanding
      industry={industry}
      hero={info.hero}
      screenshot={screenshots[industry]}
      challenges={info.challenges}
      features={info.features}
      quoteKey={testimonials[industry]}
      secondary="contact"
    />
  </main>
</Layout>
