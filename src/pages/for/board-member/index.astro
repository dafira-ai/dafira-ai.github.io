---
import Layout from '../../../layouts/Layout.astro';
import { PageHero, Section, SectionHeader, Button, Icon, FeatureColumns, CellGrid, FeatureList, Screenshot, CTA } from '../../../components/ui';

const responsibilities = {
  title: 'Supporting your duties as a director',
  lead: 'What the board expects of its members, and where Dafira helps.',
  items: [
    { icon: 'target', title: 'Strategic oversight', text: 'Read the board papers in context, with the history of past discussions at hand.' },
    { icon: 'scale', title: 'Fiduciary duty', text: 'Make decisions on complete, current information, and keep a record of them.' },
    { icon: 'users', title: 'Stakeholder relations', text: 'Keep exchanges with fellow directors and management structured and secure.' },
    { icon: 'tasks', title: 'Follow-up', text: 'Track action items and decisions from one meeting to the next.' },
  ],
};

const roles = {
  title: 'By role',
  lead: 'Pages for the specific positions on the board.',
  link: 'View role page',
  items: [
    { title: 'Independent director', icon: 'scale', text: 'Objective oversight, with private spaces for discussion among independent directors.', href: '/for/independent-director', features: ['Private conversations', 'Access to past decisions', 'Conflict of interest records'] },
    { title: 'Shareholder director', icon: 'trend', text: 'Represent shareholders while acting in the interest of the company.', href: '/for/shareholder-director', features: ['Secure communication', 'Organised board papers', 'Votes and decision log'] },
  ],
};

const features = {
  title: 'Tools for every board member',
  lead: 'What every director uses, whatever the role.',
  items: [
    { icon: 'sparkle', title: 'AI assistant', text: 'Ask questions about the board papers and get summaries of long documents.', items: ['Questions on board documents', 'Summaries', 'Search across past meetings'] },
    { icon: 'pen', title: 'Collaboration', text: 'Prepare and discuss the meeting with the rest of the board.', items: ['Private annotations', 'Secure board chat', 'Online meeting links', 'Shared documents'] },
    { icon: 'vote', title: 'Decisions', text: 'Vote, sign and find what was decided.', items: ['Voting', 'E-signature', 'Decision log', 'Action items'] },
  ],
};

const industries = {
  title: 'By sector',
  lead: 'Sector pages for directors in regulated industries.',
  link: 'View sector page',
  items: [
    { id: 'financial-services', icon: 'bank', name: 'Financial services', text: 'Banks, insurers and investment firms.', features: ['Regulatory context', 'Secure document management', 'Committee meetings'] },
    { id: 'healthcare', icon: 'health', name: 'Healthcare', text: 'Hospitals, care providers and life sciences.', features: ['Clinical governance on the agenda', 'Confidential papers', 'Committee meetings'] },
    { id: 'real-estate', icon: 'building', name: 'Real estate', text: 'Property investment and management.', features: ['Investment decisions', 'Portfolio papers', 'Decision log'] },
  ],
};
---

<Layout title="Board Member Software | Dafira Board Portal" description="Board portal for directors: read and annotate the board pack on any device, vote, sign and find past decisions. Pages by role and by sector.">
  <main>
    <PageHero eyebrow="For board members" title="The board pack, the discussion and the decisions, in one place" lead="Whether you are an independent director, a shareholder representative or a sector specialist, Dafira gives you the information you need to decide, on any device.">
      <Fragment slot="actions">
        <Button href="/request-demo">Book a demo</Button>
        <Button variant="secondary" href="/contact">Contact sales</Button>
      </Fragment>
      <Screenshot slot="aside" src="/onboarding-boardpack.png" alt="Dafira board pack organised by agenda item, with annotations on a document" eager />
    </PageHero>

    <Section>
      <SectionHeader title={responsibilities.title} lead={responsibilities.lead} />
      <CellGrid columns={2}>
        {responsibilities.items.map((item) => (
          <div class="bg-white p-8">
            <Icon name={item.icon} class="w-6 h-6 text-navy" />
            <h3 class="mt-5 text-lg font-semibold text-navy">{item.title}</h3>
            <p class="mt-2 text-[15px] text-gray-600 leading-relaxed">{item.text}</p>
          </div>
        ))}
      </CellGrid>
    </Section>

    <Section tone="surface" border="both">
      <SectionHeader title={roles.title} lead={roles.lead} />
      <CellGrid columns={2}>
        {roles.items.map((role) => (
          <a href={role.href} class="group bg-white p-8 lg:p-10 hover:bg-surface transition-colors flex flex-col">
            <Icon name={role.icon} class="w-6 h-6 text-navy" />
            <h3 class="mt-5 text-xl font-semibold text-navy">{role.title}</h3>
            <p class="mt-3 text-gray-600 leading-relaxed">{role.text}</p>
            <FeatureList items={role.features} class="mt-6" />
            <span class="mt-auto pt-8 text-[15px] font-medium text-primary group-hover:text-navy transition-colors">{roles.link}</span>
          </a>
        ))}
      </CellGrid>
    </Section>

    <Section>
      <SectionHeader title={features.title} lead={features.lead} />
      <FeatureColumns items={features.items} />
    </Section>

    <Section tone="surface" border="both">
      <SectionHeader title={industries.title} lead={industries.lead} />
      <CellGrid columns={3}>
        {industries.items.map((item) => (
          <a href={`/for/board-member/industry/${item.id}`} class="group bg-white p-8 hover:bg-surface transition-colors flex flex-col">
            <Icon name={item.icon} class="w-6 h-6 text-navy" />
            <h3 class="mt-5 text-lg font-semibold text-navy">{item.name}</h3>
            <p class="mt-2 text-[15px] text-gray-600 leading-relaxed">{item.text}</p>
            <FeatureList items={item.features} class="mt-6" />
            <span class="mt-auto pt-8 text-[15px] font-medium text-primary group-hover:text-navy transition-colors">{industries.link}</span>
          </a>
        ))}
      </CellGrid>
    </Section>

    <CTA />
  </main>
</Layout>
