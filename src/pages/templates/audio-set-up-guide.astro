---
import Layout from '../../layouts/Layout.astro';
import PreviewCard from '../../components/templates/audio/PreviewCard.astro';
import TemplateForm from '../../components/templates/audio/TemplateForm.astro';
import FeatureComparison from '../../components/templates/audio/FeatureComparison.astro';
import { PageHero, Section, SectionHeader, CellGrid, Icon, Badge, Callout, Button } from '../../components/ui';

const previews = [
  { title: "Online meetings", description: "Audio quality is typically reliable with standard video conferencing tools", icon: "desktop" },
  { title: "Hybrid and offline", description: "Requires careful setup: see the detailed guidelines in the PDF", icon: "building" }
];

const formats = [
  {
    icon: "desktop",
    title: "Online meetings",
    text: "Audio quality in fully online meetings is typically reliable. Video conferencing platforms handle audio optimisation automatically.",
    status: "Usually fine",
    tone: "success" as const,
  },
  {
    icon: "users",
    title: "Hybrid meetings",
    text: "Hybrid meetings bring their own challenges. Microphone placement is critical to capture in-room participants clearly, and echo appears when room speakers pick up remote participants' audio.",
    status: "Requires setup",
    tone: "warning" as const,
  },
  {
    icon: "building",
    title: "Offline meetings",
    text: "In-person board meetings require proper microphone placement and attention to room acoustics. Echo and background noise affect recording quality if they are not addressed.",
    status: "Detailed setup needed",
    tone: "warning" as const,
  }
];
---

<Layout
  title="Audio Setup Guide for Board Meeting Minutes | Dafira"
  description="Recording quality matters for accurate board meeting minutes. Download our free audio setup guide for hybrid and offline meetings."
>
  <main>
    <PageHero
      eyebrow="Free guide"
      title="Good minutes start with a good recording"
      lead="Accurate board minutes depend on clear audio. Whether you transcribe manually or use AI tools, the quality of the recording shapes the quality of the minutes."
    >
      <CellGrid columns={2} class="mt-10">
        {previews.map((preview) => <PreviewCard {...preview} />)}
      </CellGrid>
      <TemplateForm slot="aside" />
    </PageHero>

    <Section space="md">
      <SectionHeader title="Why recording quality matters for board minutes" lead="The audio challenges differ with each meeting format." />
      <CellGrid columns={3}>
        {formats.map((f) => (
          <div class="bg-white p-6 lg:p-8 flex flex-col">
            <Icon name={f.icon} class="w-6 h-6 text-navy" />
            <h3 class="mt-5 text-xl font-semibold text-navy">{f.title}</h3>
            <p class="mt-3 text-gray-600 leading-relaxed">{f.text}</p>
            <div class="mt-auto pt-6"><Badge tone={f.tone}>{f.status}</Badge></div>
          </div>
        ))}
      </CellGrid>

      <Callout tone="note" title="Hybrid or offline? Read the guidelines" class="mt-12 max-w-3xl">
        <p>For hybrid and offline board meetings, a proper audio setup is essential. The downloadable PDF gives detailed instructions for a clear recording.</p>
        <Button variant="link" href="#email" class="mt-3">Download the guidelines</Button>
      </Callout>
    </Section>

    <Section tone="surface" space="md" border="top">
      <SectionHeader title="We guide our clients at every step" lead="Board minutes matter for governance, compliance and institutional memory. We do not just provide software: we help our clients set it up well." />
      <FeatureComparison />
    </Section>
  </main>
</Layout>
