---
import Layout from '../../layouts/Layout.astro';
import PreviewCard from '../../components/templates/minutes/PreviewCard.astro';
import TemplateForm from '../../components/templates/minutes/TemplateForm.astro';
import FeatureComparison from '../../components/templates/minutes/FeatureComparison.astro';
import { PageHero, Section, CellGrid } from '../../components/ui';

const previews = [
  { title: "Structured format", description: "Clear sections for agenda items, discussions and decisions", icon: "list" },
  { title: "Compliance guidance", description: "Notes on the documentation boards are expected to keep", icon: "scale" }
];
---

<Layout
  title="Free Board Meeting Minutes Template | Professional Format"
  description="Download a free board meeting minutes template with clear sections for agenda items, discussions and decisions, plus guidance on good practice and compliance."
>
  <main>
    <PageHero eyebrow="Free template" title="Board meeting minutes template" lead="A clear, ready-to-use structure for your board minutes, with guidance on good practice and documentation requirements.">
      <CellGrid columns={2} class="mt-10">
        {previews.map((preview) => <PreviewCard {...preview} />)}
      </CellGrid>
      <TemplateForm slot="aside" />
    </PageHero>

    <Section space="md">
      <div class="max-w-2xl mb-12">
        <h2 class="text-3xl lg:text-4xl font-semibold text-navy leading-tight">A good start. Dafira covers the rest.</h2>
        <p class="mt-4 text-lg text-gray-600 leading-relaxed">From the recording to signed minutes, in one place.</p>
      </div>
      <FeatureComparison />
    </Section>
  </main>
</Layout>
