---
// One chapter of the terms (rendered inside Prose). Text comes verbatim from src/data/terms-sections*.ts.
interface Props {
  title: string;
  key: string;
  sections: {
    title: string;
    description: string;
    subsections?: {
      number: string;
      description: string;
    }[];
  }[];
}

const { title, sections, key }: Props = Astro.props;
---

<section id={key} class="df-legal-section">
  <h2>{title}</h2>
  {sections?.map((section) => (
    <Fragment>
      <h3>{section.title}</h3>
      {section.description && <p>{section.description.trim()}</p>}
      {section.subsections?.map((subsection) => (
        <p><strong class="font-mono text-sm">{subsection.number}</strong> {subsection.description.trim()}</p>
      ))}
    </Fragment>
  ))}
</section>
