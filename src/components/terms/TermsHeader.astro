---
// Legal page header: PageHero with last-update date, intro and contact line.
import { PageHero } from '../ui';

interface Props {
  lastUpdate: string;
  title?: string;
  titleHighlight?: string;
  description?: string;
  contactText?: string;
  contactEmail?: string;
  lastUpdateText?: string;
  eyebrow?: string;
}

const {
  lastUpdate,
  title = "General Terms and",
  titleHighlight = "Conditions",
  description = "Please read fully and carefully these Terms & Conditions as well as Dafira's privacy policy & cookie code of conduct and the Data Processing Agreement before using any of the Services. They set forth the legally binding terms that govern the access to and use of the Services.",
  contactText = "For any questions or concerns, please contact",
  contactEmail = "info@dafira.ai",
  lastUpdateText = "Last Update",
  eyebrow = "Legal",
} = Astro.props;
---

<PageHero eyebrow={eyebrow} title={`${title} ${titleHighlight}`} lead={description}>
  <dl class="mt-8 flex flex-wrap gap-x-8 gap-y-2 text-sm">
    <div class="flex gap-2">
      <dt class="text-gray-500">{lastUpdateText}:</dt>
      <dd class="text-navy">{lastUpdate}</dd>
    </div>
    <div class="flex gap-2">
      <dt class="text-gray-500">{contactText}</dt>
      <dd><a href={`mailto:${contactEmail}`} class="text-primary hover:text-navy underline underline-offset-2">{contactEmail}</a></dd>
    </div>
  </dl>
</PageHero>
