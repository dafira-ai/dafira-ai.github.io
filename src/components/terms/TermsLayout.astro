---
// Legal document frame: sticky contents list (slot "sidebar") and a Prose column.
import { Section, Prose } from '../ui';

interface Props {
  title: string;
  description?: string;
}
---

<Section space="md">
  <div class="grid lg:grid-cols-12 gap-12">
    <aside class="hidden lg:block lg:col-span-3">
      <slot name="sidebar" />
    </aside>
    <div class="lg:col-span-9">
      <Prose class="df-legal">
        <slot />
      </Prose>
    </div>
  </div>
</Section>

<style is:global>
  .df-legal h2, .df-legal h3 { scroll-margin-top: 6rem; }
  .df-legal .df-legal-section > h2:first-child { margin-top: 0; }
  .df-legal .df-legal-section { margin-top: 3.5rem; padding-top: 2.5rem; border-top: 1px solid rgb(var(--line)); }
  .df-legal .df-legal-section > * + * { margin-top: 1rem; }
  .df-legal .df-legal-section:first-child { margin-top: 0; padding-top: 0; border-top: 0; }
</style>
