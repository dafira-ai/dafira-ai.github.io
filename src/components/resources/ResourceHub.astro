---
// Resources index: overview of the four resource types, then guides, research, latest articles and podcasts.
import { PageHero, Section, SectionHeader, CellGrid, Card, Icon, Button, Badge } from '../ui';
import BlogCard from '../blog/BlogCard.astro';
import EpisodeCard from '../EpisodeCard.astro';
import LocalizedCTA from '../case-studies/LocalizedCTA.astro';

interface Resource { title: string; description: string; type: string; readTime?: string; image: string; link: string }
interface Category { eyebrow: string; title: string; description: string; link?: string; linkText?: string; resources: Resource[] }

interface Props {
  lang: 'en' | 'fr' | 'nl';
  copy: {
    eyebrow: string;
    title: string;
    lead: string;
    overview: { icon: string; title: string; text: string; href: string; linkText: string }[];
    podcasts: { title: string; link: string; linkText: string };
    articles: { title: string; link: string; linkText: string };
    readMore: string;
  };
  categories: Category[];
  posts: any[];
  podcasts: any[];
}

const { lang, copy, categories, posts, podcasts } = Astro.props;
---

<PageHero eyebrow={copy.eyebrow} title={copy.title} lead={copy.lead} />

<Section space="md" border="bottom">
  <CellGrid columns={4}>
    {copy.overview.map((o) => (
      <a href={o.href} class="group bg-white p-6 lg:p-8 flex flex-col hover:bg-surface transition-colors">
        <Icon name={o.icon} class="w-6 h-6 text-navy" />
        <h2 class="mt-5 text-xl font-semibold text-navy">{o.title}</h2>
        <p class="mt-2 text-[15px] text-gray-600 leading-relaxed flex-1">{o.text}</p>
        <span class="mt-6 inline-flex items-center gap-2 text-[15px] font-medium text-primary group-hover:text-navy transition-colors">
          {o.linkText}
          <svg class="w-4 h-4 rtl-flip" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M9 5l7 7-7 7" /></svg>
        </span>
      </a>
    ))}
  </CellGrid>
</Section>

{categories.map((category, i) => (
  <Section tone={i % 2 === 0 ? 'white' : 'surface'} space="lg" border={i % 2 === 0 ? 'none' : 'both'}>
    <SectionHeader eyebrow={category.eyebrow} title={category.title} lead={category.description} />
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
      {category.resources.map((r) => (
        <Card href={r.link} padding="sm" class="flex flex-col h-full">
          <img src={r.image} alt="" loading="lazy" class="w-full h-44 object-cover rounded-sm border border-line" />
          <div class="mt-5 flex items-center justify-between gap-3">
            <Badge tone="info">{r.type}</Badge>
            {r.readTime && <span class="font-mono text-xs text-gray-500">{r.readTime}</span>}
          </div>
          <h3 class="mt-3 text-lg font-semibold text-navy group-hover:text-primary transition-colors">{r.title}</h3>
          <p class="mt-2 text-[15px] text-gray-600 leading-relaxed flex-1">{r.description}</p>
          <span class="mt-5 text-[15px] font-medium text-primary">{copy.readMore}</span>
        </Card>
      ))}
    </div>
    {category.link && category.linkText && (
      <div class="mt-10"><Button variant="link" href={category.link}>{category.linkText}</Button></div>
    )}
  </Section>
))}

{posts.length > 0 && (
  <Section space="lg" border="top">
    <SectionHeader title={copy.articles.title} />
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
      {posts.map((post) => <BlogCard post={post} lang={lang} />)}
    </div>
    <div class="mt-10"><Button variant="link" href={copy.articles.link}>{copy.articles.linkText}</Button></div>
  </Section>
)}

{podcasts.length > 0 && (
  <Section tone="surface" space="lg" border="top">
    <SectionHeader title={copy.podcasts.title} />
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
      {podcasts.map((podcast) => <EpisodeCard episode={podcast} />)}
    </div>
    <div class="mt-10"><Button variant="link" href={copy.podcasts.link}>{copy.podcasts.linkText}</Button></div>
  </Section>
)}

<LocalizedCTA />
