---
import { langFromPath, localizePath } from '../i18n/routes';
import Section from './ui/Section.astro';
import Eyebrow from './ui/Eyebrow.astro';
import Button from './ui/Button.astro';
import CellGrid from './ui/CellGrid.astro';
import Icon from './ui/Icon.astro';

interface Props {
  texts?: {
    badge: string;
    title: string;
    subtitle: string;
    cta: string;
    features: {
      icon: string;
      title: string;
      description: string;
    }[];
  }
}

const {
  texts = {
    badge: "Security",
    title: "Board papers stay confidential",
    subtitle: "Encryption, strong authentication and access rights by role protect what the board discusses.",
    cta: "Read about security",
    features: [
      {
        icon: "🔒",
        title: "Encryption",
        description: "256-bit encryption protects documents, messages and votes."
      },
      {
        icon: "🔐",
        title: "Two-factor authentication",
        description: "Every director signs in with a second factor."
      },
      {
        icon: "👥",
        title: "Access by role",
        description: "Each document is visible only to the people who should see it, with an audit trail of every action."
      }
    ]
  }
} = Astro.props;

const securityHref = localizePath(langFromPath(Astro.url.pathname), "/security");
const icons = ['lock', 'key', 'users'];
---

<Section tone="surface" border="both">
  <div class="grid lg:grid-cols-12 gap-10">
    <div class="lg:col-span-4" data-play>
      <div data-step>
        <Eyebrow>{texts.badge}</Eyebrow>
        <h2 class="mt-4 text-3xl lg:text-4xl font-semibold text-navy leading-tight">{texts.title}</h2>
      </div>
      <p class="mt-4 text-lg text-gray-600 leading-relaxed" data-step style="--d:80">{texts.subtitle}</p>
      <Button variant="link" href={securityHref} class="mt-8">{texts.cta}</Button>
    </div>
    <CellGrid columns={3} class="lg:col-span-7 lg:col-start-6 self-start">
      {texts.features.map((feature, i) => (
        <div class="bg-white p-6">
          <Icon name={icons[i % icons.length]} class="w-6 h-6 text-navy" />
          <h3 class="mt-5 font-semibold text-navy">{feature.title}</h3>
          <p class="mt-2 text-[15px] text-gray-600 leading-relaxed">{feature.description}</p>
        </div>
      ))}
    </CellGrid>
  </div>
</Section>
