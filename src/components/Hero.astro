---
import VideoModal from './VideoModal.astro';
import { langFromPath } from '../i18n/routes';

interface HeroProps {
  /** @deprecated kept for backwards compatibility with existing pages; no longer rendered */
  imageValues?: unknown[];
  badgeText?: string;
  heading?: {
    main: string;
    highlight: string;
  };
  description?: string;
  ctaButtons?: {
    primary: { text: string; href: string };
    secondary: { text: string };
  };
  securityFeatures?: { title: string; subtitle: string }[];
  imageAlt?: string;
  imageSrc?: unknown;
}

const lang = langFromPath(Astro.url.pathname);

const {
  badgeText = "Board portal · GDPR compliant",
  heading = {
    main: "The board portal for organisations that take",
    highlight: "governance seriously."
  },
  description = "Prepare the board pack, run the meeting, record votes and circulate signed minutes. One secure place for directors, secretaries and legal teams.",
  ctaButtons = {
    primary: { text: "Book a demo", href: "/request-demo" },
    secondary: { text: "Watch the 2-minute tour" }
  },
  securityFeatures = [
    { title: "256-bit", subtitle: "Encryption" },
    { title: "GDPR", subtitle: "Compliant" },
    { title: "MFA", subtitle: "For every director" }
  ],
} = Astro.props as HeroProps;

// Product card copy — sample meeting shown next to the headline
const card = {
  en: { meeting: 'Board of Directors · Q3 2026', date: '14 Oct · 09:30', items: [
      ['09:30', 'Approval of previous minutes', 'ok', 'Approved'],
      ['09:45', 'CFO report · H1 accounts', 'ok', 'Read 7/7'],
      ['10:30', 'Resolution 2026-14 · Capex', 'vote', 'Vote open'],
      ['11:15', 'Remuneration committee', 'pend', 'In camera'],
    ], signed: 'Minutes signed 4/5', quorum: 'Quorum met', g2: 'on G2' },
  fr: { meeting: 'Conseil d’administration · T3 2026', date: '14 oct. · 09:30', items: [
      ['09:30', 'Approbation du PV précédent', 'ok', 'Approuvé'],
      ['09:45', 'Rapport du CFO · comptes S1', 'ok', 'Lu 7/7'],
      ['10:30', 'Résolution 2026-14 · Capex', 'vote', 'Vote ouvert'],
      ['11:15', 'Comité de rémunération', 'pend', 'Huis clos'],
    ], signed: 'PV signé 4/5', quorum: 'Quorum atteint', g2: 'sur G2' },
  nl: { meeting: 'Raad van bestuur · Q3 2026', date: '14 okt · 09:30', items: [
      ['09:30', 'Goedkeuring vorige notulen', 'ok', 'Goedgekeurd'],
      ['09:45', 'Rapport CFO · jaarrekening H1', 'ok', 'Gelezen 7/7'],
      ['10:30', 'Resolutie 2026-14 · Capex', 'vote', 'Stemming open'],
      ['11:15', 'Remuneratiecomité', 'pend', 'Besloten'],
    ], signed: 'Notulen getekend 4/5', quorum: 'Quorum bereikt', g2: 'op G2' },
  ar: { meeting: 'مجلس الإدارة · الربع الثالث 2026', date: '14 أكتوبر · 09:30', items: [
      ['09:30', 'اعتماد محضر الاجتماع السابق', 'ok', 'معتمد'],
      ['09:45', 'تقرير المدير المالي · حسابات النصف الأول', 'ok', 'قُرئ 7/7'],
      ['10:30', 'القرار 2026-14 · النفقات الرأسمالية', 'vote', 'التصويت مفتوح'],
      ['11:15', 'لجنة المكافآت', 'pend', 'جلسة مغلقة'],
    ], signed: 'تم توقيع المحضر 4/5', quorum: 'النصاب مكتمل', g2: 'على G2' },
}[lang];

const statusClass = {
  ok: 'bg-emerald-50 text-emerald-800',
  vote: 'bg-blue-50 text-primary',
  pend: 'bg-amber-50 text-amber-800',
};
---

<section class="relative bg-white pt-32 pb-20 lg:pt-36 lg:pb-24 border-b border-line">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid lg:grid-cols-12 gap-12 lg:gap-10 items-center">
      <div class="lg:col-span-6">
        <p class="flex items-center gap-3 font-mono text-xs uppercase tracking-[0.08em] text-gray-500">
          <span class="w-5 h-px bg-primary" aria-hidden="true"></span>
          {badgeText}
        </p>

        <h1 class="mt-6 text-4xl sm:text-5xl lg:text-[3.5rem] font-semibold text-navy leading-[1.08]">
          {heading.main} {heading.highlight}
        </h1>

        <p class="mt-6 text-lg text-gray-600 leading-relaxed max-w-xl">
          {description}
        </p>

        <div class="mt-9 flex flex-col sm:flex-row gap-3">
          <a
            href={ctaButtons.primary.href}
            class="inline-flex items-center justify-center px-5 py-3 text-[15px] font-medium rounded-md text-white bg-navy hover:bg-primary transition-colors"
          >
            {ctaButtons.primary.text}
          </a>
          <button
            type="button"
            onclick="openVideoModal()"
            class="inline-flex items-center justify-center gap-2 px-5 py-3 text-[15px] font-medium rounded-md text-navy border border-line hover:border-navy transition-colors"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <circle cx="12" cy="12" r="9" stroke-width="1.5" />
              <path d="M10 8.5v7l5.5-3.5z" fill="currentColor" stroke="none" />
            </svg>
            {ctaButtons.secondary.text}
          </button>
        </div>

        <dl class="mt-12 pt-6 border-t border-line grid grid-cols-2 sm:grid-cols-4 gap-6 text-sm">
          {securityFeatures.map((feature) => (
            <div>
              <dt class="font-medium text-ink">{feature.title}</dt>
              <dd class="text-gray-500">{feature.subtitle}</dd>
            </div>
          ))}
          <div>
            <dt>
              <a href="https://www.g2.com/products/govrn/reviews" target="_blank" rel="noopener" class="font-medium text-ink hover:text-primary transition-colors">
                4.8 / 5
              </a>
            </dt>
            <dd class="text-gray-500">{card.g2}</dd>
          </div>
        </dl>
      </div>

      <!-- Sample meeting, rendered in HTML so it follows the page language and direction -->
      <div class="lg:col-span-6 lg:ps-6" aria-hidden="true">
        <div class="relative" data-play>
          <div class="absolute -inset-x-4 -inset-y-6 bg-surface rounded-md hidden lg:block"></div>
          <div class="relative bg-white border border-line rounded-md shadow-2xl text-sm">
            <div class="flex items-baseline justify-between gap-4 px-5 py-4 border-b border-line">
              <span class="font-semibold text-navy">{card.meeting}</span>
              <span class="font-mono text-xs text-gray-500">{card.date}</span>
            </div>
            <ul>
              {card.items.map(([time, title, status, label], i) => (
                <li class="grid grid-cols-[3.25rem_1fr_auto] items-center gap-3 px-5 py-3.5 border-b border-line last:border-b-0" data-step style={`--d:${150 + i * 90}`}>
                  <span class="font-mono text-xs text-gray-500 tabular-nums">{time}</span>
                  <span class="text-ink">{title}</span>
                  <span data-step="fade" style={`--d:${520 + i * 120}`} class={`text-[11px] font-medium px-2 py-0.5 rounded-sm whitespace-nowrap ${statusClass[status as keyof typeof statusClass]}`}>{label}</span>
                </li>
              ))}
            </ul>
            <div class="flex items-center justify-between gap-4 px-5 py-3 bg-surface border-t border-line rounded-b-md">
              <span class="flex items-center gap-1.5 text-xs text-gray-600">
                {[0, 1, 2, 3].map((n) => (
                  <span class="relative w-2 h-2 rounded-full border border-gray-300"><span class="absolute -inset-px rounded-full bg-primary" data-step="fade" style={`--d:${1000 + n * 160}`}></span></span>
                ))}
                <span class="w-2 h-2 rounded-full border border-gray-300"></span>
                <span class="ms-1.5">{card.signed}</span>
              </span>
              <span class="font-mono text-[11px] text-gray-500">{card.quorum}</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <VideoModal videoId="mgr62dXb2QM" />
</section>
