---
// Top of the compliance monitoring page, built on PageHero. `title` and `titleHighlight` are joined into one h1.
// Optional slot "aside" (dashboard mock-up or screenshot).
import { PageHero, Button } from '../ui';
import { langFromPath, localizePath } from '../../i18n/routes';

interface Props {
  texts?: {
    badge: string;
    title: string;
    titleHighlight: string;
    description: string;
    cta1: string;
    cta2: string;
  };
  links?: {
    cta1: string;
    cta2: string;
  };
}

const lang = langFromPath(Astro.url.pathname);
const {
  texts = {
    badge: "Compliance monitoring",
    title: "Follow regulatory requirements",
    titleHighlight: "with the board",
    description: "The compliance dashboard maps requirements such as CSRD to your board documents. It points to the minutes and policies that address each requirement, and to the gaps that remain.",
    cta1: "Book a demo",
    cta2: "Contact sales"
  },
  links = {
    cta1: localizePath(lang, '/request-demo'),
    cta2: localizePath(lang, '/contact')
  }
} = Astro.props;
const title = [texts.title, texts.titleHighlight].filter(Boolean).join(' ');
const hasAside = Astro.slots.has('aside');
---

<PageHero eyebrow={texts.badge} title={title} lead={texts.description}>
  <Fragment slot="actions">
    <Button href={links.cta1}>{texts.cta1}</Button>
    <Button variant="secondary" href={links.cta2}>{texts.cta2}</Button>
  </Fragment>
  {hasAside && <div slot="aside"><slot name="aside" /></div>}
</PageHero>
