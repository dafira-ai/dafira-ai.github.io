---
// Regulatory areas followed in the compliance dashboard, as ruled columns.
import { Section, SectionHeader, FeatureColumns } from '../ui';

interface Feature {
  title: string;
  description: string;
  icon: string;
  benefits: string[];
}

interface Props {
  texts?: {
    title: string;
    description: string;
    features: Feature[];
  };
  tone?: 'white' | 'surface';
}

const defaultTexts = {
  title: "Regulatory areas",
  description: "The dashboard follows the requirements that reach the board and links them to the documents that address them.",
  features: [
    {
      title: "CSRD",
      description: "Follow the sustainability reporting requirements of the Corporate Sustainability Reporting Directive.",
      icon: "leaf",
      benefits: [
        "ESG indicators followed by category",
        "Board documents linked to each requirement",
        "Gaps and recommendations",
        "Stakeholder reporting"
      ]
    },
    {
      title: "GDPR",
      description: "Keep board data protection practices in line with EU privacy rules.",
      icon: "lock",
      benefits: [
        "Data privacy controls",
        "Access tracking",
        "Audit trail"
      ]
    }
  ]
};

const { texts = defaultTexts, tone = 'white' } = Astro.props;
---

<Section tone={tone} border={tone === 'surface' ? 'both' : 'none'}>
  <SectionHeader title={texts.title} lead={texts.description} />
  <FeatureColumns
    columns={texts.features.length === 2 ? 2 : texts.features.length === 4 ? 4 : 3}
    items={texts.features.map((f) => ({ icon: f.icon, title: f.title, text: f.description, items: f.benefits }))}
  />
</Section>
