const l = complianceLabels(langFromPath(Astro.url.pathname));
---

<div class="bg-white border border-line rounded-md text-sm overflow-hidden" aria-hidden="true" data-play>
  <div class="flex items-baseline justify-between gap-4 px-5 py-3.5 border-b border-line">
    <span class="font-semibold text-navy">{texts.title}</span>
    <span class="font-mono text-xs text-gray-500">{l.example}</span>
  </div>

  <div class="p-5 bg-surface space-y-5">
    <div class="grid grid-cols-2 gap-3">
      {metrics.map((metric) => <MetricCard {...metric} />)}
    </div>

    <div class="grid lg:grid-cols-3 gap-5">
      <div class="lg:col-span-2 space-y-3">
        {csrdCategories.map((category, index) => (
          <CSRDCategoryCard {...(category as any)} index={index} />
        ))}
      </div>
      <div>
        <ActivityLog activities={recentActivities as any} />
      </div>
    </div>

    <div data-step style="--d:700">
      <CSRDCategoryDetails {...(selectedCategory as any)} />
    </div>
  </div>
</div>
