---
// One CSRD category in the compliance dashboard mock-up: requirement, progress and due date.
import { langFromPath } from '../../../i18n/routes';
import { complianceLabels, statusTone, statusBar } from '../labels';

interface Props {
  title: string;
  score: number;
  status: 'good' | 'warning' | 'alert';
  index: number;
  dueDate?: string;
  requirement: string;
}

const { title, score, status, index, dueDate, requirement } = Astro.props;
const l = complianceLabels(langFromPath(Astro.url.pathname));
const s = (statusTone[status] ? status : 'good') as keyof typeof statusTone;
---

<div class="bg-white border border-line rounded-sm p-4" data-step style={`--d:${100 + index * 120}`}>
  <div class="flex items-start justify-between gap-4">
    <div class="min-w-0">
      <p class="text-[13px] font-semibold text-navy">{title}</p>
      <p class="mt-0.5 text-xs text-gray-600">{requirement}</p>
    </div>
    <div class="flex flex-col items-end shrink-0">
      <span class={`text-[11px] font-medium px-2 py-0.5 rounded-sm whitespace-nowrap ${statusTone[s]}`}>{score}% {l.complete}</span>
      {dueDate && <span class="mt-1 font-mono text-[11px] text-gray-500 whitespace-nowrap">{l.due} {dueDate}</span>}
    </div>
  </div>
  <div class="mt-3 h-1 bg-gray-100 rounded-sm overflow-hidden">
    <div class={`h-full ${statusBar[s]}`} style={`width:${score}%;--dur:700ms;--d:${250 + index * 120}`} data-step="grow"></div>
  </div>
</div>
