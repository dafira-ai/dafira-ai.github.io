---
// Recent activity list of the compliance dashboard mock-up.
import { langFromPath } from '../../../i18n/routes';
import { complianceLabels } from '../labels';

interface Activity {
  category: string;
  action: string;
  timestamp: string;
  status: 'success' | 'warning' | 'error';
}

interface Props {
  activities: Activity[];
  title?: string;
}

const { activities, title } = Astro.props;
const l = complianceLabels(langFromPath(Astro.url.pathname));
const dot = { success: 'bg-emerald-600', warning: 'bg-amber-500', error: 'bg-red-600' };
---

<div class="bg-white border border-line rounded-sm">
  <p class="px-4 py-3 border-b border-line font-mono text-[11px] uppercase tracking-[0.08em] text-gray-500">{title ?? l.activity}</p>
  <ul class="px-4">
    {activities.map((activity, index) => (
      <li class="flex items-start gap-3 py-3 border-b border-line last:border-b-0" data-step style={`--d:${400 + index * 120}`}>
        <span class={`mt-1.5 w-1.5 h-1.5 rounded-full shrink-0 ${dot[activity.status] ?? dot.success}`}></span>
        <div>
          <p class="text-xs font-medium text-navy">{activity.category}</p>
          <p class="text-[13px] text-gray-700">{activity.action}</p>
          <p class="font-mono text-[11px] text-gray-500">{activity.timestamp}</p>
        </div>
      </li>
    ))}
  </ul>
</div>
