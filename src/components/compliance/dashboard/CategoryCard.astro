---
// Compact category score for the compliance dashboard mock-up.
import { statusTone } from '../labels';

interface Props {
  title: string;
  score: number;
  status: 'good' | 'warning' | 'alert';
  index: number;
}

const { title, score, status, index } = Astro.props;
const s = (statusTone[status] ? status : 'good') as keyof typeof statusTone;
---

<div class="bg-white border border-line rounded-sm p-4" data-step style={`--d:${100 + index * 120}`}>
  <div class="flex items-center justify-between gap-3">
    <p class="text-[13px] font-medium text-navy">{title}</p>
    <span class={`text-[11px] font-medium px-2 py-0.5 rounded-sm ${statusTone[s]}`}>{score}%</span>
  </div>
  <div class="mt-3 h-1 bg-gray-100 rounded-sm overflow-hidden">
    <div class="h-full bg-primary" style={`width:${score}%;--d:${250 + index * 120}`} data-step="grow"></div>
  </div>
</div>
