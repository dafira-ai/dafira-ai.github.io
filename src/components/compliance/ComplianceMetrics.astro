---
// Row of dashboard indicators. Only pass figures that have a source; the defaults are descriptive, not measured results.
import { Section } from '../ui';
import MetricCard from './dashboard/MetricCard.astro';

interface Props {
  metrics?: {
    title: string;
    value: string;
    change: string;
    icon: string;
  }[];
  tone?: 'white' | 'surface';
}

const { tone = 'surface', metrics = [
  { title: "Regulations followed", value: "CSRD · GDPR", change: "EU requirements", icon: "scale" },
  { title: "Evidence", value: "Minutes", change: "and board policies", icon: "document" },
  { title: "Follow-up", value: "Gaps", change: "with recommendations", icon: "list" },
  { title: "Record", value: "Audit trail", change: "of every change", icon: "clipboard" }
]} = Astro.props;
---

<Section tone={tone} border={tone === 'surface' ? 'both' : 'none'} space="md">
  <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
    {metrics.map((metric) => <MetricCard {...metric} />)}
  </div>
</Section>
