---
import { localizePath, type Lang } from '../../i18n/routes';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;

const t = {
  en: {
    industries: 'Industries', roles: 'Roles', regions: 'Regions',
    items: {
      industries: [
        ['Financial services', 'Banks, insurers and investment firms', '/industries/financial-services'],
        ['Healthcare', 'Hospitals, care groups and medical devices', '/industries/healthcare'],
        ['Real estate', 'Property investment and management', '/industries/real-estate'],
        ['Family business', 'Multi-entity governance for family groups', '/industries/family-business'],
      ],
      roles: [
        ['CEO & executives', 'Prepare the board and follow up on decisions', '/for/ceo'],
        ['Board members', 'Read, annotate and vote from any device', '/for/board-member'],
        ['Board secretary', 'Agendas, board packs and minutes in one flow', '/for/board-secretary'],
        ['General counsel', 'Resolutions, registers and audit trail', '/for/general-counsel'],
      ],
      regions: [
        ['Saudi Arabia · Vision 2030', 'CMA corporate governance requirements', '/regions/saudi-vision-2030'],
      ],
    },
  },
  fr: {
    industries: 'Secteurs', roles: 'Rôles', regions: 'Régions',
    items: {
      industries: [
        ['Services financiers', 'Banques, assureurs et sociétés d’investissement', '/industries/financial-services'],
        ['Santé', 'Hôpitaux, groupes de soins et dispositifs médicaux', '/industries/healthcare'],
        ['Immobilier', 'Investissement et gestion immobilière', '/industries/real-estate'],
        ['Entreprise familiale', 'Gouvernance multi-entités des groupes familiaux', '/industries/family-business'],
      ],
      roles: [
        ['CEO et direction', 'Préparer le conseil et suivre les décisions', '/for/ceo'],
        ['Administrateurs', 'Lire, annoter et voter depuis tout appareil', '/for/board-member'],
        ['Secrétaire du conseil', 'Ordres du jour, board packs et procès-verbaux', '/for/board-secretary'],
        ['Directeur juridique', 'Résolutions, registres et piste d’audit', '/for/general-counsel'],
      ],
      regions: [
        ['Arabie saoudite · Vision 2030', 'Exigences de gouvernance de la CMA', '/regions/saudi-vision-2030'],
      ],
    },
  },
  nl: {
    industries: 'Sectoren', roles: 'Rollen', regions: 'Regio’s',
    items: {
      industries: [
        ['Financiële diensten', 'Banken, verzekeraars en beleggingsbedrijven', '/industries/financial-services'],
        ['Gezondheidszorg', 'Ziekenhuizen, zorggroepen en medische technologie', '/industries/healthcare'],
        ['Vastgoed', 'Vastgoedinvestering en -beheer', '/industries/real-estate'],
        ['Familiebedrijf', 'Governance over meerdere entiteiten', '/industries/family-business'],
      ],
      roles: [
        ['CEO en directie', 'De raad voorbereiden en besluiten opvolgen', '/for/ceo'],
        ['Bestuurders', 'Lezen, annoteren en stemmen op elk toestel', '/for/board-member'],
        ['Bestuurssecretaris', 'Agenda’s, board packs en notulen', '/for/board-secretary'],
        ['General counsel', 'Resoluties, registers en audittrail', '/for/general-counsel'],
      ],
      regions: [
        ['Saoedi-Arabië · Vision 2030', 'CMA-vereisten voor corporate governance', '/regions/saudi-vision-2030'],
      ],
    },
  },
  ar: {
    industries: 'القطاعات', roles: 'الأدوار', regions: 'المناطق',
    items: {
      industries: [
        ['الخدمات المالية', 'البنوك وشركات التأمين والاستثمار', '/industries/financial-services'],
        ['الرعاية الصحية', 'المستشفيات ومجموعات الرعاية والأجهزة الطبية', '/industries/healthcare'],
        ['العقارات', 'الاستثمار العقاري وإدارة الأملاك', '/industries/real-estate'],
        ['الشركات العائلية', 'حوكمة متعددة الكيانات للمجموعات العائلية', '/industries/family-business'],
      ],
      roles: [
        ['الرئيس التنفيذي والإدارة', 'التحضير لاجتماعات المجلس ومتابعة القرارات', '/for/ceo'],
        ['أعضاء مجلس الإدارة', 'القراءة والتعليق والتصويت من أي جهاز', '/for/board-member'],
        ['أمين سر المجلس', 'جداول الأعمال وحزم المجلس والمحاضر', '/for/board-secretary'],
        ['المستشار القانوني', 'القرارات والسجلات ومسار التدقيق', '/for/general-counsel'],
      ],
      regions: [
        ['المملكة العربية السعودية · رؤية 2030', 'متطلبات الحوكمة الصادرة عن هيئة السوق المالية', '/regions/saudi-vision-2030'],
      ],
    },
  },
}[lang];

const columns = [
  { title: t.industries, items: t.items.industries },
  { title: t.roles, items: t.items.roles },
  { title: t.regions, items: t.items.regions },
];
---

<div
  class="mega-menu absolute top-full start-0 pt-3 opacity-0 invisible translate-y-1 transition group-hover:opacity-100 group-hover:visible group-hover:translate-y-0 group-focus-within:opacity-100 group-focus-within:visible group-focus-within:translate-y-0 z-50"
>
  <div class="w-[min(880px,90vw)] bg-white border border-line rounded-md shadow-xl">
    <div class="grid grid-cols-3 divide-x divide-line rtl:divide-x-reverse">
      {columns.map((col) => (
        <div class="p-6">
          <p class="font-mono text-[11px] uppercase tracking-[0.08em] text-gray-500 mb-4">{col.title}</p>
          <ul class="space-y-1">
            {col.items.map(([name, description, href]) => (
              <li>
                <a
                  href={localizePath(lang, href)}
                  class="block -mx-3 px-3 py-2.5 rounded-md hover:bg-surface transition-colors"
                >
                  <span class="block text-sm font-medium text-navy">{name}</span>
                  <span class="block text-[13px] leading-snug text-gray-500 mt-0.5">{description}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</div>
