---
// Why the answers can be trusted: quoted responses, secure environment, sources. Cell grid.
import { Section, SectionHeader, CellGrid, Icon } from '../ui';

interface Props {
  texts?: {
    title: string;
    description: string;
    highlights: {
      icon: string;
      title: string;
      description: string;
      /** @deprecated no longer animated */
      animation?: string;
    }[];
  };
  tone?: 'white' | 'surface';
}

const { tone = 'surface', texts = {
  title: "Answers you can check",
  description: "The assistant quotes your documents rather than paraphrasing from memory, so every answer can be verified.",
  highlights: [
    {
      icon: "document",
      title: "Quoted responses",
      description: "Answers quote the relevant passages of your board documents, so you read the original wording."
    },
    {
      icon: "lock",
      title: "Inside the platform",
      description: "Questions are asked inside Dafira. Directors do not need to copy board papers into outside tools."
    },
    {
      icon: "book",
      title: "Source attribution",
      description: "Every answer names the document and the section it comes from."
    }
  ]
}} = Astro.props;
---

<Section tone={tone} border={tone === 'surface' ? 'both' : 'none'}>
  <SectionHeader title={texts.title} lead={texts.description} />
  <CellGrid columns={3}>
    {texts.highlights.map((highlight) => (
      <div class="bg-white p-6 lg:p-8">
        <Icon name={highlight.icon} class="w-6 h-6 text-navy" />
        <h3 class="mt-5 text-lg font-semibold text-navy">{highlight.title}</h3>
        <p class="mt-2 text-[15px] text-gray-600 leading-relaxed">{highlight.description}</p>
      </div>
    ))}
  </CellGrid>
</Section>
