---
// Security and privacy of the AI assistant, as ruled columns with a link to the security page.
import { Section, SectionHeader, FeatureColumns, Button } from '../ui';

interface Props {
  features: Array<{
    icon: string;
    title: string;
    description: string;
    details: string[];
  }>;
  texts?: {
    title: string;
    subtitle: string;
  };
  link?: { text: string; href: string };
  tone?: 'white' | 'surface';
}

const { features, link, tone = 'white', texts = {
  title: "Security and privacy",
  subtitle: "The assistant runs on the same secured platform as your board documents."
}} = Astro.props;
---

<Section tone={tone} border={tone === 'surface' ? 'both' : 'none'}>
  <SectionHeader title={texts.title} lead={texts.subtitle} />
  <FeatureColumns
    columns={features.length === 2 ? 2 : features.length === 4 ? 4 : 3}
    items={features.map((f) => ({ icon: f.icon, title: f.title, text: f.description, items: f.details }))}
  />
  {link && <div class="pt-8 border-t border-line"><Button variant="link" href={link.href}>{link.text}</Button></div>}
</Section>
