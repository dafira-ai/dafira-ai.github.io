---
// HTML mock-up of the AI assistant: questions and answers quoted from board documents, with their source. Plays once.
import AppFrame from '../features/AppFrame.astro';

interface Props {
  texts?: {
    messages: {
      type: "user" | "assistant";
      content: string;
      quotes?: {
        text: string;
        source: string;
      }[];
    }[];
    header: {
      title: string;
      subtitle: string;
    };
    input: {
      placeholder: string;
    };
  };
  /** strong shadow when used as the hero visual */
  shadow?: boolean;
}

const { shadow = false, texts = {
  messages: [
    {
      type: "user",
      content: "What did the board decide on the European expansion last quarter?"
    },
    {
      type: "assistant",
      content: "According to the Q3 minutes:",
      quotes: [
        {
          text: "The board approved the expansion plan for the European market. The final budget will be presented with the business plan in Q4.",
          source: "Q3 Board Minutes, item 2.3"
        }
      ]
    },
    {
      type: "user",
      content: "Which document sets out our sustainability targets?"
    },
    {
      type: "assistant",
      content: "The targets are set out in the sustainability policy adopted by the board:",
      quotes: [
        {
          text: "The company commits to reducing its emissions in line with the targets approved by the board, with progress reported every six months.",
          source: "Sustainability Policy, section 1"
        }
      ]
    }
  ],
  header: {
    title: "AI assistant",
    subtitle: "Answers from your board documents"
  },
  input: {
    placeholder: "Ask a question about your board documents"
  }
}} = Astro.props;
---

<div data-play>
  <AppFrame title={texts.header.title} meta={texts.header.subtitle} shadow={shadow}>
    <div class="p-5 space-y-4">
      {texts.messages.map((msg, index) => (
        msg.type === 'user' ? (
          <div class="flex justify-end" data-step style={`--d:${100 + index * 350}`}>
            <p class="max-w-[85%] bg-surface border border-line rounded-md px-4 py-3 text-[13px] text-ink">{msg.content}</p>
          </div>
        ) : (
          <div class="max-w-[92%] space-y-2.5" data-step style={`--d:${100 + index * 350}`}>
            <p class="text-[13px] text-gray-700">{msg.content}</p>
            {msg.quotes?.map((quote) => (
              <div class="border-s-2 border-primary ps-3 py-1">
                <p class="text-[13px] text-ink leading-relaxed">{quote.text}</p>
                <p class="mt-1 font-mono text-[11px] text-primary">{quote.source}</p>
              </div>
            ))}
          </div>
        )
      ))}
    </div>
    <div class="border-t border-line px-5 py-3 flex items-center gap-3">
      <span class="flex-1 border border-line rounded-sm px-3 py-2 text-[13px] text-gray-400">{texts.input.placeholder}</span>
      <svg class="w-5 h-5 text-navy rtl-flip" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12h15M13 6l6 6-6 6"/></svg>
    </div>
  </AppFrame>
</div>
