---
// What the AI assistant does, as ruled columns.
import { Section, SectionHeader, FeatureColumns } from '../ui';

interface Props {
  features: Array<{
    icon: string;
    title: string;
    description: string;
  }>;
  texts?: {
    title: string;
    description: string;
  };
  tone?: 'white' | 'surface';
}

const { features, tone = 'white', texts = {
  title: "What you can ask",
  description: "The assistant works on the documents you already have in Dafira: board packs, minutes and policies."
}} = Astro.props;
---

<Section tone={tone} border={tone === 'surface' ? 'both' : 'none'}>
  <SectionHeader title={texts.title} lead={texts.description} />
  <FeatureColumns items={features.map((f) => ({ icon: f.icon, title: f.title, text: f.description }))} />
</Section>
