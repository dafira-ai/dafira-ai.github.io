---
// Helpful destinations after a 404, as a ruled grid of links. `icon` accepts an icon name (legacy emoji also mapped).
import { Icon } from '../ui';

interface Suggestion {
  text: string;
  href: string;
  icon: string;
  description?: string;
}

interface Props {
  suggestions: Suggestion[];
}

const { suggestions } = Astro.props;
---

<ul class="grid gap-px bg-line border border-line rounded-md overflow-hidden sm:grid-cols-2 lg:grid-cols-3">
  {suggestions.map((s) => (
    <li class="bg-white">
      <a href={s.href} class="group flex items-start gap-4 p-6 h-full hover:bg-surface transition-colors">
        <Icon name={s.icon} class="w-5 h-5 text-navy mt-0.5" />
        <span>
          <span class="block font-medium text-navy group-hover:text-primary transition-colors">{s.text}</span>
          {s.description && <span class="block mt-1 text-sm text-gray-600">{s.description}</span>}
        </span>
      </a>
    </li>
  ))}
</ul>
