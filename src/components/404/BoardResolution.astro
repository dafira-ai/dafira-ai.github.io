---
// A small register entry recording the missing page. Labels are passed in the page language.
interface Props {
  date: string;
  labels?: { title: string; date: string; whereas: string; resolved: string; status: string; approved: string };
}

const {
  date,
  labels = {
    title: 'Resolution 404',
    date: 'Date',
    whereas: 'Whereas the requested page cannot be found;',
    resolved: 'Resolved, that the visitor be directed to a more suitable page.',
    status: 'Status',
    approved: 'Approved',
  },
} = Astro.props;
---

<div class="border border-line rounded-md bg-white">
  <div class="flex items-center justify-between gap-4 px-6 py-4 border-b border-line">
    <p class="font-mono text-xs uppercase tracking-[0.08em] text-gray-500">{labels.title}</p>
    <p class="font-mono text-xs text-gray-500 tabular-nums">{labels.date}: {date}</p>
  </div>
  <div class="px-6 py-6 space-y-3 text-[15px] text-gray-700 leading-relaxed">
    <p>{labels.whereas}</p>
    <p>{labels.resolved}</p>
  </div>
  <div class="flex items-center gap-3 px-6 py-4 border-t border-line text-sm text-gray-500">
    <span>{labels.status}</span>
    <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-sm text-[11px] font-medium bg-emerald-50 text-emerald-800">{labels.approved}</span>
  </div>
</div>
