---
import FormSuccess from './FormSuccess.astro';
import { Field, Button } from '../ui';

interface Props {
  reasons?: string[];
  labels?: {
    firstName: string;
    lastName: string;
    email: string;
    company: string;
    reason: string;
    message: string;
    submit: string;
  };
  placeholders?: {
    reason: string;
  };
  success?: {
    title: string;
    message: string;
  };
}

const { 
  reasons = [
    "Request a Demo",
    "Sales Inquiry", 
    "Technical Support",
    "Partnership Opportunity",
    "Other"
  ],
  labels = {
    firstName: "First Name",
    lastName: "Last Name", 
    email: "Email Address",
    company: "Company Name",
    reason: "Reason for Contact",
    message: "Message",
    submit: "Send Message"
  },
  placeholders = {
    reason: "Select a reason"
  },
  success = {
    title: "Message sent",
    message: "Thank you for contacting us. We'll get back to you shortly."
  }
} = Astro.props;
---


<form id="contactForm" class="space-y-5" method="POST">
  <div class="grid sm:grid-cols-2 gap-4">
    <Field id="firstName" label={labels.firstName} required autocomplete="given-name" />
    <Field id="lastName" label={labels.lastName} required autocomplete="family-name" />
  </div>

  <Field id="email" type="email" label={labels.email} required autocomplete="email" />

  <Field id="company" label={labels.company} required autocomplete="organization" />

  <Field
    id="reason"
    as="select"
    label={labels.reason}
    required
    options={[{ value: '', label: placeholders.reason }, ...reasons.map((r) => ({ value: r, label: r }))]}
  />

  <Field id="message" as="textarea" label={labels.message} rows={4} required />

  <Button type="submit" class="w-full">{labels.submit}</Button>
</form>

<div id="formSuccess" class="hidden" role="status">
  <FormSuccess 
    title={success.title}
    message={success.message}
  />
</div>

<script>
  import { sendForm } from '../../utils/sendForm';
  const form = document.getElementById('contactForm');
  const success = document.getElementById('formSuccess');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    
    const formData = new FormData(form);
    const email = formData.get('email');
    
    var myNewName = window.dataLayer || [];
    myNewName.push({'email': email});
    
    // Here you would typically send the form data to your backend
    // For demo purposes, we'll just show the success message
    if (!(await sendForm(form as HTMLFormElement, 'Contact'))) return;
    form.classList.add('hidden');
    success?.classList.remove('hidden');
  });
</script>