---
interface Props {
  title: string;
  message: string;
}

const { title, message } = Astro.props;
---

<div class="border border-line border-s-2 border-s-emerald-600 rounded-md bg-emerald-50/50 p-6 flex gap-4">
  <svg class="w-6 h-6 shrink-0 text-emerald-800" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true">
    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
  </svg>
  <div>
    <h3 class="text-lg font-semibold text-navy">{title}</h3>
    <p class="mt-1 text-gray-700 leading-relaxed">{message}</p>
  </div>
</div>
