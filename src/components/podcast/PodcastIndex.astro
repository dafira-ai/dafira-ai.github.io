---
// Podcast index body: PageHero with platforms, latest episode, Card grid of episodes.
import type { CollectionEntry } from 'astro:content';
import { PageHero, Section, SectionHeader, Button } from '../ui';
import EpisodeCard from '../EpisodeCard.astro';
import StreamingPlatforms from './StreamingPlatforms.astro';
import { getSlug } from '../../utils/slugify';
import { SHOW_LINKS, PODCAST_UI, episodeHref, formatEpisodeDate, type PodcastLang } from './podcast-i18n';

interface Props {
  lang: PodcastLang;
  episodes: CollectionEntry<'podcast'>[];
}

const { lang, episodes } = Astro.props;
const t = PODCAST_UI[lang];
const latestEpisode = episodes[0];
const regularEpisodes = episodes.slice(1);
---

<PageHero eyebrow={t.eyebrow} title={t.title} lead={t.lead}>
  <StreamingPlatforms className="mt-9" {...SHOW_LINKS} />
</PageHero>

{latestEpisode && (
  <Section space="md" border="bottom">
    <div class="grid lg:grid-cols-12 gap-10 items-center">
      <div class="lg:col-span-7 order-2 lg:order-1">
        <p class="font-mono text-xs uppercase tracking-[0.08em] text-gray-500">
          {t.latest} · <time datetime={latestEpisode.data.pubDate.toISOString()}>{formatEpisodeDate(lang, latestEpisode.data.pubDate)}</time> · {latestEpisode.data.duration}
        </p>
        <h2 class="mt-4 text-3xl lg:text-4xl font-semibold text-navy leading-tight">{latestEpisode.data.title}</h2>
        <p class="mt-4 text-lg text-gray-600 leading-relaxed">{latestEpisode.data.description}</p>
        {latestEpisode.data.guests && (
          <div class="mt-8 pt-6 border-t border-line">
            <h3 class="font-mono text-xs uppercase tracking-[0.08em] text-gray-500">{t.guests}</h3>
            <ul class="mt-4 flex flex-wrap gap-6">
              {latestEpisode.data.guests.map((guest) => (
                <li class="flex items-center gap-3">
                  {guest.image && <img loading="lazy" src={guest.image} alt="" class="w-10 h-10 rounded-full object-cover border border-line" />}
                  <div class="text-sm">
                    <p class="font-medium text-navy">{guest.name}</p>
                    <p class="text-gray-500">{guest.role}</p>
                  </div>
                </li>
              ))}
            </ul>
          </div>
        )}
        <div class="mt-8">
          <Button href={episodeHref(lang, getSlug(latestEpisode.data.title))}>{t.view}</Button>
        </div>
      </div>
      <div class="lg:col-span-4 lg:col-start-9 order-1 lg:order-2">
        <img loading="lazy" src={latestEpisode.data.image} alt={latestEpisode.data.title} class="w-full aspect-square object-cover rounded-md border border-line" />
      </div>
    </div>
  </Section>
)}

{regularEpisodes.length > 0 && (
  <Section tone="surface" space="md">
    <SectionHeader title={t.all} layout="stacked" class="!mb-10" />
    <div class="grid md:grid-cols-2 gap-6">
      {regularEpisodes.map((episode) => <EpisodeCard episode={episode} />)}
    </div>
  </Section>
)}
