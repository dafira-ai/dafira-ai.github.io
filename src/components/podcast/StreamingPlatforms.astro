---
// Links to the podcast on streaming platforms. Plain outline buttons, no brand colours.
import { podcastLang, PODCAST_UI } from './podcast-i18n';

interface Props {
  spotifyUrl?: string;
  applePodcastsUrl?: string;
  castboxUrl?: string;
  amazonMusicUrl?: string;
  className?: string;
}

const { spotifyUrl, applePodcastsUrl, castboxUrl, amazonMusicUrl, className = '' } = Astro.props;
const t = PODCAST_UI[podcastLang(Astro.url.pathname)];
const platforms = [
  { name: 'Spotify', url: spotifyUrl },
  { name: 'Apple Podcasts', url: applePodcastsUrl },
  { name: 'Castbox', url: castboxUrl },
  { name: 'Amazon Music', url: amazonMusicUrl },
].filter((p) => p.url);
---

{platforms.length > 0 && (
  <div class:list={['flex flex-wrap items-center gap-2', className]}>
    <span class="font-mono text-xs uppercase tracking-[0.08em] text-gray-500 me-2">{t.listenOn}</span>
    {platforms.map((platform) => (
      <a
        href={platform.url}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center px-3 py-2 text-sm font-medium rounded-md text-navy bg-white border border-line hover:border-navy transition-colors"
      >
        {platform.name}
      </a>
    ))}
  </div>
)}
