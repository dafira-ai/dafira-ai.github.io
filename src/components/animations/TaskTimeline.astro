---
// Vignette: a director asks the AI assistant about the board pack.
// Messages arrive in order, with a short typing indicator before each assistant reply. Plays once.
import ReplayButton from './ReplayButton.astro';

export interface Message {
  type: "assistant" | "user";
  content: string;
  insights?: string[];
}

export interface TaskTimelineProps {
  messages: Message[];
  headerTitle?: string;
  headerSubtitle?: string;
  /** @deprecated emoji no longer rendered */
  headerEmoji?: string;
}

const {
  messages = [
    {
      type: "assistant",
      content: "I've read the Q3 board pack. Three points stand out:",
      insights: [
        "Revenue is ahead of budget in two of three regions",
        "Two compliance actions from Q2 are still open",
        "The capex resolution needs a two-thirds majority"
      ]
    },
    {
      type: "user",
      content: "What are the main risks for the next quarter?"
    },
    {
      type: "assistant",
      content: "The papers mention three risks:",
      insights: [
        "Currency exposure in Asia Pacific",
        "New EU reporting requirements",
        "Dependency on a single supplier"
      ]
    }
  ],
  headerTitle = "AI assistant",
  headerSubtitle = "Q3 board pack · 64 pages",
} = Astro.props as TaskTimelineProps;

// Timeline: user messages appear directly; assistant replies after a 700ms typing indicator.
let clock = 100;
const timeline = (messages as Message[]).map((msg, i) => {
  const typing = msg.type === 'assistant' && i > 0 ? clock : null;
  if (typing !== null) clock += 700;
  const at = clock;
  clock += 240 + (msg.insights?.length ?? 0) * 120 + 360;
  return { msg, at, typing };
});
---

<div class="relative w-full h-full flex items-center justify-center" data-play>
  <div aria-hidden="true" class="w-full max-w-md bg-white border border-line rounded-md text-[13px] overflow-hidden">
    <div class="flex items-center gap-3 px-4 py-3 border-b border-line">
      <span class="w-7 h-7 rounded-sm bg-navy text-white grid place-items-center">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
          <path d="M12 3l1.8 4.6L18 9.5l-4.2 1.9L12 16l-1.8-4.6L6 9.5l4.2-1.9z" />
        </svg>
      </span>
      <span class="flex-1">
        <span class="block font-semibold text-navy text-sm">{headerTitle}</span>
        <span class="block font-mono text-[11px] text-gray-500">{headerSubtitle}</span>
      </span>
    </div>

    <div class="px-4 py-4 space-y-3">
      {timeline.map(({ msg, at, typing }) => (
        <div class:list={["flex", msg.type === 'user' ? 'justify-end' : 'justify-start']}>
          <div class="swap max-w-[88%]">
            {typing !== null && (
              <span data-step="out" style={`--d:${at}`} class="typing self-start inline-flex gap-1 px-3 py-2.5 rounded-md bg-surface">
                <i class="w-1.5 h-1.5 rounded-full bg-gray-400"></i><i class="w-1.5 h-1.5 rounded-full bg-gray-400"></i><i class="w-1.5 h-1.5 rounded-full bg-gray-400"></i>
              </span>
            )}
            <div
              data-step
              style={`--d:${at}`}
              class:list={[
                "rounded-md px-3 py-2.5",
                msg.type === 'user' ? 'bg-navy text-white' : 'bg-surface text-ink',
              ]}
            >
              <p>{msg.content}</p>
              {msg.insights && (
                <ul class="mt-2 space-y-1.5">
                  {msg.insights.map((insight, j) => (
                    <li class="flex items-start gap-2 text-gray-700" data-step style={`--d:${at + 200 + j * 120}`}>
                      <span class="mt-2 w-1.5 h-px bg-primary shrink-0"></span>
                      {insight}
                    </li>
                  ))}
                </ul>
              )}
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
  <ReplayButton />
</div>
