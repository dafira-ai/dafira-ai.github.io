---
// Vignette: a board pack being assembled and shared.
// Plays once when scrolled into view (see [data-play] in Layout); final state is the static fallback.
import { langFromPath } from '../../i18n/routes';
import ReplayButton from './ReplayButton.astro';

interface Props {
  documents?: {
    type: string;
    /** @deprecated emoji no longer rendered */
    icon?: string;
  }[];
  sharingMethods?: {
    name: string;
    line: string;
  }[];
  texts?: {
    centralIcon: {
      /** @deprecated */
      emoji?: string;
      title: string;
      subtitle: string;
    };
  };
}

const {
  documents = [
    { type: "Agenda" },
    { type: "Minutes" },
    { type: "Report" },
    { type: "Contract" },
    { type: "Policy" }
  ],
  sharingMethods = [
    { name: "Email", line: "M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" },
    { name: "Mobile", line: "M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z" },
    { name: "Desktop", line: "M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" },
  ],
  texts = {
    centralIcon: { title: "Secure", subtitle: "Storage" }
  }
} = Astro.props;

const lang = langFromPath(Astro.url.pathname);
const t = {
  en: { pack: 'Board pack · Q3 2026', draft: 'Draft', shared: 'Shared', pages: 'p.', to: 'Shared with 9 directors', on: 'Available on' },
  fr: { pack: 'Board pack · T3 2026', draft: 'Brouillon', shared: 'Partagé', pages: 'p.', to: 'Partagé avec 9 administrateurs', on: 'Disponible sur' },
  nl: { pack: 'Board pack · Q3 2026', draft: 'Concept', shared: 'Gedeeld', pages: 'p.', to: 'Gedeeld met 9 bestuurders', on: 'Beschikbaar op' },
  ar: { pack: 'ملفات الاجتماع · الربع الثالث 2026', draft: 'مسودة', shared: 'تمت المشاركة', pages: 'ص', to: 'تمت المشاركة مع 9 أعضاء', on: 'متاح على' },
}[lang];

const pageCounts = [4, 12, 28, 9, 6, 15, 8];
const rowDelay = (i: number) => 150 + i * 140;
const doneAt = rowDelay(documents.length) + 200;
const vault = `${texts.centralIcon.title} ${texts.centralIcon.subtitle}`.trim();
---

<div class="relative w-full h-full flex items-center justify-center" data-play>
  <div aria-hidden="true" class="w-full max-w-md bg-white border border-line rounded-md text-sm">
    <div class="flex items-center justify-between gap-3 px-4 py-3 border-b border-line">
      <span class="font-semibold text-navy">{t.pack}</span>
      <span class="swap justify-items-end text-[11px] font-medium">
        <span data-step="out" style={`--d:${doneAt}`} class="px-2 py-0.5 rounded-sm bg-gray-100 text-gray-600">{t.draft}</span>
        <span data-step="fade" style={`--d:${doneAt}`} class="px-2 py-0.5 rounded-sm bg-emerald-50 text-emerald-800">{t.shared}</span>
      </span>
    </div>

    <div class="h-0.5 bg-surface">
      <div class="h-full bg-primary" data-step="grow" style={`--d:150;--dur:${doneAt - 150}ms`}></div>
    </div>

    <ul class="py-1">
      {documents.slice(0, 5).map((doc, i) => (
        <li class="flex items-center gap-3 px-4 py-2" data-step style={`--d:${rowDelay(i)}`}>
          <svg class="w-4 h-4 text-gray-400 shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
            <path d="M7 3h7l5 5v13H7z" /><path d="M14 3v5h5" />
          </svg>
          <span class="flex-1 text-ink">{doc.type}</span>
          <span class="font-mono text-[11px] text-gray-400 tabular-nums">{pageCounts[i]} {t.pages}</span>
          <svg class="w-4 h-4 text-emerald-600" data-step="draw" style={`--d:${rowDelay(i) + 180}`} fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
            <path d="M5 13l4 4L19 7" />
          </svg>
        </li>
      ))}
    </ul>

    <div class="flex items-center justify-between gap-3 px-4 py-3 bg-surface border-t border-line rounded-b-md" data-step style={`--d:${doneAt + 120}`}>
      <span class="flex items-center gap-2 text-xs text-gray-600">
        <svg class="w-3.5 h-3.5 text-navy" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
          <rect x="5" y="10" width="14" height="10" rx="1" /><path d="M8 10V7a4 4 0 0 1 8 0v3" />
        </svg>
        <span>{t.to}<span class="text-gray-400"> · {vault}</span></span>
      </span>
      <span class="flex items-center gap-2 text-gray-500" title={t.on}>
        {sharingMethods.slice(0, 4).map((m) => (
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
            <path d={m.line} />
          </svg>
        ))}
      </span>
    </div>
  </div>
  <ReplayButton />
</div>
