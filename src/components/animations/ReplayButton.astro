---
// Replays the enclosing [data-play] vignette. Hidden when motion is off (see Layout).
import { langFromPath } from '../../i18n/routes';
const label = { en: 'Replay animation', fr: 'Rejouer l’animation', nl: 'Animatie opnieuw afspelen', ar: 'إعادة تشغيل الحركة' }[langFromPath(Astro.url.pathname)];
---

<button
  type="button"
  data-replay
  aria-label={label}
  title={label}
  class="absolute bottom-0 end-0 items-center justify-center w-8 h-8 rounded-md text-gray-400 hover:text-navy hover:bg-surface transition-colors"
>
  <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true">
    <path d="M4 12a8 8 0 1 0 2.3-5.6M4 4v4h4" />
  </svg>
</button>
