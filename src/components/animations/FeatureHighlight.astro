---
// Vignette: follow-up tasks get closed, then the minutes collect their signatures. Plays once.
import { langFromPath } from '../../i18n/routes';
import ReplayButton from './ReplayButton.astro';

interface Props {
  texts?: {
    tasks: {
      title: string;
      status: string;
    }[];
    signatures: {
      name: string;
      role: string;
    }[];
    labels: {
      tasks: string;
      activeTasks: string;
      signatures: string;
      pending: string;
    };
  }
}

const {
  texts = {
    tasks: [
      { title: "Circulate draft minutes", status: "done" },
      { title: "Update the risk register", status: "done" },
      { title: "File resolution 2026-14", status: "done" }
    ],
    signatures: [
      { name: "Emma Wilson", role: "Chair" },
      { name: "James Chen", role: "Director" },
      { name: "Sarah Miller", role: "Board secretary" }
    ],
    labels: {
      tasks: "Action items",
      activeTasks: "Open",
      signatures: "Minutes · signatures",
      pending: "Pending"
    }
  }
} = Astro.props;

const lang = langFromPath(Astro.url.pathname);
const t = {
  en: { closed: 'Closed', awaiting: 'Awaiting', signed: 'Signed', complete: 'Signed' },
  fr: { closed: 'Clôturé', awaiting: 'En attente', signed: 'Signé', complete: 'Signé' },
  nl: { closed: 'Afgerond', awaiting: 'In afwachting', signed: 'Getekend', complete: 'Getekend' },
  ar: { closed: 'مغلق', awaiting: 'بانتظار التوقيع', signed: 'تم التوقيع', complete: 'مكتمل' },
}[lang];

const taskAt = (i: number) => 250 + i * 380;
const signStart = taskAt(texts.tasks.length) + 200;
const signAt = (i: number) => signStart + i * 420;
const allSigned = signAt(texts.signatures.length) + 100;
const times = ['09:12', '10:47', '11:05'];
const initials = (name: string) => name.split(/\s+/).map((p) => p[0]).slice(0, 2).join('');
---

<div class="relative w-full h-full flex items-center justify-center" data-play>
  <div aria-hidden="true" class="w-full max-w-md space-y-3 text-[13px]">
    <div class="bg-white border border-line rounded-md">
      <div class="flex items-center justify-between gap-3 px-4 py-2.5 border-b border-line">
        <span class="font-semibold text-navy text-sm">{texts.labels.tasks}</span>
        <span class="swap justify-items-end text-[11px] font-medium">
          <span data-step="out" style={`--d:${signStart - 150}`} class="px-2 py-0.5 rounded-sm bg-blue-50 text-primary">{texts.labels.activeTasks} · {texts.tasks.length}</span>
          <span data-step="fade" style={`--d:${signStart - 150}`} class="px-2 py-0.5 rounded-sm bg-emerald-50 text-emerald-800">{t.closed}</span>
        </span>
      </div>
      <ul>
        {texts.tasks.map((task, i) => (
          <li class="flex items-center gap-3 px-4 py-2 border-b border-line last:border-b-0">
            <span class="relative w-4 h-4 rounded-full border border-gray-300 grid place-items-center shrink-0">
              <span class="absolute inset-[-1px] rounded-full bg-emerald-600" data-step="fade" style={`--d:${taskAt(i)}`}></span>
              <svg class="relative w-3 h-3 text-white" data-step="draw" style={`--d:${taskAt(i) + 60}`} fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                <path d="M5 13l4 4L19 7" />
              </svg>
            </span>
            <span class="text-ink">{task.title}</span>
          </li>
        ))}
      </ul>
    </div>

    <div class="bg-white border border-line rounded-md">
      <div class="flex items-center justify-between gap-3 px-4 py-2.5 border-b border-line">
        <span class="font-semibold text-navy text-sm">{texts.labels.signatures}</span>
        <span class="swap justify-items-end text-[11px] font-medium">
          <span data-step="out" style={`--d:${allSigned}`} class="px-2 py-0.5 rounded-sm bg-amber-50 text-amber-800">{texts.labels.pending}</span>
          <span data-step="fade" style={`--d:${allSigned}`} class="px-2 py-0.5 rounded-sm bg-emerald-50 text-emerald-800">{t.complete} · {texts.signatures.length}/{texts.signatures.length}</span>
        </span>
      </div>
      <ul>
        {texts.signatures.map((sig, i) => (
          <li class="flex items-center gap-3 px-4 py-2 border-b border-line last:border-b-0">
            <span class="w-7 h-7 rounded-full bg-surface border border-line grid place-items-center text-[11px] font-medium text-navy shrink-0">{initials(sig.name)}</span>
            <span class="flex-1 leading-tight">
              <span class="block text-ink">{sig.name}</span>
              <span class="block text-[11px] text-gray-500">{sig.role}</span>
            </span>
            <span class="swap text-[11px] justify-items-end">
              <span data-step="out" style={`--d:${signAt(i)}`} class="text-gray-400">{t.awaiting}</span>
              <span data-step style={`--d:${signAt(i)}`} class="text-emerald-700 font-medium">{t.signed} <span class="font-mono text-gray-400 font-normal">{times[i % times.length]}</span></span>
            </span>
          </li>
        ))}
      </ul>
    </div>
  </div>
  <ReplayButton />
</div>
