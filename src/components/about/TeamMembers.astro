---
// Leadership team: real people, real photos, one ruled row each.
import { Section, SectionHeader } from '../ui';

interface Props {
  title?: string;
  subtitle?: string;
  team?: { name: string; role: string; image: string; linkedin: string; bio: string }[];
}

const {
  title = 'Leadership',
  subtitle = 'Who leads Dafira.',
  team = [
    {
      name: 'Jean-Louis Van Houwe',
      role: 'CEO & Founder',
      image: '/jean-louis-van-houwe.jpeg',
      linkedin: 'https://www.linkedin.com/in/jeanlouisvanhouwe/',
      bio: 'Focused on improving board management through technology and AI.',
    },
  ],
} = Astro.props;
---

<Section space="lg">
  <div class:list={[team.length === 1 && 'grid lg:grid-cols-12 gap-8 items-start']}>
    <div class:list={[team.length === 1 && 'lg:col-span-4']}>
      {team.length === 1 ? (
        <div>
          <h2 class="text-3xl lg:text-4xl font-semibold text-navy leading-tight">{title}</h2>
          <p class="mt-4 text-lg text-gray-600 leading-relaxed">{subtitle}</p>
        </div>
      ) : (
        <SectionHeader title={title} lead={subtitle} />
      )}
    </div>
    <div class:list={['grid gap-x-10 border-t border-line', team.length > 1 ? 'md:grid-cols-2' : 'lg:col-span-7 lg:col-start-6']}>
      {team.map((m, i) => (
        <article class:list={['py-8 flex gap-6 items-start', i > 0 && 'border-t md:border-t-0 border-line']}>
          <img src={m.image} alt={m.name} loading="lazy" class="w-28 h-28 sm:w-36 sm:h-36 object-cover rounded-md border border-line shrink-0" />
          <div>
            <h3 class="text-xl font-semibold text-navy">{m.name}</h3>
            <p class="mt-1 font-mono text-xs uppercase tracking-[0.08em] text-gray-500">{m.role}</p>
            <p class="mt-4 text-gray-600 leading-relaxed">{m.bio}</p>
            <a href={m.linkedin} target="_blank" rel="noopener noreferrer" class="mt-4 inline-flex items-center gap-2 text-sm text-primary hover:text-navy transition-colors">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
              LinkedIn
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</Section>
