---
// Founder's account: portrait on one side, story on the other.
import { Section, Eyebrow } from '../ui';

interface Props {
  tagText?: string;
  title?: string;
  story?: string[];
  founder?: { name: string; role: string };
  image?: string;
}

const {
  tagText = 'Our story',
  title = 'Why we started Dafira',
  story = [
    'Throughout my career serving on multiple boards, I consistently encountered the same challenges: overwhelming document management, inefficient decision-making processes, and the struggle to maintain proper governance standards.',
    "The turning point came during a crucial board meeting where critical documents were misplaced, leading to delayed decisions that impacted the organization's strategic direction. I realized there had to be a better way.",
    'This experience led to the creation of Dafira. We set out to build not just another board portal, but a platform that addresses the real needs of boards.',
    'Today, Dafira helps boards prepare meetings, decide and keep a proper record, with AI used where it saves time.',
  ],
  founder = { name: 'Jean-Louis Van Houwe', role: 'Founder & CEO' },
  image = '/jean-louis-big.jpeg',
} = Astro.props;
---

<Section tone="surface" space="lg" border="both">
  <div class="grid lg:grid-cols-12 gap-12 lg:gap-16 items-start">
    <figure class="lg:col-span-5">
      <img src={image} alt={founder.name} loading="lazy" class="w-full h-[420px] lg:h-[520px] object-cover rounded-md border border-line bg-white" />
      <figcaption class="mt-4 text-sm">
        <span class="font-medium text-navy">{founder.name}</span>
        <span class="text-gray-500"> · {founder.role}</span>
      </figcaption>
    </figure>
    <div class="lg:col-span-6 lg:col-start-7">
      <Eyebrow class="mb-4">{tagText}</Eyebrow>
      <h2 class="text-3xl lg:text-4xl font-semibold text-navy leading-tight">{title}</h2>
      <div class="mt-8 space-y-5 text-lg text-gray-700 leading-relaxed">
        {story.map((p) => <p>{p}</p>)}
      </div>
    </div>
  </div>
</Section>
