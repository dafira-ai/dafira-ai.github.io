---
// Mission and vision as two ruled columns. `aiEraStatement`/`aiHighlight` are accepted for compatibility but no longer shown.
import { Section, Eyebrow } from '../ui';

interface Props {
  className?: string;
  eyebrow?: string;
  mission?: { title: string; description: string; aiText?: string };
  vision?: { title: string; description: string; highlightedText?: string };
  aiEraStatement?: string;
  aiHighlight?: string;
}

const {
  className = '',
  eyebrow = 'Why we exist',
  mission = {
    title: 'Our mission',
    description: 'We build simple board management software that improves board governance and decision-making, with',
    aiText: 'AI as an assistant.',
  },
  vision = {
    title: 'Our vision',
    description: 'Make the governance-driven solution that helps boards',
    highlightedText: 'build a better world.',
  },
} = Astro.props;

const join = (a: string, b?: string) => (b ? `${a} ${b}` : a);
const items = [
  { title: mission.title, text: join(mission.description, mission.aiText) },
  { title: vision.title, text: join(vision.description, vision.highlightedText) },
];
---

<Section class={className} space="lg">
  <Eyebrow class="mb-10">{eyebrow}</Eyebrow>
  <div class="grid lg:grid-cols-2 gap-x-16" data-play>
    {items.map((item, i) => (
      <div class="border-t border-navy pt-8 pb-10" data-step style={`--d:${i * 80}`}>
        <h2 class="text-3xl lg:text-4xl font-semibold text-navy leading-tight">{item.title}</h2>
        <p class="mt-6 text-xl text-gray-700 leading-relaxed max-w-xl">{item.text}</p>
      </div>
    ))}
  </div>
</Section>
