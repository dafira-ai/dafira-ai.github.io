---
// Regulatory context for a sector (financial services, healthcare, real estate), EN/FR/NL.
// Factual overview only: what the text is and what it implies for the board record. No compliance promises.
import { Section, SectionHeader, Callout } from '../ui';
import { langFromPath } from '../../i18n/routes';

interface Props {
  industry: string;
  tone?: 'white' | 'surface';
}

const { industry, tone = 'white' } = Astro.props;
const raw = langFromPath(Astro.url.pathname);
const lang = (raw === 'fr' || raw === 'nl' ? raw : 'en') as 'en' | 'fr' | 'nl';

type Reg = { name: string; ref: string; what: string; board: string };

const labels = {
  en: {
    eyebrow: 'Regulatory context',
    title: 'Regulations that reach the boardroom',
    lead: 'A short overview of texts that shape what the board discusses and must be able to document.',
    what: 'What it is',
    board: 'For the board',
    note: 'This overview is for information only and is not legal advice. Check which texts apply to your organisation and when.',
  },
  fr: {
    eyebrow: 'Contexte réglementaire',
    title: 'Les réglementations qui concernent le conseil',
    lead: 'Un bref aperçu des textes qui influencent ce dont le conseil discute et ce qu’il doit pouvoir documenter.',
    what: 'De quoi il s’agit',
    board: 'Pour le conseil',
    note: 'Cet aperçu est donné à titre d’information et ne constitue pas un avis juridique. Vérifiez quels textes s’appliquent à votre organisation et à partir de quand.',
  },
  nl: {
    eyebrow: 'Regelgevend kader',
    title: 'Regelgeving die de bestuurskamer raakt',
    lead: 'Een kort overzicht van teksten die bepalen wat het bestuur bespreekt en moet kunnen documenteren.',
    what: 'Wat het is',
    board: 'Voor het bestuur',
    note: 'Dit overzicht dient enkel ter informatie en is geen juridisch advies. Ga na welke teksten op uw organisatie van toepassing zijn en vanaf wanneer.',
  },
}[lang];

const regulations: Record<'en' | 'fr' | 'nl', Record<string, Reg[]>> = {
  en: {
    'financial-services': [
      { name: 'DORA', ref: 'Regulation (EU) 2022/2554', what: 'Digital operational resilience for the financial sector, applicable since 17 January 2025.', board: 'The management body defines, approves and oversees the ICT risk management framework and remains responsible for it.' },
      { name: 'CSRD', ref: 'Directive (EU) 2022/2464', what: 'Sustainability reporting by companies, phased in by company size; timelines were revised in 2025.', board: 'The board oversees the sustainability statement and the reporting process, often through the audit committee.' },
      { name: 'GDPR', ref: 'Regulation (EU) 2016/679', what: 'Protection of personal data in the EU.', board: 'Board papers containing personal data must be shared with the right people only, and kept for a defined period.' },
    ],
    healthcare: [
      { name: 'GDPR · health data', ref: 'Regulation (EU) 2016/679, art. 9', what: 'Health data is a special category of personal data, subject to stricter conditions.', board: 'Papers containing such data require restricted access and a record of who consulted them.' },
      { name: 'NIS2', ref: 'Directive (EU) 2022/2555', what: 'Cybersecurity requirements for essential and important entities, including healthcare providers.', board: 'Management bodies approve cybersecurity risk-management measures, oversee their implementation and follow training.' },
      { name: 'MDR', ref: 'Regulation (EU) 2017/745', what: 'Rules for medical devices placed on the EU market, relevant to manufacturers.', board: 'Boards of manufacturers follow compliance with the regulation and keep the related decisions documented.' },
    ],
    'real-estate': [
      { name: 'AIFMD', ref: 'Directive 2011/61/EU, as amended', what: 'Framework for managers of alternative investment funds, including real estate funds.', board: 'Governance, risk management and conflicts of interest are subject to documented oversight.' },
      { name: 'SFDR', ref: 'Regulation (EU) 2019/2088', what: 'Sustainability-related disclosures in the financial services sector.', board: 'The board approves the policies and disclosures that describe how sustainability risks are handled.' },
      { name: 'CSRD', ref: 'Directive (EU) 2022/2464', what: 'Sustainability reporting by companies, phased in by company size; timelines were revised in 2025.', board: 'The board oversees the sustainability statement and the reporting process.' },
    ],
  },
  fr: {
    'financial-services': [
      { name: 'DORA', ref: 'Règlement (UE) 2022/2554', what: 'Résilience opérationnelle numérique du secteur financier, applicable depuis le 17 janvier 2025.', board: 'L’organe de direction définit, approuve et supervise le cadre de gestion du risque informatique et en reste responsable.' },
      { name: 'CSRD', ref: 'Directive (UE) 2022/2464', what: 'Publication d’informations en matière de durabilité, introduite par étapes selon la taille des entreprises ; le calendrier a été revu en 2025.', board: 'Le conseil supervise la déclaration de durabilité et le processus de reporting, souvent via le comité d’audit.' },
      { name: 'RGPD', ref: 'Règlement (UE) 2016/679', what: 'Protection des données à caractère personnel dans l’UE.', board: 'Les documents du conseil contenant des données personnelles ne doivent être partagés qu’avec les bonnes personnes et conservés pendant une durée définie.' },
    ],
    healthcare: [
      { name: 'RGPD · données de santé', ref: 'Règlement (UE) 2016/679, art. 9', what: 'Les données de santé sont une catégorie particulière de données personnelles, soumise à des conditions plus strictes.', board: 'Les documents qui en contiennent exigent un accès restreint et une trace de qui les a consultés.' },
      { name: 'NIS2', ref: 'Directive (UE) 2022/2555', what: 'Exigences de cybersécurité pour les entités essentielles et importantes, dont les prestataires de soins de santé.', board: 'Les organes de direction approuvent les mesures de gestion des risques de cybersécurité, supervisent leur mise en œuvre et suivent une formation.' },
      { name: 'MDR', ref: 'Règlement (UE) 2017/745', what: 'Règles applicables aux dispositifs médicaux mis sur le marché de l’UE, pertinentes pour les fabricants.', board: 'Les conseils des fabricants suivent la conformité au règlement et documentent les décisions qui s’y rapportent.' },
    ],
    'real-estate': [
      { name: 'AIFMD', ref: 'Directive 2011/61/UE, telle que modifiée', what: 'Cadre applicable aux gestionnaires de fonds d’investissement alternatifs, y compris les fonds immobiliers.', board: 'La gouvernance, la gestion des risques et les conflits d’intérêts font l’objet d’une supervision documentée.' },
      { name: 'SFDR', ref: 'Règlement (UE) 2019/2088', what: 'Publication d’informations en matière de durabilité dans le secteur des services financiers.', board: 'Le conseil approuve les politiques et publications qui décrivent la prise en compte des risques de durabilité.' },
      { name: 'CSRD', ref: 'Directive (UE) 2022/2464', what: 'Publication d’informations en matière de durabilité, introduite par étapes selon la taille des entreprises ; le calendrier a été revu en 2025.', board: 'Le conseil supervise la déclaration de durabilité et le processus de reporting.' },
    ],
  },
  nl: {
    'financial-services': [
      { name: 'DORA', ref: 'Verordening (EU) 2022/2554', what: 'Digitale operationele weerbaarheid van de financiële sector, van toepassing sinds 17 januari 2025.', board: 'Het leidinggevend orgaan bepaalt, keurt goed en ziet toe op het kader voor ICT-risicobeheer en blijft ervoor verantwoordelijk.' },
      { name: 'CSRD', ref: 'Richtlijn (EU) 2022/2464', what: 'Duurzaamheidsrapportering door ondernemingen, gefaseerd ingevoerd naargelang de omvang; de timing werd in 2025 herzien.', board: 'Het bestuur houdt toezicht op de duurzaamheidsverklaring en het rapporteringsproces, vaak via het auditcomité.' },
      { name: 'AVG', ref: 'Verordening (EU) 2016/679', what: 'Bescherming van persoonsgegevens in de EU.', board: 'Bestuursstukken met persoonsgegevens mogen alleen met de juiste personen gedeeld worden en worden gedurende een bepaalde termijn bewaard.' },
    ],
    healthcare: [
      { name: 'AVG · gezondheidsgegevens', ref: 'Verordening (EU) 2016/679, art. 9', what: 'Gezondheidsgegevens zijn een bijzondere categorie persoonsgegevens, met strengere voorwaarden.', board: 'Stukken met zulke gegevens vragen beperkte toegang en een spoor van wie ze raadpleegde.' },
      { name: 'NIS2', ref: 'Richtlijn (EU) 2022/2555', what: 'Cyberbeveiligingseisen voor essentiële en belangrijke entiteiten, waaronder zorgaanbieders.', board: 'Bestuursorganen keuren de maatregelen voor cyberbeveiligingsrisicobeheer goed, zien toe op de uitvoering en volgen een opleiding.' },
      { name: 'MDR', ref: 'Verordening (EU) 2017/745', what: 'Regels voor medische hulpmiddelen op de EU-markt, relevant voor fabrikanten.', board: 'Besturen van fabrikanten volgen de naleving van de verordening op en documenteren de bijbehorende besluiten.' },
    ],
    'real-estate': [
      { name: 'AIFMD', ref: 'Richtlijn 2011/61/EU, zoals gewijzigd', what: 'Kader voor beheerders van alternatieve beleggingsinstellingen, waaronder vastgoedfondsen.', board: 'Governance, risicobeheer en belangenconflicten zijn onderworpen aan gedocumenteerd toezicht.' },
      { name: 'SFDR', ref: 'Verordening (EU) 2019/2088', what: 'Duurzaamheidsinformatie in de financiëledienstensector.', board: 'Het bestuur keurt het beleid en de publicaties goed die beschrijven hoe met duurzaamheidsrisico’s wordt omgegaan.' },
      { name: 'CSRD', ref: 'Richtlijn (EU) 2022/2464', what: 'Duurzaamheidsrapportering door ondernemingen, gefaseerd ingevoerd naargelang de omvang; de timing werd in 2025 herzien.', board: 'Het bestuur houdt toezicht op de duurzaamheidsverklaring en het rapporteringsproces.' },
    ],
  },
};

const items = regulations[lang][industry] ?? [];
---

{items.length > 0 && (
  <Section tone={tone} border="bottom">
    <SectionHeader eyebrow={labels.eyebrow} title={labels.title} lead={labels.lead} />
    <div class="border-t border-line">
      <div class="hidden lg:grid grid-cols-12 gap-8 py-4 border-b border-line font-mono text-xs uppercase tracking-[0.08em] text-gray-500">
        <div class="col-span-3"></div>
        <div class="col-span-4">{labels.what}</div>
        <div class="col-span-5">{labels.board}</div>
      </div>
      {items.map((reg) => (
        <div class="grid lg:grid-cols-12 gap-3 lg:gap-8 py-6 border-b border-line">
          <div class="lg:col-span-3">
            <h3 class="text-lg font-semibold text-navy">{reg.name}</h3>
            <p class="mt-1 font-mono text-xs text-gray-500">{reg.ref}</p>
          </div>
          <p class="lg:col-span-4 text-[15px] text-gray-600 leading-relaxed">{reg.what}</p>
          <p class="lg:col-span-5 text-[15px] text-ink leading-relaxed">{reg.board}</p>
        </div>
      ))}
    </div>
    <Callout class="mt-10 max-w-3xl">{labels.note}</Callout>
  </Section>
)}
