---
import MegaMenu from "./navigation/MegaMenu.astro";
import Logo from "./Logo.astro";
import { LANGS, LANG_LABELS, localizePath, stripLang, routeExists, type Lang } from "../i18n/routes";

interface Props {
  transparent?: boolean;
  hideMenu?: boolean;
  whiteLogo?: boolean;
  currentLang?: Lang;
}

const { transparent = false, hideMenu = false, whiteLogo = false, currentLang = "en" } = Astro.props;

const basePath = stripLang(Astro.url.pathname);
// Language switcher: link to the same page in each language, or to that language's home when it doesn't exist.
const langLinks = LANGS.map((l) => {
  const target = l === "en" ? basePath : basePath === "/" ? `/${l}` : `/${l}${basePath}`;
  return { lang: l, href: routeExists(target) ? target : l === "en" ? "/" : `/${l}` };
});

const t = {
  en: { demo: "Book a demo", menu: "Menu", language: "Language",
    nav: [["Features", "/features"], ["Use cases", "#", true], ["Pricing", "/pricing"], ["Customers", "/testimonials"], ["Resources", "/resources"], ["About", "/about"]] },
  fr: { demo: "Demander une démo", menu: "Menu", language: "Langue",
    nav: [["Fonctionnalités", "/features"], ["Cas d'usage", "#", true], ["Tarifs", "/pricing"], ["Clients", "/testimonials"], ["Ressources", "/resources"], ["À propos", "/about"]] },
  nl: { demo: "Demo aanvragen", menu: "Menu", language: "Taal",
    nav: [["Functies", "/features"], ["Toepassingen", "#", true], ["Prijzen", "/pricing"], ["Klanten", "/testimonials"], ["Kennisbank", "/resources"], ["Over ons", "/about"]] },
  ar: { demo: "اطلب عرضًا توضيحيًا", menu: "القائمة", language: "اللغة",
    nav: [["المزايا", "/features"], ["حالات الاستخدام", "#", true], ["الأسعار", "/pricing"], ["العملاء", "/testimonials"], ["الموارد", "/resources"], ["من نحن", "/about"]] },
}[currentLang];

const navItems = t.nav.map(([label, href, mega]) => ({
  label: label as string,
  href: mega ? undefined : localizePath(currentLang, href as string),
  mega: Boolean(mega),
}));
const homeHref = currentLang === "en" ? "/" : `/${currentLang}`;
const demoHref = localizePath(currentLang, "/request-demo");
---

<header
  id="site-header"
  class:list={[
    "fixed inset-x-0 top-0 z-50 transition-colors",
    transparent ? "bg-transparent border-b border-transparent" : "bg-white/95 backdrop-blur border-b border-line",
  ]}
  data-transparent={transparent ? "true" : "false"}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between gap-6 h-16">
      <a href={homeHref} class="shrink-0" aria-label="Dafira">
        <Logo tone={whiteLogo ? "light" : "dark"} />
      </a>

      {!hideMenu && (
        <nav class="hidden lg:flex items-center gap-1" aria-label="Main">
          {navItems.map((item) =>
            item.mega ? (
              <div class="relative group">
                <button
                  type="button"
                  class="inline-flex items-center gap-1 px-3 py-2 text-sm text-gray-600 hover:text-navy rounded-md transition-colors"
                  aria-haspopup="true"
                >
                  {item.label}
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M19 9l-7 7-7-7" />
                  </svg>
                </button>
                <MegaMenu lang={currentLang} />
              </div>
            ) : (
              <a href={item.href} class="px-3 py-2 text-sm text-gray-600 hover:text-navy rounded-md transition-colors">
                {item.label}
              </a>
            ),
          )}
        </nav>
      )}

      <div class="flex items-center gap-2">
        <details class="relative hidden lg:block lang-switch">
          <summary
            class="list-none cursor-pointer inline-flex items-center gap-1 px-2.5 py-1.5 text-xs font-medium text-gray-600 hover:text-navy border border-line rounded-md transition-colors"
            aria-label={t.language}
          >
            {LANG_LABELS[currentLang].short}
            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M19 9l-7 7-7-7" />
            </svg>
          </summary>
          <ul class="absolute end-0 mt-2 w-40 bg-white border border-line rounded-md shadow-lg py-1 z-50">
            {langLinks.map((l) => (
              <li>
                <a
                  href={l.href}
                  hreflang={l.lang}
                  lang={l.lang}
                  class:list={[
                    "flex justify-between px-3 py-2 text-sm hover:bg-surface",
                    l.lang === currentLang ? "text-navy font-medium" : "text-gray-600",
                  ]}
                  aria-current={l.lang === currentLang ? "true" : undefined}
                >
                  {LANG_LABELS[l.lang].long}
                  <span class="font-mono text-[11px] text-gray-400">{l.lang.toUpperCase()}</span>
                </a>
              </li>
            ))}
          </ul>
        </details>
        <a
          href={demoHref}
          class="inline-flex items-center px-4 py-2 text-sm font-medium rounded-md text-white bg-navy hover:bg-primary transition-colors"
        >
          {t.demo}
        </a>

        {!hideMenu && (
          <button
            class="lg:hidden p-2 -me-2 rounded-md text-gray-600 hover:text-navy"
            id="mobile-menu-button"
            aria-label={t.menu}
            aria-expanded="false"
            aria-controls="mobile-menu"
          >
            <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M4 7h16M4 12h16M4 17h16"></path>
            </svg>
          </button>
        )}
      </div>
    </div>
  </div>

  {!hideMenu && (
    <div class="hidden lg:hidden border-t border-line bg-white" id="mobile-menu">
      <nav class="max-w-7xl mx-auto px-4 sm:px-6 py-4 space-y-1" aria-label="Mobile">
        {navItems.filter((i) => !i.mega).map((item) => (
          <a href={item.href} class="block px-3 py-2.5 text-base text-gray-700 hover:text-navy hover:bg-surface rounded-md">
            {item.label}
          </a>
        ))}
        <div class="flex flex-wrap gap-2 pt-4 mt-2 border-t border-line">
          {langLinks.map((l) => (
            <a
              href={l.href}
              hreflang={l.lang}
              lang={l.lang}
              class:list={[
                "px-3 py-1.5 text-sm border rounded-md",
                l.lang === currentLang ? "border-navy text-navy" : "border-line text-gray-600",
              ]}
            >
              {LANG_LABELS[l.lang].long}
            </a>
          ))}
        </div>
      </nav>
    </div>
  )}
</header>

<style>
  .lang-switch summary::-webkit-details-marker { display: none; }
</style>

<script>
  const header = document.getElementById("site-header");
  const button = document.getElementById("mobile-menu-button");
  const menu = document.getElementById("mobile-menu");

  button?.addEventListener("click", () => {
    const open = menu?.classList.toggle("hidden") === false;
    button.setAttribute("aria-expanded", String(open));
    if (header?.dataset.transparent === "true") header.classList.toggle("bg-white", open);
  });

  // The header stays in place; once the page scrolls it gets a solid background.
  const onScroll = () => {
    if (header?.dataset.transparent !== "true") return;
    const scrolled = window.scrollY > 8;
    header.classList.toggle("bg-white", scrolled);
    header.classList.toggle("border-line", scrolled);
    header.classList.toggle("bg-transparent", !scrolled);
  };
  window.addEventListener("scroll", onScroll, { passive: true });
  onScroll();

  // Close the language menu when clicking elsewhere
  document.addEventListener("click", (e) => {
    document.querySelectorAll<HTMLDetailsElement>(".lang-switch[open]").forEach((d) => {
      if (!d.contains(e.target as Node)) d.open = false;
    });
  });
</script>
