---
// Template vs Dafira for board minutes (EN / FR / NL).
import Comparison from '../Comparison.astro';
import { Button } from '../../ui';
import { langFromPath, localizePath } from '../../../i18n/routes';

const lang = langFromPath(Astro.url.pathname);
const copy = {
  en: {
    title: 'What Dafira adds to a template',
    lead: 'The template gives you the structure. Dafira handles the rest of the minutes process.',
    templateLabel: 'Word template',
    dafiraLabel: 'Dafira',
    rows: [
      { template: 'Basic formatting and structure', dafira: 'AI minute builder with suggested structure' },
      { template: 'Manual input required', dafira: 'Transcription and summary drafted from the meeting recording' },
      { template: 'Static document', dafira: 'Real-time collaboration and version control' },
      { template: 'Manual distribution', dafira: 'Distribution to members with tracking' },
      { template: 'Print and sign', dafira: 'Digital signatures and approvals' },
    ],
    cta: 'Book a demo',
  },
  fr: {
    title: "Ce que Dafira ajoute à un modèle",
    lead: 'Le modèle vous donne la structure. Dafira prend en charge le reste du processus de rédaction.',
    templateLabel: 'Modèle Word',
    dafiraLabel: 'Dafira',
    rows: [
      { template: 'Mise en forme et structure de base', dafira: "Rédaction du procès-verbal assistée par l'IA, avec une structure proposée" },
      { template: 'Saisie manuelle', dafira: "Transcription et synthèse préparées à partir de l'enregistrement de la réunion" },
      { template: 'Document statique', dafira: 'Collaboration en temps réel et gestion des versions' },
      { template: 'Diffusion manuelle', dafira: 'Diffusion aux membres avec suivi' },
      { template: 'Impression et signature', dafira: 'Signatures et approbations électroniques' },
    ],
    cta: 'Demander une démo',
  },
  nl: {
    title: 'Wat Dafira toevoegt aan een sjabloon',
    lead: 'Het sjabloon geeft u de structuur. Dafira neemt de rest van het notuleringsproces voor zijn rekening.',
    templateLabel: 'Word-sjabloon',
    dafiraLabel: 'Dafira',
    rows: [
      { template: 'Basisopmaak en structuur', dafira: 'Notulen opstellen met AI, met een voorgestelde structuur' },
      { template: 'Handmatige invoer', dafira: 'Transcriptie en samenvatting op basis van de opname van de vergadering' },
      { template: 'Statisch document', dafira: 'Realtime samenwerking en versiebeheer' },
      { template: 'Handmatige verspreiding', dafira: 'Verspreiding naar leden met opvolging' },
      { template: 'Afdrukken en ondertekenen', dafira: 'Digitale handtekeningen en goedkeuringen' },
    ],
    cta: 'Demo aanvragen',
  },
}[lang === 'fr' || lang === 'nl' ? lang : 'en'];
---

<Comparison title={copy.title} lead={copy.lead} templateLabel={copy.templateLabel} dafiraLabel={copy.dafiraLabel} rows={copy.rows}>
  <div class="mt-8">
    <Button href={localizePath(lang, '/request-demo')}>{copy.cta}</Button>
  </div>
</Comparison>
