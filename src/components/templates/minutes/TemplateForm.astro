---
import FormSuccess from '../../forms/FormSuccess.astro';
import { Field, Button, Icon } from '../../ui';
import { langFromPath } from '../../../i18n/routes';

interface Props {
  className?: string;
}

const { className = "" } = Astro.props;
const lang = langFromPath(Astro.url.pathname);
const t = {
  en: { title: 'Get the template', first: 'First name', last: 'Last name', email: 'Work email', company: 'Company name', submit: 'Download template', privacy: 'Your information is kept confidential and never shared.', okTitle: 'Your template is on its way', okText: 'Check your email for the download link.' },
  fr: { title: 'Recevoir le modèle', first: 'Prénom', last: 'Nom', email: 'E-mail professionnel', company: "Nom de l'organisation", submit: 'Télécharger le modèle', privacy: 'Vos informations restent confidentielles et ne sont jamais partagées.', okTitle: 'Votre modèle est en route', okText: 'Consultez votre boîte e-mail pour le lien de téléchargement.' },
  nl: { title: 'Ontvang het sjabloon', first: 'Voornaam', last: 'Achternaam', email: 'Zakelijk e-mailadres', company: 'Naam organisatie', submit: 'Sjabloon downloaden', privacy: 'Uw gegevens blijven vertrouwelijk en worden nooit gedeeld.', okTitle: 'Uw sjabloon is onderweg', okText: 'Controleer uw e-mail voor de downloadlink.' },
}[lang === 'fr' || lang === 'nl' ? lang : 'en'];
---

<div class:list={['bg-white rounded-md border border-line p-6 lg:p-8', className]}>
  <h2 class="text-2xl font-semibold text-navy">{t.title}</h2>

  <form id="templateMinutesForm" class="mt-6 space-y-5" method="POST">
    <div class="grid sm:grid-cols-2 gap-5">
      <Field id="firstName" label={t.first} required autocomplete="given-name" />
      <Field id="lastName" label={t.last} required autocomplete="family-name" />
    </div>
    <Field id="email" type="email" label={t.email} required autocomplete="email" />
    <Field id="company" label={t.company} required autocomplete="organization" />
    <Button type="submit" class="w-full">
      <Icon slot="icon" name="download" class="w-5 h-5" />
      {t.submit}
    </Button>
    <p class="flex items-center gap-2 text-sm text-gray-500">
      <Icon name="lock" class="w-4 h-4 text-navy" />
      {t.privacy}
    </p>
  </form>

  <div id="formSuccess" class="hidden">
    <FormSuccess title={t.okTitle} message={t.okText} />
  </div>
</div>

<script>
  import { sendForm } from '../../../utils/sendForm';
  const form = document.getElementById('templateMinutesForm');
  const success = document.getElementById('formSuccess');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!(await sendForm(form as HTMLFormElement, 'Minutes template request'))) return;
    form.classList.add('hidden');
    success?.classList.remove('hidden');
  });
</script>