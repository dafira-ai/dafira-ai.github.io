---
// Short feature cell used in template landing pages (inside a CellGrid).
import { Icon } from '../../ui';

interface Props {
  title: string;
  description: string;
  emoji?: string;
  icon?: string;
}

const { title, description, emoji, icon } = Astro.props;
---

<div class="bg-white p-6">
  <Icon name={icon ?? emoji} class="w-5 h-5 text-navy" />
  <h3 class="mt-4 font-semibold text-navy">{title}</h3>
  <p class="mt-1 text-[15px] text-gray-600 leading-relaxed">{description}</p>
</div>
