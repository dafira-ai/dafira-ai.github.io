---
// Doing it alone vs with Dafira, for meeting recordings.
import Comparison from '../Comparison.astro';
import { Button } from '../../ui';

const rows = [
  { template: 'Manual setup by trial and error', dafira: 'Guidance on audio configuration for your meeting room' },
  { template: 'Inconsistent minute quality', dafira: 'AI transcription with human review' },
  { template: 'Technical issues during meetings', dafira: 'Support and troubleshooting from our team' },
  { template: 'Different tools for different needs', dafira: 'One board management platform' },
  { template: 'Limited guidance and resources', dafira: 'Onboarding and good practices' },
];
---

<Comparison title="Why boards choose Dafira" lead="Software, plus a team that helps you set it up." templateLabel="On your own" dafiraLabel="With Dafira" rows={rows}>
  <div class="mt-8">
    <Button href="/request-demo">Book a demo</Button>
  </div>
</Comparison>
