---
import FormSuccess from '../../forms/FormSuccess.astro';
import { Field, Button, Icon } from '../../ui';

interface Props {
  className?: string;
}

const { className = "" } = Astro.props;
---

<div class:list={['bg-white rounded-md border border-line p-6 lg:p-8', className]}>
  <h2 class="text-2xl font-semibold text-navy">Download the guidelines</h2>

  <form id="templateAudioForm" class="mt-6 space-y-5" method="POST">
    <div class="grid sm:grid-cols-2 gap-5">
      <Field id="firstName" label="First name" required autocomplete="given-name" />
      <Field id="lastName" label="Last name" required autocomplete="family-name" />
    </div>
    <div>
      <Field id="email" type="email" label="Professional email address" placeholder="you@company.com" required autocomplete="email" />
      <p id="emailError" class="hidden mt-2 text-xs text-red-700">
        Please enter your professional email address (not Gmail, Hotmail, Yahoo, etc.)
      </p>
    </div>
    <Field id="company" label="Company name" required autocomplete="organization" />
    <Button type="submit" class="w-full">
      <Icon slot="icon" name="download" class="w-5 h-5" />
      Download guidelines
    </Button>
    <p class="flex items-center gap-2 text-sm text-gray-500">
      <Icon name="lock" class="w-4 h-4 text-navy" />
      Your information is kept confidential and never shared.
    </p>
  </form>

  <div id="formSuccess" class="hidden">
    <FormSuccess
      title="Your guidelines are ready"
      message="Thank you for your interest. Download our audio setup guidelines for board meeting recordings below."
    />
    <Button href="/audio-setup-guide.pdf" download="dafira-audio-setup-guide.pdf" class="mt-4 w-full">
      <Icon slot="icon" name="download" class="w-5 h-5" />
      Download now
    </Button>
  </div>
</div>

<script>
  import { sendForm } from '../../../utils/sendForm';
  const form = document.getElementById('templateAudioForm') as HTMLFormElement;
  const success = document.getElementById('formSuccess');
  const emailInput = document.getElementById('email') as HTMLInputElement;
  const emailError = document.getElementById('emailError');

  // List of personal email domains to block
  const personalDomains = [
    'gmail.com', 'googlemail.com',
    'hotmail.com', 'hotmail.co.uk', 'hotmail.fr', 'hotmail.de', 'hotmail.be', 'hotmail.nl',
    'outlook.com', 'outlook.be', 'outlook.fr', 'outlook.de', 'outlook.nl',
    'live.com', 'live.be', 'live.fr', 'live.nl',
    'msn.com',
    'yahoo.com', 'yahoo.co.uk', 'yahoo.fr', 'yahoo.de', 'yahoo.be', 'yahoo.nl',
    'ymail.com',
    'aol.com',
    'icloud.com', 'me.com', 'mac.com',
    'protonmail.com', 'proton.me',
    'mail.com',
    'gmx.com', 'gmx.de', 'gmx.net',
    'zoho.com',
    'yandex.com',
    'tutanota.com',
    'fastmail.com',
    'inbox.com',
    'hey.com',
    'pm.me',
    'telenet.be', 'skynet.be', 'proximus.be', 'scarlet.be',
    'orange.fr', 'free.fr', 'sfr.fr', 'laposte.net', 'wanadoo.fr',
    't-online.de', 'web.de',
    'ziggo.nl', 'kpnmail.nl', 'xs4all.nl'
  ];

  function isPersonalEmail(email: string): boolean {
    const domain = email.toLowerCase().split('@')[1];
    return personalDomains.includes(domain);
  }

  function showEmailError() {
    emailError?.classList.remove('hidden');
    emailInput?.setAttribute('aria-invalid', 'true');
  }

  function hideEmailError() {
    emailError?.classList.add('hidden');
    emailInput?.removeAttribute('aria-invalid');
  }

  emailInput?.addEventListener('input', () => {
    hideEmailError();
  });

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();

    const email = emailInput?.value || '';

    if (isPersonalEmail(email)) {
      showEmailError();
      emailInput?.focus();
      return;
    }

    if (!(await sendForm(form as HTMLFormElement, 'Audio setup guide request'))) return;
    hideEmailError();
    form.classList.add('hidden');
    success?.classList.remove('hidden');
  });
</script>
