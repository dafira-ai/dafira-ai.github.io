---
// Vignette for /features: action items, signatures on a resolution and access by role. Plays once.
import AppFrame from '../features/AppFrame.astro';
import { langFromPath } from '../../i18n/routes';
import { featureLang } from '../features/common';

const t = {
  en: {
    title: 'Follow-up · Board of Directors Q1', meta: 'After the meeting',
    tasks: 'Action items',
    taskList: [['Circulate the approved minutes', 'Board secretary', 'done', 'Closed'], ['Update the risk register', 'CFO', 'open', 'Due 30 April'], ['Prepare the Nordic budget', 'CEO', 'open', 'Due 15 May']],
    signatures: 'Signatures', sigList: [['Resolution 2026-04 · Capex', 'done', 'Signed 5/5'], ['Minutes · Q1 meeting', 'open', 'Awaiting 2 of 5']],
    access: 'Access by role', roles: [['Chair', 'Documents · votes · signature'], ['Director', 'Documents · votes · signature'], ['Observer', 'Documents, read only']],
  },
  fr: {
    title: 'Suivi · Conseil d’administration T1', meta: 'Après la séance',
    tasks: 'Actions',
    taskList: [['Diffuser le procès-verbal approuvé', 'Secrétaire du conseil', 'done', 'Clôturée'], ['Mettre à jour le registre des risques', 'CFO', 'open', 'Échéance 30 avril'], ['Préparer le budget nordique', 'CEO', 'open', 'Échéance 15 mai']],
    signatures: 'Signatures', sigList: [['Résolution 2026-04 · Capex', 'done', 'Signée 5/5'], ['Procès-verbal · séance T1', 'open', 'En attente 2 sur 5']],
    access: 'Accès par rôle', roles: [['Président', 'Documents · votes · signature'], ['Administrateur', 'Documents · votes · signature'], ['Observateur', 'Documents, lecture seule']],
  },
  nl: {
    title: 'Opvolging · Raad van bestuur Q1', meta: 'Na de vergadering',
    tasks: 'Actiepunten',
    taskList: [['Goedgekeurde notulen verspreiden', 'Bestuurssecretaris', 'done', 'Afgerond'], ['Risicoregister bijwerken', 'CFO', 'open', 'Tegen 30 april'], ['Scandinavisch budget voorbereiden', 'CEO', 'open', 'Tegen 15 mei']],
    signatures: 'Handtekeningen', sigList: [['Resolutie 2026-04 · Capex', 'done', 'Getekend 5/5'], ['Notulen · vergadering Q1', 'open', 'Wacht op 2 van 5']],
    access: 'Toegang per rol', roles: [['Voorzitter', 'Documenten · stemmen · handtekening'], ['Bestuurder', 'Documenten · stemmen · handtekening'], ['Waarnemer', 'Documenten, alleen lezen']],
  },
}[featureLang(langFromPath(Astro.url.pathname))];

const tone = { done: 'bg-emerald-50 text-emerald-800', open: 'bg-amber-50 text-amber-800' };
const label = 'font-mono text-[11px] uppercase tracking-[0.08em] text-gray-500';
---

<div data-play>
  <AppFrame title={t.title} meta={t.meta}>
    <div class="p-5">
      <p class={label}>{t.tasks}</p>
      <ul class="mt-2 border-t border-line">
        {t.taskList.map(([task, owner, state, status], i) => (
          <li class="flex items-center justify-between gap-3 py-2.5 border-b border-line" data-step style={`--d:${100 + i * 90}`}>
            <span class="min-w-0">
              <span class="block text-[13px] text-ink">{task}</span>
              <span class="block text-xs text-gray-500">{owner}</span>
            </span>
            <span class={`text-[11px] font-medium px-2 py-0.5 rounded-sm whitespace-nowrap ${tone[state as keyof typeof tone]}`}>{status}</span>
          </li>
        ))}
      </ul>
    </div>
    <div class="grid sm:grid-cols-2 border-t border-line">
      <div class="p-5 sm:border-e border-line">
        <p class={label}>{t.signatures}</p>
        <ul class="mt-2 space-y-2">
          {t.sigList.map(([doc, state, status], i) => (
            <li class="border border-line rounded-sm px-3 py-2.5" data-step style={`--d:${450 + i * 90}`}>
              <span class="block text-[13px] text-ink">{doc}</span>
              <span class={`mt-1.5 inline-block text-[11px] font-medium px-2 py-0.5 rounded-sm ${tone[state as keyof typeof tone]}`}>{status}</span>
            </li>
          ))}
        </ul>
      </div>
      <div class="p-5 border-t sm:border-t-0 border-line bg-surface">
        <p class={label}>{t.access}</p>
        <dl class="mt-2">
          {t.roles.map(([role, rights], i) => (
            <div class="py-2 border-b border-line last:border-b-0" data-step style={`--d:${700 + i * 90}`}>
              <dt class="text-[13px] font-medium text-navy">{role}</dt>
              <dd class="text-xs text-gray-600">{rights}</dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </AppFrame>
</div>
