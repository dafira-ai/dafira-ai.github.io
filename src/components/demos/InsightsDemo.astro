---
// Vignette for /features: a question to the AI assistant with a sourced answer, and the document library by meeting. Plays once.
import AppFrame from '../features/AppFrame.astro';
import { langFromPath } from '../../i18n/routes';
import { featureLang } from '../features/common';

const t = {
  en: {
    title: 'AI assistant', meta: 'Board of Directors',
    question: 'What did the board decide on the Nordic expansion?',
    answer: 'The board approved the first phase of the Nordic expansion and asked management for a detailed budget at the next meeting.',
    source: 'Minutes · Board of Directors, 15 March · item 3',
    library: 'Documents', folders: [['Board of Directors Q1', '5 documents'], ['Audit committee Q1', '3 documents'], ['Policies', '8 documents']],
  },
  fr: {
    title: 'Assistant IA', meta: 'Conseil d’administration',
    question: 'Qu’a décidé le conseil au sujet de l’expansion nordique ?',
    answer: 'Le conseil a approuvé la première phase de l’expansion nordique et a demandé à la direction un budget détaillé pour la prochaine séance.',
    source: 'PV · Conseil d’administration, 15 mars · point 3',
    library: 'Documents', folders: [['Conseil d’administration T1', '5 documents'], ['Comité d’audit T1', '3 documents'], ['Politiques', '8 documents']],
  },
  nl: {
    title: 'AI-assistent', meta: 'Raad van bestuur',
    question: 'Wat heeft het bestuur beslist over de Scandinavische uitbreiding?',
    answer: 'Het bestuur keurde de eerste fase van de Scandinavische uitbreiding goed en vroeg het management om een gedetailleerd budget voor de volgende vergadering.',
    source: 'Notulen · Raad van bestuur, 15 maart · punt 3',
    library: 'Documenten', folders: [['Raad van bestuur Q1', '5 documenten'], ['Auditcomité Q1', '3 documenten'], ['Beleid', '8 documenten']],
  },
}[featureLang(langFromPath(Astro.url.pathname))];
---

<div data-play>
  <AppFrame title={t.title} meta={t.meta}>
    <div class="p-5 space-y-4">
      <div class="flex justify-end" data-step style="--d:100">
        <p class="max-w-[85%] bg-surface border border-line rounded-md px-4 py-3 text-[13px] text-ink">{t.question}</p>
      </div>
      <div class="max-w-[90%] space-y-3" data-step style="--d:500">
        <p class="text-[13px] text-gray-700 leading-relaxed">{t.answer}</p>
        <p class="flex items-start gap-2 border-s-2 border-primary ps-3 py-1 text-xs text-gray-600">
          <svg class="w-4 h-4 text-primary shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M7 3h7l5 5v13H7z"/><path d="M14 3v5h5M10 13h6M10 17h6"/></svg>
          {t.source}
        </p>
      </div>
    </div>
    <div class="border-t border-line bg-surface px-5 py-4">
      <p class="font-mono text-[11px] uppercase tracking-[0.08em] text-gray-500">{t.library}</p>
      <ul class="mt-2">
        {t.folders.map(([name, count], i) => (
          <li class="flex items-center justify-between gap-3 py-2 border-b border-line last:border-b-0" data-step style={`--d:${800 + i * 90}`}>
            <span class="flex items-center gap-2 text-[13px] text-ink">
              <svg class="w-4 h-4 text-gray-500 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h6l2 2h10v11H3z"/></svg>
              {name}
            </span>
            <span class="text-xs text-gray-500">{count}</span>
          </li>
        ))}
      </ul>
    </div>
  </AppFrame>
</div>
