---
// Vignette for /features: a meeting in session — agenda on the side, draft minutes and shared documents. Plays once.
import AppFrame from '../features/AppFrame.astro';
import { langFromPath } from '../../i18n/routes';
import { featureLang } from '../features/common';

const t = {
  en: {
    title: 'Board of Directors · Q1', meta: 'In session', agenda: 'Agenda',
    items: [
      ['Opening and attendance', '5 min', 'done', 'Done'],
      ['Financial review Q1', '15 min', 'current', 'Current item'],
      ['Strategic initiatives', '20 min', 'next', 'Next'],
    ],
    current: 'Financial review Q1', draft: 'Minutes · draft',
    lines: ['The CFO presented the Q1 results and the updated forecast.', 'The board approved the Q1 financial statements.'],
    docs: 'Documents for this item', files: [['Q1 financial report.pdf', 'Read by 6 of 7'], ['Forecast 2026.xlsx', 'Read by 5 of 7']],
  },
  fr: {
    title: 'Conseil d’administration · T1', meta: 'En séance', agenda: 'Ordre du jour',
    items: [
      ['Ouverture et présences', '5 min', 'done', 'Traité'],
      ['Revue financière T1', '15 min', 'current', 'Point en cours'],
      ['Initiatives stratégiques', '20 min', 'next', 'À suivre'],
    ],
    current: 'Revue financière T1', draft: 'Procès-verbal · projet',
    lines: ['Le CFO a présenté les résultats du T1 et la prévision actualisée.', 'Le conseil a approuvé les états financiers du T1.'],
    docs: 'Documents de ce point', files: [['Rapport financier T1.pdf', 'Lu par 6 sur 7'], ['Prévisions 2026.xlsx', 'Lu par 5 sur 7']],
  },
  nl: {
    title: 'Raad van bestuur · Q1', meta: 'In vergadering', agenda: 'Agenda',
    items: [
      ['Opening en aanwezigheden', '5 min', 'done', 'Behandeld'],
      ['Financieel overzicht Q1', '15 min', 'current', 'Huidig punt'],
      ['Strategische initiatieven', '20 min', 'next', 'Volgend'],
    ],
    current: 'Financieel overzicht Q1', draft: 'Notulen · ontwerp',
    lines: ['De CFO presenteerde de resultaten van Q1 en de bijgewerkte prognose.', 'Het bestuur keurde de financiële staten van Q1 goed.'],
    docs: 'Documenten bij dit punt', files: [['Financieel rapport Q1.pdf', 'Gelezen door 6 van 7'], ['Prognose 2026.xlsx', 'Gelezen door 5 van 7']],
  },
}[featureLang(langFromPath(Astro.url.pathname))];

const status = {
  done: 'bg-emerald-50 text-emerald-800',
  current: 'bg-blue-50 text-primary',
  next: 'bg-gray-100 text-gray-700',
};
---

<div data-play>
  <AppFrame title={t.title} meta={t.meta}>
    <div class="grid sm:grid-cols-[minmax(0,15rem)_1fr]">
      <div class="bg-surface border-b sm:border-b-0 sm:border-e border-line p-4">
        <p class="font-mono text-[11px] uppercase tracking-[0.08em] text-gray-500">{t.agenda}</p>
        <ol class="mt-3 space-y-2">
          {t.items.map(([title, duration, state, label], i) => (
            <li class:list={['bg-white border rounded-sm px-3 py-2.5', state === 'current' ? 'border-primary' : 'border-line']} data-step style={`--d:${100 + i * 90}`}>
              <div class="flex items-baseline justify-between gap-2">
                <span class="text-[13px] text-ink">{i + 1}. {title}</span>
                <span class="font-mono text-[11px] text-gray-500 whitespace-nowrap">{duration}</span>
              </div>
              <span class={`mt-1.5 inline-block text-[11px] font-medium px-2 py-0.5 rounded-sm ${status[state as keyof typeof status]}`}>{label}</span>
            </li>
          ))}
        </ol>
      </div>

      <div class="p-5 space-y-5">
        <p class="font-semibold text-navy">{t.current}</p>
        <div class="border border-line rounded-sm">
          <p class="px-4 py-2 border-b border-line font-mono text-[11px] uppercase tracking-[0.08em] text-gray-500">{t.draft}</p>
          <div class="px-4 py-3 space-y-2 text-[13px] text-gray-700 leading-relaxed">
            {t.lines.map((line, i) => <p data-step style={`--d:${450 + i * 250}`}>{line}</p>)}
          </div>
        </div>
        <div>
          <p class="font-mono text-[11px] uppercase tracking-[0.08em] text-gray-500">{t.docs}</p>
          <ul class="mt-2 border-t border-line">
            {t.files.map(([name, read], i) => (
              <li class="flex items-center justify-between gap-3 py-2.5 border-b border-line" data-step style={`--d:${900 + i * 90}`}>
                <span class="flex items-center gap-2 text-[13px] text-ink min-w-0">
                  <svg class="w-4 h-4 text-gray-500 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M7 3h7l5 5v13H7z"/><path d="M14 3v5h5"/></svg>
                  <span class="truncate">{name}</span>
                </span>
                <span class="text-xs text-gray-500 whitespace-nowrap">{read}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </AppFrame>
</div>
