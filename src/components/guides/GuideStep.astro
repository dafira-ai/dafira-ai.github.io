---
// One numbered chapter of a guide.
interface Props {
  number: number;
  title: string;
  description: string;
}

const { number, title, description } = Astro.props;
---

<section class="df-guide-step border-t border-line pt-8">
  <p class="font-mono text-xs text-primary tabular-nums">{String(number).padStart(2, '0')}</p>
  <h2 class="!mt-3">{title}</h2>
  <p class="text-gray-700">{description}</p>
  <slot />
</section>
