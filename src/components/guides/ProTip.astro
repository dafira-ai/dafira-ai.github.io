---
// Short tip inside a guide, rendered as a Callout.
import { Callout } from '../ui';
import { guideLang, GUIDE_UI } from './guides-data';

interface Props {
  tip: string;
  title?: string;
}

const { tip, title } = Astro.props;
const t = GUIDE_UI[guideLang(Astro.url.pathname)];
// Legacy tips sometimes start with an emoji: drop it.
const text = tip.replace(/^[\p{Extended_Pictographic}️\s]+/u, '');
---

<Callout tone="tip" title={title ?? t.tip} class="my-8">{text}</Callout>
