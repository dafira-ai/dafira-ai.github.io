---
// Main capabilities of document collaboration, as ruled columns.
import { Section, SectionHeader, FeatureColumns } from '../../ui';

interface Props {
  features: Array<{
    title: string;
    description: string;
    icon: string;
    benefits: string[];
  }>;
  texts: {
    title: string;
    subtitle: string;
  };
  tone?: 'white' | 'surface';
}

const { features, texts, tone = 'white' } = Astro.props;
---

<Section tone={tone} border={tone === 'surface' ? 'both' : 'none'}>
  <SectionHeader title={texts.title} lead={texts.subtitle} />
  <FeatureColumns items={features.map((f) => ({ icon: f.icon, title: f.title, text: f.description, items: f.benefits }))} />
</Section>
