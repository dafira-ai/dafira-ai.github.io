---
// Security of shared documents, as a cell grid.
import { Section, SectionHeader, CellGrid, Icon, Button } from '../../ui';

interface Props {
  texts?: {
    title: string;
    description: string;
    features: Array<{
      icon: string;
      title: string;
      description: string;
    }>;
  };
  link?: { text: string; href: string };
  tone?: 'white' | 'surface';
}

const { link, tone = 'white', texts = {
  title: "Security of the board pack",
  description: "Documents are protected by the same security measures as the rest of the platform.",
  features: [
    { icon: "lock", title: "Encryption", description: "Documents, changes and comments are encrypted in transit and at rest." },
    { icon: "users", title: "Role-based access", description: "Permissions set who can view, annotate and comment on each document." },
    { icon: "clipboard", title: "Audit trail", description: "A complete history of the activity on each document." }
  ]
}} = Astro.props;
---

<Section tone={tone} border={tone === 'surface' ? 'both' : 'none'}>
  <SectionHeader title={texts.title} lead={texts.description} />
  <CellGrid columns={3}>
    {texts.features.map((feature) => (
      <div class="bg-white p-6 lg:p-8">
        <Icon name={feature.icon} class="w-6 h-6 text-navy" />
        <h3 class="mt-5 text-lg font-semibold text-navy">{feature.title}</h3>
        <p class="mt-2 text-[15px] text-gray-600 leading-relaxed">{feature.description}</p>
      </div>
    ))}
  </CellGrid>
  {link && <div class="mt-8"><Button variant="link" href={link.href}>{link.text}</Button></div>}
</Section>
