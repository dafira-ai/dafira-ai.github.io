---
// HTML mock-up of the document viewer: toolbar, document with a highlighted passage, comments and version history. Plays once.
import { Icon } from '../../ui';

interface Author {
  name: string;
  initials: string;
  /** @deprecated no longer used */
  color?: string;
}

interface Props {
  comments?: Array<{
    id: string;
    author: Author;
    content: string;
    timestamp: string;
    replies?: Array<{
      id: string;
      author: Author;
      content: string;
      timestamp: string;
    }>;
  }>;
  versions?: Array<{
    id: string;
    author: {
      name: string;
      initials: string;
    };
    timestamp: string;
    changes: string[];
  }>;
  tools?: Array<{
    icon: string;
    label: string;
  }>;
  texts?: {
    version: string;
    share: string;
    /** @deprecated */
    shareThrough?: string;
    /** @deprecated */
    shareOptions?: string[];
    title: string;
    date: string;
    strategicTitle: string;
    strategicContent: string;
    strategicItems: string[];
    financialTitle: string;
    financialContent: string;
    highlightedText: string;
    comparedText: string;
    comments: {
      title: string;
      /** @deprecated */
      filterButton?: string;
      addCommentPlaceholder: string;
      /** @deprecated */
      submitButton?: string;
      userInitials: string;
    };
    versionsTitle?: string;
  };
  shadow?: boolean;
}

const {
  shadow = false,
  comments = [
    {
      id: '1',
      author: { name: 'John Doe', initials: 'JD' },
      content: 'Should we add more detail about the Q2 targets?',
      timestamp: '2 min ago',
      replies: [
        {
          id: '2',
          author: { name: 'Alice Smith', initials: 'AS' },
          content: "Good point, I'll update that section.",
          timestamp: '1 min ago'
        }
      ]
    }
  ],
  versions = [
    {
      id: 'v1.2',
      author: { name: 'Alice Smith', initials: 'AS' },
      timestamp: '10 min ago',
      changes: ['Updated Q2 targets', 'Added financial summary']
    },
    {
      id: 'v1.1',
      author: { name: 'John Doe', initials: 'JD' },
      timestamp: '1 hour ago',
      changes: ['Initial draft']
    }
  ],
  tools = [
    { icon: "pen", label: "Annotate" },
    { icon: "chat", label: "Comment" },
    { icon: "search", label: "Search" },
    { icon: "refresh", label: "Version history" }
  ],
  texts = {
    version: "Version 1.2",
    share: "Share",
    title: "Board Meeting Minutes",
    date: "15 March",
    strategicTitle: "Strategic initiatives",
    strategicContent: "The board discussed the company's strategic initiatives for the coming quarter, focusing on three areas:",
    strategicItems: [
      "Expansion into new markets",
      "Product development roadmap",
      "Operational efficiency"
    ],
    financialTitle: "Financial performance",
    financialContent: "Results for the quarter were in line with the budget, with a",
    highlightedText: "higher operating margin",
    comparedText: "than in the previous quarter.",
    comments: {
      title: "Comments",
      addCommentPlaceholder: "Add a comment",
      userInitials: "ME"
    },
    versionsTitle: "Versions"
  }
} = Astro.props;
---

<div class:list={['bg-white border border-line rounded-md text-sm overflow-hidden', shadow && 'shadow-2xl']} aria-hidden="true" data-play>
  <div class="flex items-center justify-between gap-4 px-4 py-2.5 border-b border-line">
    <div class="flex items-center gap-1">
      {tools.map((tool, i) => (
        <span class:list={['inline-flex items-center gap-1.5 px-2 py-1.5 rounded-sm text-xs', i === 0 ? 'bg-surface text-navy' : 'text-gray-600']}>
          <Icon name={tool.icon} class="w-4 h-4" />
          <span class="hidden sm:inline">{tool.label}</span>
        </span>
      ))}
    </div>
    <div class="flex items-center gap-3 text-xs">
      <span class="font-mono text-gray-500 whitespace-nowrap">{texts.version}</span>
      <span class="hidden sm:inline px-2.5 py-1 border border-line rounded-sm text-navy">{texts.share}</span>
    </div>
  </div>

  <div class="grid md:grid-cols-[1fr_minmax(0,17rem)]">
    <div class="p-6 lg:p-8">
      <p class="text-lg font-semibold text-navy">{texts.title}</p>
      <p class="mt-1 font-mono text-xs text-gray-500">{texts.date}</p>

      <p class="mt-6 font-semibold text-ink">{texts.strategicTitle}</p>
      <p class="mt-2 text-gray-700 leading-relaxed">{texts.strategicContent}</p>
      <ul class="mt-3 space-y-1.5">
        {texts.strategicItems.map((item) => (
          <li class="flex items-start gap-2.5 text-gray-700">
            <span class="mt-2.5 w-1.5 h-px bg-primary shrink-0"></span>{item}
          </li>
        ))}
      </ul>

      <p class="mt-6 font-semibold text-ink">{texts.financialTitle}</p>
      <p class="mt-2 text-gray-700 leading-relaxed">
        {texts.financialContent}{' '}
        <mark class="bg-amber-50 text-ink border-b-2 border-amber-500 px-0.5" data-step="fade" style="--d:300">{texts.highlightedText}</mark>{' '}
        {texts.comparedText}
      </p>
    </div>

    <div class="bg-surface border-t md:border-t-0 md:border-s border-line">
      <p class="px-4 py-2.5 border-b border-line font-mono text-[11px] uppercase tracking-[0.08em] text-gray-500">{texts.comments.title}</p>
      <div class="p-4 space-y-3">
        {comments.map((comment, i) => (
          <div data-step style={`--d:${500 + i * 200}`}>
            <div class="bg-white border border-line rounded-sm p-3">
              <div class="flex items-center justify-between gap-2">
                <span class="flex items-center gap-2">
                  <span class="w-6 h-6 rounded-full bg-navy text-white text-[10px] grid place-items-center">{comment.author.initials}</span>
                  <span class="text-xs font-medium text-navy">{comment.author.name}</span>
                </span>
                <span class="text-[11px] text-gray-500">{comment.timestamp}</span>
              </div>
              <p class="mt-2 text-[13px] text-gray-700">{comment.content}</p>
            </div>
            {comment.replies?.map((reply, j) => (
              <div class="ms-5 mt-2 bg-white border border-line rounded-sm p-3" data-step style={`--d:${750 + i * 200 + j * 150}`}>
                <div class="flex items-center justify-between gap-2">
                  <span class="flex items-center gap-2">
                    <span class="w-6 h-6 rounded-full bg-primary text-white text-[10px] grid place-items-center">{reply.author.initials}</span>
                    <span class="text-xs font-medium text-navy">{reply.author.name}</span>
                  </span>
                  <span class="text-[11px] text-gray-500">{reply.timestamp}</span>
                </div>
                <p class="mt-2 text-[13px] text-gray-700">{reply.content}</p>
              </div>
            ))}
          </div>
        ))}
        <div class="flex items-center gap-2">
          <span class="w-6 h-6 rounded-full border border-line bg-white text-[10px] text-gray-600 grid place-items-center">{texts.comments.userInitials}</span>
          <span class="flex-1 border border-line bg-white rounded-sm px-3 py-2 text-xs text-gray-400">{texts.comments.addCommentPlaceholder}</span>
        </div>
      </div>

      <p class="px-4 py-2.5 border-y border-line font-mono text-[11px] uppercase tracking-[0.08em] text-gray-500">{texts.versionsTitle ?? 'Versions'}</p>
      <ul class="p-4 space-y-3">
        {versions.map((version, i) => (
          <li class:list={['border-s-2 ps-3', i === 0 ? 'border-primary' : 'border-line']}>
            <div class="flex items-baseline justify-between gap-2">
              <span class="font-mono text-xs text-navy">{version.id}</span>
              <span class="text-[11px] text-gray-500">{version.timestamp}</span>
            </div>
            <p class="text-xs text-gray-600">{version.author.name} · {version.changes.join(', ')}</p>
          </li>
        ))}
      </ul>
    </div>
  </div>
</div>
