---
// Annotations and comments on a page of the board pack: text and list on one side, a small static mock-up on the other.
import { Section, SectionHeader, Icon } from '../../ui';

interface Props {
  texts?: {
    title: string;
    description: string;
    features: Array<{
      text: string;
      icon: string;
    }>;
    comments: Array<{
      author: {
        name: string;
        initials: string;
      };
      content: string;
    }>;
    /** eyebrow above the title */
    eyebrow?: string;
    /** sample lines of the annotated document */
    documentLines?: string[];
  };
  tone?: 'white' | 'surface';
}

const { tone = 'surface', texts = {
  eyebrow: "Annotations",
  title: "Annotations and comments on the page",
  description: "Directors highlight and annotate the documents they read. Comments shared with the board appear next to the passage they refer to, so the discussion stays attached to the text.",
  features: [
    { text: "Comments visible to all participants of the meeting", icon: "users" },
    { text: "Threaded replies", icon: "chat" },
    { text: "Complete annotation history", icon: "clipboard" }
  ],
  comments: [
    { author: { name: "John Doe", initials: "JD" }, content: "Good point here." },
    { author: { name: "Alice Smith", initials: "AS" }, content: "Should we add more context?" }
  ],
  documentLines: [
    "The committee reviewed the internal audit plan for the year.",
    "Two findings from the previous audit remain open.",
    "Management will present a remediation plan at the next meeting."
  ]
}} = Astro.props;

const lines = texts.documentLines ?? [];
---

<Section tone={tone} border={tone === 'surface' ? 'both' : 'none'}>
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-10 items-center">
    <div class="lg:col-span-5">
      <SectionHeader layout="stacked" eyebrow={texts.eyebrow} title={texts.title} lead={texts.description} class="mb-8" />
      <ul class="border-t border-line">
        {texts.features.map((feature) => (
          <li class="flex items-center gap-4 py-4 border-b border-line">
            <Icon name={feature.icon} class="w-5 h-5 text-navy" />
            <span class="text-gray-700">{feature.text}</span>
          </li>
        ))}
      </ul>
    </div>

    <div class="lg:col-span-6 lg:col-start-7" aria-hidden="true" data-play>
      <div class="bg-white border border-line rounded-md p-6 lg:p-8 text-sm">
        <div class="space-y-4">
          {lines.map((line, i) => (
            <p class="text-gray-700 leading-relaxed"><span class:list={[i === 1 && 'bg-amber-50 border-b-2 border-amber-500']}>{line}</span></p>
          ))}
        </div>
        <div class="mt-8 grid sm:grid-cols-2 gap-3">
          {texts.comments.map((comment, i) => (
            <div class="border border-line rounded-sm p-3 bg-surface" data-step style={`--d:${200 + i * 200}`}>
              <div class="flex items-center gap-2">
                <span class:list={['w-6 h-6 rounded-full text-white text-[10px] grid place-items-center', i === 0 ? 'bg-navy' : 'bg-primary']}>{comment.author.initials}</span>
                <span class="text-xs font-medium text-navy">{comment.author.name}</span>
              </div>
              <p class="mt-2 text-[13px] text-gray-700">{comment.content}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</Section>
