---
// HTML mock-up of an agenda in the agenda builder: items with type, duration, sub-items and documents. Plays once.
import AgendaItem from './AgendaItem.astro';
import { type AgendaItem as AgendaItemType } from '../types';

interface Props {
  items: AgendaItemType[];
  totalDuration: number;
  texts?: {
    title: string;
    totalDurationLabel: string;
    addItemButton: string;
    itemTexts: {
      documentsLabel: string;
      /** @deprecated no longer shown */
      addDocumentButton?: string;
      subItemsLabel: string;
      typeLabels?: Partial<Record<AgendaItemType['type'], string>>;
    };
  };
  shadow?: boolean;
}

const { items, totalDuration, shadow = false, texts = {
  title: "Board meeting agenda",
  totalDurationLabel: "Total duration",
  addItemButton: "Add agenda item",
  itemTexts: {
    documentsLabel: "Documents",
    subItemsLabel: "Sub-items"
  }
}} = Astro.props;
---

<div class:list={['bg-white border border-line rounded-md text-sm overflow-hidden', shadow && 'shadow-2xl']} aria-hidden="true" data-play>
  <div class="flex items-baseline justify-between gap-4 px-5 py-3.5 border-b border-line">
    <span class="font-semibold text-navy">{texts.title}</span>
    <span class="font-mono text-xs text-gray-500 whitespace-nowrap">{texts.totalDurationLabel} · {totalDuration} min</span>
  </div>

  <ol>
    {items.map((item, index) => (
      <AgendaItem {...item} index={index} texts={texts.itemTexts} animationDelay={100 + index * 160} />
    ))}
  </ol>

  <div class="px-5 py-3 bg-surface border-t border-line">
    <span class="inline-flex items-center gap-2 text-[13px] text-primary">
      <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M12 5v14M5 12h14" /></svg>
      {texts.addItemButton}
    </span>
  </div>
</div>
