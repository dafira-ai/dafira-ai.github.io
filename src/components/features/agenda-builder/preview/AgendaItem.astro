---
// One agenda item of the agenda mock-up.
import type { AgendaItemType } from '../types';

interface Props {
  id?: string;
  title: string;
  type: AgendaItemType;
  duration: number;
  documents?: Array<{ name: string; type: string; }>;
  subItems?: Array<{ title: string; duration: number; }>;
  index?: number;
  /** delay (ms) of the play-once entrance */
  animationDelay?: number;
  texts?: {
    documentsLabel: string;
    /** @deprecated no longer shown */
    addDocumentButton?: string;
    subItemsLabel: string;
    typeLabels?: Partial<Record<AgendaItemType, string>>;
  };
}

const {
  title,
  type,
  duration,
  documents = [],
  subItems = [],
  index = 0,
  animationDelay = 0,
  texts = {
    documentsLabel: "Documents",
    subItemsLabel: "Sub-items"
  }
} = Astro.props;

const defaultLabels: Record<AgendaItemType, string> = {
  discussion: 'Discussion',
  decision: 'Decision',
  information: 'Information',
  presentation: 'Presentation',
  voting: 'Vote',
  workshop: 'Workshop',
  break: 'Break',
};
const label = texts.typeLabels?.[type] ?? defaultLabels[type] ?? type;
const tone = type === 'decision' || type === 'voting' ? 'bg-amber-50 text-amber-800' : type === 'information' ? 'bg-gray-100 text-gray-700' : 'bg-blue-50 text-primary';
---

<li class="px-5 py-4 border-b border-line last:border-b-0" data-step style={`--d:${animationDelay}`}>
  <div class="flex items-start justify-between gap-4">
    <div class="flex items-baseline gap-3 min-w-0">
      <span class="font-mono text-xs text-gray-500 tabular-nums">{index + 1}</span>
      <span class="font-medium text-ink">{title}</span>
    </div>
    <div class="flex items-center gap-2 shrink-0">
      <span class={`text-[11px] font-medium px-2 py-0.5 rounded-sm ${tone}`}>{label}</span>
      <span class="font-mono text-xs text-gray-500 tabular-nums">{duration} min</span>
    </div>
  </div>

  {subItems.length > 0 && (
    <ul class="mt-3 ms-6 border-s border-line" aria-label={texts.subItemsLabel}>
      {subItems.map((item, i) => (
        <li class="flex items-baseline justify-between gap-3 ps-3 py-1">
          <span class="text-[13px] text-gray-700"><span class="font-mono text-xs text-gray-500 me-2">{index + 1}.{i + 1}</span>{item.title}</span>
          <span class="font-mono text-xs text-gray-500 tabular-nums">{item.duration} min</span>
        </li>
      ))}
    </ul>
  )}

  {documents.length > 0 && (
    <div class="mt-3 ms-6 flex flex-wrap gap-2" aria-label={texts.documentsLabel}>
      {documents.map((doc) => (
        <span class="inline-flex items-center gap-1.5 px-2 py-1 border border-line rounded-sm text-xs text-gray-700">
          <svg class="w-3.5 h-3.5 text-gray-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M7 3h7l5 5v13H7z"/><path d="M14 3v5h5"/></svg>
          {doc.name}
        </span>
      ))}
    </div>
  )}
</li>
