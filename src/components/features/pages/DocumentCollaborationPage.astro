      alt: 'Documentbibliotheek in Dafira, gegroepeerd per vergadering',
    },
    security: {
      title: 'Beveiliging van het bestuursdossier',
      description: 'Documenten genieten dezelfde beveiligingsmaatregelen als de rest van het platform.',
      features: [
        { icon: 'lock', title: 'End-to-end versleuteling', description: 'Documenten, wijzigingen en opmerkingen zijn versleuteld.' },
        { icon: 'users', title: 'Toegang per rol', description: 'Rechten bepalen wie elk document kan bekijken en bewerken.' },
        { icon: 'clipboard', title: 'Audittrail', description: 'Een volledige geschiedenis van de activiteit op elk document.' },
