        ],
        tools: [{ icon: 'pen', label: 'Annoter' }, { icon: 'chat', label: 'Commenter' }, { icon: 'search', label: 'Rechercher' }, { icon: 'refresh', label: 'Versions' }],
        texts: {
          version: 'Version 1.2', share: 'Partager', title: "Procès-verbal du conseil d'administration", date: '15 mars',
          strategicTitle: 'Initiatives stratégiques',
          strategicContent: 'Le conseil a discuté des initiatives stratégiques pour le trimestre à venir, autour de trois axes :',
          strategicItems: ['Expansion sur de nouveaux marchés', 'Feuille de route produit', 'Efficacité opérationnelle'],
          financialTitle: 'Performance financière',
          financialContent: 'Les résultats du trimestre sont conformes au budget, avec une',
          highlightedText: 'marge opérationnelle plus élevée', comparedText: "qu'au trimestre précédent.",
          comments: { title: 'Commentaires', addCommentPlaceholder: 'Ajouter un commentaire', userInitials: 'MOI' },
