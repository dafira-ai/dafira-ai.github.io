        { title: 'Commentaires partagés', description: 'Des commentaires partagés avec le conseil, à côté du passage concerné.', icon: 'chat', benefits: ['Discussion de groupe sur le document', 'Réponses en fil', 'Texte enrichi', 'Alertes de nouveaux commentaires'] },
        { title: 'Historique des versions', description: 'Chaque modification est enregistrée, avec son auteur et sa date.', icon: 'refresh', benefits: ['Suivi des changements', 'Comparaison des versions', 'Retour aux versions précédentes', 'Identification des auteurs'] },
      ],
    },
    viewer: {
      eyebrow: 'Lecteur de documents',
      title: 'Commentaires et versions à côté du document',
      lead: 'Le document, la discussion qui l’accompagne et son historique sur un seul écran.',
      data: {
        comments: [
          { id: '1', author: { name: 'Jean Dupont', initials: 'JD' }, content: 'Devrions-nous ajouter plus de détails sur les objectifs du T2 ?', timestamp: 'il y a 2 min', replies: [{ id: '2', author: { name: 'Alice Martin', initials: 'AM' }, content: 'Bonne remarque, je mets cette partie à jour.', timestamp: 'il y a 1 min' }] },
        ],
        versions: [
          { id: 'v1.2', author: { name: 'Alice Martin', initials: 'AM' }, timestamp: 'il y a 10 min', changes: ['Mise à jour des objectifs T2', 'Ajout du résumé financier'] },
