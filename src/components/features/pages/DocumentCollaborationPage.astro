        ],
        tools: [{ icon: 'pen', label: 'Annotate' }, { icon: 'chat', label: 'Comment' }, { icon: 'search', label: 'Search' }, { icon: 'refresh', label: 'Versions' }],
        texts: {
          version: 'Version 1.2', share: 'Share', title: 'Board Meeting Minutes', date: '15 March',
          strategicTitle: 'Strategic initiatives',
          strategicContent: "The board discussed the company's strategic initiatives for the coming quarter, focusing on three areas:",
          strategicItems: ['Expansion into new markets', 'Product development roadmap', 'Operational efficiency'],
          financialTitle: 'Financial performance',
          financialContent: 'Results for the quarter were in line with the budget, with a',
          highlightedText: 'higher operating margin', comparedText: 'than in the previous quarter.',
          comments: { title: 'Comments', addCommentPlaceholder: 'Add a comment', userInitials: 'ME' },
          versionsTitle: 'Versions',
        },
      },
    },
    annotation: {
      eyebrow: 'Annotations',
      title: 'Annotations and comments on the page',
      description: 'Directors highlight and annotate the documents they read. Comments shared with the board appear next to the passage they refer to, so the discussion stays attached to the text.',
      features: [
        { text: 'Comments visible to all participants', icon: 'users' },
        { text: 'Rich text formatting and threaded replies', icon: 'chat' },
        { text: 'Complete annotation history', icon: 'clipboard' },
      ],
      comments: [
        { author: { name: 'John Doe', initials: 'JD' }, content: 'Good point here.' },
        { author: { name: 'Alice Smith', initials: 'AS' }, content: 'Should we add more context?' },
      ],
      documentLines: ['The committee reviewed the internal audit plan for the year.', 'Two findings from the previous audit remain open.', 'Management will present a remediation plan at the next meeting.'],
    },
    library: {
      eyebrow: 'Document library',
      title: 'Every document filed with its meeting',
      text: 'Board packs, minutes and appendices are grouped by meeting and by type. Directors find last year’s papers as easily as this month’s.',
      items: ['Documents grouped by meeting', 'Filters by document type and date', 'Search by title', 'Documents to sign in a separate tab'],
      alt: 'Document library in Dafira, grouped by meeting',
    },
    security: {
      title: 'Security of the board pack',
      description: 'Documents are protected by the same security measures as the rest of the platform.',
      features: [
        { icon: 'lock', title: 'End-to-end encryption', description: 'Documents, changes and comments are encrypted.' },
        { icon: 'users', title: 'Role-based access', description: 'Permissions set who can view and edit each document.' },
        { icon: 'clipboard', title: 'Audit trail', description: 'A complete history of the activity on each document.' },
      ],
    },
  },
  fr: {
    eyebrow: 'Collaboration documentaire',
    title: 'Lire, annoter et discuter le dossier du conseil au même endroit',
    lead: 'Les administrateurs préparent la séance avec des annotations privées, échangent par des commentaires visibles du conseil et lisent toujours la dernière version de chaque document.',
    heroAlt: "Lecteur du dossier du conseil dans Dafira, avec l'ordre du jour sur le côté et des annotations sur le procès-verbal",
    features: {
