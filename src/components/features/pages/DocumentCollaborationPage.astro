---

<PageHero eyebrow={copy.eyebrow} title={copy.title} lead={copy.lead}>
  <Fragment slot="actions">
    <Button href={localizePath(lang, '/request-demo')}>{c.demo}</Button>
    <Button variant="secondary" href={localizePath(lang, '/contact')}>{c.contact}</Button>
  </Fragment>
  <Screenshot slot="aside" src="/onboarding-boardpack.png" alt={copy.heroAlt} eager />
</PageHero>

<CollaborationFeatures features={copy.features.items} texts={{ title: copy.features.title, subtitle: copy.features.subtitle }} />

<Section tone="surface" border="both">
  <SectionHeader eyebrow={copy.viewer.eyebrow} title={copy.viewer.title} lead={copy.viewer.lead} />
  <DocumentViewer {...copy.viewer.data} />
</Section>

<LiveAnnotation texts={copy.annotation} tone="white" />

<Section tone="surface" border="both">
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-10 items-center">
    <div class="lg:col-span-4">
      <SectionHeader layout="stacked" eyebrow={copy.library.eyebrow} title={copy.library.title} lead={copy.library.text} class="mb-8" />
      <FeatureList items={copy.library.items} />
    </div>
    <div class="lg:col-span-7 lg:col-start-6">
      <Screenshot src="/onboarding-document-list.png" alt={copy.library.alt} />
    </div>
  </div>
</Section>

<SecurityFeatures texts={copy.security} link={{ text: c.security, href: localizePath(lang, '/security') }} />

<RelatedFeatures current="document-collaboration" tone="surface" />

<FeatureCTA />
