      features: [
        { text: 'Opmerkingen zichtbaar voor alle deelnemers', icon: 'users' },
        { text: 'Tekstopmaak en discussielijnen', icon: 'chat' },
        { text: 'Volledige annotatiegeschiedenis', icon: 'clipboard' },
      ],
      comments: [
        { author: { name: 'Jan de Vries', initials: 'JV' }, content: 'Goed punt.' },
        { author: { name: 'Anna Bakker', initials: 'AB' }, content: 'Moeten we meer context toevoegen?' },
      ],
      documentLines: ['Het comité besprak het interne auditplan voor het jaar.', 'Twee bevindingen uit de vorige audit staan nog open.', 'Het management legt op de volgende vergadering een herstelplan voor.'],
    },
    library: {
      eyebrow: 'Documentbibliotheek',
      title: 'Elk document bewaard bij zijn vergadering',
      text: 'Bestuursdossiers, notulen en bijlagen zijn gegroepeerd per vergadering en per type. Bestuurders vinden de stukken van vorig jaar even snel terug als die van deze maand.',
