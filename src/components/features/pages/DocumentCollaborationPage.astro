---
// /features/document-collaboration (EN / FR / NL)
import { PageHero, Section, SectionHeader, Button, Screenshot, FeatureList } from '../../ui';
import DocumentViewer from '../document-collaboration/DocumentViewer.astro';
import CollaborationFeatures from '../document-collaboration/CollaborationFeatures.astro';
import LiveAnnotation from '../document-collaboration/LiveAnnotation.astro';
import SecurityFeatures from '../document-collaboration/SecurityFeatures.astro';
import RelatedFeatures from '../RelatedFeatures.astro';
import FeatureCTA from '../FeatureCTA.astro';
import { langFromPath, localizePath } from '../../../i18n/routes';
import { common, featureLang } from '../common';

const lang = featureLang(langFromPath(Astro.url.pathname));
const c = common[lang];

const copy = {
