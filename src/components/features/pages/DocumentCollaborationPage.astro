        { text: 'Commentaires visibles de tous les participants', icon: 'users' },
        { text: 'Texte enrichi et réponses en fil', icon: 'chat' },
        { text: 'Historique complet des annotations', icon: 'clipboard' },
      ],
      comments: [
        { author: { name: 'Jean Dupont', initials: 'JD' }, content: 'Bonne remarque.' },
        { author: { name: 'Alice Martin', initials: 'AM' }, content: 'Devrions-nous ajouter du contexte ?' },
      ],
      documentLines: ["Le comité a examiné le plan d'audit interne de l'année.", "Deux constats de l'audit précédent restent ouverts.", 'La direction présentera un plan de remédiation à la prochaine séance.'],
    },
    library: {
      eyebrow: 'Bibliothèque documentaire',
      title: 'Chaque document classé avec sa séance',
      text: "Dossiers du conseil, procès-verbaux et annexes sont regroupés par séance et par type. Les administrateurs retrouvent les documents de l'an dernier aussi facilement que ceux du mois.",
      items: ['Documents regroupés par séance', 'Filtres par type de document et par date', 'Recherche par titre', 'Documents à signer dans un onglet dédié'],
      alt: 'Bibliothèque documentaire de Dafira, classée par séance',
    },
    security: {
      title: 'Sécurité du dossier du conseil',
      description: 'Les documents bénéficient des mêmes mesures de sécurité que le reste de la plateforme.',
      features: [
        { icon: 'lock', title: 'Chiffrement de bout en bout', description: 'Les documents, les modifications et les commentaires sont chiffrés.' },
        { icon: 'users', title: 'Accès par rôle', description: 'Les droits définissent qui peut consulter et modifier chaque document.' },
        { icon: 'clipboard', title: "Piste d'audit", description: "L'historique complet de l'activité sur chaque document." },
      ],
    },
  },
  nl: {
    eyebrow: 'Samenwerken aan documenten',
    title: 'Het bestuursdossier lezen, annoteren en bespreken op één plek',
