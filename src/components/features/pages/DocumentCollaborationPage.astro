    heroAlt: 'Viewer voor het bestuursdossier in Dafira, met de agenda aan de zijkant en annotaties op de notulen',
    features: {
      title: 'Drie manieren om aan een document te werken',
      subtitle: 'Persoonlijke voorbereiding, gedeeld overleg en een duidelijke geschiedenis van elke wijziging.',
      items: [
        { title: 'Persoonlijke notities', description: 'Privéaantekeningen en markeringen, alleen zichtbaar voor u, om de vergadering voor te bereiden.', icon: 'pen', benefits: ['Vertrouwelijke notities', 'Persoonlijke markeringen', 'Geheugensteun', 'Notitiegeschiedenis'] },
        { title: 'Gedeelde opmerkingen', description: 'Opmerkingen gedeeld met het bestuur, naast de passage waarop ze betrekking hebben.', icon: 'chat', benefits: ['Groepsoverleg op het document', 'Antwoorden in discussielijnen', 'Uitgebreide tekstopmaak', 'Meldingen bij nieuwe reacties'] },
        { title: 'Versiebeheer', description: 'Elke wijziging wordt vastgelegd, met auteur en datum.', icon: 'refresh', benefits: ['Wijzigingen volgen', 'Versies vergelijken', 'Eerdere versies herstellen', 'Auteur van elke wijziging'] },
      ],
    },
    viewer: {
      eyebrow: 'Documentviewer',
      title: 'Opmerkingen en versies naast het document',
      lead: 'Het document, het overleg erover en de geschiedenis op één scherm.',
      data: {
        comments: [
          { id: '1', author: { name: 'Jan de Vries', initials: 'JV' }, content: 'Moeten we meer details toevoegen over de Q2-doelstellingen?', timestamp: '2 min geleden', replies: [{ id: '2', author: { name: 'Anna Bakker', initials: 'AB' }, content: 'Goed punt, ik werk dat deel bij.', timestamp: '1 min geleden' }] },
        ],
        versions: [
          { id: 'v1.2', author: { name: 'Anna Bakker', initials: 'AB' }, timestamp: '10 min geleden', changes: ['Q2-doelstellingen bijgewerkt', 'Financieel overzicht toegevoegd'] },
          { id: 'v1.1', author: { name: 'Jan de Vries', initials: 'JV' }, timestamp: '1 uur geleden', changes: ['Eerste versie'] },
