---
// One chapter of the /features overview: heading, ruled list of features (with links to their pages) and a product vignette.
import { Section, SectionHeader, Button, Icon, Screenshot } from '../ui';
import MeetingDemo from '../demos/MeetingDemo.astro';
import InsightsDemo from '../demos/InsightsDemo.astro';
import GovernanceDemo from '../demos/GovernanceDemo.astro';
import { langFromPath } from '../../i18n/routes';
import { common, featureLang } from './common';

interface Props {
  title: string;
  /** shown as the eyebrow */
  subtitle: string;
  description: string;
  /** @deprecated no longer rendered */
  gradient?: string;
  features: Array<{
    title: string;
    description: string;
    icon: string;
    /** @deprecated no longer rendered */
    highlight?: boolean;
    link?: string;
  }>;
  image: string;
  imageAlt: string;
  reversed?: boolean;
  demoType?: 'meeting' | 'insights' | 'governance';
  tone?: 'white' | 'surface';
  id?: string;
}

const { title, subtitle, description, features, image, imageAlt, reversed = false, demoType, tone = 'white', id } = Astro.props;
const t = common[featureLang(langFromPath(Astro.url.pathname))];
---

<Section id={id} tone={tone} border={tone === 'surface' ? 'both' : 'none'}>
  <SectionHeader eyebrow={subtitle} title={title} lead={description} />

  <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-10 items-start">
    <ul class:list={['lg:col-span-5', reversed && 'lg:col-start-8 lg:row-start-1']} data-play>
      {features.map((feature, i) => (
        <li class="border-t border-line py-6 flex gap-4" data-step style={`--d:${i * 70}`}>
          <Icon name={feature.icon} class="w-5 h-5 mt-0.5 text-navy" />
          <div>
            <h3 class="text-lg font-semibold text-navy">{feature.title}</h3>
            <p class="mt-1.5 text-[15px] text-gray-600 leading-relaxed">{feature.description}</p>
            {feature.link && <Button variant="link" href={feature.link} class="mt-3" aria-label={`${t.readMore}: ${feature.title}`}>{t.readMore}</Button>}
          </div>
        </li>
      ))}
    </ul>

    <div class:list={['lg:col-span-7', reversed ? 'lg:col-start-1 lg:row-start-1 lg:pe-6' : 'lg:col-start-6 lg:ps-6']}>
      {demoType === 'meeting' && <MeetingDemo />}
      {demoType === 'insights' && <InsightsDemo />}
      {demoType === 'governance' && <GovernanceDemo />}
      {!demoType && <Screenshot src={image} alt={imageAlt} />}
    </div>
  </div>
</Section>
