---
import Section from '../ui/Section.astro';
import SectionHeader from '../ui/SectionHeader.astro';
import FeatureList from '../ui/FeatureList.astro';
import Button from '../ui/Button.astro';
import DocumentFlow from '../animations/DocumentFlow.astro';
import TaskTimeline, { type TaskTimelineProps } from '../animations/TaskTimeline.astro';
import FeatureHighlight from '../animations/FeatureHighlight.astro';

interface Props {
  texts?: {
    badge: string;
    title: string;
    subtitle: string;
    keyBenefits: string;
  };
  outcomes?: {
    title: string;
    description: string;
    component: any;
    componentProps?: any;
    /** @deprecated statistics are no longer displayed */
    stats?: {
      value: string;
      label: string;
    }[];
    benefits: string[];
    link?: {
      text: string;
      url: string;
    }
  }[];
}

const {
  texts = {
    badge: "How it works",
    title: "Built around how boards actually work",
    subtitle: "Documents, decisions and compliance live in one place, with access set by role and a record of every change.",
    keyBenefits: "Key Benefits:"
  },
  outcomes= [
    {
      title: "Board packs, assembled once",
      description:
        "Agenda, reports and supporting papers go into one board pack. Directors get it on any device, with access set by their role.",
      component: DocumentFlow,
      benefits: [
        "One source for every board document",
        "Version history",
        "Access rights by role",
        "Private annotations",
      ],
    },
    {
      title: "Ask the board papers",
      description:
        "The AI assistant answers questions about the board pack and summarises long documents, so directors arrive prepared.",
      component: TaskTimeline,
      benefits: [
        "Questions on the board pack",
        "Summaries of long documents",
        "AI minute builder",
        "Secure board chat",
      ],
      link: {
        text: "About the AI assistant",
        url: "/features/ai-assistant",
      },
    },
    {
      title: "Decisions that are recorded",
      description:
        "Action items are followed up after the meeting and the minutes are signed electronically, with a full audit trail.",
      component: FeatureHighlight,
      benefits: [
        "Action item follow-up",
        "Electronic signature",
        "Access rights by role",
        "Audit trail",
      ],
    },
  ],
} = Astro.props;
---

<Section tone="surface" border="both">
  <SectionHeader layout="stacked" eyebrow={texts.badge} title={texts.title} lead={texts.subtitle} class="!mb-16" />
  <div class="space-y-20 lg:space-y-28">
    {outcomes.map((outcome, index) => (
      <div class="grid lg:grid-cols-12 gap-10 lg:gap-16 items-center">
        <div class:list={["lg:col-span-5", index % 2 === 1 && "lg:order-2"]} data-play>
          <h3 class="text-2xl font-semibold text-navy" data-step>{outcome.title}</h3>
          <p class="mt-4 text-gray-600 leading-relaxed" data-step style="--d:80">{outcome.description}</p>
          <FeatureList items={outcome.benefits} columns={2} class="mt-8 border-t border-line pt-6" />
          {outcome.link && <Button variant="link" href={outcome.link.url} class="mt-8">{outcome.link.text}</Button>}
        </div>
        <div class:list={["lg:col-span-7", index % 2 === 1 && "lg:order-1"]}>
          <div class="relative bg-white border border-line rounded-md p-4 sm:p-8 min-h-[400px] flex items-center">
            <outcome.component {...outcome.componentProps} />
          </div>
        </div>
      </div>
    ))}
  </div>
</Section>
