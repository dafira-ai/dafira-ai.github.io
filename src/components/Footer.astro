---
import Logo from "./Logo.astro";
import { localizePath, type Lang } from "../i18n/routes";

const { currentLang = "en" } = Astro.props as { currentLang?: Lang };
const currentYear = new Date().getFullYear();

const t = {
  en: {
    tagline: "The board portal for organisations that take governance seriously.",
    product: "Product", company: "Company", legal: "Legal",
    features: "Features", pricing: "Pricing", security: "Security", resources: "Resources",
    about: "About", customers: "Customers", blog: "Blog", podcast: "Podcast", contact: "Contact",
    minutes: "Board minutes template", audio: "Audio setup guide",
    privacy: "Privacy policy", terms: "Terms of service", rights: "All rights reserved.",
    address: "Rue de l'Hôpital 31, 1000 Brussels, Belgium",
  },
  fr: {
    tagline: "Le portail des conseils d’administration qui prennent la gouvernance au sérieux.",
    product: "Produit", company: "Entreprise", legal: "Mentions légales",
    features: "Fonctionnalités", pricing: "Tarifs", security: "Sécurité", resources: "Ressources",
    about: "À propos", customers: "Clients", blog: "Blog", podcast: "Podcast", contact: "Contact",
    minutes: "Modèle de procès-verbal", audio: "Guide de configuration audio",
    privacy: "Politique de confidentialité", terms: "Conditions d’utilisation", rights: "Tous droits réservés.",
    address: "Rue de l'Hôpital 31, 1000 Bruxelles, Belgique",
  },
  nl: {
    tagline: "Het bestuursportaal voor organisaties die governance ernstig nemen.",
    product: "Product", company: "Bedrijf", legal: "Juridisch",
    features: "Functies", pricing: "Prijzen", security: "Beveiliging", resources: "Kennisbank",
    about: "Over ons", customers: "Klanten", blog: "Blog", podcast: "Podcast", contact: "Contact",
    minutes: "Sjabloon voor notulen", audio: "Audio-installatiegids",
    privacy: "Privacybeleid", terms: "Gebruiksvoorwaarden", rights: "Alle rechten voorbehouden.",
    address: "Gasthuisstraat 31, 1000 Brussel, België",
  },
  ar: {
    tagline: "بوابة مجالس الإدارة للمؤسسات التي تأخذ الحوكمة على محمل الجد.",
    product: "المنتج", company: "الشركة", legal: "الشؤون القانونية",
    features: "المزايا", pricing: "الأسعار", security: "الأمان", resources: "الموارد",
    about: "من نحن", customers: "العملاء", blog: "المدونة", podcast: "البودكاست", contact: "تواصل معنا",
    minutes: "نموذج محضر الاجتماع", audio: "دليل إعداد الصوت",
    privacy: "سياسة الخصوصية", terms: "شروط الخدمة", rights: "جميع الحقوق محفوظة.",
    address: "Rue de l'Hôpital 31, 1000 بروكسل، بلجيكا",
  },
}[currentLang];

const L = (p: string) => localizePath(currentLang, p);
const columns = [
  { title: t.product, links: [[t.features, L("/features")], [t.pricing, L("/pricing")], [t.security, L("/security")], [t.minutes, L("/templates/board-meeting-minutes")], [t.audio, "/templates/audio-set-up-guide"]] },
  { title: t.company, links: [[t.about, L("/about")], [t.customers, L("/testimonials")], [t.resources, L("/resources")], [t.blog, L("/blog")], [t.podcast, L("/podcast")]] },
  { title: t.legal, links: [[t.contact, L("/contact")], [t.privacy, L("/privacy")], [t.terms, L("/terms")]] },
];
---

<footer class="bg-white border-t border-line relative z-10">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-16 pb-10">
    <div class="grid grid-cols-2 md:grid-cols-12 gap-10">
      <div class="col-span-2 md:col-span-5 space-y-5">
        <Logo />
        <p class="text-gray-600 max-w-sm leading-relaxed">{t.tagline}</p>
        <a href="https://www.linkedin.com/company/govrncorp" class="inline-flex items-center gap-2 text-sm text-gray-600 hover:text-navy transition-colors">
          <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
          </svg>
          LinkedIn
        </a>
      </div>

      {columns.map((col, i) => (
        <div class:list={["md:col-span-2", i === 0 && "md:col-start-7"]}>
          <p class="font-mono text-[11px] uppercase tracking-[0.08em] text-gray-500 mb-4">{col.title}</p>
          <ul class="space-y-2.5">
            {col.links.map(([label, href]) => (
              <li><a href={href} class="text-sm text-gray-700 hover:text-navy transition-colors">{label}</a></li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div class="mt-14 pt-6 border-t border-line flex flex-col md:flex-row gap-2 md:justify-between text-xs text-gray-500">
      <p>&copy; {currentYear} Dafira. {t.rights}</p>
      <p>{t.address}</p>
    </div>
  </div>
</footer>
