---
import { Section, Button } from '../ui';
---

<Section border="top" space="md">
  <div class="grid lg:grid-cols-12 gap-8 items-end">
    <div class="lg:col-span-7">
      <h2 class="text-3xl lg:text-4xl font-semibold text-navy leading-tight">Let's make 2025 a good year for your board</h2>
      <p class="mt-4 text-lg text-gray-600 leading-relaxed max-w-xl">
        Planning changes to your board management in the new year? We are here to help you reach your governance goals.
      </p>
    </div>
    <div class="lg:col-span-5 flex flex-col sm:flex-row lg:justify-end gap-3">
      <Button href="/request-demo">Schedule a demo</Button>
      <Button href="/contact" variant="secondary">Contact us</Button>
    </div>
  </div>
</Section>
