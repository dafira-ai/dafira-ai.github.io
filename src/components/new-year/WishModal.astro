---
const predefinedWishes = [
  "Sustainable growth and global impact",
  "Innovative governance solutions",
  "Stronger networks and partnerships",
  "Inclusive and transparent development"
];
---

<div
  id="wish-modal"
  class="fixed inset-0 z-50 hidden"
  role="dialog"
  aria-modal="true"
  aria-labelledby="wish-modal-title"
>
  <div class="absolute inset-0 bg-navy/80" aria-hidden="true"></div>

  <div id="wish-modal-frame" class="absolute inset-0 flex items-center justify-center p-4">
    <div id="wish-modal-panel" class="relative w-full max-w-xl bg-white border border-line rounded-md p-6 sm:p-8">
      <button
        id="close-wish-modal"
        type="button"
        aria-label="Close"
        class="absolute top-4 end-4 p-1 text-gray-500 hover:text-navy transition-colors"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>

      <div class="mb-8 pe-8">
        <h2 id="wish-modal-title" class="text-2xl font-semibold text-navy">Make your wish for 2025</h2>
        <p class="mt-2 text-gray-600">Share your aspirations for the new year.</p>
      </div>

      <div class="space-y-6">
        <div class="space-y-1.5">
          <label for="wish" class="block text-sm font-medium text-navy">Your wish</label>
          <textarea
            id="wish"
            rows="4"
            class="block w-full rounded-md border border-line bg-white px-3 py-2.5 text-[15px] text-ink placeholder:text-gray-400 focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20 resize-none transition-colors"
            placeholder="Type your wish for 2025"
          ></textarea>
        </div>

        <fieldset>
          <legend class="block text-sm font-medium text-navy mb-3">Or choose from our suggestions</legend>
          <div class="grid sm:grid-cols-2 gap-3">
            {predefinedWishes.map(wish => (
              <button
                type="button"
                class="p-3 text-sm text-gray-700 bg-white rounded-md border border-line hover:border-navy hover:text-navy transition-colors text-start"
                data-wish={wish}
              >
                {wish}
              </button>
            ))}
          </div>
        </fieldset>

        <button
          id="submit-wish"
          class="w-full inline-flex items-center justify-center px-5 py-3 text-[15px] font-medium rounded-md bg-navy text-white hover:bg-primary transition-colors"
          type="submit"
        >
          Send my wish
        </button>
      </div>
    </div>
  </div>
</div>

<script>

  // Modal controls
  const modal = document.getElementById('wish-modal');
  const frame = document.getElementById('wish-modal-frame');
  const panel = document.getElementById('wish-modal-panel');
  const closeBtn = document.getElementById('close-wish-modal');
  const submitBtn = document.getElementById('submit-wish');
  const wishInput = document.getElementById('wish') as HTMLTextAreaElement;

  // Close modal
  const closeModal = () => modal?.classList.add('hidden');
  closeBtn?.addEventListener('click', closeModal);

  // Handle predefined wish selection
  document.querySelectorAll('[data-wish]').forEach(button => {
    button.addEventListener('click', () => {
      const wish = button.getAttribute('data-wish');
      if (wish && wishInput) wishInput.value = wish;
    });
  });

  // Handle wish submission
  submitBtn?.addEventListener('click', async () => {
    if (!wishInput?.value) return;

    // Update modal content
    if (panel) {
      panel.innerHTML = `
        <div class="text-center" role="status">
          <h3 class="text-2xl font-semibold text-navy">Your wish has been sent</h3>
          <p class="mt-3 text-gray-600 leading-relaxed">
            May 2025 bring you joy, success and everything you have wished for.
          </p>
          <button
            type="button"
            id="wish-continue"
            class="mt-8 inline-flex items-center justify-center px-5 py-3 text-[15px] font-medium rounded-md bg-navy text-white hover:bg-primary transition-colors"
          >
            Continue
          </button>
        </div>
      `;
      document.getElementById('wish-continue')?.addEventListener('click', closeModal);
    }
  });

  // Close on background click
  modal?.addEventListener('click', (e) => {
    if (e.target === modal || e.target === frame) closeModal();
  });

  // Close on escape key
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeModal();
  });
</script>
