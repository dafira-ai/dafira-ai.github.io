---
import { Section, SectionHeader } from '../ui';

interface Milestone {
  date: string;
  title: string;
  description: string;
}

const milestones: Milestone[] = [
  {
    date: "Q1 2024",
    title: "Web application launch",
    description: "Released our core web platform for modern board management"
  },
  {
    date: "Q2 2024",
    title: "Enhanced board tools",
    description: "Major improvements to documents, board packs and meeting management"
  },
  {
    date: "Q3 2024",
    title: "AI assistant beta",
    description: "Launched the beta version of our AI board management assistant"
  },
  {
    date: "Q4 2024",
    title: "New website",
    description: "Unveiled our redesigned website with an improved user experience"
  }
];
---

<Section tone="surface" border="top">
  <SectionHeader eyebrow="Retrospective" title="2024 highlights" />
  <ol class="border-t border-line" data-play>
    {milestones.map((m, i) => (
      <li class="grid md:grid-cols-12 gap-2 md:gap-6 py-6 border-b border-line" data-step style={`--d:${i * 80}`}>
        <span class="md:col-span-2 font-mono text-sm text-primary tabular-nums">{m.date}</span>
        <h3 class="md:col-span-4 text-lg font-semibold text-navy">{m.title}</h3>
        <p class="md:col-span-6 text-gray-600 leading-relaxed">{m.description}</p>
      </li>
    ))}
  </ol>
</Section>
