---
// Static hero on navy (the page uses a transparent header with the light logo).
import { Container, Eyebrow, Button } from '../ui';
---

<section class="bg-navy text-white pt-40 pb-24 lg:pt-48 lg:pb-32">
  <Container>
    <div class="max-w-3xl" data-play>
      <div data-step>
        <Eyebrow tone="inverse">Dafira · 2024 – 2025</Eyebrow>
        <h1 class="mt-6 text-5xl sm:text-6xl font-semibold leading-[1.05]">
          Happy New Year <span class="font-mono tabular-nums text-white/70">2025</span>
        </h1>
      </div>
      <p class="mt-8 text-xl text-white/70 leading-relaxed max-w-2xl" data-step style="--d:80">
        Our best wishes for a year of well-prepared meetings and sound governance.
      </p>
      <div class="mt-10" data-step style="--d:160">
        <Button id="make-wish-btn" variant="inverse" size="lg" aria-haspopup="dialog" aria-controls="wish-modal">Make a wish</Button>
      </div>
    </div>
  </Container>
</section>
