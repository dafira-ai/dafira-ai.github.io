---
import { Section, FeatureColumns } from '../ui';

const achievements = [
  {
    icon: "sparkle",
    title: "Innovation",
    text: "Launched the AI board assistant and smart document management"
  },
  {
    icon: "globe",
    title: "Impact",
    text: "Expanded across Europe"
  }
];
---

<Section>
  <div class="grid lg:grid-cols-12 gap-10">
    <p class="lg:col-span-5 text-2xl lg:text-3xl text-navy leading-snug">
      Thank you for being with us in 2024. Your trust drives our work. Let's make 2025 even better together.
    </p>
    <div class="lg:col-span-6 lg:col-start-7">
      <FeatureColumns items={achievements} columns={2} />
    </div>
  </div>
</Section>
