---
import { langFromPath, localizePath } from '../i18n/routes';
import Section from "./ui/Section.astro";
import SectionHeader from "./ui/SectionHeader.astro";
import Quote from "./ui/Quote.astro";
import Button from "./ui/Button.astro";

interface Props {
  texts?: {
    title: string;
    subtitle: string;
    cta: string;
    ctaLink: string;
  };
  testimonials?: {
    quote: string;
    author: string;
    position: string;
    company: string;
    image: string;
    link: string;
  }[];
}

const {
  texts = {
    title: "What board teams say",
    subtitle: "Secretaries, general counsels and CEOs on running their board with Dafira.",
    cta: "All customer stories",
    ctaLink: "/testimonials"
  },
  testimonials = [
    {
      quote: "Dafira has <strong>transformed</strong> how we manage our board operations, bringing <strong>efficiency</strong> and <strong>clarity</strong> to our governance processes.",
      author: "General Counsel",
      position: "",
      company: "Listed fashion group",
      link: "/case-studies/listed-fashion-group"
    },
    {
      quote: "Dafira has <strong>simplified</strong> our document management tremendously, making our meeting preparations more <strong>efficient</strong> and allowing our board to focus on <strong>decision-making</strong>.",
      author: "CEO",
      position: "",
      company: "Regional public investment fund",
      link: "/case-studies/public-investment-fund"
    },
    {
      quote: "Dafira embraced the <strong>next generation</strong> of Board management software, <strong>easy to use</strong> and with <strong>AI integration</strong>.",
      author: "Paralegal & Compliance Officer",
      position: "",
      company: "Listed healthcare real estate company",
      link: "/case-studies/healthcare-real-estate"
    }
  ]
} = Astro.props;

const lang = langFromPath(Astro.url.pathname);
const readCase = { en: 'Read the case study', fr: 'Lire l’étude de cas', nl: 'Lees het klantverhaal', ar: 'اقرأ دراسة الحالة' }[lang];
---

<Section id="testimonials">
  <SectionHeader title={texts.title} lead={texts.subtitle} />
  <div class="grid lg:grid-cols-3 gap-x-10" data-play>
    {testimonials.map((t, i) => (
      <Quote
        class="border-t border-line pt-8 pb-10"
        data-step
        style={`--d:${i * 80}`}
        quote={t.quote}
        author={t.author}
        role={t.position}
        company={t.company}
        image={t.image}
        href={localizePath(lang, t.link)}
        linkText={readCase}
      />
    ))}
  </div>
  <div class="pt-8 border-t border-line">
    <Button variant="link" href={texts.ctaLink}>{texts.cta}</Button>
  </div>
</Section>
