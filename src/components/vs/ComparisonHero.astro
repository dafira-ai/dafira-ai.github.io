---
// Top of a comparison page: PageHero with one primary action, one secondary action,
// and an "at a glance" register of facts in the aside.
import { PageHero, Button } from '../ui';

interface Props {
  eyebrow: string;
  title: string;
  lead: string;
  primary: { text: string; href: string };
  secondary: { text: string; href: string };
  glance: { label: string; rows: [string, string][] };
}

const { eyebrow, title, lead, primary, secondary, glance } = Astro.props;
---

<PageHero eyebrow={eyebrow} title={title} lead={lead}>
  <Fragment slot="actions">
    <Button href={primary.href}>{primary.text}</Button>
    <Button variant="secondary" href={secondary.href}>{secondary.text}</Button>
  </Fragment>
  <div slot="aside" class="border border-line rounded-md bg-surface">
    <p class="px-6 py-4 border-b border-line font-mono text-xs uppercase tracking-[0.08em] text-gray-500">{glance.label}</p>
    <dl class="divide-y divide-line">
      {glance.rows.map(([term, value]) => (
        <div class="px-6 py-4 grid sm:grid-cols-3 gap-1 sm:gap-4">
          <dt class="text-sm font-medium text-navy">{term}</dt>
          <dd class="sm:col-span-2 text-[15px] text-gray-700 leading-relaxed">{value}</dd>
        </div>
      ))}
    </dl>
  </div>
</PageHero>
