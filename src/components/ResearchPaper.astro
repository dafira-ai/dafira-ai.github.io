---
// Research paper layout: sober header (title, authors, institution, date), abstract, sticky contents list and Prose body.
// Numbers in the body must come from the paper itself; cite them with KeyFigure (source required).
import { Container, Section, Eyebrow, Prose, CTA } from './ui';
import SharingButtons from './socials/SharingButtons.astro';
import { langFromPath } from '../i18n/routes';
import { ctaProps } from './blog/blog-i18n';

interface Props {
  title: string;
  authors: string;
  institution: string;
  date: string;
  abstract: string;
  toc?: { id: string; text: string }[];
}

const { title, authors, institution, date, abstract, toc = [] } = Astro.props;
const lang = langFromPath(Astro.url.pathname);
const t = {
  en: { eyebrow: 'Research paper', abstract: 'Abstract', contents: 'Contents', authors: 'Authors', institution: 'Institution', published: 'Published' },
  fr: { eyebrow: 'Étude', abstract: 'Résumé', contents: 'Sommaire', authors: 'Auteurs', institution: 'Institution', published: 'Publication' },
  nl: { eyebrow: 'Onderzoek', abstract: 'Samenvatting', contents: 'Inhoud', authors: 'Auteurs', institution: 'Instelling', published: 'Gepubliceerd' },
  ar: { eyebrow: 'Research paper', abstract: 'Abstract', contents: 'Contents', authors: 'Authors', institution: 'Institution', published: 'Published' },
}[lang];
---

<header class="pt-32 pb-14 lg:pt-36 bg-white border-b border-line">
  <Container>
    <div class="max-w-3xl">
      <Eyebrow>{t.eyebrow}</Eyebrow>
      <h1 class="mt-6 text-4xl sm:text-5xl font-semibold text-navy leading-[1.1]">{title}</h1>
    </div>
    <dl class="mt-10 grid sm:grid-cols-3 gap-px bg-line border border-line rounded-md overflow-hidden max-w-3xl">
      <div class="bg-white p-4">
        <dt class="font-mono text-xs uppercase tracking-[0.08em] text-gray-500">{t.authors}</dt>
        <dd class="mt-1 text-navy font-medium">{authors}</dd>
      </div>
      <div class="bg-white p-4">
        <dt class="font-mono text-xs uppercase tracking-[0.08em] text-gray-500">{t.institution}</dt>
        <dd class="mt-1 text-gray-700">{institution}</dd>
      </div>
      <div class="bg-white p-4">
        <dt class="font-mono text-xs uppercase tracking-[0.08em] text-gray-500">{t.published}</dt>
        <dd class="mt-1 text-gray-700">{date}</dd>
      </div>
    </dl>
  </Container>
</header>

<Section space="md">
  <div class="grid lg:grid-cols-12 gap-12">
    {toc.length > 0 && (
      <aside class="hidden lg:block lg:col-span-3">
        <nav class="sticky top-24" aria-label={t.contents}>
          <p class="font-mono text-xs uppercase tracking-[0.08em] text-gray-500">{t.contents}</p>
          <ol class="mt-4 border-s border-line">
            {toc.map((item) => (
              <li>
                <a href={`#${item.id}`} class="block -ms-px border-s border-transparent ps-4 py-1.5 text-sm text-gray-600 hover:text-navy hover:border-navy transition-colors">{item.text}</a>
              </li>
            ))}
          </ol>
        </nav>
      </aside>
    )}
    <div class:list={[toc.length > 0 ? 'lg:col-span-9' : 'lg:col-span-12']}>
      <section class="border-s-2 border-primary bg-surface rounded-e-md px-6 py-5 max-w-[68ch]">
        <h2 class="font-mono text-xs uppercase tracking-[0.08em] text-gray-500">{t.abstract}</h2>
        <p class="mt-3 text-gray-700 leading-relaxed">{abstract}</p>
      </section>
      <Prose class="mt-12 df-research">
        <slot />
      </Prose>
      <SharingButtons title={title} message={abstract} href={Astro.url.href} class="mt-16 pt-8 border-t border-line max-w-[68ch]" />
    </div>
  </div>
</Section>

<CTA {...ctaProps(lang)} />

<style is:global>
  .df-research h2 { scroll-margin-top: 6rem; }
  .df-research > h2:first-child { margin-top: 0; }
</style>
