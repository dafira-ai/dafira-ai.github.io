---
// Office: photo, city, address and contact e-mail. No overlays.
import { Icon } from './ui';

type Props = {
  city: string;
  country: string;
  address: string;
  postalCode: string;
  image: string;
  email: string;
};

const { city, country, address, postalCode, image, email } = Astro.props;
---

<article class="border border-line rounded-md overflow-hidden bg-white">
  <img src={image} alt={`${city} office`} loading="lazy" class="w-full h-56 object-cover border-b border-line" />
  <div class="p-6">
    <h3 class="text-xl font-semibold text-navy">{city}</h3>
    <p class="font-mono text-xs uppercase tracking-[0.08em] text-gray-500 mt-1">{country}</p>
    <dl class="mt-6 space-y-3 text-[15px] text-gray-700">
      <div class="flex items-start gap-3">
        <dt class="sr-only">Address</dt>
        <Icon name="building" class="w-5 h-5 text-navy mt-0.5 shrink-0" />
        <dd>{address}<br />{postalCode} {city}</dd>
      </div>
      <div class="flex items-start gap-3">
        <dt class="sr-only">E-mail</dt>
        <Icon name="mail" class="w-5 h-5 text-navy mt-0.5 shrink-0" />
        <dd><a href={`mailto:${email}`} class="text-primary hover:text-navy transition-colors">{email}</a></dd>
      </div>
    </dl>
  </div>
</article>
