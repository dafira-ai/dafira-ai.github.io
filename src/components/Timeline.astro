---
import Section from './ui/Section.astro';
import SectionHeader from './ui/SectionHeader.astro';
import Button from './ui/Button.astro';
import beforeMeetingImg from '../assets/images/before-meeting.jpg';
import duringMeetingImg from '../assets/images/during-meeting.jpg';
import afterMeetingImg from '../assets/images/after-meeting.jpg';

interface Props {
  texts?: {
    title: string;
    subtitle: string;
    cta: string;
    ctaLink: string;
  };
  timelineSteps?: {
    phase: string;
    title: string;
    icon: string;
    color: string;
    image: string;
    features: {
      title: string;
      description: string;
      icon: string;
    }[];
  }[];
}

const {
  texts = {
    title: "Before, during and after the meeting",
    subtitle: "One workspace follows the meeting from the first agenda draft to the last signature.",
    cta: "Try Dafira",
    ctaLink: "/try"
  },
  timelineSteps = [
    {
      phase: "Before",
      title: "Simplifying Preparation",
      icon: "📋",
      color: "from-blue-500 to-primary",
      image: beforeMeetingImg,
      features: [
        {
          title: "Automated Agendas",
          description: "Quickly create and distribute tailored meeting agendas.",
          icon: "📅"
        },
        {
          title: "Document Management", 
          description: "Organize and share essential materials securely.",
          icon: "📁"
        },
        {
          title: "AI assistant",
          description: "Directors ask questions about the board pack and get summaries of long documents before the meeting.",
          icon: "🤖"
        }
      ]
    },
    {
      phase: "During",
      title: "Real-Time Collaboration",
      icon: "🤝",
      color: "from-primary to-blue-600",
      image: duringMeetingImg,
      features: [
        {
          title: "Live Collaboration",
          description: "Enable board members to annotate documents and engage in discussions during meetings, all in one secure place.",
          icon: "✏"
        },
        {
          title: "Resolutions",
          description: "Capture real-time decisions and track action items efficiently.",
          icon: "📝"
        }
      ]
    },
    {
      phase: "After",
      title: "Seamless Follow-Up",
      icon: "✅",
      color: "from-blue-600 to-primary",
      image: afterMeetingImg,
      features: [
        {
          title: "Minutes",
          description: "Draft the minutes with the AI minute builder, with action items and resolutions carried over.",
          icon: "⚡"
        },
        {
          title: "Task Management",
          description: "Track and assign follow-up tasks, ensuring nothing falls through the cracks.",
          icon: "📋"
        },
        {
          title: "Integrated Communication",
          description: "Stay informed with a real-time news feed, simplify decision-making with votes and polls.",
          icon: "💬"
        }
      ]
    }
  ]
} = Astro.props;
---

<Section>
  <SectionHeader title={texts.title} lead={texts.subtitle} />
  <ol class="grid lg:grid-cols-3 gap-px bg-line border border-line rounded-md overflow-hidden" data-play>
    {timelineSteps.map((step, index) => (
      <li class="bg-white p-8 lg:p-10" data-step style={`--d:${index * 100}`}>
        <div class="flex items-center gap-3">
          <span class="font-mono text-xs text-gray-400 tabular-nums">{String(index + 1).padStart(2, '0')}</span>
          <span class="font-mono text-xs uppercase tracking-[0.08em] text-primary">{step.phase}</span>
        </div>
        <h3 class="mt-4 text-xl font-semibold text-navy">{step.title}</h3>
        <dl class="mt-8 space-y-6">
          {step.features.map((feature) => (
            <div class="border-t border-line pt-4">
              <dt class="font-medium text-ink">{feature.title}</dt>
              <dd class="mt-1 text-[15px] text-gray-600 leading-relaxed">{feature.description}</dd>
            </div>
          ))}
        </dl>
      </li>
    ))}
  </ol>
  <div class="mt-10">
    <Button variant="link" href={texts.ctaLink}>{texts.cta}</Button>
  </div>
</Section>
