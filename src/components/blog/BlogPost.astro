---
// Blog post layout: sober article header (category, title, lead, author, date, reading time),
// hero image, Prose body, sharing, tags, CTA and related posts.
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { Section, SectionHeader, Container, Eyebrow, CTA } from '../ui';
import BlogContent from './BlogContent.astro';
import BlogCard from './BlogCard.astro';
import SharingButtons from '../socials/SharingButtons.astro';
import { BLOG_UI, categoryLabel, ctaProps, formatDate, readingMinutes, resolveBlogImage, type BlogLang } from './blog-i18n';

interface Props {
  lang: BlogLang;
  entry: CollectionEntry<'blog'>;
  related: CollectionEntry<'blog'>[];
}

const { lang, entry, related } = Astro.props;
const t = BLOG_UI[lang];
const { Content } = await entry.render();
const heroImage = resolveBlogImage(entry.data.image);
const indexHref = lang === 'en' ? '/blog' : `/${lang}/blog`;
---

<header class="pt-32 pb-12 lg:pt-36 bg-white">
  <Container size="prose">
    <a href={indexHref} class="inline-flex items-center gap-1.5 font-mono text-xs uppercase tracking-[0.08em] text-primary hover:text-navy transition-colors">
      <svg class="w-3.5 h-3.5 rtl-flip" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M15 19l-7-7 7-7" /></svg>
      {t.back}
    </a>
    <Eyebrow class="mt-8">{categoryLabel(lang, entry.data.category)}</Eyebrow>
    <h1 class="mt-6 text-4xl sm:text-5xl font-semibold text-navy leading-[1.1]">{entry.data.title}</h1>
    <p class="mt-6 text-lg text-gray-600 leading-relaxed">{entry.data.description}</p>
    <dl class="mt-8 pt-6 border-t border-line flex flex-wrap gap-x-8 gap-y-3 text-sm">
      <div>
        <dt class="sr-only">{t.by}</dt>
        <dd><span class="font-medium text-navy">{entry.data.author}</span>{entry.data.authorRole && <span class="text-gray-500"> · {entry.data.authorRole}</span>}</dd>
      </div>
      <div class="text-gray-500"><time datetime={entry.data.pubDate.toISOString()}>{formatDate(lang, entry.data.pubDate)}</time></div>
      <div class="text-gray-500">{t.minRead(readingMinutes(entry.body))}</div>
    </dl>
  </Container>
</header>

<Container size="narrow">
  <div class="border border-line rounded-md overflow-hidden bg-surface aspect-video">
    {typeof heroImage === 'string'
      ? <img src={heroImage} alt={entry.data.imageAlt || entry.data.title} class="w-full h-full object-cover" loading="eager" fetchpriority="high" />
      : <Image src={heroImage} alt={entry.data.imageAlt || entry.data.title} widths={[640, 960, 1200]} sizes="(max-width: 640px) 640px, (max-width: 1024px) 960px, 1200px" class="w-full h-full object-cover" loading="eager" fetchpriority="high" quality={85} format="webp" />}
  </div>
</Container>

<Section size="prose" space="md">
  <article>
    <BlogContent>
      <Content />
    </BlogContent>
    <footer class="mt-16 pt-8 border-t border-line space-y-6">
      <SharingButtons title={entry.data.title} message={entry.data.description} href={Astro.url.href} />
      {entry.data.tags.length > 0 && (
        <div class="flex flex-wrap items-center gap-2">
          <span class="font-mono text-xs uppercase tracking-[0.08em] text-gray-500 me-2">{t.tags}</span>
          {entry.data.tags.map((tag) => <span class="px-2 py-0.5 rounded-sm border border-line text-xs text-gray-700">{tag}</span>)}
        </div>
      )}
    </footer>
  </article>
</Section>

<CTA {...ctaProps(lang)} />

{related.length > 0 && (
  <Section tone="surface" space="md" border="top">
    <SectionHeader title={t.related} layout="stacked" class="!mb-10" />
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
      {related.map((post) => <BlogCard post={post} lang={lang} />)}
    </div>
  </Section>
)}
