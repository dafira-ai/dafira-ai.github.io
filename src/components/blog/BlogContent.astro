---
// Markdown body of a blog post / podcast episode, rendered with the Prose typography.
import { Prose } from '../ui';

interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<Prose class:list={['df-blog', className]}>
  <slot />
</Prose>

<style is:global>
  /* Markdown extras used inside posts (e.g. ::: info-box). Sober rendering, tokens only. */
  .df-blog .info-box {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    align-items: center;
    margin: 2.5em 0;
    padding: 1.5rem;
    background: rgb(var(--surface));
    border: 1px solid rgb(var(--line));
    border-inline-start: 2px solid rgb(var(--brand));
    border-radius: 4px;
  }
  @media (min-width: 768px) {
    .df-blog .info-box { grid-template-columns: 1fr 1fr; }
  }
  .df-blog .info-box .content { display: flex; flex-direction: column; gap: 0.75rem; }
  .df-blog .info-box :is(h1, h2, h3, h4, p) { margin: 0; }
  .df-blog .info-box img { width: 100%; height: auto; margin: 0; }
  .df-blog img { margin-block: 2em; }
  .df-blog h1 { font-size: 2rem; line-height: 1.2; font-weight: 600; color: rgb(var(--navy)); }
  /* Legacy utility classes embedded in some markdown files: neutralise decorative backgrounds. */
  .df-blog [class*="bg-gradient"], .df-blog [class*="bg-gray-50"] {
    background: rgb(var(--surface)) !important;
    border: 1px solid rgb(var(--line));
    border-radius: 4px !important;
  }
  .df-blog [class*="font-bold"] { font-weight: 600; }
</style>
