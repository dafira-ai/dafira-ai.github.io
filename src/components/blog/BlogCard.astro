---
// Blog post tile (Card): image, category, reading time, title, description, author.
import { Image } from 'astro:assets';
import { Card } from '../ui';
import { BLOG_UI, blogHref, categoryLabel, readingMinutes, resolveBlogImage, type BlogLang } from './blog-i18n';

interface Props {
  post: {
    slug: string;
    body?: string;
    data: {
      title: string;
      description: string;
      pubDate: Date;
      author: string;
      authorRole: string;
      image: string;
      imageAlt?: string;
      category: string;
      tags: string[];
    };
  };
  lang: string;
  featured?: boolean;
}

const { post, lang: rawLang } = Astro.props;
const lang = (['fr', 'nl'].includes(rawLang) ? rawLang : 'en') as BlogLang;
const t = BLOG_UI[lang];
const cardImage = resolveBlogImage(post.data.image);
const minutes = readingMinutes(post.body);
---

<Card href={blogHref(lang, post.slug)} padding="sm" class="flex flex-col h-full">
  <div class="-mx-5 -mt-5 mb-5 aspect-[16/9] overflow-hidden rounded-t-md border-b border-line bg-surface">
    {typeof cardImage === 'string'
      ? <img src={cardImage} alt={post.data.imageAlt || ''} class="w-full h-full object-cover" loading="lazy" />
      : <Image src={cardImage} alt={post.data.imageAlt || ''} class="w-full h-full object-cover" widths={[400, 760]} sizes="(max-width: 768px) 100vw, 400px" loading="lazy" quality={80} format="webp" />}
  </div>
  <p class="font-mono text-xs uppercase tracking-[0.08em] text-gray-500">
    {categoryLabel(lang, post.data.category)}
    {post.body && <span> · {t.minRead(minutes)}</span>}
  </p>
  <h3 class="mt-3 text-lg font-semibold text-navy leading-snug group-hover:text-primary transition-colors">{post.data.title}</h3>
  <p class="mt-2 text-[15px] text-gray-600 leading-relaxed line-clamp-3">{post.data.description}</p>
  <p class="mt-auto pt-5 text-sm text-gray-500">{post.data.author}</p>
</Card>
