---
// Three plans side by side, separated by hairlines. The recommended plan carries a Badge.
import { Badge, Button, Icon } from '../ui';
import { langFromPath, localizePath } from '../../i18n/routes';

interface Plan {
  name: string;
  price: string;
  description: string;
  limits?: string;
  popular?: boolean;
  features: string[];
}

interface Props {
  plans: Plan[];
  texts?: {
    requestQuote: string;
    billedAnnually: string;
    mostPopular: string;
    month: string;
  };
}

const {
  plans,
  texts = {
    requestQuote: 'Request a quote',
    billedAnnually: 'billed annually',
    mostPopular: 'Recommended',
    month: 'month',
  },
} = Astro.props;

const lang = langFromPath(Astro.url.pathname);
const locale = { en: 'en-IE', fr: 'fr-BE', nl: 'nl-BE', ar: 'en-IE' }[lang];
const formatPrice = (price: string) =>
  isNaN(Number(price))
    ? price
    : new Intl.NumberFormat(locale, { style: 'currency', currency: 'EUR', maximumFractionDigits: 0 }).format(Number(price));
// Emoji markers from the data are not shown; AI features already say so in their label.
const clean = (s: string) => s.replace(/\s*✨\s*/g, '').trim();
const contactHref = localizePath(lang, '/contact');
---

<div class="grid gap-px bg-line border border-line rounded-md overflow-hidden lg:grid-cols-3" data-play>
  {plans.map((plan, i) => {
    const numeric = !isNaN(Number(plan.price));
    return (
      <article
        class="relative bg-white p-6 lg:p-8 flex flex-col"
        data-step
        style={`--d:${i * 80}`}
        aria-labelledby={`plan-${i}`}
      >
        {plan.popular && <span class="absolute inset-x-0 top-0 h-0.5 bg-navy" aria-hidden="true"></span>}
        <div class="flex items-center justify-between gap-3 min-h-[1.5rem]">
          <h2 id={`plan-${i}`} class="text-xl font-semibold text-navy">{plan.name}</h2>
          {plan.popular && <Badge tone="info">{texts.mostPopular}</Badge>}
        </div>
        <p class="mt-3 text-[15px] text-gray-600 leading-relaxed">{plan.description}</p>

        <div class="mt-8">
          <p class="flex items-baseline gap-1.5">
            <span class:list={[numeric ? 'font-mono text-4xl tabular-nums' : 'text-3xl font-semibold', 'text-navy']}>{formatPrice(plan.price)}</span>
            {numeric && <span class="text-gray-500">/ {texts.month}</span>}
          </p>
          <p class="mt-1 text-sm text-gray-500 min-h-[1.25rem]">{numeric ? texts.billedAnnually : ''}</p>
        </div>

        {plan.limits && (
          <p class="mt-6 font-mono text-xs uppercase tracking-[0.08em] text-gray-500">{plan.limits}</p>
        )}

        <Button
          href={contactHref}
          variant={plan.popular ? 'primary' : 'secondary'}
          class="mt-6 w-full"
        >
          {texts.requestQuote}
        </Button>

        <ul class="mt-8 pt-6 border-t border-line space-y-3">
          {plan.features.map((feature) =>
            clean(feature).endsWith(':') ? (
              <li class="text-sm font-medium text-navy">{clean(feature)}</li>
            ) : (
              <li class="flex items-start gap-2.5 text-[15px] text-gray-700">
                <Icon name="check" class="w-4 h-4 mt-1 text-primary" />
                <span>{clean(feature)}</span>
              </li>
            )
          )}
        </ul>
      </article>
    );
  })}
</div>
