---

<PricingPlans plans={plans} texts={planTexts} />

<!-- Feature comparison -->
<div class="mt-24" id="comparison">
  <SectionHeader title={featureComparison.title} lead={featureComparison.subtitle} layout="split" />

  <div class="overflow-x-auto border border-line rounded-md" tabindex="0" role="region" aria-label={featureComparison.title}>
    <table class="w-full min-w-[640px] text-[15px] border-collapse">
      <caption class="sr-only">{featureComparison.title}</caption>
      <thead>
        <tr class="bg-surface">
          <th scope="col" class="sticky start-0 z-10 bg-surface px-4 py-3 text-start font-mono text-xs uppercase tracking-[0.08em] text-gray-500 font-normal w-2/5">
            {featureComparison.feature ?? "Feature"}
          </th>
          {plans.map((plan) => (
            <th scope="col" class="px-4 py-3 text-center text-sm font-semibold text-navy">{plan.name}</th>
          ))}
        </tr>
      </thead>
      {featureCategories.map((category) => (
        <tbody>
          <tr class="border-t border-line">
            <th scope="colgroup" colspan={plans.length + 1} class="sticky start-0 bg-white px-4 pt-6 pb-2 text-start text-sm font-semibold text-navy">
              {category.name}
            </th>
          </tr>
          {category.features.map((feature) => (
            <tr class="border-t border-line">
              <th scope="row" class="sticky start-0 bg-white px-4 py-2.5 text-start font-normal text-gray-700">{feature.name}</th>
              {[feature.essential, feature.pro, feature.enterprise].map((value) => (
                <td class="px-4 py-2.5 text-center">
                  {typeof value === "boolean" ? (
                    value ? (
                      <>
                        <Icon name="check" class="w-5 h-5 text-navy mx-auto" />
                        <span class="sr-only">{featureComparison.included ?? "Included"}</span>
                      </>
                    ) : (
                      <>
                        <span class="text-gray-300" aria-hidden="true">–</span>
                        <span class="sr-only">{featureComparison.notIncluded ?? "Not included"}</span>
                      </>
                    )
                  ) : (
                    <span class="text-sm text-gray-700">{value}</span>
                  )}
                </td>
              ))}
            </tr>
          ))}
        </tbody>
      ))}
    </table>
  </div>
</div>
