---
import Section from "./ui/Section.astro";
import SectionHeader from "./ui/SectionHeader.astro";
import FeatureColumns from "./ui/FeatureColumns.astro";
import Button from "./ui/Button.astro";

interface Feature {
  title: string;
  description: string;
  /** @deprecated emoji icons are no longer rendered; icons follow the pillar order */
  icon?: string;
  features: string[];
  /** @deprecated */
  gradient?: string;
}

interface Texts {
  title: string;
  subtitle: string;
  exploreButton: string;
  learnMore: string;
  exploreButtonUrl: string;
}

interface Props {
  texts?: Texts;
  pillars?: Feature[];
}

const {
  texts = {
    title: "From agenda to signed minutes, in one place",
    subtitle: "Dafira covers the full board cycle: preparing the meeting, holding it, and following up on what was decided.",
    exploreButton: "See all features",
    learnMore: "Learn more",
    exploreButtonUrl: "/features"
  },
  pillars = [
    {
      title: "Prepare the meeting",
      description: "Build the agenda, assemble the board pack and share it securely. Directors read and annotate on any device.",
      features: ["Agenda builder", "Document library", "Private annotations", "Secure authentication"],
    },
    {
      title: "Understand the papers",
      description: "Ask the AI assistant about the board papers and get summaries of long documents. Draft minutes in a fraction of the time.",
      features: ["AI assistant on board documents", "AI minute builder", "Secure board chat", "Action item follow-up"],
    },
    {
      title: "Decide and record",
      description: "Hold votes, sign minutes electronically and keep a register of every decision, with access set by board role.",
      features: ["Voting", "E-signature", "Decision log", "Role-based access"],
    }
  ]
} = Astro.props;

const icons = ["document", "sparkle", "shield"];
const columns = pillars.map((p, i) => ({ icon: icons[i % icons.length], title: p.title, text: p.description, items: p.features }));
---

<Section id="features">
  <SectionHeader title={texts.title} lead={texts.subtitle} />
  <FeatureColumns items={columns} />
  <div class="pt-8 border-t border-line">
    <Button variant="link" href={texts.exploreButtonUrl}>{texts.exploreButton}</Button>
  </div>
</Section>
