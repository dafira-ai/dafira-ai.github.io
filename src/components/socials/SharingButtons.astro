---
// Share links (LinkedIn, X, copy link). Text links, no brand colours.
import { langFromPath } from '../../i18n/routes';
import { BLOG_UI, type BlogLang } from '../blog/blog-i18n';

interface Props {
  title: string;
  message: string;
  href: string;
  class?: string;
}

const { title, message, href, class: className } = Astro.props;
const l = langFromPath(Astro.url.pathname);
const t = BLOG_UI[(l === 'fr' || l === 'nl' ? l : 'en') as BlogLang].share;
const link = 'inline-flex items-center gap-2 text-sm text-gray-600 hover:text-navy transition-colors';
---

<div class:list={['flex flex-wrap items-center gap-x-6 gap-y-3', className]} data-title={title}>
  <span class="font-mono text-xs uppercase tracking-[0.08em] text-gray-500">{t.label}</span>
  <a href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(href)}`} target="_blank" rel="noopener noreferrer" class={link}>
    <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
    {t.linkedin}
  </a>
  <a href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(message)}&url=${encodeURIComponent(href)}`} target="_blank" rel="noopener noreferrer" class={link}>
    <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
    {t.x}
  </a>
  <button type="button" class={link} data-copy-link data-copied={t.copied}>
    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true"><path d="M10 14a4 4 0 0 0 5.66 0l3-3a4 4 0 0 0-5.66-5.66l-1 1M14 10a4 4 0 0 0-5.66 0l-3 3a4 4 0 0 0 5.66 5.66l1-1"/></svg>
    <span>{t.copy}</span>
  </button>
</div>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy-link]').forEach((btn) => {
    btn.addEventListener('click', () => {
      navigator.clipboard?.writeText(window.location.href).then(() => {
        const label = btn.querySelector('span');
        if (label) label.textContent = btn.dataset.copied || '';
      });
    });
  });
</script>
