---
import { langFromPath, localizePath } from "../i18n/routes";
import Section from "./ui/Section.astro";
import SectionHeader from "./ui/SectionHeader.astro";
import CellGrid from "./ui/CellGrid.astro";
import FeatureList from "./ui/FeatureList.astro";
import Button from "./ui/Button.astro";

interface Persona {
  role: string;
  description: string;
  icon: string;
  features: string[];
  link: string;
}

interface Props {
  texts?: {
    title: string;
    subtitle: string;
    cta: string;
    learnMore: string;
  };
  personas?: Persona[];
}

const {
  texts = {
    title: "One portal, four ways to use it",
    subtitle: "Executives, secretaries, directors and legal teams each see the board from their own angle.",
    cta: "Find Your Role-Based Solution",
    learnMore: "See how it works for this role"
  },
  personas = [
    {
      role: "CEO & Executives",
      description: "Keep the board informed between meetings and follow up on decisions without chasing people by email.",
      icon: "👔",
      features: [
        "Real-time board engagement tracking",
        "Strategic decision support", 
        "Performance analytics",
        "Executive dashboards"
      ],
      link: "/for/ceo"
    },
    {
      role: "Board Professionals & Admin",
      description: "Prepare agendas, assemble board packs and circulate minutes from one place instead of shared drives and email threads.",
      icon: "📊",
      features: [
        "Automated meeting scheduling",
        "Document distribution",
        "Task management", 
        "Stakeholder communications"
      ],
      link: "/for/board-secretary"
    },
    {
      role: "Directors & Trustees",
      description: "Read and annotate the board pack on any device, vote, and find past decisions when you need them.",
      icon: "🎯",
      features: [
        "Intuitive document access",
        "Meeting preparation tools",
        "Voting capabilities",
        "Strategic insights"
      ],
      link: "/for/board-member"
    },
    {
      role: "General Counsels",
      description: "Keep resolutions, signatures and the audit trail in order, with documents that stay inside the board.",
      icon: "⚖",
      features: [
        "Compliance monitoring",
        "Risk management tools",
        "Secure document vault",
        "Audit trails"
      ],
      link: "/for/general-counsel"
    }
  ]
} = Astro.props;

const lang = langFromPath(Astro.url.pathname);
---

<Section id="use-cases">
  <SectionHeader title={texts.title} lead={texts.subtitle} />
  <CellGrid columns={2}>
    {personas.map((persona) => (
      <a href={localizePath(lang, persona.link)} class="group bg-white p-8 lg:p-10 hover:bg-surface transition-colors flex flex-col">
        <h3 class="text-xl font-semibold text-navy">{persona.role}</h3>
        <p class="mt-3 text-gray-600 leading-relaxed">{persona.description}</p>
        <FeatureList items={persona.features} columns={2} class="mt-6" />
        <span class="mt-auto pt-8 inline-flex items-center gap-2 text-[15px] font-medium text-primary group-hover:text-navy transition-colors">
          {texts.learnMore}
          <svg class="w-4 h-4 rtl-flip" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M9 5l7 7-7 7" />
          </svg>
        </span>
      </a>
    ))}
  </CellGrid>
</Section>
