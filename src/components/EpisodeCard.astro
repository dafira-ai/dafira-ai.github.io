---
// Podcast episode tile (Card).
import { getSlug } from '../utils/slugify';
import { Card } from './ui';
import { episodeHref, formatEpisodeDate, podcastLang, PODCAST_UI } from './podcast/podcast-i18n';

interface Guest {
  name: string;
  role: string;
  image?: string;
}

interface Props {
  episode: {
    data: {
      title: string;
      description: string;
      image: string;
      pubDate: Date;
      duration: string;
      spotifyUrl: string;
      guests?: Guest[];
    };
  };
}

const { episode } = Astro.props;
const lang = podcastLang(Astro.url.pathname);
const t = PODCAST_UI[lang];
---

<Card href={episodeHref(lang, getSlug(episode.data.title))} padding="sm" class="flex flex-col sm:flex-row gap-5 h-full">
  <img
    loading="lazy"
    src={episode.data.image}
    alt=""
    class="w-full sm:w-32 aspect-square object-cover rounded-sm border border-line shrink-0"
  />
  <div class="flex flex-col min-w-0">
    <p class="font-mono text-xs uppercase tracking-[0.08em] text-gray-500">
      <time datetime={episode.data.pubDate.toISOString()}>{formatEpisodeDate(lang, episode.data.pubDate)}</time> · {episode.data.duration}
    </p>
    <h3 class="mt-2 text-lg font-semibold text-navy leading-snug group-hover:text-primary transition-colors">{episode.data.title}</h3>
    <p class="mt-2 text-[15px] text-gray-600 leading-relaxed line-clamp-3">{episode.data.description}</p>
    {episode.data.guests && episode.data.guests.length > 0 && (
      <p class="mt-4 text-sm text-gray-500">
        {t.guests}: {episode.data.guests.map((g) => g.name).join(', ')}
      </p>
    )}
  </div>
</Card>
