---
import Container from "./ui/Container.astro";
import Button from "./ui/Button.astro";

interface Props {
  texts?: {
    title: string;
    subtitle: string;
    cta1: string;
    cta2: string;
  };
  links?: {
    cta1: string;
    cta2: string;
  };
}

const {
  texts = {
    title: "See Dafira with your own board pack",
    subtitle: "A 30-minute demo with someone who has run board meetings. Bring a real agenda and we will set it up with you.",
    cta1: "Book a demo",
    cta2: "Contact sales"
  },
  links = {
    cta1: "/request-demo",
    cta2: "/contact"
  }
} = Astro.props;
---

<section id="cta" class="bg-navy">
  <Container class="py-20">
    <div class="grid lg:grid-cols-12 gap-8 items-end" data-play>
      <div class="lg:col-span-7" data-step>
        <h2 class="text-3xl lg:text-4xl font-semibold text-white leading-tight">{texts.title}</h2>
        <p class="mt-4 text-lg text-white/70 leading-relaxed max-w-xl">{texts.subtitle}</p>
      </div>
      <div class="lg:col-span-5 flex flex-col sm:flex-row lg:justify-end gap-3" data-step style="--d:80">
        <Button variant="inverse" href={links.cta1}>{texts.cta1}</Button>
        <Button variant="inverse-outline" href={links.cta2}>{texts.cta2}</Button>
      </div>
    </div>
  </Container>
</section>
