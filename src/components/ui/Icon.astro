---
// Line icon. `name` accepts an icon name or a legacy emoji (mapped via iconFor).
import { ICONS, iconFor } from './icons';

interface Props {
  name?: string;
  class?: string;
  label?: string;
}
const { name, class: className = 'w-6 h-6', label } = Astro.props;
const paths = ICONS[iconFor(name)];
---

<svg
  class:list={['shrink-0', className]}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  set:html={paths}
/>
