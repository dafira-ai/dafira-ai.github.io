---
// Ruled columns (2–4) of icon + title + text (+ optional list and link). Replaces "three cards in a row".
import Icon from './Icon.astro';
import FeatureList from './FeatureList.astro';
import Button from './Button.astro';

export interface FeatureColumn {
  icon?: string;
  title: string;
  text?: string;
  items?: string[];
  link?: { text: string; href: string };
}

interface Props {
  items: FeatureColumn[];
  columns?: 2 | 3 | 4;
  class?: string;
}

const { items, columns = 3, class: className } = Astro.props;
const cols = { 2: 'md:grid-cols-2', 3: 'md:grid-cols-2 lg:grid-cols-3', 4: 'md:grid-cols-2 lg:grid-cols-4' }[columns];
---

<div class:list={['grid gap-x-10', cols, className]} data-play>
  {items.map((item, i) => (
    <div class="border-t border-line pt-8 pb-10" data-step style={`--d:${i * 80}`}>
      {item.icon && <Icon name={item.icon} class="w-6 h-6 text-navy" />}
      <h3 class:list={['text-xl font-semibold text-navy', item.icon && 'mt-5']}>{item.title}</h3>
      {item.text && <p class="mt-3 text-gray-600 leading-relaxed">{item.text}</p>}
      {item.items && <FeatureList items={item.items} class="mt-6" />}
      {item.link && <Button variant="link" href={item.link.href} class="mt-6">{item.link.text}</Button>}
    </div>
  ))}
</div>
