---
// Numbered steps — only for real sequences (a process, a setup guide).
interface Props {
  items: { title: string; text?: string }[];
  columns?: 1 | 3 | 4;
  class?: string;
}
const { items, columns = 3, class: className } = Astro.props;
const cols = { 1: '', 3: 'md:grid-cols-3', 4: 'md:grid-cols-2 lg:grid-cols-4' }[columns];
---

<ol class:list={['grid gap-px bg-line border border-line rounded-md overflow-hidden', cols, className]} data-play>
  {items.map((item, i) => (
    <li class="bg-white p-6 lg:p-8" data-step style={`--d:${i * 80}`}>
      <span class="font-mono text-xs text-primary tabular-nums">{String(i + 1).padStart(2, '0')}</span>
      <h3 class="mt-3 text-lg font-semibold text-navy">{item.title}</h3>
      {item.text && <p class="mt-2 text-[15px] text-gray-600 leading-relaxed">{item.text}</p>}
    </li>
  ))}
</ol>
