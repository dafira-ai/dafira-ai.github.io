---
// Short list with dash markers. Strings only; keep items to a few words.
interface Props {
  items: string[];
  columns?: 1 | 2;
  class?: string;
}
const { items, columns = 1, class: className } = Astro.props;
---

<ul class:list={['gap-x-6 gap-y-2.5 grid', columns === 2 ? 'sm:grid-cols-2' : '', className]}>
  {items.map((item) => (
    <li class="flex items-start gap-2.5 text-[15px] text-gray-700">
      <span class="mt-2.5 w-1.5 h-px bg-primary shrink-0" aria-hidden="true"></span>
      <span>{item}</span>
    </li>
  ))}
</ul>
