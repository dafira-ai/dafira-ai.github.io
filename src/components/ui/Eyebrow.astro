---
// Small mono label above a heading, with a short accent rule.
interface Props {
  class?: string;
  tone?: 'default' | 'inverse';
}
const { class: className, tone = 'default' } = Astro.props;
---

<p class:list={[
  'flex items-center gap-3 font-mono text-xs uppercase tracking-[0.08em]',
  tone === 'inverse' ? 'text-white/60' : 'text-gray-500',
  className,
]}>
  <span class:list={['w-5 h-px shrink-0', tone === 'inverse' ? 'bg-white/60' : 'bg-primary']} aria-hidden="true"></span>
  <slot />
</p>
