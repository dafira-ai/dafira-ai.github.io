---
// Discreet one-time entrance for a block (8px, 240ms) when it scrolls into view. Final state without JS / reduced motion.
interface Props {
  delay?: number;
  as?: string;
  class?: string;
}
const { delay = 0, as: Tag = 'div', class: className } = Astro.props;
---

<Tag class={className} data-play>
  <div data-step style={`--d:${delay}`}>
    <slot />
  </div>
</Tag>
